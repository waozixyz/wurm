// One game mixer, with SDL desktop and raylib Android output.
File :: #import "std/file_linux";
Output :: #import, file "audio_output.zi";
#if #defined(ANDROID_BUILD) {
    Assets :: #import "kryon/app_asset";
    music_data: string;
}

Effect :: struct { bytes: [65536]u8; count: s32; position: s32; playing: bool; }
device: u32;
attempted: bool;
muted: bool;
effects: [4]Effect;
music_file: File.FileHandle;
music_bytes: s64;
music_position: s64;
music_track: s32;
music_samples: [4096]u8;
mixed: [2048]s16;
previous_level: s32 = -1;
previous_apples: s32;
previous_death: s32;
previous_transition: s32;
was_playing: bool;

SignedSample :: (low: u8, high: u8) -> s32 {
    value := cast(s32)low | (cast(s32)high << 8)
    if value >= 32768 { value -= 65536 }
    return value
}

#if #defined(ANDROID_BUILD) {
    LoadEffect :: (index: s32, path: string) {
        data := Assets.ReadAppAsset(path)
        defer Assets.FreeAppAsset(data)
        if data.count > 65536 { return }
        for at: 0..data.count - 1 { effects[index].bytes[at] = data[at] }
        effects[index].count = cast(s32)data.count
    }

    ChangeMusic :: (track: s32) {
        if music_track == track && music_data.count > 0 { return }
        Assets.FreeAppAsset(music_data)
        path := "assets/sounds/garden.pcm"
        music_data = Assets.ReadAppAsset(path)
        music_bytes = music_data.count
        music_track = track
        music_position = 0
    }

    ReadMusicSamples :: () {
        if music_bytes <= 0 { return }
        for at: 0..4095 {
            music_samples[at] = music_data[music_position]
            music_position = (music_position + 1) % music_bytes
        }
    }

    CloseMusic :: () {
        Assets.FreeAppAsset(music_data)
        music_data = ""
        music_bytes = 0
    }
} else {
    LoadEffect :: (index: s32, path: string) {
        file := File.OpenRead(path)
        if !file.valid { return }
        defer File.CloseFile(file)
        count := File.ReadAt(file, effects[index].bytes[:], 0)
        if count > 0 && count <= 65536 { effects[index].count = cast(s32)count }
    }

    ChangeMusic :: (track: s32) {
        if music_track == track && music_file.valid { return }
        if music_file.valid { File.CloseFile(music_file) }
        music_track = track
        music_position = 0
        music_file = File.OpenRead("assets/sounds/garden.pcm")
        music_bytes = ifx music_file.valid then File.FileSize(music_file) else 0
    }

    ReadMusicSamples :: () {
        if !music_file.valid || music_bytes <= 0 { return }
        // Fill the entire block across the loop boundary. A short final
        // read must not insert silence before the music starts again.
        filled: s64 = 0
        while filled < music_samples.count {
            count := File.ReadAt(music_file, music_samples[filled:music_samples.count], music_position)
            if count <= 0 { return }
            filled += count
            music_position = (music_position + count) % music_bytes
        }
    }

    CloseMusic :: () {
        if music_file.valid { File.CloseFile(music_file) }
        music_file.valid = false
        music_bytes = 0
    }
}

EnsureAudio :: () {
    // Display-free pixmap verification never opens a real audio device.
    if attempted || !Output.Available() { return }
    attempted = true
    device = Output.Open()
    if device == 0 { return }
    LoadEffect(0, "assets/sounds/start.pcm")
    LoadEffect(1, "assets/sounds/exit.pcm")
    LoadEffect(2, "assets/sounds/lose.pcm")
    LoadEffect(3, "assets/sounds/pickup.pcm")
}

PlayEffect :: (index: s32) {
    effects[index].position = 0
    effects[index].playing = true
}

ToggleMute :: () {
    muted = !muted
    if device != 0 { Output.Clear(device) }
}

PumpAudio :: () {
    if device == 0 || muted { return }
    while Output.Ready(device) {
        for index: 0..4095 { music_samples[index] = 0 }
        ReadMusicSamples()
        for index: 0..2047 {
            value := SignedSample(music_samples[index * 2], music_samples[index * 2 + 1]) / 2
            for effect: 0..3 {
                sound := *effects[effect]
                if sound.playing && sound.position + 1 < sound.count {
                    value += SignedSample(sound.bytes[sound.position], sound.bytes[sound.position + 1])
                    sound.position += 2
                    if sound.position >= sound.count { sound.playing = false }
                }
            }
            if value > 32767 { value = 32767 }
            if value < -32768 { value = -32768 }
            mixed[index] = cast(s16)value
        }
        if !Output.Submit(device, mixed[:]) { return }
    }
}

UpdateAudio :: (playing: bool, level: s32, apples: s32, death: s32, transition: s32) {
    EnsureAudio()
    if device == 0 { return }
    if playing {
        if !was_playing || level != previous_level {
            // One acoustic score accompanies the whole journey. New levels
            // play their cue without rewinding the same recording.
            ChangeMusic(1)
            PlayEffect(0)
        } else {
            if apples < previous_apples { PlayEffect(3) }
            if death > 0 && previous_death == 0 { PlayEffect(2) }
            if death == 0 && previous_death > 0 { PlayEffect(0) }
            if transition > 0 && previous_transition == 0 { PlayEffect(1) }
        }
        PumpAudio()
    } else if was_playing {
        Output.Clear(device)
        CloseMusic()
        for index: 0..3 { effects[index].playing = false }
    }
    was_playing = playing
    previous_level = level
    previous_apples = apples
    previous_death = death
    previous_transition = transition
}
