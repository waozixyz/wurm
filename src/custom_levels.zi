// Owner edits of the recovered levels. Each edited level is one file beside
// the originals, in the archive's own LEVELn.DAT layout plus an object
// plane: the apple count, the 40x30 tiles, then the 40x30 object ids, all
// in the original column order. Old files without objects load with none.
// A missing file leaves the recovered original in play, so deleting a
// saved file restores it.
#import, file "game.zi";
#if #defined(WURM_PORTABLE) {
    Storage :: #import "portable_runtime";
    #import "portable_levels"
    LevelDirectory :: () -> string { return "" }
} else {
    #import, file "level_directory.zi";
    File :: #import "std/file_linux";
}
Originals :: #import, file "original_levels.zi";
#import "std/c_string"
#import "std/number_text"
#import "std/text_buffer"

#if !#defined(WURM_PORTABLE) {
    libc :: #system_library "libc";
    GetEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
}

LEVEL_FILE_BYTES :: 1201;
LEVEL_FILE_V2_BYTES :: 2401;

// The archive and editor layout is always the canonical 40x30 grid,
// independent of the orientation the engine is playing.
At :: (x: s64, y: s64) -> s32 { return cast(s32)(y * COLUMNS + x) }

custom_root: [96]u8;
custom_root_length: s32;
custom_loaded: bool;
custom_present: [LEVEL_COUNT]bool;
custom_apples: [LEVEL_COUNT]s32;
custom_boards: [LEVEL_COUNT][CELLS]u8;
custom_objects: [LEVEL_COUNT][CELLS]u8;

CopyText :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}

// The path buffers stay zero beyond their text, so a NUL scan ends a view.
// Views are derived per call and never stored, so the buffers stay mutable.
BufferText :: (buffer: []u8, length: s32) -> string {
    buffer[length] = 0
    return TextUntilNul(buffer[:])
}

RootText :: () -> string { return BufferText(custom_root[:], custom_root_length) }

// The root must end in a slash; WURM_LEVEL_DIR redirects it for tests so the
// private UI run never writes into the repository's assets.
CustomSetRoot :: (path: string) -> bool {
    if custom_loaded || path.count < 1 || path.count + 1 > custom_root.count { return false }
    at := CopyText(custom_root[:], 0, path)
    if path[path.count - 1] != #char "/" {
        custom_root[at] = #char "/"
        at += 1
    }
    custom_root_length = at
    return true
}

ApplyEnvironmentRoot :: () {
    #if !#defined(WURM_PORTABLE) {
    name: [32]u8
    if !CopyCString("WURM_LEVEL_DIR", name[:]) { return }
    value := GetEnvironment(*name[0])
    if value == null { return }
    length: s32 = 0
    while value[length] != 0 && length < custom_root.count - 1 {
        custom_root[length] = value[length]
        length += 1
    }
    if length > 0 && custom_root[length - 1] != #char "/" && length < custom_root.count {
        custom_root[length] = #char "/"
        length += 1
    }
    custom_root_length = length
    }
}

custom_path: [160]u8;
custom_temp: [160]u8;
LevelPath :: (level: s32, suffix: string) -> string {
    at := CopyText(custom_path[:], 0, RootText())
    at = CopyText(custom_path[:], at, "level")
    digits: [16]u8
    at = CopyText(custom_path[:], at, FormatInteger(cast(s64)(level + 1), digits[:]))
    at = CopyText(custom_path[:], at, suffix)
    return BufferText(custom_path[:], at)
}

EnsureLoaded :: () {
    if custom_loaded { return }
    custom_loaded = true
    if custom_root_length == 0 {
        root := LevelDirectory()
        if root.count + 1 > custom_root.count { return }
        custom_root_length = CopyText(custom_root[:], 0, root)
        ApplyEnvironmentRoot()
    }
    bytes: [LEVEL_FILE_V2_BYTES]u8
    for level: 0..LEVEL_COUNT - 1 {
        size: s64
        read: s64
        #if #defined(WURM_PORTABLE) {
            size = Storage.ReadLevel(LevelPath(cast(s32)level, ".dat"), bytes[:])
            if size < 0 { size = BundledLevel(cast(s32)level, bytes[:]) }
            read = size
        } else {
        file := File.OpenRead(LevelPath(cast(s32)level, ".dat"))
        if file.valid {
            size = File.FileSize(file)
            if size != LEVEL_FILE_BYTES && size != LEVEL_FILE_V2_BYTES {
                File.CloseFile(file)
                continue
            }
            read = File.ReadAt(file, bytes[0:cast(s64)size], 0)
            File.CloseFile(file)
        } else {
            size = ReadBundledLevel(cast(s32)level, bytes[:])
            read = size
        }
        }
        if size != LEVEL_FILE_BYTES && size != LEVEL_FILE_V2_BYTES { continue }
        if read != size { continue }
        custom_present[level] = true
        custom_apples[level] = cast(s32)bytes[0]
        for column: 0..COLUMNS - 1 {
            for row: 0..ROWS - 1 {
                custom_boards[level][At(column, row)] =
                    bytes[1 + column * ROWS + row]
                if size == LEVEL_FILE_V2_BYTES {
                    custom_objects[level][At(column, row)] =
                        bytes[1 + CELLS + column * ROWS + row]
                }
            }
        }
    }
}

HasCustomLevel :: (level: s32) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    return custom_present[level]
}

EffectiveTile :: (level: s32, x: s32, y: s32) -> u8 {
    EnsureLoaded()
    if level >= 0 && level < LEVEL_COUNT && custom_present[level] {
        return custom_boards[level][At(x, y)]
    }
    return BaseTile(level, x, y)
}

EffectiveApples :: (level: s32) -> s32 {
    EnsureLoaded()
    if level >= 0 && level < LEVEL_COUNT && custom_present[level] {
        return custom_apples[level]
    }
    return BaseApples(level)
}

EffectiveObjects :: (level: s32, objects: []u8) {
    EnsureLoaded()
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 {
            objects[At(x, y)] = BaseObject(level, cast(s32)x, cast(s32)y)
        }
    }
    if level < 0 || level >= LEVEL_COUNT { return }
    if custom_present[level] {
        for at: 0..CELLS - 1 { objects[at] = custom_objects[level][at] }
    }
}

// The raw tiles a level starts from: the saved override when one exists,
// otherwise the recovered original.
EffectiveBoard :: (level: s32, board: []u8) {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT {
        for at: 0..CELLS - 1 { board[at] = 20 }
        return
    }
    if custom_present[level] {
        for at: 0..CELLS - 1 { board[at] = custom_boards[level][at] }
        return
    }
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 {
            board[At(x, y)] = BaseTile(level, cast(s32)x, cast(s32)y)
        }
    }
}

// Writes the override, tiles and objects, through a temporary file so a
// failed save never replaces a good one, then refreshes the cache.
SaveCustomLevel :: (level: s32, board: []u8, objects: []u8, apples: s32) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    bytes: [LEVEL_FILE_V2_BYTES]u8
    bytes[0] = cast(u8)apples
    for column: 0..COLUMNS - 1 {
        for row: 0..ROWS - 1 {
            bytes[1 + column * ROWS + row] = board[At(column, row)]
            bytes[1 + CELLS + column * ROWS + row] = objects[At(column, row)]
        }
    }
    #if #defined(WURM_PORTABLE) {
        if !Storage.WriteLevel(LevelPath(level, ".dat"), bytes[:]) { return false }
    } else {
    unused File.CreateDirectory(RootText())
    // LevelPath borrows one buffer, so the temporary name is copied aside
    // before the final name is built.
    temporary := LevelPath(level, ".tmp")
    for index: 0..temporary.count - 1 { custom_temp[index] = temporary[index] }
    temporary_text := BufferText(custom_temp[:], cast(s32)temporary.count)
    file := File.OpenReplace(temporary_text)
    if !file.valid { return false }
    written := File.WriteAt(file, bytes[:], 0)
    File.CloseFile(file)
    if written != LEVEL_FILE_V2_BYTES {
        unused File.RemoveFile(temporary_text)
        return false
    }
    if !File.RenamePath(temporary_text, LevelPath(level, ".dat")) {
        unused File.RemoveFile(temporary_text)
        return false
    }
    }
    custom_present[level] = true
    custom_apples[level] = apples
    for at: 0..CELLS - 1 {
        custom_boards[level][at] = board[at]
        custom_objects[level][at] = objects[at]
    }
    return true
}

// Deleting the override restores the recovered original.
ClearCustomLevel :: (level: s32) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    if !custom_present[level] { return true }
    #if #defined(WURM_PORTABLE) {
        if !Storage.RemoveLevel(LevelPath(level, ".dat")) { return false }
    } else {
        if !File.RemoveFile(LevelPath(level, ".dat")) { return false }
    }
    custom_present[level] = false
    return true
}
