// Landscape records use 40 columns of 30 rows; the independent portrait
// records use 30 columns of 40 rows and a -portrait filename suffix.
// Both contain an apple count and tile/object planes. Missing portrait
// records use an authored variant or a best guess from the landscape.
#import, file "game.zi";
#import, file "authored_levels.zi";
#if #defined(PLATFORM_WEB) {
    BrowserStorage :: #import "kryon/bundle_storage_web";
}
#if #defined(WURM_PORTABLE) {
    Storage :: #import "portable_runtime";
    #import "portable_levels"
    LevelDirectory :: () -> string { return "campaign-" }
} else {
    #import, file "level_directory.zi";
    File :: #import "std/file_linux";
}
Originals :: #import, file "original_levels.zi";
#import "std/number_text"
#import "std/text_buffer"

#if !#defined(WURM_PORTABLE) {
    #import "std/environment_linux"
}

LEVEL_FILE_BYTES :: 1201;
LEVEL_FILE_V2_BYTES :: 2401;

// The archive and editor layout is always the canonical 40x30 grid,
// independent of the orientation the engine is playing.
At :: (x: s64, y: s64, portrait: bool = false) -> s32 {
    return cast(s32)(y * (ifx portrait then ROWS else COLUMNS) + x)
}
Slot :: (level: s32, portrait: bool) -> s32 { return level + (ifx portrait then LEVEL_COUNT else 0) }

custom_root: [96]u8;
custom_root_length: s32;
custom_loaded: bool;
custom_present: [LEVEL_COUNT * 2]bool;
custom_apples: [LEVEL_COUNT * 2]s32;
custom_boards: [LEVEL_COUNT * 2][CELLS]u8;
custom_objects: [LEVEL_COUNT * 2][CELLS]u8;

CopyText :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}

// The path buffers stay zero beyond their text, so a NUL scan ends a view.
// Views are derived per call and never stored, so the buffers stay mutable.
BufferText :: (buffer: []u8, length: s32) -> string {
    buffer[length] = 0
    return TextUntilNul(buffer[:])
}

RootText :: () -> string { return BufferText(custom_root[:], custom_root_length) }

// The root must end in a slash; WURM_LEVEL_DIR redirects it for tests so the
// private UI run never writes into the repository's assets.
CustomSetRoot :: (path: string) -> bool {
    if custom_loaded || path.count < 1 || path.count + 1 > custom_root.count { return false }
    at := CopyText(custom_root[:], 0, path)
    if path[path.count - 1] != #char "/" {
        custom_root[at] = #char "/"
        at += 1
    }
    custom_root_length = at
    return true
}

ApplyEnvironmentRoot :: () {
    #if !#defined(WURM_PORTABLE) {
    value := EnvironmentText("WURM_LEVEL_DIR")
    if value == "" { return }
    length: s32 = 0
    while length < value.count && length < custom_root.count - 1 {
        custom_root[length] = value[length]
        length += 1
    }
    if length > 0 && custom_root[length - 1] != #char "/" && length < custom_root.count {
        custom_root[length] = #char "/"
        length += 1
    }
    custom_root_length = length
    }
}

custom_path: [160]u8;
custom_temp: [160]u8;
LevelPath :: (level: s32, suffix: string, portrait: bool = false) -> string {
    at := CopyText(custom_path[:], 0, RootText())
    at = CopyText(custom_path[:], at, "level")
    digits: [16]u8
    at = CopyText(custom_path[:], at, FormatInteger(cast(s64)(level + 1), digits[:]))
    if portrait { at = CopyText(custom_path[:], at, "-portrait") }
    at = CopyText(custom_path[:], at, suffix)
    return BufferText(custom_path[:], at)
}

EnsureLoaded :: () {
    if custom_loaded { return }
    custom_loaded = true
    if custom_root_length == 0 {
        root := LevelDirectory()
        if root.count + 1 > custom_root.count { return }
        custom_root_length = CopyText(custom_root[:], 0, root)
        ApplyEnvironmentRoot()
    }
    bytes: [LEVEL_FILE_V2_BYTES]u8
    for slot: 0..LEVEL_COUNT * 2 - 1 {
        level := cast(s32)slot % LEVEL_COUNT
        portrait := slot >= LEVEL_COUNT
        columns := ifx portrait then ROWS else COLUMNS
        rows := ifx portrait then COLUMNS else ROWS
        size: s64
        read: s64
        #if #defined(WURM_PORTABLE) {
            size = Storage.ReadLevel(LevelPath(level, ".dat", portrait), bytes[:])
            if size < 0 && !portrait { size = BundledLevel(level, bytes[:]) }
            read = size
        } else {
        file := File.OpenRead(LevelPath(level, ".dat", portrait))
        if file.valid {
            size = File.FileSize(file)
            if size != LEVEL_FILE_BYTES && size != LEVEL_FILE_V2_BYTES {
                File.CloseFile(file)
                continue
            }
            read = File.ReadAt(file, bytes[0:cast(s64)size], 0)
            File.CloseFile(file)
        } else {
            size = ifx portrait then -1 else ReadBundledLevel(level, bytes[:])
            read = size
        }
        }
        if size != LEVEL_FILE_BYTES && size != LEVEL_FILE_V2_BYTES { continue }
        if read != size { continue }
        custom_present[slot] = true
        custom_apples[slot] = cast(s32)bytes[0]
        for column: 0..columns - 1 {
            for row: 0..rows - 1 {
                custom_boards[slot][At(column, row, portrait)] =
                    bytes[1 + column * rows + row]
                if size == LEVEL_FILE_V2_BYTES {
                    custom_objects[slot][At(column, row, portrait)] =
                        bytes[1 + CELLS + column * rows + row]
                }
            }
        }
    }
}

HasCustomLevel :: (level: s32, portrait: bool = false) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    return custom_present[Slot(level, portrait)]
}
EffectiveApples :: (level: s32, portrait: bool = false) -> s32 {
    EnsureLoaded()
    if HasCustomLevel(level, portrait) { return custom_apples[Slot(level, portrait)] }
    authored := AuthoredApples(level,portrait)
    if authored >= 0 { return authored }
    if portrait && HasCustomLevel(level) { return custom_apples[level] }
    authored = AuthoredApples(level,false)
    if authored >= 0 { return authored }
    return BaseApples(level)
}
HasAuthoredLevel :: (level: s32, portrait: bool = false) -> bool {
    return AuthoredTiles(level,portrait).count == CELLS
}
// The published campaign is separate from each player's editable overrides.
DefaultBoard :: (level: s32, board: []u8, portrait: bool = false) {
    text := AuthoredTiles(level,portrait)
    columns := ifx portrait then ROWS else COLUMNS
    rows := ifx portrait then COLUMNS else ROWS
    if text.count == CELLS {
        for x: 0..columns - 1 {
            for y: 0..rows - 1 { board[y * columns + x] = AuthoredDecode(text[x * rows + y]) }
        }
    } else if portrait {
        landscape: [CELLS]u8
        DefaultBoard(level,landscape[:])
        if HasAuthoredLevel(level) { GuessPortrait(landscape[:],board) }
        else { PortraitBoard(level,landscape[:],board) }
    } else {
        for y: 0..ROWS - 1 {
            for x: 0..COLUMNS - 1 { board[y * COLUMNS + x] = BaseTile(level,cast(s32)x,cast(s32)y) }
        }
    }
}
EffectiveBoard :: (level: s32, board: []u8, portrait: bool = false) {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT {
        for at: 0..CELLS - 1 { board[at] = 20 }
        return
    }
    slot := Slot(level, portrait)
    if custom_present[slot] {
        for at: 0..CELLS - 1 { board[at] = custom_boards[slot][at] }
        return
    }
    if portrait && !HasAuthoredLevel(level,true) && HasCustomLevel(level) {
        landscape: [CELLS]u8
        EffectiveBoard(level, landscape[:])
        GuessPortrait(landscape[:], board)
    } else {
        DefaultBoard(level,board,portrait)
    }
}
EffectiveTile :: (level: s32, x: s32, y: s32, portrait: bool = false) -> u8 {
    board: [CELLS]u8
    EffectiveBoard(level,board[:],portrait)
    return board[At(x,y,portrait)]
}
EffectiveObjects :: (level: s32, objects: []u8, portrait: bool = false) {
    EnsureLoaded()
    if HasCustomLevel(level, portrait) {
        slot := Slot(level,portrait)
        for at: 0..CELLS - 1 { objects[at] = custom_objects[slot][at] }
    } else if HasAuthoredLevel(level,portrait) {
        text := AuthoredObjects(level,portrait)
        columns := ifx portrait then ROWS else COLUMNS
        rows := ifx portrait then COLUMNS else ROWS
        for x: 0..columns - 1 {
            for y: 0..rows - 1 {
                objects[y * columns + x] = ifx text.count == CELLS then AuthoredDecode(text[x * rows + y]) else 0
            }
        }
    } else if portrait {
        landscape: [CELLS]u8
        EffectiveObjects(level,landscape[:])
        TurnForward(landscape[:],objects)
    } else {
        for y: 0..ROWS - 1 {
            for x: 0..COLUMNS - 1 { objects[At(x,y)] = BaseObject(level,cast(s32)x,cast(s32)y) }
        }
    }
}

// Writes the override, tiles and objects, through a temporary file so a
// failed save never replaces a good one, then refreshes the cache.
SaveCustomLevel :: (level: s32, board: []u8, objects: []u8, apples: s32, portrait: bool = false) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    columns := ifx portrait then ROWS else COLUMNS
    rows := ifx portrait then COLUMNS else ROWS
    slot := Slot(level,portrait)
    bytes: [LEVEL_FILE_V2_BYTES]u8
    bytes[0] = cast(u8)apples
    for column: 0..columns - 1 {
        for row: 0..rows - 1 {
            bytes[1 + column * rows + row] = board[At(column, row, portrait)]
            bytes[1 + CELLS + column * rows + row] = objects[At(column, row, portrait)]
        }
    }
    #if #defined(WURM_PORTABLE) {
        if !Storage.WriteLevel(LevelPath(level, ".dat", portrait), bytes[:]) { return false }
    } else {
    unused File.CreateDirectory(RootText())
    // LevelPath borrows one buffer, so the temporary name is copied aside
    // before the final name is built.
    temporary := LevelPath(level, ".tmp", portrait)
    for index: 0..temporary.count - 1 { custom_temp[index] = temporary[index] }
    temporary_text := BufferText(custom_temp[:], cast(s32)temporary.count)
    file := File.OpenReplace(temporary_text)
    if !file.valid { return false }
    written := File.WriteAt(file, bytes[:], 0)
    File.CloseFile(file)
    if written != LEVEL_FILE_V2_BYTES {
        unused File.RemoveFile(temporary_text)
        return false
    }
    if !File.RenamePath(temporary_text, LevelPath(level, ".dat", portrait)) {
        unused File.RemoveFile(temporary_text)
        return false
    }
    #if #defined(PLATFORM_WEB) {
        if !BrowserStorage.BundleStorageFlush() { return false }
    }
    }
    custom_present[slot] = true
    custom_apples[slot] = apples
    for at: 0..CELLS - 1 {
        custom_boards[slot][at] = board[at]
        custom_objects[slot][at] = objects[at]
    }
    return true
}

// Deleting the override restores the recovered original.
ClearCustomLevel :: (level: s32, portrait: bool = false) -> bool {
    EnsureLoaded()
    if level < 0 || level >= LEVEL_COUNT { return false }
    slot := Slot(level,portrait)
    if !custom_present[slot] { return true }
    #if #defined(WURM_PORTABLE) {
        if !Storage.RemoveLevel(LevelPath(level, ".dat", portrait)) { return false }
    } else {
        if !File.RemoveFile(LevelPath(level, ".dat", portrait)) { return false }
    }
    custom_present[slot] = false
    #if #defined(PLATFORM_WEB) {
        return BrowserStorage.BundleStorageFlush()
    }
    return true
}
