AuthoredAlphabet :: "0123456789ABCDEFGH";
AuthoredCodebook: [18]u8 = .[0, 20, 21, 22, 40, 41, 42, 43, 44, 50, 51, 52, 53, 54, 55, 56, 57, 58];

AuthoredTiles :: (level: s32, portrait: bool) -> string {
    if level == 0 && portrait { return "" }
    if level == 9 && portrait { return "" }
    if level == 9 && !portrait { return "" }
    if level == 10 && portrait { return "" }
    if level == 11 && portrait { return "" }
    if level == 120 && portrait { return "" }
    if level == 12 && portrait { return "" }
    if level == 13 && portrait { return "" }
    if level == 14 && portrait { return "" }
    if level == 160 && portrait { return "" }
    if level == 2 && portrait { return "" }
    if level == 32 && portrait { return "" }
    if level == 33 && portrait { return "" }
    if level == 40 && portrait { return "" }
    if level == 80 && portrait { return "" }
    return ""
}

AuthoredObjects :: (level: s32, portrait: bool) -> string {
    return ""
}

AuthoredApples :: (level: s32, portrait: bool) -> s32 {
    if level == 0 && portrait { return 5 }
    if level == 9 && portrait { return 6 }
    if level == 9 && !portrait { return 6 }
    if level == 10 && portrait { return 5 }
    if level == 11 && portrait { return 5 }
    if level == 120 && portrait { return 8 }
    if level == 12 && portrait { return 5 }
    if level == 13 && portrait { return 5 }
    if level == 14 && portrait { return 5 }
    if level == 160 && portrait { return 9 }
    if level == 2 && portrait { return 5 }
    if level == 32 && portrait { return 5 }
    if level == 33 && portrait { return 5 }
    if level == 40 && portrait { return 6 }
    if level == 80 && portrait { return 7 }
    return -1
}

AuthoredDecode :: (code: u8) -> u8 {
    for index: 0..AuthoredAlphabet.count - 1 {
        if AuthoredAlphabet[index] == code { return AuthoredCodebook[index] }
    }
    return 0
}
