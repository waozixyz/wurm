// A private-display UI probe, never installed or used as the game launcher.
using UI :: #import "kryon/Widgets";
#import "kryon/Desktop"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/Frame"
#import "kryon/test_driver"
Timer :: #import "std/timer_linux";
App :: #import "app";
Progress :: #import, file "progress.zi";
Controls :: #import, file "controls.zi";
Wardrobe :: #import, file "wardrobe.zi";
Input :: #import "kryon/input_protocol";
#import, file "game.zi";
#import "std/environment_linux"
libc :: #system_library "libc";
Flush :: (stream: *void) -> s32 #foreign libc "fflush";

Number :: (name: string, fallback: s32) -> s32 {
    return cast(s32)EnvironmentNumber(name, fallback)
}

ProbeFrame :: (session: Session) -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    if cast(s32)BeginFrame(session, 1, viewport) != 0 { return false }
    if App.Frame(session, viewport) != 0 { return false }
    return cast(s32)EndFrame(session) == 0 && EndDesktopFrame()
}

// Exercise the real frame and engine transitions with private save records.
ProgressProbe :: (session: Session) -> s32 {
    now := Timer.MonotonicMilliseconds()
    unused Controls.SetPad(false)
    if !Progress.Begin(39, 5, 120) { return 30 }
    App.StartRun(now)
    App.game.transition_ticks = 1
    App.game.next_step = 0
    if !ProbeFrame(session) { return 31 }
    if Progress.level != 40 || Progress.unlocked != 40 || Progress.lives != 5 || Progress.score != 120 { return 32 }
    if !ProbeFrame(session) || App.game.level != 40 || App.game.mode != MODE_READY || App.game.lives != 5 || App.game.score != 120 { return 33 }
    head := App.game.worm[0]
    random := App.game.random
    monster := App.game.monsters[0].position
    if Step(*App.game, now + 600000) || App.game.worm[0].x != head.x || App.game.worm[0].y != head.y ||
        App.game.random != random || App.game.monsters[0].position.x != monster.x || App.game.monsters[0].position.y != monster.y { return 47 }
    App.HandleInput(Input.KeyUp, now + 600000)
    if App.game.mode != MODE_READY { return 48 }
    App.HandleInput(Input.KeyEnter, now + 600000)
    if App.game.mode != MODE_PLAYING || App.game.next_step != now + 600000 + TickInterval(40) ||
        Step(*App.game, now + 600000) { return 49 }
    App.game.score = 130
    App.HandleInput(82, now)
    if App.game.level != 40 || App.game.score != 120 || App.game.lives != 5 { return 34 }
    // Enter the actual goal on level 12, then preview level 13 without a key.
    if !Progress.Begin(11, 5, 120) { return 50 }
    App.StartRun(now)
    App.game.apples = 0
    App.game.worm[0] = Point.{board_columns / 2 * 16 + 8, 2}
    App.game.direction = DIR_UP
    App.game.next_direction = DIR_UP
    Tick(*App.game)
    if App.game.transition_ticks != 50 { return 51 }
    carried_score := App.game.score
    carried_lives := App.game.lives
    for tick: 0..49 { Tick(*App.game) }
    if !ProbeFrame(session) || App.game.level != 12 || App.game.mode != MODE_READY ||
        App.game.score != carried_score || App.game.lives != carried_lives || Progress.level != 12 { return 52 }
    App.HandleInput(32, now)
    if App.game.mode != MODE_PLAYING || App.game.next_step != now + TickInterval(12) { return 53 }
    if !Progress.Begin(40, 5, 120) { return 54 }
    App.editor.playtest = true
    App.StartLevel(150, now, 1)
    App.game.transition_ticks = 1
    App.game.next_step = 0
    if !ProbeFrame(session) || Progress.unlocked != 40 || Progress.level != 40 { return 35 }
    App.editor.playtest = false
    App.StartRun(now)
    App.game.lives = 1
    App.game.death_ticks = 1
    App.game.next_step = 0
    if !ProbeFrame(session) || App.game.mode != MODE_DIED || Progress.level != 0 || Progress.unlocked != 40 { return 36 }
    App.HandleInput(Input.KeyEnter, now)
    if App.game.level != 40 || App.game.lives != 3 || App.game.score != 0 { return 37 }
    // Replaying an earlier level still retries at the highest unlocked one.
    if !App.PlaySelected(2, now) || App.game.level != 2 || Progress.unlocked != 40 { return 41 }
    App.game.mode = MODE_DIED
    App.HandleInput(32, now)
    if App.game.level != 40 || App.game.lives != 3 || App.game.score != 0 { return 42 }
    App.OpenLevels()
    if App.PlaySelected(41, now) || App.game.mode != MODE_LEVELS || Progress.unlocked != 40 { return 43 }
    App.HandleInput(Input.KeyEscape, now)
    if App.game.mode != MODE_STAGES { return 44 }
    Controls.mode = -1
    App.OpenLevels()
    if !App.PlaySelected(3, now) || App.game.mode != MODE_CONTROLS { return 45 }
    App.ChooseControls(false, now)
    if App.game.level != 3 || App.game.lives != 3 || App.game.score != 0 || Progress.unlocked != 40 { return 46 }
    App.Play(now)
    if App.game.level != 0 || Progress.unlocked != 40 { return 38 }
    if !Progress.Begin(199, 7, 220) { return 39 }
    Wardrobe.owned |= 512
    App.StartRun(now)
    App.game.transition_ticks = 1
    App.game.next_step = 0
    if !ProbeFrame(session) || App.game.mode != MODE_VICTORY || Progress.level != 0 || Progress.unlocked != 40 { return 40 }
    Progress.unlocked = 0
    Wardrobe.owned = 0
    if App.LevelAvailable(160) || App.LevelAvailable(199) { return 55 }
    Wardrobe.owned = 512
    if !App.LevelAvailable(160) || !App.LevelAvailable(199) || App.LevelAvailable(79) ||
    !Progress.Select(160, true) || Progress.unlocked != 0 { return 56 }
    print("Application progress local test: goal 12 to ready 13, frozen worm/enemies, deliberate start, carried stats, restart, editor isolation, game-over retry, locked levels, selected controls, Continue, Play and victory passed.\n")
    return 0
}

#program_export
main :: () -> s32 {
    width := Number("WURM_PROBE_WIDTH", 320)
    height := Number("WURM_PROBE_HEIGHT", 568)
    if !OpenDesktopSized(width, height) { return 1 }
    defer CloseDesktop()
    session := SessionOpen()
    if !SessionValid(session) { return 2 }
    defer CloseSession(session)
    App.game_portrait = height > width
    if Number("WURM_PROBE_PROGRESS", 0) != 0 { return ProgressProbe(session) }
    App.StartLevel(Number("WURM_PROBE_LEVEL", 0), Timer.MonotonicMilliseconds(), 1)
    state: *Game = *App.game
    // Behavioural adjacency cases: internal joins never receive borders,
    // while an unlike material keeps its own exposed edge.
    walls: [CELLS]u8
    walls[Index(5, 5)] = 20
    if App.WallEdges(walls[:], 5, 5, 20) != 15 { return 10 }
    walls[Index(4, 5)] = 20
    walls[Index(6, 5)] = 20
    if App.WallEdges(walls[:], 5, 5, 20) != 10 { return 11 }
    walls[Index(5, 4)] = 21
    if App.WallEdges(walls[:], 5, 5, 20) != 10 { return 12 }
    walls[Index(5, 4)] = 20
    if App.WallEdges(walls[:], 5, 5, 20) != 8 { return 13 }
    walls[Index(5, 6)] = 20
    if App.WallEdges(walls[:], 5, 5, 20) != 0 { return 14 }
    state.mode = Number("WURM_PROBE_MODE", 2)
    state.score = 1234
    if state.mode == 3 { state.lives = 0 }
    // Deterministic, display-only scenes keep the gates and a long bent
    // worm visible without running the clock or modifying saved levels.
    scene := Number("WURM_PROBE_SCENE", 0)
    if scene > 0 {
        columns: s32 = ifx height > width then 30 else 40
        rows: s32 = ifx height > width then 40 else 30
        for y: 0..rows - 1 {
            for x: 0..columns - 1 {
                state.board[y * columns + x] = ifx x == 0 || x == columns - 1 || y == 0 || y == rows - 1 then 20 else 0
                state.objects[y * columns + x] = 0
            }
        }
        state.monster_count = 0
        state.mode = 1
        state.lives = 3
        state.apples = 5
        state.board[(rows - 1) * columns + columns / 2] = 0
        if scene == 2 || scene == 5 {
            state.apples = 0
            state.board[columns / 2] = 0
            state.board[(rows - 1) * columns + columns / 2] = 20
        }
        state.length = 84
        head := Point.{columns / 2 * 16 + 8, rows / 2 * 16 + 8}
        state.direction = 2
        for segment: 0..83 {
            if segment < 40 { state.worm[segment] = Point.{head.x - cast(s32)segment * 4, head.y} }
            else { state.worm[segment] = Point.{head.x - 156, head.y + (cast(s32)segment - 39) * 4} }
        }
        if scene == 6 {
            state.direction = 3
            for segment: 0..83 {
                if segment < 40 { state.worm[segment] = Point.{head.x, head.y - cast(s32)segment * 4} }
                else { state.worm[segment] = Point.{head.x - (cast(s32)segment - 39) * 4, head.y - 156} }
            }
        }
        state.apple = Point.{head.x + 80, head.y - 64}
        if scene == 7 || scene == 8 {
            for x: 5..columns - 6 {
                state.board[Index(x, 6)] = 20
                state.board[Index(x, 7)] = 20
            }
            for y: 8..rows - 10 {
                state.board[Index(columns - 7, y)] = 20
                state.board[Index(columns - 6, y)] = 20
            }
            for y: rows - 12..rows - 8 {
                for x: 5..9 { state.board[Index(x, y)] = 21 }
            }
            state.length = 12
        }
        if scene == 4 || scene == 5 {
            state.length = 12
            state.direction = 1
            head.y = ifx scene == 4 then rows * 16 - 2 else 2
            for segment: 0..11 { state.worm[segment] = Point.{head.x, head.y + cast(s32)segment * 4} }
        }
        state.next_step = Timer.MonotonicMilliseconds() + 600000
        if scene == 3 {
            state.lives = 1
            state.death_ticks = 1
            Tick(state)
        }
    }
    if Number("WURM_PROBE_FREEZE", 0) != 0 { state.next_step = Timer.MonotonicMilliseconds() + 600000 }
    steering := Number("WURM_PROBE_STEERING", 0) != 0
    if steering {
        // Input probes make rapid successive turns; keep the test worm short
        // so its own tail cannot kill it before the next pointer assertion.
        state.length = 8
        state.target_length = 1
        state.direction = 1
        state.next_direction = 1
        head := Point.{board_columns / 2 * 16 + 8, board_rows / 2 * 16 + 8}
        for segment: 0..31 { state.worm[segment] = Point.{head.x, head.y + cast(s32)segment * 4} }
        state.next_step = Timer.MonotonicMilliseconds() + TICK_MS
    }
    layout := Number("WURM_PROBE_EDITOR_LAYOUT",-1)
    if layout >= 0 {
        App.EditorAtStartup(Number("WURM_PROBE_LEVEL",1))
        App.editor.browsing = false
        if layout == 1 { App.EditorTurn() }
        App.EditorPlaytest(Timer.MonotonicMilliseconds())
        if board_columns != (ifx layout == 1 then 30 else 40) || board_rows != (ifx layout == 1 then 40 else 30) { return 20 }
        state.next_step = Timer.MonotonicMilliseconds() + 600000
    }
    Wardrobe.skin = Number("WURM_PROBE_SKIN", Wardrobe.skin)
    Wardrobe.loaded = true
    state.direction = Number("WURM_PROBE_DIRECTION", state.direction)
    state.death_ticks = Number("WURM_PROBE_DEATH", state.death_ticks)
    previous_columns: s32 = -1
    previous_rows: s32 = -1
    previous: s32 = -1
    previous_direction: s32 = -1
    previous_contact: bool;
    while PollDesktop() {
        BeginDesktopFrame()
        // A private-display test drives the probe through KRYON_TEST_DRIVER.
        TreePointerUpdate(session, TestDriverPointer(session, PollPointer()))
        key := DesktopPressedKey()
        if key == 0 {
            for candidate: cast(s32)0..349 { if TestDriverKeyPressed(candidate) { key = candidate; break } }
        }
        if key != 0 { KeyboardSend(session, key) }
        viewport := DesktopViewport()
        if cast(s32)BeginFrame(session, 1, viewport) != 0 { return 3 }
        if App.Frame(session, viewport) != 0 { return 4 }
        if cast(s32)EndFrame(session) != 0 || !EndDesktopFrame() { return 5 }
        TestDriverFrame(session)
        if previous_columns != board_columns || previous_rows != board_rows {
            previous_columns = board_columns; previous_rows = board_rows
            print("board=%x% lives=% score=% mode=%\n",board_columns,board_rows,state.lives,state.score,state.mode)
            unused Flush(null)
        }
        if previous != state.mode {
            previous = state.mode
            print("mode=% lives=% level=% score=%\n", previous, state.lives, state.level, state.score)
            unused Flush(null)
        }
        pointer := PointerSample(session)
        if steering && (previous_direction != state.direction || previous_contact != pointer.down) {
            previous_direction = state.direction
            previous_contact = pointer.down
            print("steering=% touch=% x=% y=% pad=% pointer=%,%\n", state.direction,
                ifx pointer.down then 1 else 0, state.worm[0].x, state.worm[0].y, ifx Controls.Pad() then 1 else 0, pointer.x, pointer.y)
            unused Flush(null)
        }
        PauseDesktop()
    }
    return 0
}
