// The desktop entry. It runs Kryon's desktop loop in a 1280x760 window, or
// the size WURM_WINDOW=WxH gives, so the mobile-first layout can be checked
// in landscape and portrait.
#import "kryon/desktop_loop"
#import "std/environment_linux"
#import "std/number_text"
App :: #import "app";

// The window size WURM_WINDOW asks for, when both sides are at least 240.
WindowSize :: () -> (width: s32, height: s32) {
    text := EnvironmentText("WURM_WINDOW")
    width, count := IntegerPrefix(text)
    if count == 0 || width < 240 || count >= cast(s64)text.count || text[count] != #char "x" { return 1280, 760 }
    height, digits := IntegerPrefix(text[count + 1:text.count])
    if digits == 0 || height < 240 { return 1280, 760 }
    return cast(s32)width, cast(s32)height
}

// WURM_START=editor opens straight into the level editor, optionally at
// WURM_LEVEL=n (1-based), instead of the stage screen; WURM_START=rewards
// opens the daily reward chest.
StartScreen :: () {
    start := EnvironmentText("WURM_START")
    if start.count > 0 && (start[0] == #char "r" || start[0] == #char "R") { App.RewardsAtStartup(); return }
    if start.count == 0 || (start[0] != #char "e" && start[0] != #char "E") { return }
    level := EnvironmentNumber("WURM_LEVEL", 1) - 1
    if level < 0 { level = 0 }
    App.EditorAtStartup(cast(s32)level)
}

#program_export
main :: () -> s32 {
    // A direct launch starts beside the executable in build/.
    if !DesktopStartBeside("assets/art/title.png") {
        print("Apfelwurm could not find assets/art/title.png beside the game or its parent directory.\n")
        return 1
    }
    StartScreen()
    width, height := WindowSize()
    return RunDesktop(width, height)
}
