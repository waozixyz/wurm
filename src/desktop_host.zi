// The desktop entry. Kryon's default host opens a fixed 960x600 window;
// this one sizes the window from WURM_WINDOW=WxH (default 1280x760) so the
// mobile-first layout can be checked in landscape and portrait. The frame
// loop mirrors the default host: poll, feed the session, draw one frame.
#import "std/c_string"
#import "kryon/Desktop"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/Frame"
File :: #import "std/file_linux";
App :: #import "app";

libc :: #system_library "libc";
GetEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
ParseNumber :: (text: *u8) -> s32 #foreign libc "atoi";
ChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";
ReadExecutableLink :: (path: *u8, output: *u8, capacity: u64) -> s64 #foreign libc "readlink";

// A direct desktop launch starts beside the executable in build/. Resolve
// its asset root before any image, sound or saved level is opened.
FindAssets :: () -> bool {
    if File.PathExists("assets/art/title.png") { return true }
    link: [32]u8
    path: [4096]u8
    if !CopyCString("/proc/self/exe", link[:]) { return false }
    count := ReadExecutableLink(*link[0], *path[0], 4095)
    if count <= 0 { return false }
    index := cast(s32)count - 1
    while index > 0 && path[index] != #char "/" { index -= 1 }
    if index <= 0 { return false }
    path[index] = 0
    if ChangeDirectory(*path[0]) != 0 { return false }
    if File.PathExists("assets/art/title.png") { return true }
    if !CopyCString("..", link[:]) || ChangeDirectory(*link[0]) != 0 { return false }
    return File.PathExists("assets/art/title.png")
}

window_width: s32;
window_height: s32;

WindowSize :: () {
    window_width = 1280
    window_height = 760
    name: [32]u8
    if !CopyCString("WURM_WINDOW", name[:]) { return }
    value := GetEnvironment(*name[0])
    if value == null { return }
    width := ParseNumber(value)
    if width < 240 { return }
    index: s32 = 0
    while value[index] != 0 && value[index] != 120 && index < 15 { index += 1 }
    if value[index] != 120 { return }
    height := ParseNumber(*value[index + 1])
    if height < 240 { return }
    window_width = width
    window_height = height
}

// WURM_START=editor opens straight into the level editor, optionally at
// WURM_LEVEL=n (1-based), instead of the stage screen.
StartScreen :: () {
    name: [32]u8
    if !CopyCString("WURM_START", name[:]) { return }
    value := GetEnvironment(*name[0])
    if value == null { return }
    editor: bool
    for index: 0..5 {
        editor = value[index] == #char "e" || value[index] == #char "E"
        if editor { break }
    }
    if !editor { return }
    level: s32 = 0
    if CopyCString("WURM_LEVEL", name[:]) {
        number := GetEnvironment(*name[0])
        if number != null && ParseNumber(number) > 1 { level = ParseNumber(number) - 1 }
    }
    App.EditorAtStartup(level)
}

DrawFrame :: (session: Session) -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    pointer := PollPointer()
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    wheel := DesktopWheelMove()
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    if cast(s32)BeginFrame(session, 1, viewport) != 0 { return false }
    if App.Frame(session, viewport) != 0 {
        TreeCancel(session)
        return false
    }
    if cast(s32)EndFrame(session) != 0 { return false }
    unused DesktopCursor(session)
    return EndDesktopFrame()
}

#program_export
main :: () -> s32 {
    if !FindAssets() {
        print("Apfelwurm could not find assets/art/title.png beside the game or its parent directory.\n")
        return 1
    }
    WindowSize()
    if !OpenDesktopSized(window_width, window_height) {
        CloseDesktop()
        return 1
    }
    defer { CloseDesktop() }
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    defer { CloseSession(session) }
    StartScreen()
    ok := true
    while ok && PollDesktop() {
        KeyboardModifiersSend(session, DesktopModifiers())
        key := DesktopPressedKey()
        if key != 0 { KeyboardSend(session, key) }
        codepoint := DesktopTypedCodepoint()
        while codepoint != 0 {
            TypedCodepointSend(session, codepoint)
            codepoint = DesktopTypedCodepoint()
        }
        ok = DrawFrame(session)
        if ok { PauseDesktop() }
    }
    return ifx ok then 0 else 1
}
