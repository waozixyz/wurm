// Wurm owns one device for the process; a frame only scopes access to it.
#import "kryon/session"
#import "std/audio_decode_wav"
Sink :: #import "std/audio_sink";
#if #defined(PLATFORM_WEB) {
    #import "std/web"
    gesture: s32;
    Gesture :: (data: s32, first: s32, second: s32, third: s32) {
        unused data; unused first; unused second; unused third
        unused Sink.AudioSinkResume()
    }
}
enabled: bool;
active: bool;
Enable :: () { enabled = true }
Begin :: (session: Session) {
    unused session
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        enabled = true
    }
    active = true
    if !enabled { return }
    unused Sink.AudioSinkOpen()
    #if #defined(PLATFORM_WEB) {
        if gesture == 0 {
            scope := WebScope(); defer WebEnd(scope)
            gesture = WebFunction(Gesture, 0)
            unused WebCall2(WebGlobal, WebName("addEventListener"), WebText("pointerdown"), WebObject(gesture))
            unused WebCall2(WebGlobal, WebName("addEventListener"), WebText("keydown"), WebObject(gesture))
        }
    }
}
Ready :: () -> bool {
    if !active || !enabled { return false }
    unused Sink.AudioSinkOpen()
    #if #defined(PLATFORM_WEB) {
        return Sink.AudioSinkRunning()
    }
    return Sink.AudioSinkReady()
}
End :: () { active = false }
Close :: () {
    #if #defined(PLATFORM_WEB) {
        if gesture != 0 {
            scope := WebScope(); defer WebEnd(scope)
            unused WebCall2(WebGlobal, WebName("removeEventListener"), WebText("pointerdown"), WebObject(gesture))
            unused WebCall2(WebGlobal, WebName("removeEventListener"), WebText("keydown"), WebObject(gesture))
            WebRelease(gesture); gesture = 0
        }
    }
    Sink.AudioSinkClose()
    active = false
}
