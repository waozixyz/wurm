// The per-level inputs of the terrain shaders: rounded signed distances to
// hedges, stones and water, the slopes of the raised surfaces, contact
// occlusion and small decorations. Collision is never read from here; the
// field only paints the board's existing cells.
#import "std/vec"
#import "std/math"

TERRAIN_FLOOR :: 0;
TERRAIN_HEDGE :: 1;
TERRAIN_STONE :: 2;
TERRAIN_WATER :: 3;
IS_HEDGE :: 2;
IS_STONE :: 4;
IS_WATER :: 8;
IS_SOLID :: 6;
MAX_CELLS :: 1200;
// Distance samples per cell; pixels interpolate between them.
FIELD_SAMPLES :: 8;

TerrainClass :: (tile: u8) -> s32 {
    kind := cast(s32)(tile & 127)
    if kind == 21 { return TERRAIN_STONE }
    if kind == 22 { return TERRAIN_WATER }
    if kind >= 40 && kind <= 45 { return TERRAIN_FLOOR }
    if kind >= 20 { return TERRAIN_HEDGE }
    return TERRAIN_FLOOR
}

TerrainCells :: struct {
    columns: s32
    rows: s32
    classes: [MAX_CELLS]u8
}

// The board as drawn: the stone posts beside an open entrance or exit are
// part of the landscape, exactly where the board draws its gate posts.
TerrainCellsFrom :: (board: []u8, columns: s32, rows: s32, gate_posts: bool) -> TerrainCells {
    cells: TerrainCells
    cells.columns = columns
    cells.rows = rows
    for at: 0..columns * rows - 1 { cells.classes[at] = cast(u8)TerrainClass(board[at]) }
    if gate_posts {
        half := columns / 2
        for gate: 0..1 {
            row := ifx gate == 0 then rows - 1 else 0
            centre := board[row * columns + half]
            if centre >= 20 && centre < 128 { continue }
            cells.classes[row * columns + half - 1] = TERRAIN_STONE
            cells.classes[row * columns + half + 1] = TERRAIN_STONE
        }
    }
    return cells
}

SameCells :: (a: *TerrainCells, b: *TerrainCells) -> bool {
    if a.columns != b.columns || a.rows != b.rows { return false }
    for at: 0..a.columns * a.rows - 1 { if a.classes[at] != b.classes[at] { return false } }
    return true
}

// Outside the board continues the nearest edge cell, so the border hedge
// has no false rim along the frame.
In :: (cells: *TerrainCells, x: s32, y: s32, kinds: s32) -> bool {
    cx := ifx x < 0 then 0 else ifx x >= cells.columns then cells.columns - 1 else x
    cy := ifx y < 0 then 0 else ifx y >= cells.rows then cells.rows - 1 else y
    return ((1 << cast(s32)cells.classes[cy * cells.columns + cx]) & kinds) != 0
}

// Bit 0..3: top-left, top-right, bottom-left, bottom-right corners whose
// two side neighbours are both outside the region, rounded by the field.
ConvexCorners :: (cells: *TerrainCells, x: s32, y: s32, kinds: s32) -> s32 {
    left := !In(cells, x - 1, y, kinds)
    right := !In(cells, x + 1, y, kinds)
    up := !In(cells, x, y - 1, kinds)
    down := !In(cells, x, y + 1, kinds)
    mask: s32
    if left && up { mask |= 1 }
    if right && up { mask |= 2 }
    if left && down { mask |= 4 }
    if right && down { mask |= 8 }
    return mask
}

Hypot :: (x: float64, y: float64) -> float64 { return Sqrt(x * x + y * y) }
FloorCell :: (v: float64) -> s32 {
    i := cast(s32)v
    if cast(float64)i > v { i -= 1 }
    return i
}
CeilCell :: (v: float64) -> s32 {
    i := cast(s32)v
    if cast(float64)i < v { i += 1 }
    return i
}

// Distance from a point in a cell's local units to that cell's area with
// the given convex corners rounded to `radius`.
RoundedCellDistance :: (qx: float64, qy: float64, corners: s32, radius: float64) -> float64 {
    for corner: 0..3 {
        if (corners & (1 << cast(s32)corner)) == 0 { continue }
        left := corner % 2 == 0
        top := corner < 2
        cx := ifx left then radius else 1.0 - radius
        cy := ifx top then radius else 1.0 - radius
        if (ifx left then qx < cx else qx > cx) && (ifx top then qy < cy else qy > cy) {
            d := Hypot(qx - cx, qy - cy) - radius
            return ifx d > 0.0 then d else 0.0
        }
    }
    dx := ifx qx < 0.0 then -qx else ifx qx > 1.0 then qx - 1.0 else 0.0
    dy := ifx qy < 0.0 then -qy else ifx qy > 1.0 then qy - 1.0 else 0.0
    return Hypot(dx, dy)
}

// Signed distance in cells to the edge of the region of `kinds`, positive
// inside, limited to +-reach. Convex corners are rounded to `radius`.
SignedDistance :: (cells: *TerrainCells, px: float64, py: float64, kinds: s32,
    radius: float64, reach: float64) -> float64 {
    x := FloorCell(px)
    y := FloorCell(py)
    inside := In(cells, x, y, kinds)
    best := reach
    span := CeilCell(reach)
    for dy: -span..span {
        for dx: -span..span {
            nx := x + cast(s32)dx
            ny := y + cast(s32)dy
            if In(cells, nx, ny, kinds) == inside { continue }
            qx := px - cast(float64)nx
            qy := py - cast(float64)ny
            d: float64
            if inside {
                d = RoundedCellDistance(qx, qy, 0, 0.0)
            } else {
                d = RoundedCellDistance(qx, qy, ConvexCorners(cells, nx, ny, kinds), radius)
            }
            if d < best { best = d }
        }
    }
    if !inside { return -best }
    // Rounded convex corners of this very cell cut into it.
    corners := ConvexCorners(cells, x, y, kinds)
    qx := px - cast(float64)x
    qy := py - cast(float64)y
    for corner: 0..3 {
        if (corners & (1 << cast(s32)corner)) == 0 { continue }
        left := corner % 2 == 0
        top := corner < 2
        cx := ifx left then radius else 1.0 - radius
        cy := ifx top then radius else 1.0 - radius
        if (ifx left then qx < cx else qx > cx) && (ifx top then qy < cy else qy > cy) {
            d := radius - Hypot(qx - cx, qy - cy)
            if d < best { best = d }
        }
    }
    return best
}

// Whether every cell within `span` shares this cell's membership.
Uniform :: (cells: *TerrainCells, x: s32, y: s32, kinds: s32, span: s32) -> bool {
    inside := In(cells, x, y, kinds)
    for dy: -span..span {
        for dx: -span..span { if In(cells, x + cast(s32)dx, y + cast(s32)dy, kinds) != inside { return false } }
    }
    return true
}

HEDGE_ROUND :: 0.32;
STONE_ROUND :: 0.46;
WATER_ROUND :: 0.42;
HEDGE_REACH :: 1.0;
STONE_REACH :: 1.0;
WATER_REACH :: 2.0;
SOLID_REACH :: 1.4;

// Signed distances sampled FIELD_SAMPLES times per cell.
TerrainDistances :: struct {
    width: s32
    height: s32
    hedge: Vec(float32)
    stone: Vec(float32)
    water: Vec(float32)
    solid: Vec(float32)
}

DistancesFree :: (d: *TerrainDistances) {
    VecFree(d.hedge); VecFree(d.stone); VecFree(d.water); VecFree(d.solid)
    d.width = 0; d.height = 0
}

// A cell whose whole neighbourhood agrees is simply at full reach.
Signed :: (cells: *TerrainCells, flat: bool, sign: float32, px: float64, py: float64, kinds: s32,
    radius: float64, reach: float64) -> float32 {
    if flat { return sign * cast(float32)reach }
    return cast(float32)SignedDistance(cells, px, py, kinds, radius, reach)
}

// Sizes the distance samples for CELLS' board.
DistancesAllocate :: (cells: *TerrainCells, d: *TerrainDistances) -> bool {
    width := cells.columns * FIELD_SAMPLES
    height := cells.rows * FIELD_SAMPLES
    count := cast(s64)width * height
    if !VecResize(d.hedge, count) || !VecResize(d.stone, count) || !VecResize(d.water, count) || !VecResize(d.solid, count) { return false }
    d.width = width
    d.height = height
    return true
}

// Samples the distances of cells [x0, x1) x [y0, y1).
ComputeDistances :: (cells: *TerrainCells, d: *TerrainDistances, x0: s32, y0: s32, x1: s32, y1: s32) {
    width := d.width
    for cy: y0..y1 - 1 {
        for cx: x0..x1 - 1 {
            x := cast(s32)cx
            y := cast(s32)cy
            flat_hedge := Uniform(cells, x, y, IS_HEDGE, 1)
            flat_stone := Uniform(cells, x, y, IS_STONE, 1)
            flat_water := Uniform(cells, x, y, IS_WATER, 2)
            flat_solid := Uniform(cells, x, y, IS_SOLID, 2)
            sign_hedge: float32 = ifx In(cells, x, y, IS_HEDGE) then 1.0 else -1.0
            sign_stone: float32 = ifx In(cells, x, y, IS_STONE) then 1.0 else -1.0
            sign_water: float32 = ifx In(cells, x, y, IS_WATER) then 1.0 else -1.0
            sign_solid: float32 = ifx In(cells, x, y, IS_SOLID) then 1.0 else -1.0
            for sy: 0..FIELD_SAMPLES - 1 {
                for sx: 0..FIELD_SAMPLES - 1 {
                    px := cast(float64)x + (cast(float64)sx + 0.5) / cast(float64)FIELD_SAMPLES
                    py := cast(float64)y + (cast(float64)sy + 0.5) / cast(float64)FIELD_SAMPLES
                    at := cast(s64)(y * FIELD_SAMPLES + cast(s32)sy) * width + x * FIELD_SAMPLES + cast(s32)sx
                    d.hedge[at] = Signed(cells, flat_hedge, sign_hedge, px, py, IS_HEDGE, HEDGE_ROUND, HEDGE_REACH)
                    d.stone[at] = Signed(cells, flat_stone, sign_stone, px, py, IS_STONE, STONE_ROUND, STONE_REACH)
                    d.water[at] = Signed(cells, flat_water, sign_water, px, py, IS_WATER, WATER_ROUND, WATER_REACH)
                    d.solid[at] = Signed(cells, flat_solid, sign_solid, px, py, IS_SOLID, HEDGE_ROUND, SOLID_REACH)
                }
            }
        }
    }
}

// Softened water distances keep lake beds free of creased centre lines.
SoftenWater :: (d: *TerrainDistances, x0: s32, y0: s32, x1: s32, y1: s32) {
    for pass: 0..4 { Blur(d.water[:], d.width, d.height, x0 * FIELD_SAMPLES, y0 * FIELD_SAMPLES, x1 * FIELD_SAMPLES, y1 * FIELD_SAMPLES) }
}

// A 3x3 box blur of the window [x0, x1) x [y0, y1) of VALUES in place.
Blur :: (values: []float32, width: s32, height: s32, x0: s32, y0: s32, x1: s32, y1: s32) {
    copy: Vec(float32)
    defer VecFree(copy)
    if !VecResize(copy, cast(s64)width * height) { return }
    for at: 0..cast(s64)width * height - 1 { copy[at] = values[at] }
    for y: y0..y1 - 1 {
        for x: x0..x1 - 1 {
            sum: float32 = 0.0
            for dy: -1..1 {
                for dx: -1..1 {
                    sx := x + cast(s32)dx
                    sy := y + cast(s32)dy
                    if sx < 0 { sx = 0 }; if sy < 0 { sy = 0 }
                    if sx > width - 1 { sx = width - 1 }; if sy > height - 1 { sy = height - 1 }
                    sum += copy[cast(s64)sy * width + sx]
                }
            }
            values[cast(s64)y * width + x] = sum / 9.0
        }
    }
}

// Bilinear between distance samples at a pixel centre, in cell units.
SampleDistance :: (values: []float32, width: s32, height: s32, gx: float64, gy: float64) -> float64 {
    fx := gx * cast(float64)FIELD_SAMPLES - 0.5
    fy := gy * cast(float64)FIELD_SAMPLES - 0.5
    x0 := FloorCell(fx)
    y0 := FloorCell(fy)
    tx := fx - cast(float64)x0
    ty := fy - cast(float64)y0
    x1 := x0 + 1
    y1 := y0 + 1
    if x0 < 0 { x0 = 0 }; if y0 < 0 { y0 = 0 }
    if x1 > width - 1 { x1 = width - 1 }; if y1 > height - 1 { y1 = height - 1 }
    if x0 > width - 1 { x0 = width - 1 }; if y0 > height - 1 { y0 = height - 1 }
    a := cast(float64)values[cast(s64)y0 * width + x0]
    b := cast(float64)values[cast(s64)y0 * width + x1]
    c := cast(float64)values[cast(s64)y1 * width + x0]
    d := cast(float64)values[cast(s64)y1 * width + x1]
    top := a + (b - a) * tx
    bottom := c + (d - c) * tx
    return top + (bottom - top) * ty
}

// Rounded profile of a raised surface: 0 at its edge, 1 once `bevel` in.
Profile :: (distance: float64, bevel: float64) -> float64 {
    if distance <= 0.0 { return 0.0 }
    t := distance / bevel
    if t >= 1.0 { return 1.0 }
    return t * (2.0 - t)
}
HEDGE_BEVEL :: 0.42;
STONE_BEVEL :: 0.36;

// How each landscape heaps its walls: bushes, pine crowns or boulders.
Heap :: struct { count: s32; radius: float64; jitter: float64; floor: float64; cone: bool; }
HeapFor :: (area: s32) -> Heap {
    if area == 2 { return .{1, 0.78, 0.18, 0.5, true} }
    if area == 4 { return .{2, 0.8, 0.3, 0.4, false} }
    if area == 1 { return .{2, 0.62, 0.25, 0.66, false} }
    return .{2, 0.56, 0.24, 0.7, false}
}

// The tallest heap over a point among nearby wall cells, 0..1.
Heaps :: (cells: *TerrainCells, px: float64, py: float64, heap: Heap) -> float64 {
    x := FloorCell(px)
    y := FloorCell(py)
    best := 0.0
    for dy: -1..1 {
        for dx: -1..1 {
            nx := x + cast(s32)dx
            ny := y + cast(s32)dy
            if !In(cells, nx, ny, IS_HEDGE) { continue }
            for k: 0..heap.count - 1 {
                cx := cast(float64)nx + 0.5 + (Unit(nx, ny, 11 + cast(s32)k * 2) - 0.5) * 2.0 * heap.jitter
                cy := cast(float64)ny + 0.5 + (Unit(nx, ny, 12 + cast(s32)k * 2) - 0.5) * 2.0 * heap.jitter
                radius := heap.radius * (0.85 + 0.3 * Unit(nx, ny, 17 + cast(s32)k))
                r2 := ((px - cx) * (px - cx) + (py - cy) * (py - cy)) / (radius * radius)
                if r2 >= 1.0 { continue }
                v := ifx heap.cone then (1.0 - Sqrt(r2)) else (1.0 - r2) * (1.0 - r2)
                v *= 0.8 + 0.2 * Unit(nx, ny, 19 + cast(s32)k)
                if v > best { best = v }
            }
        }
    }
    return best
}

// Stones are rubble: irregular rounded stones about half a cell across,
// each a cell of a jittered Voronoi pattern bevelled towards its border.
Rubble :: (px: float64, py: float64) -> float64 {
    u := px * 2.0
    v := py * 2.0
    ix := FloorCell(u)
    iy := FloorCell(v)
    best := 9.0
    second := 9.0
    owner_x: s32
    owner_y: s32
    for oy: -1..1 {
        for ox: -1..1 {
            cx := ix + cast(s32)ox
            cy := iy + cast(s32)oy
            sx := cast(float64)cx + 0.12 + 0.76 * Unit(cx, cy, 31)
            sy := cast(float64)cy + 0.12 + 0.76 * Unit(cx, cy, 32)
            d := (u - sx) * (u - sx) + (v - sy) * (v - sy)
            if d < best { second = best; best = d; owner_x = cx; owner_y = cy }
            else if d < second { second = d }
        }
    }
    border := (Sqrt(second) - Sqrt(best)) * 0.5
    return Profile(border - 0.04, 0.2) * (0.72 + 0.28 * Unit(owner_x, owner_y, 33))
}

Height :: (cells: *TerrainCells, heap: Heap, px: float64, py: float64, hedge: float64, stone: float64) -> float64 {
    h := 0.0
    if hedge > 0.0 {
        h = Profile(hedge, HEDGE_BEVEL) * (heap.floor + (1.0 - heap.floor) * Heaps(cells, px, py, heap))
    }
    if stone > 0.0 {
        s := Profile(stone, STONE_BEVEL) * (0.35 + 0.65 * Rubble(px, py)) * 0.85
        if s > h { h = s }
    }
    return h
}

Byte :: (value: float64) -> u8 {
    v := value * 255.0 + 0.5
    if v <= 0.0 { return 0 }
    if v >= 255.0 { return 255 }
    return cast(u8)cast(s32)v
}

// The pictures the shaders sample, `cell` pixels per board cell. Shape:
// slope x, slope y (0.5 + slope / 10 per cell) and contact occlusion.
// Masks: hedge and stone (0.5 + distance / 2) and water (0.25 + distance
// * 0.375).
TerrainField :: struct {
    cell: s32
    width: s32
    height: s32
    shape: Vec(u8)
    masks: Vec(u8)
    heights: Vec(float32)
}

FieldFree :: (f: *TerrainField) {
    VecFree(f.shape); VecFree(f.masks); VecFree(f.heights)
    f.width = 0; f.height = 0
}

FieldAllocate :: (f: *TerrainField, columns: s32, rows: s32, cell: s32) -> bool {
    f.cell = cell
    f.width = columns * cell
    f.height = rows * cell
    count := cast(s64)f.width * f.height
    return VecResize(f.shape, count * 4) && VecResize(f.masks, count * 4) && VecResize(f.heights, count)
}

// Fills the window [x0, x1) x [y0, y1) of the field's pictures.
FieldPaint :: (f: *TerrainField, cells: *TerrainCells, d: *TerrainDistances, area: s32,
    x0: s32, y0: s32, x1: s32, y1: s32) {
    scale := 1.0 / cast(float64)f.cell
    heap := HeapFor(area)
    // Heights one pixel around the window give its edge slopes.
    hx0 := ifx x0 > 0 then x0 - 1 else 0
    hy0 := ifx y0 > 0 then y0 - 1 else 0
    hx1 := ifx x1 < f.width then x1 + 1 else f.width
    hy1 := ifx y1 < f.height then y1 + 1 else f.height
    for y: hy0..hy1 - 1 {
        gy := (cast(float64)y + 0.5) * scale
        for x: hx0..hx1 - 1 {
            gx := (cast(float64)x + 0.5) * scale
            hedge := SampleDistance(d.hedge[:], d.width, d.height, gx, gy)
            stone := SampleDistance(d.stone[:], d.width, d.height, gx, gy)
            f.heights[cast(s64)y * f.width + x] = cast(float32)Height(cells, heap, gx, gy, hedge, stone)
        }
    }
    for y: y0..y1 - 1 {
        gy := (cast(float64)y + 0.5) * scale
        up := ifx y > 0 then y - 1 else y
        down := ifx y < f.height - 1 then y + 1 else y
        for x: x0..x1 - 1 {
            gx := (cast(float64)x + 0.5) * scale
            at := cast(s64)y * f.width + x
            left := ifx x > 0 then x - 1 else x
            right := ifx x < f.width - 1 then x + 1 else x
            // Slopes per cell from the neighbouring pixels.
            sx := cast(float64)(f.heights[cast(s64)y * f.width + right] - f.heights[cast(s64)y * f.width + left]) *
                cast(float64)f.cell / cast(float64)(right - left + ifx right == left then 1 else 0)
            sy := cast(float64)(f.heights[cast(s64)down * f.width + x] - f.heights[cast(s64)up * f.width + x]) *
                cast(float64)f.cell / cast(float64)(down - up + ifx down == up then 1 else 0)
            hedge := SampleDistance(d.hedge[:], d.width, d.height, gx, gy)
            stone := SampleDistance(d.stone[:], d.width, d.height, gx, gy)
            water := SampleDistance(d.water[:], d.width, d.height, gx, gy)
            solid := SampleDistance(d.solid[:], d.width, d.height, gx, gy)
            occlusion := 1.0
            if solid < 0.0 {
                t := -solid / 1.15
                if t > 1.0 { t = 1.0 }
                occlusion = (1.0 - t) * (1.0 - t)
            }
            f.shape[at * 4] = Byte(0.5 + sx * 0.1)
            f.shape[at * 4 + 1] = Byte(0.5 + sy * 0.1)
            f.shape[at * 4 + 2] = Byte(occlusion)
            f.shape[at * 4 + 3] = 255
            f.masks[at * 4] = Byte(0.5 + hedge * 0.5)
            f.masks[at * 4 + 1] = Byte(0.5 + stone * 0.5)
            f.masks[at * 4 + 2] = Byte(0.25 + water * 0.375)
            f.masks[at * 4 + 3] = 255
        }
    }
}

Hash :: (x: s32, y: s32, seed: s32) -> s32 {
    h := cast(u32)x * cast(u32)374761393 + cast(u32)y * cast(u32)668265263 + cast(u32)seed * cast(u32)2246822519
    h = (h ^ (h >> 13)) * cast(u32)1274126177
    h = h ^ (h >> 16)
    return cast(s32)(h & cast(u32)0x7fffffff)
}
Unit :: (x: s32, y: s32, seed: s32) -> float64 { return cast(float64)(Hash(x, y, seed) % 10007) / 10007.0 }
