// Shared asset voices follow the same calm playlist and phrase-length fades as PCM.
#import "kryon/media_audio"
#import "kryon/session"
#import, file "audio_volume.zi";
#import, file "audio_score.zi";
Portal :: #import, file "portal.zi";
ready: bool;
muted: bool;
// A portal's own mute, over the player's choice, which it leaves as it was.
silenced: bool;
volume: s32 = 100;
session: Session;
loaded: [7]bool;
Bind :: (value: Session) {
    if session.slot != value.slot || session.epoch != value.epoch {
        for index: 0..6 { loaded[index] = false }
        was_playing = false
        music_incoming = 0
        music_gain = 0.0
    }
    session = value
}
Voice :: (index: s32, operation: MediaAudioOperation) -> MediaAudioResult {
    return MediaAudio(session, MediaAudioCommand.{.operation = operation, .voice = index + 1})
}
music_current: s32 = 1;
music_incoming: s32;
music_requested: s32 = 1;
music_change_at: float64;
music_gain: float64;
previous_level: s32 = -1;
previous_apples: s32;
previous_death: s32;
previous_transition: s32;
was_playing: bool;
was_active: bool;
CanSetVolume :: () -> bool { return true }
ApplyVolume :: () {
    for index: 0..6 {
        gain := cast(float64)volume / 100.0
        if index >= 4 {
            if index == music_current + 3 { gain *= 0.4 * (1.0 - music_gain) }
            else if index == music_incoming + 3 { gain *= 0.4 * music_gain }
            else { gain = 0.0 }
        }
        unused MediaAudio(session, MediaAudioCommand.{.operation = .Gain, .voice = cast(s32)index + 1,
            .gain = ifx muted || silenced then 0.0 else cast(float32)gain})
    }
}
SetVolume :: (value: s32) {
    volume = ClampVolume(value)
    Ensure()
    ApplyVolume()
}
Ensure :: () {
    paths: [7]string = .["assets/sounds/start.wav", "assets/sounds/pickup.wav", "assets/sounds/lose.wav", "assets/sounds/exit.wav",
        "assets/sounds/garden.ogg", "assets/sounds/factory.ogg", "assets/sounds/space.ogg"]
    capabilities := MediaAudio(session, MediaAudioCommand.{.operation = .Capabilities})
    if capabilities.code != .Ok || (capabilities.capabilities & cast(u32)55) != 55 { ready = false; return }
    ready = true
    for index: 0..6 {
        if loaded[index] && Voice(cast(s32)index, .Status).code == .Missing {
            loaded[index] = false
            was_playing = false
            music_incoming = 0
            music_gain = 0.0
        }
        if !loaded[index] {
            result := MediaAudio(session, MediaAudioCommand.{.operation = .Load, .voice = cast(s32)index + 1,
                .asset = paths[index], .music = index >= 4, .gain = 0.0})
            loaded[index] = result.code == .Ok
        }
        if !loaded[index] { ready = false }
    }
    ApplyVolume()
}
Play :: (index: s32) -> bool {
    status := Voice(index, .Status)
    if status.code != .Ok { return false }
    if status.state == .Paused { return Voice(index, .Resume).code == .Ok }
    return MediaAudio(session, MediaAudioCommand.{.operation = .Play, .voice = index + 1, .looping = index >= 4}).code == .Ok
}
ApplyMute :: () { ApplyVolume() }
ToggleMute :: () {
    Ensure()
    muted = !muted
    ApplyMute()
}
MusicTime :: (track: s32) -> float64 {
    result := Voice(track + 3, .Status)
    return ifx result.code == .Ok && result.has_position then result.position_seconds else -1.0
}
RequestMusic :: (track: s32) {
    if track == music_requested { return }
    music_requested = track
    phrase := cast(float64)MusicPhraseFrames(music_current) / MUSIC_RATE
    music_change_at = (cast(float64)cast(s64)(MusicTime(music_current) / phrase) + 1.0) * phrase
}
PumpMusic :: () {
    time := MusicTime(music_current)
    if time < 0.0 { return }
    duration := cast(float64)MusicFrames(music_current) / MUSIC_RATE
    fading := cast(float64)MUSIC_FADE_FRAMES / MUSIC_RATE
    if music_incoming == 0 && ((music_requested != music_current && time >= music_change_at) || (duration > 0.0 && duration - time <= fading)) {
        if music_requested == music_current { music_requested = NextMusic(music_current) }
        music_incoming = music_requested
        unused Voice(music_incoming + 3, .Stop)
        if !Play(music_incoming + 3) { music_incoming = 0; return }
    }
    if music_incoming != 0 {
        incoming_time := MusicTime(music_incoming)
        if incoming_time < 0.0 { return }
        fraction := incoming_time / fading
        if fraction >= 1.0 {
            unused Voice(music_current + 3, .Pause)
            music_current = music_incoming
            music_incoming = 0
            music_gain = 0.0
            if music_requested != music_current {
                requested := music_requested
                music_requested = music_current
                RequestMusic(requested)
            }
        } else { music_gain = fraction * fraction * (3.0 - 2.0 * fraction) }
        ApplyVolume()
    }
}
UpdateAudio :: (playing: bool, level: s32, apples: s32, death: s32, transition: s32, active: bool = true) {
    EnforceMute()
    if !ready { return }
    if playing && !was_playing {
        if !Play(music_current + 3) { return }
        if music_incoming != 0 && !Play(music_incoming + 3) { return }
    }
    if !playing && was_playing {
        if Voice(music_current + 3, .Pause).code != .Ok { return }
        if music_incoming != 0 && Voice(music_incoming + 3, .Pause).code != .Ok { return }
    }
    if playing {
        if !was_playing || level / 4 != previous_level / 4 { RequestMusic(MusicForLevel(level)) }
        PumpMusic()
    }
    effect: s32 = -1
    if playing && active && (!was_active || previous_level != level) { effect = 0 }
    else if playing && active && apples < previous_apples { effect = 1 }
    else if playing && active && death > previous_death { effect = 2 }
    else if playing && active && transition > previous_transition { effect = 3 }
    if effect >= 0 && !muted && !silenced {
        unused Voice(effect, .Stop)
        unused Play(effect)
    }
    was_playing = playing
    was_active = playing && active
    previous_level = level
    previous_apples = apples
    previous_death = death
    previous_transition = transition
}

// Also called before modal and pending-ad early returns.
EnforceMute :: () {
    Ensure()
    if Portal.AudioMuted() != silenced {
        silenced = !silenced
        ApplyMute()
    }
}
