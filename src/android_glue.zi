#import "android_device"
#import "android_jni"
#import "kryon/android_notifications"
#import "kryon/notification_desktop"
#if #defined(WURM_ACCOUNTS) {
    Handoff :: #import "entity/account_handoff";
}

// Registers Kryon's canonical Android natives on this activity. Keep your
// own JNI_OnLoad and call AndroidJniOnLoad yourself to add application
// methods on top.
#program_export
JNI_OnLoad :: (vm: *JniVm, reserved: *void) -> s32 {
    unused reserved
    version := AndroidJniOnLoad(vm, "xyz/waozi/wurm/MainActivity")
    #if #defined(WURM_ACCOUNTS) {
        Handoff.AccountHandoffJniOnLoad(vm)
    }
    return version
}
