brush_digits: [21]u8;

StageName :: (stage: s32) -> string {
    if stage == 1 { return "Leafwood" }
    if stage == 2 { return "Pinewood" }
    if stage == 3 { return "Lake" }
    if stage == 4 { return "Mountains" }
    return "Meadow"
}
StageKey :: (stage: s32) -> string {
    if stage == 1 { return "leafwood-" }
    if stage == 2 { return "pinewood-" }
    if stage == 3 { return "lake-" }
    if stage == 4 { return "mountains-" }
    return "meadow-"
}

// Terrain keeps the stable 20-column tile coordinates; every landscape
// shares the same orange worm and apples.
SHEET_SCALE :: 2.0;
Sheet :: (stage: s32) -> string {
    if stage == 1 { return ART_LEAFWOOD }
    if stage == 2 { return ART_PINEWOOD }
    if stage == 3 { return ART_LAKE }
    if stage == 4 { return ART_MOUNTAINS }
    return ART_MEADOW
}
preview_path: [64]u8;
PreviewPath :: (stage: s32, number: s32, portrait: bool = false) -> string {
    digits: [16]u8
    at := CopyInto(preview_path[:], 0, ART_PREVIEWS)
    at = CopyInto(preview_path[:], at, StageKey(stage))
    at = CopyInto(preview_path[:], at, FormatInteger(cast(s64)number, digits[:]))
    if portrait { at = CopyInto(preview_path[:], at, "-portrait") }
    at = CopyInto(preview_path[:], at, ".png")
    preview_path[at] = 0
    return TextUntilNul(preview_path[:])
}
CopyInto :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}
Picture :: (session: Session, key: u64, asset: string, bounds: Rectangle, source: Rectangle, alpha: u8 = 255) {
    unused Image(session, ImageProps.{.key = key, .asset_path = asset, .bounds = bounds,
        .source = Rectangle.{source.x * SHEET_SCALE, source.y * SHEET_SCALE,
            source.width * SHEET_SCALE, source.height * SHEET_SCALE},
        .tint = cast(u32)0xffffff00 | cast(u32)alpha, .smooth = true, .alt_text = "Worm artwork"})
}

TextLine :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text),
        .font = size, .wrap = TextWrap.TextWrapNone})
}

CentreText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text),
        .font = size, .align = TextAlign.TextAlignCenter})
}


GamePointer :: (session: Session) -> Input.PointerFrame {
    #if #defined(WURM_PORTABLE) {
        unused session
        return SamplePointer()
    } else {
        return PointerSample(session)
    }
}
GameSecondaryPointer :: (session: Session) -> Input.SecondaryPointerFrame {
    #if #defined(WURM_PORTABLE) {
        unused session
        return Input.SecondaryPointerFrame.{}
    } else {
        return SecondaryPointerSample(session)
    }
}

NavigateBack :: (now: s64) -> bool {
    if game.mode == MODE_STAGES { return false }
    if EditorApp() && game.mode == MODE_EDITOR && editor_page == EDITOR_PAGE_HOME { return false }
    HandleInput(Input.KeyEscape, now)
    return true
}
GameText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32, muted: bool = false,
             centre: bool = false) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text), .font = size,
        .class_name = ifx muted then 2 else 0, .align = ifx centre then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
        .wrap = TextWrap.TextWrapNone})
}

sound_loaded: bool;
preferences_dirty: bool;
preferences_poll: s64;
PreferencesChanged :: () { preferences_dirty = true; preferences_poll = 0 }
PreferencesPump :: (now: s64) {
    if now < preferences_poll || Progress.owner[0] == 0 { return }
    preferences_poll = now + 5000
    if preferences_dirty {
        out: Vec(u8)
        BuilderPrint(*out, "{\"operation\":\"put\",\"kind\":\"wurm-settings\",\"id\":\"00000000000000000000000000000001\",\"schema\":\"wurm.settings.v1\",\"document\":{\"theme\":%,\"pad\":%,\"muted\":%,\"skin\":%,\"volume\":%}}",
            Appearance.mode, Controls.Pad(), Audio.muted, Wardrobe.skin, Audio.volume)
        answer := Account.Service("entity.records", TextView(VecSlice(out, 0, out.count)))
        done: [16]u8
        preferences_dirty = ReadStringText(answer, FieldAt(answer, 0, "status"), done[:]) < 0 || TextUntilNul(done[:]) != "done"
        VecFree(out)
        return
    }
    reply := Account.Service("entity.records", "{\"operation\":\"get\",\"kind\":\"wurm-settings\",\"id\":\"00000000000000000000000000000001\"}")
    document := FieldAt(reply, 0, "document")
    if document < 0 { return }
    theme := ReadNumber(reply, FieldAt(reply, document, "theme"))
    if Account.SharedTheme() < 0 && theme.valid && theme.value >= 0.0 && theme.value <= 2.0 && theme.value == cast(float64)cast(s32)theme.value &&
    cast(s32)theme.value != Appearance.mode { Appearance.Set(cast(s32)theme.value) }
    pad := FieldAt(reply, document, "pad")
    if pad >= 0 && (reply[pad] == #char "t" || reply[pad] == #char "f") {
        desired := reply[pad] == #char "t"
        if !Controls.Chosen() || Controls.Pad() != desired { unused Controls.SetPad(desired) }
    }
    sound := FieldAt(reply, document, "muted")
    if sound >= 0 && (reply[sound] == #char "t" || reply[sound] == #char "f") &&
    Audio.muted != (reply[sound] == #char "t") { Audio.ToggleMute() }
    gain := ReadNumber(reply,FieldAt(reply,document,"volume"))
    if gain.valid && gain.value >= 0.0 && gain.value <= 100.0 && gain.value == cast(float64)cast(s32)gain.value {
        Audio.SetVolume(cast(s32)gain.value)
    }
    chosen := ReadNumber(reply, FieldAt(reply, document, "skin"))
    if chosen.valid && chosen.value >= 0.0 && chosen.value <= 12.0 && chosen.value == cast(float64)cast(s32)chosen.value &&
    Wardrobe.Available(cast(s32)chosen.value) {
        Wardrobe.skin = cast(s32)chosen.value
        Wardrobe.Save()
    }
}
LoadSound :: () {
    if sound_loaded { return }
    sound_loaded = true
    bytes: [2]u8
    count := Controls.ReadRecord("sound.dat", bytes[:])
    if count >= 1 && bytes[0] == 1 && !Audio.muted { Audio.ToggleMute() }
    if count == 2 && bytes[1] <= 100 { Audio.SetVolume(cast(s32)bytes[1]) }
}
SaveSound :: () {
    bytes: [2]u8 = .[ifx Audio.muted then cast(u8)1 else cast(u8)0,cast(u8)Audio.volume]
    unused Controls.WriteRecord("sound.dat", bytes[:])
    PreferencesChanged()
}
ToggleSound :: () {
    LoadSound()
    if Audio.volume == 0 {
        Audio.SetVolume(100)
        if Audio.muted { Audio.ToggleMute() }
    } else { Audio.ToggleMute() }
    SaveSound()
}
sound_popup: bool;
sound_percent: [24]u8;
DrawSoundPopup :: (session: Session, hud: Rectangle, trigger: Rectangle) {
    if !sound_popup { return }
    width: float32 = 248.0
    if width > hud.width - 16.0 { width = hud.width - 16.0 }
    left := trigger.x + trigger.width - width
    if left < hud.x + 8.0 { left = hud.x + 8.0 }
    panel := Rectangle.{left,trigger.y + trigger.height + 8.0,width,140.0}
    popup := Popup(session,PopupProps.{.key=24100,.bounds=panel,.keep_bounds=trigger})
    if popup.closed { sound_popup = false; return }
    if popup.panel_node < 0 || !TreePushScope(session,popup.panel_node) { return }
    unused Box(session,BoxProps.{.key=24101,.bounds=panel,.fill=Appearance.Surface(),.border=Appearance.Border(),.radius=12.0})
    GameText(session,24102,Locale.Text("Sound"),Rectangle.{panel.x+16.0,panel.y+14.0,panel.width-120.0,32.0},16)
    if Button(session,ButtonProps.{.key=24103,.bounds=Rectangle.{panel.x+panel.width-96.0,panel.y+10.0,80.0,40.0},
        .label=Locale.Text(ifx Audio.muted || Audio.volume == 0 then "Off" else "On"),.selected=!Audio.muted && Audio.volume>0}) != 0 { ToggleSound() }
    if Audio.CanSetVolume() {
        text := FormatInteger(cast(s64)Audio.volume,sound_percent[:])
        result := Slider(session,SliderProps.{.key=24104,.id=24104,
            .bounds=Rectangle.{panel.x+16.0,panel.y+66.0,panel.width-32.0,58.0},
            .label=Locale.Text("Volume"),.value_text=text,.semantic_label=Locale.Text("Volume"),
            .value=cast(float32)Audio.volume,.min=0.0,.max=100.0})
        if result.changed {
            Audio.SetVolume(cast(s32)(result.value+0.5))
            if Audio.volume > 0 && Audio.muted { Audio.ToggleMute() }
            SaveSound()
        }
    }
    unused End(session)
}
dew_text: [32]u8;
DewText :: () -> string {
    reply := Account.Service("entity.dew", "balance")
    units := ReadNumber(reply, FieldAt(reply, 0, "units"))
    if units.valid && units.value < 0.0 { return "…" }
    value := ifx units.valid && units.value >= 0.0 then cast(s64)units.value else cast(s64)0
    if !DewFormat(value, DewUnits, dew_text[:]) { return "0" }
    return TextUntilNul(dew_text[:])
}
TitleActions :: (session: Session, area: Rectangle) {
    right := area.x + area.width - 12.0
    top := area.y + 12.0
    // Painted icons float on the title like the chest, a little smaller on phones.
    size: float32 = ifx area.width < 600.0 then 56.0 else 76.0
    icon: float32 = ifx area.width < 600.0 then 48.0 else 60.0
    // Portal copies are guest-only: no account, Dew, shop or daily chest.
    #if #defined(WURM_CRAZYGAMES) {
        if Portal.AccountAvailable() && TitleIcon(session, 28002,
                Rectangle.{right - icon * 2.0 - 8.0, top, icon, icon}, 2, "Profile") { Portal.OpenProfile() }
    } else #if !#defined(WURM_PORTABLE) {
        // The balance follows Dew earned or spent elsewhere: asked again
        // whenever the title comes back into view, then twice a minute.
        now := Timer.MonotonicMilliseconds()
        if Rewards.SignedIn() && (now >= dew_refresh_at || now - dew_title_seen > 1000) {
            unused Account.Service("entity.dew", "refresh")
            dew_refresh_at = now + 30000
        }
        dew_title_seen = now
        // Embedded games use the enclosing host's navigation and account UI.
        if TitleIcon(session, 28002, Rectangle.{right - icon * 3.0 - 16.0, top, icon, icon}, 2, "Profile") { Account.OpenProfile() }
        if TitleIcon(session, 28004, Rectangle.{right - icon * 2.0 - 8.0, top, icon, icon}, 1, "Leaderboard") { Account.OpenLeaderboard() }
    }
    if TitleIcon(session, 28003, Rectangle.{right - icon, top, icon, icon}, 0, "Settings") { game.mode = MODE_SETTINGS }
    #if #defined(WURM_CRAZYGAMES) {
        if Portal.SaveLimited() {
            GameText(session, 28005, "Progress is kept only until this page closes.",
                Rectangle.{area.x + 16.0, area.y + 12.0, area.width - 180.0, 24.0}, 15, false, true)
        }
    }
    #if !#defined(WURM_CRAZYGAMES) {
        TitleShop(session, Rectangle.{area.x + 12.0, top, size, size})
        RewardChest(session, Rectangle.{area.x + 12.0, top + size + 10.0, size, size})
    }
}
TitleIcon :: (session: Session, key: u64, bounds: Rectangle, cell: s32, label: string) -> bool {
    unused Image(session, ImageProps.{.key = key + 100, .asset_path = ART_TITLE_ICONS, .bounds = bounds,
        .source = Rectangle.{cast(float32)cell * 256.0, 0.0, 256.0, 256.0},
        .fit = ImageFit.ImageFitContain, .smooth = true})
    return Button(session, ButtonProps.{.key = key, .bounds = bounds, .label = Locale.Text(label), .invisible = true}) != 0
}
dew_refresh_at: s64;
dew_title_seen: s64;
OpenShop :: () { game.mode = MODE_SHOP; Wardrobe.poll_at = 0; unused Account.Service("entity.game-shop", "refresh") }
// The shop's stall with the wallet beside it: coins, then Dew below.
TitleShop :: (session: Session, bounds: Rectangle) {
    // The button below names the stall.
    RewardIcon(session, 28010, bounds, 4, "")
    digits: [21]u8
    coins := FormatInteger(cast(s64)Rewards.Coins(), digits[:])
    dew := ""
    #if !#defined(WURM_PORTABLE) {
        if Rewards.SignedIn() { dew = DewText() }
    }
    pill_width := AmountWidth(coins, 15)
    if AmountWidth(dew, 15) > pill_width { pill_width = AmountWidth(dew, 15) }
    pill_width += 20.0
    rows: float32 = ifx dew.count > 0 then 2.0 else 1.0
    pill := Rectangle.{bounds.x + bounds.width - 4.0, bounds.y + bounds.height / 2.0 - 15.0 * rows - 2.0 * (rows - 1.0), pill_width, 30.0}
    unused Box(session, BoxProps.{.key = 28011, .bounds = pill, .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 15.0})
    Amount(session, 28012, Rectangle.{pill.x + 6.0, pill.y + 3.0, pill.width - 8.0, 24.0}, false, coins, 15, false)
    if dew.count > 0 {
        wallet := Rectangle.{pill.x, pill.y + 34.0, pill_width, 30.0}
        unused Box(session, BoxProps.{.key = 28014, .bounds = wallet, .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 15.0})
        Amount(session, 28015, Rectangle.{wallet.x + 6.0, wallet.y + 3.0, wallet.width - 8.0, 24.0}, true, dew, 15, false)
    }
    if Button(session, ButtonProps.{.key = 28000, .bounds = Rectangle.{bounds.x, bounds.y, pill.x + pill_width - bounds.x, bounds.height},
            .label = Locale.Text("Shop"), .invisible = true}) != 0 { OpenShop() }
}
// An amount with its currency's picture: a coin or a Dew drop. It uses
// key and key + 1.
AmountWidth :: (text: string, size: s32) -> float32 {
    return cast(float32)size * 1.3 + 4.0 + cast(float32)text.count * cast(float32)size * 0.62
}
Amount :: (session: Session, key: u64, bounds: Rectangle, dew: bool, text: string, size: s32, centre: bool) {
    icon := cast(float32)size * 1.3
    x := bounds.x
    if centre { x += (bounds.width - AmountWidth(text, size)) / 2.0 }
    top := bounds.y + (bounds.height - icon) / 2.0
    RewardIcon(session, key, Rectangle.{x, top, icon, icon}, ifx dew then 3 else 2, ifx dew then "Dew" else "Coins")
    unused Text(session, TextProps.{.key = key + 1, .bounds = Rectangle.{x + icon + 4.0, bounds.y, bounds.x + bounds.width - x - icon - 4.0, bounds.height},
        .text = text, .font = size, .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapNone})
}
// A skin's price as its number beside a coin or a Dew drop.
SkinPrice :: (session: Session, key: u64, bounds: Rectangle, id: s32, size: s32) {
    coin_price := Rewards.CoinPrice(id)
    digits: [32]u8
    if coin_price > 0 {
        Amount(session, key, bounds, false, FormatInteger(cast(s64)coin_price, digits[:]), size, true)
    } else if DewFormat(ShopModel.GameShopPrice(id), DewUnits, digits[:]) {
        Amount(session, key, bounds, true, TextUntilNul(digits[:]), size, true)
    }
}
// The daily chest floats on the title. While a gift waits it bobs, glows
// and wears a dot, inviting a visit every day.
RewardIcon :: (session: Session, key: u64, bounds: Rectangle, cell: s32, label: string) {
    unused Image(session, ImageProps.{.key = key, .asset_path = ART_REWARD_ICONS, .bounds = bounds,
        .source = Rectangle.{cast(float32)cell * 256.0, 0.0, 256.0, 256.0},
        .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = ifx label.count > 0 then Locale.Text(label) else ""})
}
RewardBob :: () -> float32 {
    phase := cast(s32)((Timer.MonotonicMilliseconds() / 25) % 80)
    return cast(float32)(ifx phase < 40 then phase else 80 - phase) / 5.0 - 4.0
}
RewardChest :: (session: Session, bounds: Rectangle) {
    ready := Rewards.ClaimReady()
    chest := bounds
    if ready {
        chest.y += RewardBob()
        unused Box(session, BoxProps.{.key = 28008, .bounds = Rectangle.{chest.x + 4.0, chest.y + 6.0, chest.width - 8.0, chest.height - 8.0},
            .fill = Color.{255, 214, 102, 90}, .radius = chest.width / 2.0})
    }
    // An open chest has a gift to collect; a closed one waits for tomorrow.
    RewardIcon(session, 28009, chest, ifx ready then 1 else 0, "Daily rewards")
    if Button(session, ButtonProps.{.key = 28006, .bounds = bounds, .label = Locale.Text("Daily rewards"),
            .invisible = true}) != 0 { game.mode = MODE_REWARDS }
    if ready {
        unused Box(session, BoxProps.{.key = 28007, .bounds = Rectangle.{chest.x + chest.width - 22.0, chest.y + 4.0, 18.0, 18.0},
            .fill = Color.{236, 72, 60, 255}, .border = Color.{255, 255, 255, 255}, .radius = 9.0})
    }
}
PageHeading :: (session: Session, area: Rectangle, title: string) {
    unused Box(session, BoxProps.{.key = 28100, .bounds = area, .fill = Appearance.Canvas()})
    GameText(session, 28101, title, Rectangle.{area.x + 108.0, area.y + 18.0, area.width - 124.0, 32.0}, 24)
    if Button(session, ButtonProps.{.key = 28102, .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 84.0, 44.0},
            .label = Locale.Text("Back"), .class_name = 11}) != 0 { game.mode = MODE_STAGES; buy_skin = 0 }
}
// One keyboard key: a raised cap showing its letter or arrow.
KeyCap :: (session: Session, key: u64, bounds: Rectangle, label: string, shape: string) {
    unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{bounds.x, bounds.y + 3.0, bounds.width, bounds.height},
        .fill = Appearance.Border(), .radius = 7.0})
    unused Box(session, BoxProps.{.key = key + 1, .bounds = bounds, .fill = Appearance.Canvas(),
        .border = Appearance.Border(), .radius = 7.0})
    if shape != "" {
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + 7.0, bounds.y + 7.0, bounds.width - 14.0, bounds.height - 14.0},
            .shape = shape, .color = Appearance.TextColor()})
    } else {
        unused Text(session, TextProps.{.key = key + 2, .bounds = Rectangle.{bounds.x, bounds.y + (bounds.height - 22.0) / 2.0 + 3.0, bounds.width, 22.0},
            .text = label, .font = 16, .align = TextAlign.TextAlignCenter})
    }
}
// Four steering keys in the keyboard's inverted T, 98 by 64 points.
KeyCluster :: (session: Session, key: u64, origin: Point, arrows: bool) {
    size: float32 = 30.0
    gap: float32 = 4.0
    left := cast(float32)origin.x
    top := cast(float32)origin.y
    labels: [4]string = .["W", "A", "S", "D"]
    shapes: [4]string = .[ArrowUp.Shape, ArrowLeft.Shape, ArrowDown.Shape, ArrowRight.Shape]
    for cap: 0..3 {
        column: float32 = ifx cap == 0 then 1.0 else cast(float32)(cap - 1)
        row: float32 = ifx cap == 0 then 0.0 else 1.0
        bounds := Rectangle.{left + column * (size + gap), top + row * (size + gap), size, size}
        KeyCap(session, key + cast(u64)cap * 3, bounds, labels[cap], ifx arrows then shapes[cap] else "")
    }
}
settings_scroll: s32;
DrawSettings :: (session: Session, area: Rectangle) {
    PageHeading(session, area, "Settings")
    width := area.width - 32.0
    if width > 540.0 { width = 540.0 }
    scroller := Scroll(session, ScrollProps.{.key = 28200,
        .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + 76.0, width, area.height - 88.0},
        .content_height = (ifx KeyboardOnly() then 448 else 508) - (ifx Portal.Guest() then 150 else 0), .scroll_offset = settings_scroll})
    settings_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    x := scroller.content.x; y := scroller.content.y; width = scroller.content.width
    // Appearance belongs to the shared profile, absent from portal copies.
    if Portal.Guest() { y -= 150.0 }
    else if Button(session, ButtonProps.{.key = 28201, .bounds = Rectangle.{x, y, width, 60.0},
            .label = Locale.Text("Appearance"), .class_name = 11}) != 0 { Account.OpenAppearance() }
    #if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) && !#defined(WURM_PORTABLE) {
        // Local rounds share one keyboard, so only computers offer them.
        if Button(session, ButtonProps.{.key = 28202, .bounds = Rectangle.{x, y + 72.0, width, 60.0},
                .label = Locale.Text("Local multiplayer"), .class_name = 11}) != 0 { OpenLocalSetup() }
    }
    GameText(session, 28220, "Controls", Rectangle.{x, y + 150.0, width, 28.0}, 20)
    half := (width - 8.0) / 2.0
    lower: float32 = 0.0
    if KeyboardOnly() {
        // The keys that steer, drawn as the keyboard's own caps.
        lower = -60.0
        for choice: 0..1 {
            preview := Rectangle.{x + cast(float32)choice * (half + 8.0), y + 186.0, half, 116.0}
            unused Box(session, BoxProps.{.key = 28250 + cast(u64)choice, .bounds = preview,
                .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 12.0})
            KeyCluster(session, 28270 + cast(u64)choice * 12, Point.{cast(s32)(preview.x + (preview.width - 98.0) / 2.0), cast(s32)preview.y + 12}, choice == 0)
            GameText(session, 28252 + cast(u64)choice, ifx choice == 0 then "Arrow keys" else "W A S D",
                Rectangle.{preview.x + 8.0, preview.y + 84.0, preview.width - 16.0, 24.0}, 15, true, true)
        }
    } else {
        for choice: 0..1 {
            preview := Rectangle.{x + cast(float32)choice * (half + 8.0), y + 186.0, half, 116.0}
            unused Box(session, BoxProps.{.key = 28250 + cast(u64)choice, .bounds = preview,
                .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 12.0})
            side: float32 = 88.0
            square := Rectangle.{preview.x + (preview.width - side) / 2.0, preview.y + 10.0, side, side}
            if choice == 0 {
                Character(session, 28260, Rectangle.{square.x + 4.0, square.y + 18.0, 46.0, 46.0}, Wardrobe.skin, true)
                SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{square.x + 34.0, square.y + 32.0, 54.0, 54.0},
                    .shape = FingerSwipe.Shape, .color = Appearance.TextColor()})
            } else {
                pad := DirectionPad(session, DirectionPadProps.{.key = 28261, .bounds = square,
                    .label = Locale.Text("Try the direction pad"), .now = cast(float64)Timer.MonotonicMilliseconds() / 1000.0})
                if pad.step { unused Controls.SetPad(true); PreferencesChanged() }
            }
        }
        if Button(session, ButtonProps.{.key = 28221, .bounds = Rectangle.{x, y + 310.0, half, 52.0},
                .label = Locale.Text("Swipe"), .selected = !Controls.Pad(), .class_name = 11}) != 0 { unused Controls.SetPad(false); PreferencesChanged() }
        if Button(session, ButtonProps.{.key = 28222, .bounds = Rectangle.{x + half + 8.0, y + 310.0, half, 52.0},
                .label = Locale.Text("Direction pad"), .selected = Controls.Pad(), .class_name = 11}) != 0 { unused Controls.SetPad(true); PreferencesChanged() }
    }
    y += lower
    GameText(session, 28230, "Sound", Rectangle.{x, y + 402.0, width - 104.0, 32.0}, 20)
    if Button(session, ButtonProps.{.key = 28231, .bounds = Rectangle.{x + width - 100.0, y + 392.0, 100.0, 52.0},
            .label = Locale.Text(ifx Audio.muted then "Off" else "On"), .selected = !Audio.muted, .class_name = 11}) != 0 { ToggleSound() }
    GameText(session, 28240, "Version", Rectangle.{x, y + 470.0, width - 104.0, 24.0}, 14, true)
    GameText(session, 28241, Version.AppVersion, Rectangle.{x + width - 100.0, y + 470.0, 100.0, 24.0}, 14, true)
    unused End(session)
}

SkinName :: (id: s32) -> string {
    if id == 1 { return "Mint" }
    if id == 2 { return "Berry" }
    if id == 3 { return "Rose" }
    if id == 4 { return "Night owl" }
    if id == 5 { return "Golden apple" }
    if id == 6 { return "Explorer" }
    if id == 7 { return "Moon dragon" }
    if id == 8 { return "Winter cheer" }
    if id == 9 { return "Moss" }
    if id == 10 { return "River" }
    if id == 11 { return "Mushroom" }
    if id == 12 { return "Aurora" }
    return "Apfelwurm"
}
CharacterPreview :: (session: Session, key: u64, bounds: Rectangle, id: s32) {
    // The body's balls touch, overlapping a little like the worm in play.
    for segment: 0..2 {
        size := 23.0 + cast(float32)segment * 2.0
        x := bounds.x + 10.0 + cast(float32)segment * 16.0
        y := bounds.y + 20.0 - cast(float32)segment * 4.0
        Character(session, key + cast(u64)segment * 8, Rectangle.{x, y, size, size}, id, false)
    }
    Character(session, key + 24, Rectangle.{bounds.x + 54.0, bounds.y + 2.0, 38.0, 38.0}, id, true, 2)
}
Character :: (session: Session, key: u64, bounds: Rectangle, id: s32, head: bool, direction: s32 = 2, alpha: u8 = 255, clip: Rectangle = .{}) {
    if id == 0 {
        column := ifx head then direction else 4
        Picture(session, key, Sheet(0), bounds,
            Rectangle.{cast(float32)column * 16.0, 48.0, 16.0, 16.0}, alpha)
        return
    }
    // Every other skin is painted: a head facing right and a round body
    // segment. Skins 1-6 share skins.png in 180px cells, one row each; the
    // two specials keep their own sheet.
    path := ART_SKINS
    source := Rectangle.{ifx head then 0.0 else 180.0, cast(float32)(id - 1) * 180.0, 180.0, 180.0}
    if id >= 9 {
        path = ART_REWARD_SKINS
        source = Rectangle.{ifx head then 0.0 else 256.0, cast(float32)(id - 9) * 256.0, 256.0, 256.0}
    }
    if id == 7 || id == 8 {
        column := ifx id == 7 then 0 else 2
        if !head { column += 1 }
        crops: [4]Rectangle = .[Rectangle.{79.0, 87.0, 464.0, 491.0}, Rectangle.{543.0, 155.0, 497.0, 429.0},
            Rectangle.{1086.0, 105.0, 520.0, 534.0}, Rectangle.{1696.0, 182.0, 410.0, 405.0}]
        path = ART_SPECIAL_SKINS
        source = crops[column]
    }
    height := bounds.height
    width := height * source.width / source.height
    if width > bounds.width { width = bounds.width; height = width * source.height / source.width }
    cx := bounds.x + bounds.width / 2.0
    cy := bounds.y + bounds.height / 2.0
    corners: [4]Vector2
    for corner: 0..3 {
        dx := (ifx corner % 2 == 0 then -width else width) / 2.0
        dy := (ifx corner < 2 then -height else height) / 2.0
        if head && direction == 0 { dx = -dx; dy = -dy }
        else if head && direction == 1 { previous := dx; dx = dy; dy = -previous }
        else if head && direction == 3 { previous := dx; dx = -dy; dy = previous }
        corners[corner] = Vector2.{cx + dx, cy + dy}
    }
    unused Image(session, ImageProps.{.key = key, .asset_path = path,
        .bounds = ifx clip.width > 0.0 then clip else bounds, .source = source, .mesh = ImageMesh.{2, 2, corners[:]},
        .tint = cast(u32)0xffffff00 | cast(u32)alpha, .smooth = true, .alt_text = Locale.Text(SkinName(id))})
}
shop_scroll: s32;
buy_skin: s32;
// The shop's tabs: skins, coin packs bought with Dew, and Dew top-ups.
SHOP_SKINS :: 0;
SHOP_COINS :: 1;
SHOP_DEW :: 2;
shop_tab: s32;
buy_pack: s32;
// The bought coins when a pack was asked for; -1 while none is waiting.
pack_from: s32 = -1;
pack_grace: s32;
DrawShop :: (session: Session, area: Rectangle) {
    PageHeading(session, area, "Shop")
    if buy_pack > 0 { DrawPackConfirm(session, area); return }
    if buy_skin > 0 {
        id := buy_skin
        width := area.width - 32.0
        if width > 360.0 { width = 360.0 }
        x := area.x + (area.width - width) / 2.0; y := area.y + 112.0
        Character(session, 28320, Rectangle.{x + width / 2.0 - 26.0, y, 52.0, 52.0}, id, true)
        GameText(session, 28311, SkinName(id), Rectangle.{x, y + 68.0, width, 28.0}, 22, false, true)
        SkinPrice(session, 28316, Rectangle.{x, y + 104.0, width, 28.0}, id, 18)
        pending := TextUntilNul(Wardrobe.status[:]) == "pending"
        coin_purchase := Rewards.CoinPrice(id) > 0
        signin := !coin_purchase && (Progress.owner[0] == 0 || TextUntilNul(Wardrobe.status[:]) == "signin")
        if Wardrobe.Available(id) { buy_skin = 0; Wardrobe.Select(id); PreferencesChanged(); return }
        if Button(session, ButtonProps.{.key = 28313, .bounds = Rectangle.{x, y + 150.0, width, 48.0},
                .label = Locale.Text(ifx signin then "Sign in" else ifx pending then "Please wait…" else "Confirm purchase"),
                .disabled = (pending && !signin && !coin_purchase) || (coin_purchase && Rewards.Coins() < Rewards.CoinPrice(id)), .class_name = 10}) != 0 {
            if signin { Account.OpenProfile() }
            else if coin_purchase {
                if Rewards.Buy(id) { buy_skin = 0; Wardrobe.Select(id); PreferencesChanged() }
            }
            else {
                product := ShopModel.GameShopProduct(id)
                unused Account.Service("entity.game-shop", product)
                Wardrobe.poll_at = 0
            }
        }
        if Button(session, ButtonProps.{.key = 28314, .bounds = Rectangle.{x, y + 210.0, width, 44.0}, .label = Locale.Text("Cancel"), .class_name = 11}) != 0 { buy_skin = 0 }
        failed := TextUntilNul(Wardrobe.status[:]) == "failed" || TextUntilNul(Wardrobe.status[:]) == "insufficient"
        if failed { GameText(session, 28315, "Purchase not confirmed. Check your Dew and retry.", Rectangle.{x, y + 264.0, width, 24.0}, 12, true, true) }
        Wardrobe.poll_at = 0
        return
    }
    // The wallet: coins, and Dew for a signed-in account.
    {
        digits: [21]u8
        coins := FormatInteger(cast(s64)Rewards.Coins(), digits[:])
        badge := Rectangle.{area.x + 16.0, area.y + 78.0, AmountWidth(coins, 18) + 24.0, 40.0}
        unused Box(session, BoxProps.{.key = 28330, .bounds = badge, .fill = Appearance.Surface(), .radius = 20.0})
        Amount(session, 28331, Rectangle.{badge.x + 10.0, badge.y + 4.0, badge.width - 12.0, 32.0}, false, coins, 18, false)
        #if !#defined(WURM_PORTABLE) {
            if Rewards.SignedIn() {
                dew := DewText()
                wallet := Rectangle.{badge.x + badge.width + 10.0, badge.y, AmountWidth(dew, 18) + 24.0, 40.0}
                unused Box(session, BoxProps.{.key = 28333, .bounds = wallet, .fill = Appearance.Surface(), .radius = 20.0})
                Amount(session, 28334, Rectangle.{wallet.x + 10.0, wallet.y + 4.0, wallet.width - 12.0, 32.0}, true, dew, 18, false)
            }
        }
    }
    top := area.y + 136.0
    #if !#defined(WURM_PORTABLE) {
        // Inside Arcade or Breeze the host sells Dew; the game keeps skins.
        tabs: [3]string = .["Skins", "Coins", "Dew"]
        tab_width := (area.width - 32.0 - 16.0) / 3.0
        if tab_width > 160.0 { tab_width = 160.0 }
        left := area.x + (area.width - tab_width * 3.0 - 16.0) / 2.0
        for tab: cast(s32)0..2 {
            if Button(session, ButtonProps.{.key = cast(u64)(28340 + tab),
                    .bounds = Rectangle.{left + cast(float32)tab * (tab_width + 8.0), top, tab_width, 40.0},
                    .label = Locale.Text(tabs[tab]), .selected = shop_tab == tab, .pill = true, .class_name = 11}) != 0 {
                shop_tab = tab
                if tab == SHOP_DEW { Account.ShowDew() }
            }
        }
        top += 52.0
        content := Rectangle.{area.x + 16.0, top, area.width - 32.0, area.y + area.height - top - 12.0}
        if shop_tab == SHOP_COINS { DrawCoinPacks(session, content); return }
        if shop_tab == SHOP_DEW {
            Account.DrawProfile(session, content, 0, Appearance.mode != 2)
            return
        }
    }
    grid := Rectangle.{area.x + 16.0, top, area.width - 32.0, area.y + area.height - top - 12.0}
    columns: s32 = ifx grid.width >= 650.0 then 3 else 2
    width := (grid.width - 16.0 - cast(float32)(columns - 1) * 12.0) / cast(float32)columns
    // Winter cheer only appears in its season or once owned.
    shown: [13]s32
    skin_count: s32 = 0
    for skin: cast(s32)0..12 {
        if skin == 8 && !Wardrobe.Available(8) && !Wardrobe.christmas_claimable { continue }
        shown[skin_count] = skin; skin_count += 1
    }
    rows := (skin_count + columns - 1) / columns
    scroller := Scroll(session, ScrollProps.{.key = 28400, .bounds = grid, .content_height = rows * 196, .scroll_offset = shop_scroll})
    shop_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    for slot: 0..skin_count - 1 {
        id := shown[slot]
        x := scroller.content.x + cast(float32)(slot % columns) * (width + 12.0)
        y := scroller.content.y + cast(float32)(slot / columns) * 196.0
        key := cast(u64)28500 + cast(u64)id * 100
        unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x, y, width, 184.0}, .fill = Appearance.Surface(), .radius = 16.0})
        CharacterPreview(session, key + 20, Rectangle.{x + width / 2.0 - 48.0, y + 10.0, 96.0, 50.0}, cast(s32)id)
        GameText(session, key + 8, SkinName(cast(s32)id), Rectangle.{x + 4.0, y + 68.0, width - 8.0, 24.0}, 17, false, true)
        available := Wardrobe.Available(cast(s32)id)
        if !available {
            if id <= 3 || id == 7 || Rewards.CoinPrice(cast(s32)id) > 0 {
                SkinPrice(session, key + 12, Rectangle.{x + 4.0, y + 96.0, width - 8.0, 28.0}, cast(s32)id, 16)
            } else {
                detail := ifx id == 12 then "Day 30 reward" else ifx id == 4 then "Play for 5 hours" else ifx id == 5 then "Reach level 40" else ifx id == 8 then "Free · December 2026" else "Visit waozi.xyz"
                GameText(session, key + 9, detail, Rectangle.{x + 4.0, y + 99.0, width - 8.0, 22.0}, 12, true, true)
            }
        }
        label := ifx Wardrobe.skin == id then "Wearing" else ifx available then "Wear" else ifx id <= 3 || id == 7 || Rewards.CoinPrice(cast(s32)id) > 0 then "Buy" else ifx id == 8 && Wardrobe.christmas_claimable then "Claim" else ifx id == 6 then "Visit" else "Locked"
        if Button(session, ButtonProps.{.key = key + 10, .bounds = Rectangle.{x + 10.0, y + 132.0, width - 20.0, 42.0},
                .label = Locale.Text(label), .disabled = Wardrobe.skin == id || (!available && (id == 4 || id == 5 || id == 12 || (id == 8 && !Wardrobe.christmas_claimable))),
                .selected = Wardrobe.skin == id, .class_name = 11}) != 0 {
            if available { Wardrobe.Select(cast(s32)id); PreferencesChanged() }
            else if id <= 3 || id == 7 || Rewards.CoinPrice(cast(s32)id) > 0 { buy_skin = cast(s32)id }
            else if id == 8 { unused Account.Service("entity.game-shop", "wurm.christmas-2026"); Wardrobe.poll_at = 0 }
            else if id == 6 && Account.VisitWebsite() { Wardrobe.Visit(); Wardrobe.Select(6); PreferencesChanged() }
        }
    }
    unused End(session)
}

// Coin packs, bought with Dew. The node's receipts are the coins.
DrawCoinPacks :: (session: Session, bounds: Rectangle) {
    wide := bounds.width >= 560.0
    gap: float32 = 12.0
    for pack: cast(s32)1..ShopModel.COIN_PACKS {
        key := cast(u64)(28600 + pack * 20)
        card := ifx wide then Rectangle.{bounds.x + cast(float32)(pack - 1) * (bounds.width + gap) / 3.0, bounds.y, (bounds.width - gap * 2.0) / 3.0, 232.0}
            else Rectangle.{bounds.x, bounds.y + cast(float32)(pack - 1) * (104.0 + gap), bounds.width, 104.0}
        unused Box(session, BoxProps.{.key = key, .bounds = card, .fill = Appearance.Surface(), .radius = 16.0})
        // Bigger packs show a bigger pile.
        icon: float32 = ifx wide then 64.0 + cast(float32)pack * 12.0 else 72.0
        digits: [21]u8
        coins := FormatInteger(cast(s64)ShopModel.CoinPackCoins(pack), digits[:])
        price: [32]u8
        unused DewFormat(ShopModel.CoinPackPrice(pack), DewUnits, price[:])
        buy := Rectangle.{}
        if wide {
            RewardIcon(session, key + 1, Rectangle.{card.x + (card.width - icon) / 2.0, card.y + 12.0 + (100.0 - icon) / 2.0, icon, icon}, 2, "")
            Amount(session, key + 2, Rectangle.{card.x + 8.0, card.y + 124.0, card.width - 16.0, 36.0}, false, coins, 22, true)
            buy = Rectangle.{card.x + 12.0, card.y + 176.0, card.width - 24.0, 44.0}
        } else {
            RewardIcon(session, key + 1, Rectangle.{card.x + 12.0, card.y + 16.0, icon, icon}, 2, "")
            Amount(session, key + 2, Rectangle.{card.x + 96.0, card.y + 34.0, card.width - 220.0, 36.0}, false, coins, 22, false)
            buy = Rectangle.{card.x + card.width - 112.0, card.y + 30.0, 100.0, 44.0}
        }
        // The Dew it costs sits on the button.
        if Button(session, ButtonProps.{.key = key + 6, .bounds = buy, .label = TextUntilNul(price[:]), .icon_shape = DewIcon.Shape,
                .class_name = 11}) != 0 {
            buy_pack = pack; pack_from = -1
        }
    }
}
// Confirms a coin pack; the coins arrive with the node's receipt.
DrawPackConfirm :: (session: Session, area: Rectangle) {
    pack := buy_pack
    width := area.width - 32.0
    if width > 360.0 { width = 360.0 }
    x := area.x + (area.width - width) / 2.0; y := area.y + 112.0
    coins := ShopModel.CoinPackCoins(pack)
    if pack_from >= 0 && Rewards.bought_coins >= pack_from + coins { buy_pack = 0; pack_from = -1; return }
    RewardIcon(session, 28660, Rectangle.{x + width / 2.0 - 32.0, y, 64.0, 64.0}, 2, "")
    digits: [21]u8
    Amount(session, 28661, Rectangle.{x, y + 72.0, width, 32.0}, false, FormatInteger(cast(s64)coins, digits[:]), 22, true)
    price: [32]u8
    unused DewFormat(ShopModel.CoinPackPrice(pack), DewUnits, price[:])
    Amount(session, 28663, Rectangle.{x, y + 108.0, width, 28.0}, true, TextUntilNul(price[:]), 18, true)
    state := TextUntilNul(Wardrobe.status[:])
    if pack_grace > 0 { pack_grace -= 1; state = "pending" }
    if pack_from >= 0 && (state == "failed" || state == "insufficient" || state == "signin") { pack_from = -1 }
    signin := Progress.owner[0] == 0 || state == "signin"
    waiting := pack_from >= 0
    if Button(session, ButtonProps.{.key = 28665, .bounds = Rectangle.{x, y + 150.0, width, 48.0},
            .label = Locale.Text(ifx signin then "Sign in" else ifx waiting then "Please wait…" else "Confirm purchase"),
            .disabled = !signin && waiting, .class_name = 10}) != 0 {
        if signin { Account.OpenProfile() }
        else {
            pack_from = Rewards.bought_coins
            request := ifx pack == 1 then "coins:1" else ifx pack == 2 then "coins:2" else "coins:3"
            unused Account.Service("entity.game-shop", request)
            // The wardrobe's status is from before this request until it polls.
            pack_grace = 3
        }
    }
    if Button(session, ButtonProps.{.key = 28666, .bounds = Rectangle.{x, y + 210.0, width, 44.0}, .label = Locale.Text("Cancel"), .class_name = 11}) != 0 {
        buy_pack = 0; pack_from = -1
    }
    if !waiting && state == "insufficient" {
        GameText(session, 28667, "Not enough Dew.", Rectangle.{x, y + 264.0, width, 24.0}, 13, true, true)
        if Button(session, ButtonProps.{.key = 28668, .bounds = Rectangle.{x, y + 294.0, width, 44.0}, .label = Locale.Text("Top up Dew"),
                .icon_shape = DewIcon.Shape, .class_name = 11}) != 0 { buy_pack = 0; shop_tab = SHOP_DEW; Account.ShowDew() }
    } else if !waiting && state == "failed" {
        GameText(session, 28667, "Purchase not confirmed. Check your Dew and retry.", Rectangle.{x, y + 264.0, width, 24.0}, 12, true, true)
    }
    Wardrobe.poll_at = 0
}

// Pause, game over and completion use the same roomy card, with full-width
// touch actions. Short landscape screens use the compact composition.
Overlay :: (session: Session, area: Rectangle, title: string, message: string, score: s32 = -1) {
    unused Box(session, BoxProps.{.key = 50, .bounds = area, .fill = Color.{17, 38, 27, 155}})
    compact := area.height < 400.0
    width := area.width - 32.0
    if width > 360.0 { width = 360.0 }
    height: float32 = ifx compact then 252.0 else 292.0
    if score >= 0 { height = ifx compact then 288.0 else 340.0 }
    if game.mode == MODE_PAUSED && !KeyboardOnly() { height += 56.0 }
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    unused Box(session, BoxProps.{.key = 51,
        .bounds = Rectangle.{card.x, card.y + 6.0, card.width, card.height},
        .fill = Color.{10, 30, 18, 70}, .radius = 28.0})
    unused Box(session, BoxProps.{.key = 52, .bounds = card,
        .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 28.0})
    title_y: float32 = ifx compact then 22.0 else 86.0
    if !compact {
        centre := card.x + card.width / 2.0
        unused Box(session, BoxProps.{.key = 53,
            .bounds = Rectangle.{centre - 27.0, card.y + 22.0, 54.0, 54.0},
            .fill = Appearance.Canvas(), .radius = 27.0})
        shape := "F:M7 5H10V19H7ZM14 5H17V19H14Z"
        color := Color.{65, 113, 68, 255}
        if game.mode == MODE_DIED { shape = HeartIcon.Shape; color = Color.{213, 95, 89, 255} }
        else if game.mode == MODE_VICTORY { shape = StarIcon.Shape; color = Color.{218, 153, 45, 255} }
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{centre - 14.0, card.y + 35.0, 28.0, 28.0},
            .shape = shape, .color = color})
    }
    GameText(session, 54, title, Rectangle.{card.x + 12.0, card.y + title_y, card.width - 24.0, 36.0}, 28, false, true)
    GameText(session, 55, message, Rectangle.{card.x + 16.0, card.y + title_y + 42.0, card.width - 32.0, 24.0}, 15, true, true)
    if score >= 0 {
        score_y := card.y + title_y + 80.0
        GameText(session, 56, "SCORE", Rectangle.{card.x + 22.0, score_y + 4.0, card.width / 2.0 - 22.0, 22.0}, 12, true)
        score_text := FormatInteger(cast(s64)score, score_digits[:])
        GameText(session, 60, score_text, Rectangle.{card.x + card.width / 2.0, score_y, card.width / 2.0 - 22.0, 32.0}, 24)
    }
    primary := ifx game.mode == MODE_PAUSED then "Resume" else "Try again"
    if game.mode == MODE_VICTORY { primary = "Play again" }
    primary_offset: float32 = ifx game.mode == MODE_PAUSED && !KeyboardOnly() then 176.0 else 120.0
    if Button(session, ButtonProps.{.key = 57,
            .bounds = Rectangle.{card.x + 20.0, card.y + card.height - primary_offset, card.width - 40.0, 48.0},
            .label = primary, .class_name = 10, .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        key: s32 = cast(s32)(ifx game.mode == MODE_PAUSED then Input.KeyEscape else Input.KeyEnter)
        HandleInput(key, Timer.MonotonicMilliseconds())
    }
    if game.mode == MODE_PAUSED && !KeyboardOnly() {
        if Button(session, ButtonProps.{.key = 61,
                .bounds = Rectangle.{card.x + 20.0, card.y + card.height - 120.0, card.width - 40.0, 48.0},
                .label = Locale.Text("Controls"), .class_name = 11, .tone = ButtonTone.ButtonToneNeutral}) != 0 { AskControls() }
    }
    if Button(session, ButtonProps.{.key = 58,
            .bounds = Rectangle.{card.x + 20.0, card.y + card.height - 60.0, card.width - 40.0, 48.0},
            .label = Locale.Text("Back to title"), .class_name = 11, .tone = ButtonTone.ButtonToneNeutral}) != 0 { LeavePlay() }
}

// Keep the next board readable while its worm and enemies wait for Start.
DrawLevelReady :: (session: Session, area: Rectangle) {
    width := area.width - 32.0
    if width > 320.0 { width = 320.0 }
    height: float32 = ifx area.height < 180.0 then 132.0 else 164.0
    portal_hint := MeadowPortalLevel(game.level) && game.portal_count > 0 && area.height >= 216.0
    if portal_hint { height += 40.0 }
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    overlay := DismissibleOverlay(session, DismissibleOverlayProps.{.key = 24200,
        .bounds = card, .scrim = Color.{0, 0, 0, 64}, .dismiss_disabled = true})
    if overlay.panel_node < 0 || !TreePushScope(session, overlay.panel_node) { return }
    defer { unused End(session) }
    unused Box(session, BoxProps.{.key = 24201, .bounds = card, .fill = Appearance.Surface(),
        .border = Appearance.Border(), .radius = 24.0})
    CentreText(session, 24202, "Level", Rectangle.{card.x + 12.0, card.y + 12.0, width - 24.0, 22.0}, 16)
    digits: [21]u8
    number := FormatInteger(cast(s64)game.level + 1, digits[:])
    CentreText(session, 24203, number, Rectangle.{card.x + 12.0, card.y + 36.0, width - 24.0, 32.0}, 28)
    if portal_hint {
        CentreText(session, 24205, "Matching rings teleport you.",
            Rectangle.{card.x + 12.0, card.y + 76.0, width - 24.0, 30.0}, 13)
    }
    if Button(session, ButtonProps.{.key = 24204, .id = 24204,
        .bounds = Rectangle.{card.x + 20.0, card.y + height - 64.0, width - 40.0, 48.0},
        .label = Locale.Text("Start level"), .class_name = 10,
        .tone = ButtonTone.ButtonToneSuccess, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        HandleInput(Input.KeyEnter, Timer.MonotonicMilliseconds())
    }
}

// A logical-pixel sprite square on the live board.
Sprite :: (session: Session, key: u64, stage: Rectangle, position: Point, source: Rectangle,
    sheet: string, size: float32 = 16.0, alpha: u8 = 255) {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + (cast(float32)position.x - size / 2.0) * scale)
    top := Snap(stage.y + (cast(float32)position.y - size / 2.0) * scale)
    right := Snap(stage.x + (cast(float32)position.x + size / 2.0) * scale)
    bottom := Snap(stage.y + (cast(float32)position.y + size / 2.0) * scale)
    width := right - left
    height := bottom - top
    if width <= 0.0 || height <= 0.0 { return }
    // Clip, rather than hide, a sprite moving through an edge gate.
    clipped_left := left
    clipped_top := top
    clipped_right := right
    clipped_bottom := bottom
    if clipped_left < Snap(stage.x) { clipped_left = Snap(stage.x) }
    if clipped_top < Snap(stage.y) { clipped_top = Snap(stage.y) }
    if clipped_right > Snap(stage.x + stage.width) { clipped_right = Snap(stage.x + stage.width) }
    if clipped_bottom > Snap(stage.y + stage.height) { clipped_bottom = Snap(stage.y + stage.height) }
    if clipped_right <= clipped_left || clipped_bottom <= clipped_top { return }
    fragment := Rectangle.{source.x + (clipped_left - left) / width * source.width,
        source.y + (clipped_top - top) / height * source.height,
        (clipped_right - clipped_left) / width * source.width,
        (clipped_bottom - clipped_top) / height * source.height}
    bounds := Rectangle.{clipped_left, clipped_top, clipped_right - clipped_left, clipped_bottom - clipped_top}
    if Wardrobe.skin > 0 && source.y == 48.0 && key >= 2000 && key < 3000 {
        Character(session, key * 8 + 300000, Rectangle.{left, top, width, height}, Wardrobe.skin, key == 2000, game.direction, alpha, bounds)
    } else { Picture(session, key, sheet, bounds, fragment, alpha) }
}

// Garden-only dressage: animated water frames and grass floor variants,
// both chosen per frame and per cell so boards feel alive without any
// change to the level data.
water_frame: s32;
enemy_frame: s32;
fancy_garden: bool;
GRASS_TILES :: 9;

Snap :: (value: float32) -> float32 { return cast(float32)cast(s32)(value + 0.5) }

// Shared bounds keep neighbouring textures and their outside edges aligned.
TileBounds :: (stage: Rectangle, x: s32, y: s32) -> Rectangle {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + cast(float32)x * 16.0 * scale)
    top := Snap(stage.y + cast(float32)y * 16.0 * scale)
    return Rectangle.{left, top, Snap(stage.x + cast(float32)(x + 1) * 16.0 * scale) - left,
        Snap(stage.y + cast(float32)(y + 1) * 16.0 * scale) - top}
}

WallMaterial :: (tile: s32) -> s32 {
    value := tile & 127
    if value == 20 || (value >= 50 && value <= 58) { return 20 }
    if value == 21 || value == 22 { return value }
    return 0
}

// Only exposed edges have an outline. Equal touching materials share one
// continuous surface, including corners and walls painted in the editor.
WallEdges :: (board: []u8, x: s32, y: s32, tile: s32) -> s32 {
    material := WallMaterial(tile)
    if material == 0 { return 0 }
    mask: s32
    for side: 0..3 {
        nx := x
        ny := y
        if side == 0 { nx -= 1 }
        else if side == 1 { ny -= 1 }
        else if side == 2 { nx += 1 }
        else { ny += 1 }
        if !Inside(nx, ny) || WallMaterial(cast(s32)board[Index(nx, ny)]) != material {
            mask |= 1 << cast(s32)side
        }
    }
    return mask
}

DrawWallEdges :: (session: Session, key: u64, stage: Rectangle, x: s32, y: s32, tile: s32, board: []u8) {
    mask := WallEdges(board, x, y, tile)
    if mask == 0 { return }
    bounds := TileBounds(stage, x, y)
    edge := Snap(stage.width / (cast(float32)board_columns * 16.0) * 1.2)
    if edge < 1.0 { edge = 1.0 }
    material := WallMaterial(tile)
    dark := Color.{31, 76, 42, 255}
    light := Color.{94, 143, 67, 255}
    if material == 21 { dark = Color.{82, 83, 75, 255}; light = Color.{176, 174, 153, 255} }
    else if material == 22 { dark = Color.{36, 105, 113, 255}; light = Color.{110, 190, 177, 255} }
    for side: 0..3 {
        if (mask & (1 << cast(s32)side)) == 0 { continue }
        line := bounds
        if side == 0 { line.width = edge }
        else if side == 1 { line.height = edge }
        else if side == 2 { line.x += line.width - edge; line.width = edge }
        else { line.y += line.height - edge; line.height = edge }
        unused Box(session, BoxProps.{.key = 20000 + key * 4 + cast(u64)side, .bounds = line,
            .fill = ifx side < 2 then light else dark})
    }
}

// Tile edges land on whole pixels, so scaled neighbours meet without seams.
MeadowGround :: (session: Session, key: u64, bounds: Rectangle, x: s32, y: s32) {
    width := 1448.0 / cast(float32)board_columns
    height := 1086.0 / cast(float32)board_rows
    unused Image(session, ImageProps.{.key = key, .asset_path = ART_GROUND, .bounds = bounds,
        .source = Rectangle.{cast(float32)x * width, cast(float32)y * height, width, height},
        .smooth = true, .alt_text = "Continuous meadow ground"})
}
Tile :: (session: Session, key: u64, stage: Rectangle, x: s32, y: s32, tile: s32, sheet: string) {
    bounds := TileBounds(stage, x, y)
    kind := tile & 127
    if kind == 22 {
        // One field spans the board. Touching water cells sample touching
        // regions, so painting a lake never repeats a shoreline per tile.
        width := 1448.0 / cast(float32)board_columns
        height := 1086.0 / cast(float32)board_rows
        unused Image(session, ImageProps.{.key = key, .asset_path = ART_WATER, .bounds = bounds,
            .source = Rectangle.{cast(float32)x * width,cast(float32)y * height,width,height},
            .smooth = true, .alt_text = "Continuous water"})
        return
    }
    if kind >= 40 && kind <= 45 {
        if sheet == Sheet(0) { MeadowGround(session, key, bounds, x, y) }
        else { Picture(session, key, sheet, bounds, Rectangle.{0.0, 0.0, 16.0, 16.0}) }
        column := kind - 40
        if kind == 40 { column = 6 + enemy_frame }
        Picture(session, key + 1000000, sheet, bounds, Rectangle.{cast(float32)column * 16.0, 32.0, 16.0, 16.0})
        return
    }
    if sheet == Sheet(0) && (kind == 0 || kind == 3 || kind == 4 || kind == 5 || kind == 6 ||
        kind == 15 || kind == 16 || kind == 17 || kind == 19) {
        MeadowGround(session, key, bounds, x, y)
        return
    }
    if WallMaterial(tile) == 20 && sheet == Sheet(1) {
        // Sample one continuous forest field in board coordinates. Turning
        // the board also turns the field, so every shared tile edge matches.
        canopy := ifx board_columns == ROWS then ART_CANOPY_PORTRAIT else ART_CANOPY
        unused Image(session, ImageProps.{.key = key, .asset_path = canopy, .bounds = bounds,
            .source = Rectangle.{cast(float32)x * 16.0 * SHEET_SCALE, cast(float32)y * 16.0 * SHEET_SCALE,
                16.0 * SHEET_SCALE, 16.0 * SHEET_SCALE},
            .smooth = true, .alt_text = "Forest wall"})
        return
    }
    source := Rectangle.{cast(float32)(tile % 20) * 16.0,
        cast(float32)(tile / 20) * 16.0, 16.0, 16.0}
    if fancy_garden {
        if tile == 22 {
            source = Rectangle.{cast(float32)(water_frame % 3) * 16.0, 176.0, 16.0, 16.0}
        } else if tile == 0 || tile == 3 || tile == 4 || tile == 5 ||
            tile == 6 || tile == 15 || tile == 16 || tile == 17 || tile == 19 {
            variant := (x * 7 + y * 13) % 4
            source = Rectangle.{cast(float32)(4 + variant) * 16.0, 176.0, 16.0, 16.0}
        }
    }
    Picture(session, key, sheet, bounds, source)
}

// The live board scaled to fit inside an area: 640x480 in landscape, the
// same level standing 480x640 in portrait, so a phone screen fills edge to
// edge while the worm keeps entering from the bottom and leaving at the top.
BoardIn :: (area: Rectangle) -> Rectangle {
    wide := cast(float32)board_columns * 16.0
    tall := cast(float32)board_rows * 16.0
    scale := area.width / wide
    if area.height / tall < scale { scale = area.height / tall }
    return Rectangle.{area.x + (area.width - wide * scale) / 2.0,
        area.y + (area.height - tall * scale) / 2.0, wide * scale, tall * scale}
}

AppleFlash :: (session: Session, stage: Rectangle) {
    if game.apple_flash <= 0 { return }
    // A quiet sparkle uses the same clean icon art as the interface.
    if (game.apple_flash / 8) % 2 == 0 { return }
    scale := stage.width / (cast(float32)board_columns * 16.0)
    SvgIcon(session, SvgIconProps.{
        .bounds = Rectangle.{stage.x + cast(float32)(game.apple.x + 3) * scale,
            stage.y + cast(float32)(game.apple.y - 13) * scale, 7.0 * scale, 7.0 * scale},
        .shape = StarIcon.Shape, .color = Color.{255, 227, 116, 220}})
}

// Each portal pair glows in its own colour and breathes slowly, so the two
// rings that belong together are easy to tell apart.
portal_frame: s32;
DrawPortals :: (session: Session, stage: Rectangle) {
    if game.portal_count == 0 { return }
    portal_frame = (portal_frame + 1) % 120
    scale := stage.width / (cast(float32)board_columns * 16.0)
    breath := cast(float32)(ifx portal_frame < 60 then portal_frame else 120 - portal_frame) / 60.0
    for pair: 0..game.portal_count - 1 {
        glow := ifx pair == 0 then Color.{150, 112, 255, 255} else Color.{255, 160, 70, 255}
        core := ifx pair == 0 then Color.{58, 30, 120, 235} else Color.{120, 58, 12, 235}
        for end: 0..1 {
            centre := ifx end == 0 then game.portals[pair].a else game.portals[pair].b
            key := 12000 + cast(u64)pair * 8 + cast(u64)end * 4
            outer := (13.0 + 2.0 * breath) * scale
            inner := 8.0 * scale
            x := stage.x + cast(float32)centre.x * scale
            y := stage.y + cast(float32)centre.y * scale
            unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x - outer, y - outer, outer * 2.0, outer * 2.0},
                    .fill = Color.{glow.r, glow.g, glow.b, cast(u8)(70.0 + 50.0 * breath)}, .radius = outer})
            unused Box(session, BoxProps.{.key = key + 1, .bounds = Rectangle.{x - inner, y - inner, inner * 2.0, inner * 2.0},
                    .fill = core, .border = glow, .radius = inner})
        }
    }
}

// Stone posts mark each open gate throughout the journey. Their tiles and the
// centre opening keep their existing collision data and width.
DrawGatePosts :: (session: Session, stage: Rectangle) {
    half := board_columns / 2
    for gate: 0..1 {
        row := ifx gate == 0 then board_rows - 1 else 0
        centre := game.board[Index(half, row)]
        if centre >= 20 && centre < 128 { continue }
        for side: 0..1 {
            column := half - 1 + cast(s32)side * 2
            Tile(session, 11000 + cast(u64)gate * 2 + cast(u64)side, stage, column, row, 21, Sheet(0))
        }
    }
}

DrawBoard :: (session: Session, stage: Rectangle) {
    fancy_garden = true
    tiles := Sheet(StageOf(game.level))
    sprites := tiles
    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            Tile(session, 100 + cast(u64)at, stage, cast(s32)x, cast(s32)y,
                cast(s32)(game.board[at] & 127), tiles)
            DrawWallEdges(session, 100 + cast(u64)at, stage, cast(s32)x, cast(s32)y,
                cast(s32)game.board[at], game.board[:])
        }
    }
    DrawGatePosts(session, stage)
    DrawPortals(session, stage)
    // A closed gate, the key that opens it or the switch stone that flips it.
    if game.gate >= 0 && !game.gate_open {
        for part: 0..game.gate_span - 1 {
            cell := game.gate + cast(s32)part * game.gate_step
            Sprite(session, 12110 + cast(u64)part, stage, Point.{(cell % board_columns) * 16 + 8, (cell / board_columns) * 16 + 8},
                Rectangle.{(ifx game.gate_step == 1 then 11.0 else 12.0) * 16.0, 64.0, 16.0, 16.0}, sprites)
        }
    }
    if game.key.x >= 0 { Sprite(session, 12101, stage, game.key, Rectangle.{8.0 * 16.0, 64.0, 16.0, 16.0}, sprites) }
    if game.switch_stone.x >= 0 {
        Sprite(session, 12102, stage, game.switch_stone,
            Rectangle.{(ifx game.gate_open then 10.0 else 9.0) * 16.0, 64.0, 16.0, 16.0}, sprites)
    }
    if game.apples > 0 && game.apple.x >= 0 {
        Sprite(session, 1400, stage, game.apple, Rectangle.{0.0, 112.0, 16.0, 16.0}, sprites)
        AppleFlash(session, stage)
    }
    // Keep individual segments readable at the same spacing as the original.
    // Painted art fills its cell, so it needs slimmer bounds than the sprite.
    fade: float32 = ifx game.death_ticks > 0 then cast(float32)game.death_ticks / 20.0 else 1.0
    alpha := cast(u8)(255.0 * fade * fade * (3.0 - 2.0 * fade))
    draw_step: s32 = WORM_DRAW_STEP
    body_size: float32 = ifx Wardrobe.skin != 0 then 12.0 else WORM_BODY_SIZE
    head_size: float32 = ifx Wardrobe.skin != 0 then 17.0 else WORM_HEAD_SIZE
    index := game.length - 1
    while index > 0 {
        column := 4
        from_tail := game.length - 1 - index
        if from_tail < 2 { column = 6 }
        else if from_tail < 8 { column = 5 }
        if alpha > 0 {
            Sprite(session, 2000 + cast(u64)index, stage, game.worm[index],
                Rectangle.{cast(float32)column * 16.0, 48.0, 16.0, 16.0}, sprites, body_size, alpha)
        }
        index -= draw_step
    }
    if game.length > 0 && alpha > 0 {
        Sprite(session, 2000, stage, game.worm[0],
            Rectangle.{cast(float32)game.direction * 16.0, 48.0, 16.0, 16.0}, sprites, head_size, alpha)
    }
    for monster: 0..game.monster_count - 1 {
        creature := game.monsters[monster]
        column := creature.kind - 1
        row: float32 = 32.0
        if creature.kind == 1 { column = 6 + enemy_frame }
        // The animals met after the meadow share row four of every sheet.
        if creature.animal != ANIMAL_CLASSIC { row = 64.0 }
        if creature.animal == ANIMAL_SQUIRREL { column = (creature.timer / 4) % 2 }
        if creature.animal == ANIMAL_HEDGEHOG { column = ifx creature.timer < 0 then 3 else 2 }
        if creature.animal == ANIMAL_FROG { column = ifx creature.timer >= 14 && creature.timer % 14 < 4 then 5 else 4 }
        if creature.animal == ANIMAL_STONE { column = 6 + (creature.timer / 3) % 2 }
        Sprite(session, 6000 + cast(u64)monster, stage, creature.position,
            Rectangle.{cast(float32)column * 16.0, row, 16.0, 16.0}, sprites)
    }
    for particle: 0..99 {
        life := game.particles[particle].life
        if life > 1 && life <= 12 {
            Sprite(session, 7000 + cast(u64)particle, stage, game.particles[particle].position,
                Rectangle.{cast(float32)(life / 2) * 16.0, 160.0, 16.0, 16.0}, sprites)
        }
    }
}

OpenStages :: () {
    BoardSize(COLUMNS, ROWS)
    game.mode = MODE_STAGES
}

// Play the selected layout from its own private override, published board
// or mirror. An explicit editor mode takes precedence over window shape.
PlayBoard :: (level: s32, now: s64, seed: u32, restart: bool, layout: s32 = -1) {
    touch_steering.active = false
    recorded_level = -1
    board: [CELLS]u8
    objects: [CELLS]u8
    portrait := ifx layout < 0 then game_portrait else layout == 1
    apples: s32
    if editor.playtest && editor.own {
        portrait = editor.turned
        for at: 0..CELLS - 1 { board[at] = editor.board[at]; objects[at] = editor.objects[at] }
        apples = editor.apples
    } else {
        Custom.EffectiveBoard(level,board[:],portrait)
        Custom.EffectiveObjects(level,objects[:],portrait)
        apples = Custom.EffectiveApples(level,portrait)
    }
    columns: s32 = ifx portrait then ROWS else COLUMNS
    rows: s32 = ifx portrait then COLUMNS else ROWS
    if restart { LoadLevelData(*game,level,now,board[:],apples,columns,rows,objects[:]) }
    else { StartGameData(*game,level,now,seed,board[:],apples,columns,rows,objects[:]) }
}
StartLevel :: (level: s32, now: s64, seed: u32) { PlayBoard(level, now, seed, false) }
ReloadLevel :: (level: s32, now: s64) {
    layout: s32 = -1
    if editor.playtest { layout = ifx editor.turned then 1 else 0 }
    PlayBoard(level,now,1,true,layout)
}

// Leaving a paused or finished playtest returns to the editor; a normal game
// returns to the stages.
LeavePlay :: () {
    if editor.playtest { EditorResume() }
    else { OpenStages() }
}

// The desktop host's WURM_START=editor entry: straight into the editor,
// facing its all-levels view.
EditorAtStartup :: (level: s32) {
    game.started = true
    editor_everything = true
    editor.browsing = true
    OpenEditor(level)
}

// WURM_START=rewards opens the title with the daily reward chest open.
rewards_at_start: bool;
RewardsAtStartup :: () { rewards_at_start = true }

EditorLevelOpen :: (level: s32) -> bool { return editor_everything || LevelAvailable(level) }
EditorStageOpen :: (stage: s32) -> bool { return EditorLevelOpen(StageFirst(stage)) }
// How many of a landscape's levels are open; unlocking runs in order.
EditorOpenLevels :: (stage: s32) -> s32 {
    open: s32 = 0
    for index: 0..StageLevels(stage) - 1 {
        if EditorLevelOpen(StageFirst(stage) + cast(s32)index) { open = cast(s32)index + 1 }
    }
    return open
}
// The furthest landscape reached; its painting backs the editor's pages, so
// they change as the journey goes on.
EditorFurthestStage :: () -> s32 {
    furthest: s32 = 0
    for stage: 0..STAGE_COUNT - 1 { if EditorStageOpen(cast(s32)stage) { furthest = cast(s32)stage } }
    return furthest
}
OpenEditorHome :: () {
    Progress.Load()
    Own.own_service = Account.Service
    editor_everything = false
    editor.browsing = false
    editor.playtest = false
    editor_page = EDITOR_PAGE_HOME
    game.mode = MODE_EDITOR
}
EditorOpenStages :: () {
    EditorSave()
    if editor.save_failed { return }
    editor.browsing = false
    editor_stage_scroll = 0
    editor_page = EDITOR_PAGE_STAGES
}
EditorOpenStage :: (stage: s32) {
    if !EditorStageOpen(stage) { return }
    editor_stage = stage
    editor.browsing = true
    editor_page = EDITOR_PAGE_EDIT
}
// The level grid of the board's own landscape.
EditorBrowse :: () {
    EditorSave()
    if editor.save_failed { return }
    if editor.own { EditorOpenMine(); return }
    editor_stage = StageOf(editor.level)
    editor.browsing = true
}
// The next open landscape in either direction, for the grid's arrows.
EditorStageStep :: (stage: s32, delta: s32) -> s32 {
    next := stage
    for tries: 1..STAGE_COUNT {
        next = (next + delta + STAGE_COUNT) % STAGE_COUNT
        if EditorStageOpen(next) { return next }
    }
    return stage
}

EditorLoad :: (level: s32) {
    if editor.own {
        own := *Own.own_levels[editor.own_index]
        if !editor.turned {
            for at: 0..CELLS - 1 { editor.board[at] = own.board[at]; editor.objects[at] = own.objects[at] }
        } else if own.has_portrait {
            for at: 0..CELLS - 1 { editor.board[at] = own.portrait[at]; editor.objects[at] = own.portrait_objects[at] }
        } else {
            // An own portrait not made yet mirrors the landscape, as campaign
            // portraits do.
            problems := Mirror.MirrorLevel(level, own.board[:], own.objects[:], true, editor.board[:], editor.objects[:])
            if (problems & Mirror.MIRROR_TOPOLOGY) != 0 {
                GuessPortrait(own.board[:], editor.board[:])
                TurnForward(own.objects[:], editor.objects[:])
            }
        }
        BoardSize(ifx editor.turned then ROWS else COLUMNS,ifx editor.turned then COLUMNS else ROWS)
        editor.apples = own.apples
        return
    }
    Custom.EffectiveBoard(level,editor.board[:],editor.turned)
    Custom.EffectiveObjects(level,editor.objects[:],editor.turned)
    BoardSize(ifx editor.turned then ROWS else COLUMNS,ifx editor.turned then COLUMNS else ROWS)
    editor.apples = Custom.EffectiveApples(level,editor.turned)
}

OpenEditor :: (level: s32) {
    if level < 0 { level = 0 }
    if level >= LEVEL_COUNT { level = LEVEL_COUNT - 1 }
    if game.mode != MODE_EDITOR || editor.level != level || editor.own {
        editor.own = false
        EditorLoad(level)
        editor.dirty = false
    }
    editor.level = level
    editor.reset_armed = false
    editor.save_failed = false
    EditorInput.StrokeReset(*editor.stroke)
    editor_stage = StageOf(level)
    editor_page = EDITOR_PAGE_EDIT
    editor_board_open = true
    game.mode = MODE_EDITOR
}

// T switches independently saved layouts. A layout without its own record
// starts as the mirror of the other; saving keeps it independent.
EditorTurn :: () {
    EditorSave()
    if editor.save_failed { return }
    editor.turned = !editor.turned
    EditorInput.StrokeReset(*editor.stroke)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
}

// Only an edited layout is saved: an untouched one stays the mirror of the
// other orientation, or the published board.
EditorSave :: () {
    if !editor.dirty { return }
    if editor.own {
        own := *Own.own_levels[editor.own_index]
        for at: 0..CELLS - 1 {
            if editor.turned { own.portrait[at] = editor.board[at]; own.portrait_objects[at] = editor.objects[at] }
            else { own.board[at] = editor.board[at]; own.objects[at] = editor.objects[at] }
        }
        if editor.turned { own.has_portrait = true }
        own.apples = editor.apples
        editor.save_failed = !Own.OwnSave()
        editor.dirty = editor.save_failed
        return
    }
    if Custom.SaveCustomLevel(editor.level,editor.board[:],editor.objects[:],editor.apples,editor.turned) {
        editor.dirty = false
        editor.save_failed = false
    } else { editor.save_failed = true }
}

// Deleting the override restores the recovered original in the working copy.
EditorReset :: () {
    if editor.own {
        // An own portrait goes back to mirroring its landscape.
        if editor.turned {
            Own.own_levels[editor.own_index].has_portrait = false
            editor.save_failed = !Own.OwnSave()
        }
        EditorLoad(editor.level)
        editor.dirty = false
        editor.reset_armed = false
        return
    }
    unused Custom.ClearCustomLevel(editor.level,editor.turned)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
}

// R throws the working copy away and takes the saved level back in.
EditorReloadSaved :: () {
    EditorLoad(editor.level)
    editor.dirty = false
}

EditorExit :: () {
    EditorSave()
    if editor.save_failed { return }
    editor.playtest = false
    editor.turned = false
    OpenStages()
}

EditorPlaytest :: (now: s64) {
    EditorSave()
    if editor.save_failed { return }
    editor.playtest = true
    PlayBoard(editor.level, now, cast(u32)(now & 4294967295), false, ifx editor.turned then 1 else 0)
}

// Previous and next skip the levels not reached yet.
EditorSwitch :: (delta: s32) {
    EditorSave()
    if editor.save_failed { return }
    if editor.own {
        count := Own.own_level_count
        if count > 0 { EditorOpenOwn((editor.own_index + delta + count) % count) }
        return
    }
    level := editor.level
    for tries: 1..LEVEL_COUNT {
        level = (level + delta + LEVEL_COUNT) % LEVEL_COUNT
        if EditorLevelOpen(level) { break }
    }
    OpenEditor(level)
}

EditorSetApples :: (delta: s32) {
    editor.apples += delta
    if editor.apples < 1 { editor.apples = 1 }
    if editor.apples > 12 { editor.apples = 12 }
    editor.dirty = true
}

// One palette swatch: the brush value it selects and its sheet art.
PaletteEntry :: struct { brush: s32; source_x: float32; source_y: float32 }
floor_entries: [3]PaletteEntry = PaletteEntry.[
    PaletteEntry.{.brush = 0, .source_x = 0.0, .source_y = 0.0},
    PaletteEntry.{.brush = 1, .source_x = 16.0, .source_y = 0.0},
    PaletteEntry.{.brush = 2, .source_x = 32.0, .source_y = 0.0}];
wall_entries: [4]PaletteEntry = PaletteEntry.[
    PaletteEntry.{.brush = BRUSH_SMART_WALL, .source_x = 160.0, .source_y = 32.0},
    PaletteEntry.{.brush = 20, .source_x = 0.0, .source_y = 16.0},
    PaletteEntry.{.brush = 21, .source_x = 16.0, .source_y = 16.0},
    PaletteEntry.{.brush = 22, .source_x = 32.0, .source_y = 16.0}];
enemy_entries: [6]PaletteEntry = .[
    PaletteEntry.{.brush = 40, .source_x = 96.0, .source_y = 32.0},
    PaletteEntry.{.brush = 41, .source_x = 16.0, .source_y = 32.0},
    PaletteEntry.{.brush = 42, .source_x = 32.0, .source_y = 32.0},
    PaletteEntry.{.brush = 43, .source_x = 48.0, .source_y = 32.0},
    PaletteEntry.{.brush = 44, .source_x = 64.0, .source_y = 32.0},
    PaletteEntry.{.brush = 45, .source_x = 80.0, .source_y = 32.0}];
// One titled run of palette swatches. Returns the content cursor below it.
DrawPalettePart :: (session: Session, key: u64, content: Rectangle, cursor: s32, label: string,
                    entries: []PaletteEntry, tiles: string,
                    pointer_x: float32, pointer_y: float32, pointer_pressed: bool) -> s32 {
    TextLine(session, key, label, Rectangle.{content.x, content.y + cast(float32)cursor, content.width, 22.0}, 13)
    count := cast(s32)entries.count
    for index: 0..count - 1 {
        column := index % 6
        row := index / 6
        bounds := Rectangle.{content.x + cast(float32)(column * 38),
            content.y + cast(float32)(cursor + 26 + row * 38), 34.0, 34.0}
        value := entries[index].brush
        if pointer_pressed && Input.PointInBounds(pointer_x, pointer_y, bounds) { editor.brush = value }
        selected := editor.brush == value
        unused Box(session, BoxProps.{.key = key + 10 + cast(u64)index, .bounds = bounds,
            .fill = ifx selected then Color.{46, 125, 74, 235} else Color.{255, 255, 255, 30}, .radius = 6.0})
        Picture(session, key + 80 + cast(u64)index, tiles, Rectangle.{bounds.x + 1.0, bounds.y + 1.0, 32.0, 32.0},
            Rectangle.{entries[index].source_x, entries[index].source_y, 16.0, 16.0})
    }
    rows := (count + 5) / 6
    return cursor + 26 + rows * 38 + 10
}

// The editor screen: the level as raw tiles on the left, brush palette and
// actions on the right. The held left button paints, the right button
// restores the recovered original tile under it.
// The level selector, Shovey-style: one card per level with its board
// sampled small as the picture, the number as the caption, a green frame on
// saved edits, the current level filled, one click to edit. Back returns.
DrawLevelBrowser :: (session: Session, area: Rectangle) {
    chapter := editor_stage
    unused Box(session, BoxProps.{.key = 8700, .bounds = area, .fill = Appearance.Canvas()})
    // The landscape's painting stays faintly behind its levels.
    unused Image(session, ImageProps.{.key = 8706, .asset_path = ART_STAGE_COVERS, .bounds = area,
        .source = Rectangle.{0.0, cast(float32)chapter * COVER_HEIGHT, 960.0, COVER_HEIGHT},
        .fit = ImageFit.ImageFitCover, .smooth = true, .tint = cast(u32)0xffffff38, .alt_text = StageName(chapter)})
    if Button(session, ButtonProps.{.key = 8703, .bounds = Rectangle.{area.x + 10.0, area.y + 8.0, 88.0, 36.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorOpenStages(); return }
    previous := EditorStageStep(chapter, -1)
    following := EditorStageStep(chapter, 1)
    if Button(session, ButtonProps.{.key = 8704, .bounds = Rectangle.{area.x + area.width - 94.0, area.y + 8.0, 38.0, 36.0},
            .label = Locale.Text("Previous landscape"), .icon_only = true, .icon_shape = "S2rr:M15 6L9 12L15 18",
            .disabled = previous == chapter}) != 0 { editor_stage = previous; return }
    if Button(session, ButtonProps.{.key = 8705, .bounds = Rectangle.{area.x + area.width - 48.0, area.y + 8.0, 38.0, 36.0},
            .label = Locale.Text("Next landscape"), .icon_only = true, .icon_shape = "S2rr:M9 6L15 12L9 18",
            .disabled = following == chapter}) != 0 { editor_stage = following; return }
    CentreText(session, 8701, StageName(chapter),
        Rectangle.{area.x + 102.0, area.y + 10.0, area.width - 204.0, 28.0}, 18)
    first := StageFirst(chapter)
    count := StageLevels(chapter)
    // Cards keep the size of a full landscape; only the open levels show.
    open := EditorOpenLevels(chapter)
    columns: s32 = 8
    for candidate: 4..11 {
        rows := (count + candidate - 1) / candidate
        item_width := (area.width - 16.0 - cast(float32)(candidate - 1) * 8.0) / cast(float32)candidate
        total := cast(float32)rows * (item_width * 0.75 + 30.0) + cast(float32)(rows - 1) * 8.0 + 56.0
        if total <= area.height { columns = cast(s32)candidate; break }
    }
    item_width := (area.width - 16.0 - cast(float32)(columns - 1) * 8.0) / cast(float32)columns
    item_height := item_width * 0.75 + 30.0
    pointer := GamePointer(session)
    for index: 0..open - 1 {
        column := index % columns
        row := index / columns
        bounds := Rectangle.{area.x + 8.0 + cast(float32)column * (item_width + 8.0),
            area.y + 56.0 + cast(float32)row * (item_height + 8.0), item_width, item_height}
        level := first + cast(s32)index
        current := editor_board_open && level == editor.level
        edited := Custom.HasCustomLevel(level,editor.turned)
        if pointer.pressed && Input.PointInBounds(pointer.x, pointer.y, bounds) {
            EditorSave()
            editor.browsing = false
            if editor_pick == EDITOR_PICK_TEMPLATE { EditorNewOwn(StageOf(level), level) }
            else { OpenEditor(level) }
            return
        }
        unused Box(session, BoxProps.{.key = 8710 + cast(u64)index, .bounds = bounds,
            .fill = ifx current then Color.{207, 225, 175, 255} else Appearance.Surface(),
            .border = ifx edited then Color.{120, 220, 150, 255} else Color.{240, 242, 232, 90},
            .radius = 10.0})
        // The picture: the level's rendered preview board.
        thumb := Rectangle.{bounds.x + 6.0, bounds.y + 6.0, bounds.width - 12.0, (bounds.width - 12.0) * 0.75}
        unused Image(session, ImageProps.{.key = 88000 + cast(u64)index,
            .asset_path = PreviewPath(chapter, cast(s32)index + 1,editor.turned),
            .bounds = thumb, .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = "Level board preview"})
        number := FormatInteger(cast(s64)(index + 1), editor_digits[:])
        CentreText(session, 8760 + cast(u64)index, number,
            Rectangle.{bounds.x, bounds.y + bounds.height - 26.0, bounds.width, 22.0}, 15)
        if edited {
            unused Box(session, BoxProps.{.key = 8850 + cast(u64)index,
                .bounds = Rectangle.{bounds.x + bounds.width - 14.0, bounds.y + 6.0, 8.0, 8.0},
                .fill = Color.{120, 220, 150, 255}, .radius = 4.0})
        }
    }
    if open < count {
        rows := (open + columns - 1) / columns
        GameText(session, 8707, "Finish levels to unlock more",
            Rectangle.{area.x + 16.0, area.y + 64.0 + cast(float32)rows * (item_height + 8.0), area.width - 32.0, 24.0}, 15, true, true)
    }
}


// Own levels. New levels join the open collection; the first one is made
// for you and, like every collection, stays private until you share it.
own_open: bool;
editor_notice: string;
mine_list: bool;
mine_scroll: s32;
mine_armed: s32 = -1;
changes_scroll: s32;
changes_armed: s32 = -1;
// Own the array; state.bytes is bound only while drawing, never across moves.
NameField :: struct { bytes: [96]u8; using state: TextFieldState }
mine_name: NameField;
// The collection whose level the editor board shows.
editor_collection: [33]u8;
// Sharing: a collection stays private until you choose Friends or Everyone.
share_choice: s32 = Collections.COLLECTION_PRIVATE;
share_notice: string;
share_poll_at: s64;
community_query: NameField;
community_scroll: s32;
// The key a focused field takes instead of the editor's shortcuts.
editor_field_key: s32;
#if #defined(WURM_PORTABLE) {
    field_api :: #system_library "host_api";
    AppFieldInputHost :: () -> TextFieldInput #foreign field_api;
}
NameFieldSet :: (field: *NameField, text: string) {
    length: s32 = 0
    for byte: text {
        if length >= 95 { break }
        field.bytes[length] = byte
        length += 1
    }
    field.length = length
    field.cursor = length
    field.anchor = length
    field.scroll_x = 0
}
// Draws a name field and applies its edit; true when Enter committed it.
DrawNameField :: (session: Session, field: *NameField, key: u64, bounds: Rectangle, label: string, max_bytes: s32) -> bool {
    input: TextFieldInput
    typed: [256]u8
    if field.focused {
        #if #defined(WURM_PORTABLE) {
            input = AppFieldInputHost()
        } else {
            input = TextFieldInputFor(editor_field_key, KeyboardModifiers(session), TypedTextTake(session, typed[:]))
        }
    }
    // A bounded, valid display copy keeps malformed legacy names editable.
    // Keep the original bytes until an accepted edit; queued paint borrows shown.
    shown: [96]u8
    shown_length: s32
    {
        copied := Utf8.Copy(field.bytes[:field.length], shown[:])
        shown_length = cast(s32)copied.count
    }
    editing: [96]u8
    for index: 0..shown_length - 1 { editing[index] = shown[index] }
    next := field.state
    committed: bool
    {
        state := next
        state.length = shown_length
        state.bytes = shown[:]
        edited := TextField(session, TextFieldStateProps(state, TextFieldProps.{.key = key, .bounds = bounds,
            .label = label, .placeholder = label, .focus_id = cast(s32)key,
            .max_bytes = max_bytes, .max_codepoints = max_bytes, .input = input}))
        state.bytes = editing[:]
        if TextFieldStateApplyResult(*state, edited) {
            if edited.edit.changed {
                for index: 0..state.length - 1 { field.bytes[index] = editing[index] }
            } else { state.length = field.length }
            empty: []u8
            state.bytes = empty
            next = state
        }
        committed = edited.committed
    }
    field.state = next
    return committed
}

EditorCollectionOpened :: () {
    if editor.own && TextUntilNul(Own.own_record[:]) != TextUntilNul(editor_collection[:]) {
        editor.own = false
        editor_board_open = false
    }
    unused CopyInto(editor_collection[:], 0, TextUntilNul(Own.own_record[:]))
    own_open = true
    mine_list = false
    mine_armed = -1
    mine_scroll = 0
    NameFieldSet(*mine_name, TextUntilNul(Own.own_title[:]))
}
// The open collection, else the newest saved one, else a new "My levels".
EditorEnsureCollection :: () -> bool {
    if own_open { return true }
    if Own.OwnRefresh() && Own.own_collection_count > 0 {
        newest := Own.own_collections[Own.own_collection_count - 1]
        if Own.OwnOpen(TextUntilNul(newest.record[:])) { EditorCollectionOpened(); return true }
    }
    return EditorNewCollection()
}
EditorNewCollection :: () -> bool {
    order: s64 = 1
    for index: 0..Own.own_collection_count - 1 {
        if Own.own_collections[index].order >= order { order = Own.own_collections[index].order + 1 }
    }
    Own.OwnNew(Locale.Text("My levels"), order)
    if !Own.OwnSave() { editor_notice = "Your levels could not be saved."; return false }
    unused Own.OwnRefresh()
    EditorCollectionOpened()
    return true
}
own_name: [96]u8;
// A new own level: an empty board inside the landscape's frame, or a copy of
// a level reached (with its own portrait, if it has one).
EditorNewOwn :: (stage: s32, template: s32) {
    editor_notice = ""
    if !EditorEnsureCollection() { return }
    level: LevelJson.WurmLevel
    level.stage = stage
    source := ifx template >= 0 then template else StageFirst(stage)
    Custom.EffectiveBoard(source, level.board[:], false)
    Custom.EffectiveObjects(source, level.objects[:], false)
    level.apples = Custom.EffectiveApples(source, false)
    if template >= 0 {
        if !Custom.IsMirroredLayout(source, true) {
            level.has_portrait = true
            Custom.EffectiveBoard(source, level.portrait[:], true)
            Custom.EffectiveObjects(source, level.portrait_objects[:], true)
        }
    } else {
        for y: 1..ROWS - 2 {
            for x: 1..COLUMNS - 2 { level.board[Custom.At(x, y)] = 0 }
        }
        for at: 0..CELLS - 1 { level.objects[at] = 0 }
    }
    digits: [21]u8
    at := CopyInto(own_name[:], 0, Locale.Text(StageName(stage)))
    at = CopyInto(own_name[:], at, " ")
    at = CopyInto(own_name[:], at, FormatInteger(cast(s64)(Own.own_level_count + 1), digits[:]))
    own_name[at] = 0
    for index: 0..at { level.name[index] = own_name[index] }
    index := Own.OwnAdd(*level)
    if index < 0 { editor_notice = "This collection is full."; EditorOpenMine(); return }
    if !Own.OwnSave() {
        Own.OwnRemove(index)
        editor_notice = "Your levels could not be saved."
        EditorOpenMine()
        return
    }
    EditorOpenOwn(index)
}
EditorOpenOwn :: (index: s32) {
    if index < 0 || index >= Own.own_level_count { return }
    editor.own = true
    editor.own_index = index
    editor.level = StageFirst(Own.own_levels[index].stage)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
    editor.save_failed = false
    editor.browsing = false
    EditorInput.StrokeReset(*editor.stroke)
    editor_stage = StageOf(editor.level)
    editor_page = EDITOR_PAGE_EDIT
    editor_board_open = true
    game.mode = MODE_EDITOR
}
// Back to the board last open: an own level or, in the developer's entry,
// a campaign level.
EditorResume :: () {
    if editor.own { EditorOpenOwn(editor.own_index) }
    else { OpenEditor(editor.level) }
}
EditorOpenMine :: () {
    unused Own.OwnRefresh()
    if !own_open && Own.own_collection_count > 0 { unused EditorEnsureCollection() }
    mine_list = !own_open
    mine_armed = -1
    editor_page = EDITOR_PAGE_MINE
    game.mode = MODE_EDITOR
}
EditorPick :: (pick: s32) {
    editor_pick = pick
    EditorOpenStages()
}
// Campaign levels with a personal layout, landscape then portrait.
EditorChangeCount :: () -> s32 {
    count: s32 = 0
    for level: 0..LEVEL_COUNT - 1 {
        if Custom.HasCustomLevel(cast(s32)level, false) { count += 1 }
        if Custom.HasCustomLevel(cast(s32)level, true) { count += 1 }
    }
    return count
}
EditorChangeAt :: (index: s32, portrait: *bool) -> s32 {
    seen: s32 = 0
    for level: 0..LEVEL_COUNT - 1 {
        for turn: 0..1 {
            if Custom.HasCustomLevel(cast(s32)level, turn == 1) {
                if seen == index { portrait.* = turn == 1; return cast(s32)level }
                seen += 1
            }
        }
    }
    return -1
}
editor_label: [160]u8;
// A player's own words, shown as written rather than translated.
PlainText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = size,
        .wrap = TextWrap.TextWrapNone})
}

// The editor's own title, like the game's: its painting, a heading, and the
// way on to the landscapes or back to the last board.
editor_continue: [64]u8;
DrawEditorHome :: (session: Session, area: Rectangle, now: s64) {
    // Cover fit without a pixel crop, so the half-size copies fit too.
    portrait := area.height > area.width
    unused Box(session, BoxProps.{.key = 40000, .bounds = area, .fill = Color.{34, 66, 39, 255}})
    unused Image(session, ImageProps.{.key = 40001, .asset_path = ifx portrait then ART_EDITOR_TITLE_PORTRAIT else ART_EDITOR_TITLE,
        .bounds = area, .fit = ImageFit.ImageFitCover, .smooth = true,
        .alt_text = "The little worm laying out a hedge maze on a meadow workbench"})
    unused Box(session, BoxProps.{.key = 40002, .bounds = area, .fill = Appearance.ArtworkShade()})
    unused Box(session, BoxProps.{.key = 40003,
        .bounds = Rectangle.{area.x, area.y + area.height - 380.0, area.width, 380.0},
        .fill = Color.{20, 47, 22, 0}, .fill_bottom = Color.{20, 47, 22, 200}, .has_fill_bottom = true})
    if !EditorApp() && Button(session, ButtonProps.{.key = 40004, .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 84.0, 44.0},
            .label = Locale.Text("Back"), .class_name = 11}) != 0 { OpenStages(); return }
    heading_width := area.width - 120.0
    if heading_width > 420.0 { heading_width = 420.0 }
    heading := Rectangle.{area.x + (area.width - heading_width) / 2.0, area.y + 64.0, heading_width, 84.0}
    surface := Appearance.Surface()
    surface.a = 225
    unused Box(session, BoxProps.{.key = 40005, .bounds = heading, .fill = surface, .border = Appearance.Border(), .radius = 18.0})
    CentreText(session, 40006, "Level editor", Rectangle.{heading.x + 8.0, heading.y + 10.0, heading.width - 16.0, 34.0}, 26)
    CentreText(session, 40007, "Make levels of your own.",
        Rectangle.{heading.x + 8.0, heading.y + 48.0, heading.width - 16.0, 24.0}, 15)
    width := area.width - 48.0
    if width > 300.0 { width = 300.0 }
    left := area.x + (area.width - width) / 2.0
    // The column grows upwards from the bottom: My levels, From a level,
    // New level, then Continue when a board is open.
    y := area.y + area.height - 84.0
    changes := ifx editor_everything then 0 else EditorChangeCount()
    if changes > 0 {
        if Button(session, ButtonProps.{.key = 40014, .bounds = Rectangle.{left, y + 26.0, width, 40.0},
                .label = Locale.Text("Campaign changes"), .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            changes_armed = -1; editor_page = EDITOR_PAGE_CHANGES; return
        }
        y -= 52.0
    }
    if editor_everything {
        if Button(session, ButtonProps.{.key = 40015, .bounds = Rectangle.{left, y, width, 52.0},
                .label = Locale.Text("Edit campaign"), .class_name = 13, .pill = true,
                .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorPick(EDITOR_PICK_CAMPAIGN); return }
        y -= 64.0
    }
    half := (width - 10.0) / 2.0
    if Button(session, ButtonProps.{.key = 40013, .bounds = Rectangle.{left, y, half, 52.0},
            .label = Locale.Text("My levels"), .class_name = 13, .pill = true,
            .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorOpenMine(); return }
    if Button(session, ButtonProps.{.key = 40017, .bounds = Rectangle.{left + half + 10.0, y, half, 52.0},
            .label = Locale.Text("Community"), .class_name = 13, .pill = true,
            .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorOpenCommunity(now); return }
    y -= 64.0
    if Button(session, ButtonProps.{.key = 40012, .bounds = Rectangle.{left, y, width, 52.0},
            .label = Locale.Text("From a level"), .class_name = 13, .pill = true,
            .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorPick(EDITOR_PICK_TEMPLATE); return }
    y -= 72.0
    if Button(session, ButtonProps.{.key = 40011, .bounds = Rectangle.{left, y, width, 60.0},
            .label = Locale.Text("New level"), .class_name = 13, .pill = true,
            .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorPick(EDITOR_PICK_BLANK); return }
    y -= 72.0
    resumable := editor_board_open && (ifx editor.own then editor.own_index < Own.own_level_count else EditorLevelOpen(editor.level))
    if resumable {
        at := CopyInto(editor_continue[:], 0, Locale.Text("Continue editing"))
        at = CopyInto(editor_continue[:], at, " · ")
        if editor.own {
            at = CopyInto(editor_continue[:], at, TextUntilNul(Own.own_levels[editor.own_index].name[:]))
        } else {
            digits: [21]u8
            at = CopyInto(editor_continue[:], at, FormatInteger(cast(s64)(editor.level + 1), digits[:]))
        }
        editor_continue[at] = 0
        if Button(session, ButtonProps.{.key = 40010, .bounds = Rectangle.{left, y, width, 60.0},
                .label = TextUntilNul(editor_continue[:]), .class_name = 13, .pill = true,
                .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorResume(); return }
    }
    if editor_notice != "" {
        GameText(session, 40016, editor_notice, Rectangle.{area.x + 16.0, heading.y + heading.height + 12.0, area.width - 32.0, 24.0}, 15, false, true)
    }
}

// Your collections, or the open one: its name, its levels and the ways to
// add more. Every collection is private: only you see it.
DrawEditorMine :: (session: Session, area: Rectangle, now: s64) {
    unused Box(session, BoxProps.{.key = 40400, .bounds = area, .fill = Appearance.Canvas()})
    furthest := EditorFurthestStage()
    unused Image(session, ImageProps.{.key = 40401, .asset_path = ART_STAGE_COVERS, .bounds = area,
        .source = Rectangle.{0.0, cast(float32)furthest * COVER_HEIGHT, 960.0, COVER_HEIGHT},
        .fit = ImageFit.ImageFitCover, .smooth = true, .tint = cast(u32)0xffffff30, .alt_text = StageName(furthest)})
    if Button(session, ButtonProps.{.key = 40402, .bounds = Rectangle.{area.x + 12.0, area.y + 10.0, 84.0, 40.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 {
        mine_name.focused = false
        editor_page = EDITOR_PAGE_HOME
        return
    }
    content_width := area.width - 24.0
    if content_width > 640.0 { content_width = 640.0 }
    left := area.x + (area.width - content_width) / 2.0
    if mine_list || !own_open {
        CentreText(session, 40403, "My levels", Rectangle.{area.x + 104.0, area.y + 14.0, area.width - 208.0, 30.0}, 22)
        if Button(session, ButtonProps.{.key = 40404, .bounds = Rectangle.{left, area.y + 62.0, content_width, 48.0},
                .label = Locale.Text("New collection"), .pill = true, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
            if EditorNewCollection() { mine_name.focused = true }
            return
        }
        list := Rectangle.{left, area.y + 122.0, content_width, area.height - 134.0}
        if Own.own_collection_count == 0 {
            GameText(session, 40405, "No levels yet. Start one with New level.", list, 15, true, true)
            return
        }
        scroller := Scroll(session, ScrollProps.{.key = 40406, .bounds = list,
            .content_height = Own.own_collection_count * 64, .scroll_offset = mine_scroll})
        mine_scroll = scroller.scroll_offset
        if !scroller.opened { return }
        chosen: s32 = -1
        for index: 0..Own.own_collection_count - 1 {
            entry := Own.own_collections[Own.own_collection_count - 1 - index]
            key := cast(u64)(40410 + index * 4)
            bounds := Rectangle.{list.x, scroller.content.y + cast(float32)index * 64.0, list.width, 56.0}
            unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
                .border = Appearance.Border(), .radius = 14.0})
            if Button(session, ButtonProps.{.key = key + 1, .bounds = bounds, .label = TextUntilNul(entry.title[:]),
                    .invisible = true}) != 0 { chosen = cast(s32)(Own.own_collection_count - 1 - index) }
            PlainText(session, key + 2, TextUntilNul(entry.title[:]), Rectangle.{bounds.x + 16.0, bounds.y + 15.0, bounds.width - 120.0, 26.0}, 18)
            GameText(session, key + 3, VisibilityName(entry.visibility), Rectangle.{bounds.x + bounds.width - 100.0, bounds.y + 18.0, 86.0, 22.0}, 14, true)
        }
        unused End(session)
        if chosen >= 0 && Own.OwnOpen(TextUntilNul(Own.own_collections[chosen].record[:])) { EditorCollectionOpened() }
        return
    }
    // The open collection: rename it in place, then its levels.
    if Button(session, ButtonProps.{.key = 40407, .bounds = Rectangle.{area.x + area.width - 168.0, area.y + 10.0, 156.0, 40.0},
            .label = Locale.Text("All collections"), .tone = ButtonTone.ButtonToneNeutral}) != 0 {
        mine_name.focused = false
        unused Own.OwnRefresh()
        mine_list = true
        mine_scroll = 0
        return
    }
    was_focused := mine_name.focused
    committed := DrawNameField(session, *mine_name, 40408, Rectangle.{left, area.y + 60.0, content_width, 52.0},
        Locale.Text("Collection name"), 60)
    if (committed || (was_focused && !mine_name.focused)) && mine_name.length > 0 {
        mine_name.focused = false
        Own.OwnRename(TextView(mine_name.bytes[0:mine_name.length]))
        if !Own.OwnSave() { editor_notice = "Your levels could not be saved." }
    }
    GameText(session, 40409, VisibilityLine(Own.own_visibility), Rectangle.{left + 4.0, area.y + 118.0, content_width - 120.0, 22.0}, 14, true)
    if Account.SharingAvailable() && Own.own_level_count > 0 &&
    Button(session, ButtonProps.{.key = 40420, .bounds = Rectangle.{left + content_width - 104.0, area.y + 112.0, 104.0, 34.0},
            .label = Locale.Text("Share"), .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        mine_name.focused = false
        share_choice = Own.own_visibility
        share_notice = ""
        editor_page = EDITOR_PAGE_SHARE
        return
    }
    buttons_y := area.y + area.height - 60.0
    half := (content_width - 12.0) / 2.0
    if Button(session, ButtonProps.{.key = 40480, .bounds = Rectangle.{left, buttons_y, half, 48.0},
            .label = Locale.Text("New level"), .pill = true, .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorPick(EDITOR_PICK_BLANK); return }
    if Button(session, ButtonProps.{.key = 40481, .bounds = Rectangle.{left + half + 12.0, buttons_y, half, 48.0},
            .label = Locale.Text("From a level"), .pill = true, .tone = ButtonTone.ButtonToneNeutral}) != 0 {
        EditorPick(EDITOR_PICK_TEMPLATE); return
    }
    list := Rectangle.{left, area.y + 148.0, content_width, buttons_y - area.y - 160.0}
    rows := Own.own_level_count + 1
    scroller := Scroll(session, ScrollProps.{.key = 40411, .bounds = list,
        .content_height = rows * 76, .scroll_offset = mine_scroll})
    mine_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    action: s32 = 0
    target: s32 = -1
    if Own.own_level_count == 0 {
        GameText(session, 40412, "No levels yet. Start one with New level.",
            Rectangle.{list.x, scroller.content.y + 12.0, list.width, 24.0}, 15, true, true)
    }
    for index: 0..Own.own_level_count - 1 {
        own := *Own.own_levels[index]
        key := cast(u64)(40500 + index * 10)
        bounds := Rectangle.{list.x, scroller.content.y + cast(float32)index * 76.0, list.width, 68.0}
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = ifx editor.own && editor.own_index == cast(s32)index then ColorFromPacked(Appearance.Palette().selected) else Appearance.Border(),
            .radius = 14.0})
        if Button(session, ButtonProps.{.key = key + 1, .bounds = Rectangle.{bounds.x, bounds.y, bounds.width - 214.0, bounds.height},
                .label = TextUntilNul(own.name[:]), .invisible = true}) != 0 { action = 1; target = cast(s32)index }
        unused Image(session, ImageProps.{.key = key + 2, .asset_path = ART_STAGE_COVERS,
            .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 8.0, 78.0, 52.0},
            .source = Rectangle.{0.0, cast(float32)own.stage * COVER_HEIGHT, 960.0, COVER_HEIGHT},
            .fit = ImageFit.ImageFitCover, .smooth = true, .radius = 10.0, .alt_text = StageName(own.stage)})
        PlainText(session, key + 3, TextUntilNul(own.name[:]), Rectangle.{bounds.x + 96.0, bounds.y + 12.0, bounds.width - 316.0, 24.0}, 17)
        GameText(session, key + 4, StageName(own.stage), Rectangle.{bounds.x + 96.0, bounds.y + 38.0, bounds.width - 316.0, 20.0}, 13, true)
        x := bounds.x + bounds.width - 208.0
        if Button(session, ButtonProps.{.key = key + 5, .bounds = Rectangle.{x, bounds.y + 14.0, 64.0, 40.0},
                .label = Locale.Text("Play"), .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 { action = 2; target = cast(s32)index }
        if Button(session, ButtonProps.{.key = key + 6, .bounds = Rectangle.{x + 70.0, bounds.y + 14.0, 40.0, 40.0},
                .label = Locale.Text("Move up"), .icon_only = true, .icon_shape = "S2rr:M6 15L12 9L18 15",
                .disabled = index == 0}) != 0 { action = 3; target = cast(s32)index }
        if Button(session, ButtonProps.{.key = key + 7, .bounds = Rectangle.{x + 114.0, bounds.y + 14.0, 40.0, 40.0},
                .label = Locale.Text("Move down"), .icon_only = true, .icon_shape = "S2rr:M6 9L12 15L18 9",
                .disabled = cast(s32)index == Own.own_level_count - 1}) != 0 { action = 4; target = cast(s32)index }
        armed := mine_armed == cast(s32)index
        if Button(session, ButtonProps.{.key = key + 8, .bounds = Rectangle.{x + 158.0, bounds.y + 14.0, 44.0, 40.0},
                .label = Locale.Text(ifx armed then "Sure?" else "Delete"), .icon_only = !armed,
                .icon_shape = "S2rr:M6 7L18 7M9 7L9 5L15 5L15 7M8 7L9 19L15 19L16 7",
                .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ifx armed then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            action = 5; target = cast(s32)index
        }
    }
    // The whole collection goes only after a second press.
    delete_bounds := Rectangle.{list.x, scroller.content.y + cast(float32)Own.own_level_count * 76.0 + 8.0, list.width, 44.0}
    if Button(session, ButtonProps.{.key = 40490, .bounds = delete_bounds,
            .label = Locale.Text(ifx mine_armed == -2 then "Sure?" else "Delete collection"),
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ifx mine_armed == -2 then ButtonEmphasis.ButtonEmphasisFilled
                else ButtonEmphasis.ButtonEmphasisSoft}) != 0 { action = 6 }
    unused End(session)
    if action == 1 { EditorOpenOwn(target) }
    else if action == 2 { EditorOpenOwn(target); EditorPlaytest(now) }
    else if action == 3 || action == 4 {
        mine_armed = -1
        if Own.OwnMove(target, ifx action == 3 then -1 else 1) {
            if editor.own && editor.own_index == target { editor.own_index += ifx action == 3 then -1 else 1 }
            else if editor.own && editor.own_index == target + (ifx action == 3 then -1 else 1) { editor.own_index = target }
            if !Own.OwnSave() { editor_notice = "Your levels could not be saved." }
        }
    } else if action == 5 {
        if mine_armed != target { mine_armed = target; return }
        mine_armed = -1
        Own.OwnRemove(target)
        if editor.own {
            if editor.own_index == target { editor_board_open = false; editor.own = false }
            else if editor.own_index > target { editor.own_index -= 1 }
        }
        if !Own.OwnSave() { editor_notice = "Your levels could not be saved." }
    } else if action == 6 {
        if mine_armed != -2 { mine_armed = -2; return }
        mine_armed = -1
        if Own.OwnDelete() {
            own_open = false
            if editor.own { editor_board_open = false; editor.own = false }
            unused Own.OwnRefresh()
            mine_list = true
        } else { editor_notice = "Your levels could not be saved." }
    }
}

// Sharing uses the same publications service and permissions as Shovey:
// Private (the default), Friends or Everyone.
VisibilityName :: (visibility: s32) -> string {
    if visibility == Collections.COLLECTION_PUBLIC { return "Everyone" }
    if visibility == Collections.COLLECTION_FRIENDS { return "Friends" }
    return "Private"
}
VisibilityLine :: (visibility: s32) -> string {
    if visibility == Collections.COLLECTION_PUBLIC { return "Everyone can see it." }
    if visibility == Collections.COLLECTION_FRIENDS { return "Your friends can see it." }
    return "Private: only you can see it."
}
ShareProblem :: (result: s32) -> string {
    if result == Sharing.SHARE_UNAVAILABLE { return "Sharing is not available here." }
    if result == Sharing.SHARE_SIGNED_OUT { return "Sign in to share levels." }
    if result == Sharing.SHARE_OFFLINE { return "You are offline. Try again later." }
    if result == Sharing.SHARE_NOT_FOUND { return "That collection is no longer shared." }
    if result == Sharing.SHARE_TOO_LARGE { return "This collection is too large to share." }
    if result == Sharing.SHARE_BUSY { return "Please wait a moment and try again." }
    return "Sharing was refused."
}
EditorShareStarted :: (result: s32, waiting: string, now: s64) {
    if result == Sharing.SHARE_WAITING { share_notice = waiting; share_poll_at = now + 600 }
    else { share_notice = ShareProblem(result) }
}
// Polls the request in flight about once a second.
EditorSharePump :: (now: s64) {
    if Sharing.share_kind == Sharing.SHARE_IDLE || now < share_poll_at { return }
    share_poll_at = now + 1000
    kind := Sharing.share_kind
    result := Sharing.SharePoll()
    if result == Sharing.SHARE_WAITING { return }
    if result != Sharing.SHARE_OK { share_notice = ShareProblem(result); return }
    if kind == Sharing.SHARE_PUBLISH {
        share_notice = ifx Own.own_visibility == Collections.COLLECTION_PUBLIC then "Shared with everyone." else "Shared with your friends."
    } else if kind == Sharing.SHARE_UNPUBLISH {
        share_notice = "Only you can see it now."
    } else if kind == Sharing.SHARE_FIND {
        share_notice = ifx Sharing.share_result_count == 0 then "No shared collections found." else ""
    } else if kind == Sharing.SHARE_FETCH {
        // The copy is a new private collection of your own; open it.
        unused Own.OwnRefresh()
        EditorCollectionOpened()
        editor_notice = "Added to My levels."
        share_notice = ""
        editor_page = EDITOR_PAGE_MINE
    }
}

// Who may see the open collection, and publishing it for them.
DrawEditorShare :: (session: Session, area: Rectangle, now: s64) {
    EditorSharePump(now)
    unused Box(session, BoxProps.{.key = 43000, .bounds = area, .fill = Appearance.Canvas()})
    waiting := Sharing.share_kind != Sharing.SHARE_IDLE
    if Button(session, ButtonProps.{.key = 43001, .bounds = Rectangle.{area.x + 12.0, area.y + 10.0, 84.0, 40.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 {
        editor_page = EDITOR_PAGE_MINE
        return
    }
    CentreText(session, 43002, "Share collection", Rectangle.{area.x + 104.0, area.y + 14.0, area.width - 208.0, 30.0}, 22)
    width := area.width - 24.0
    if width > 520.0 { width = 520.0 }
    left := area.x + (area.width - width) / 2.0
    PlainText(session, 43003, TextUntilNul(Own.own_title[:]), Rectangle.{left, area.y + 66.0, width, 28.0}, 20)
    GameText(session, 43004, VisibilityLine(Own.own_visibility), Rectangle.{left, area.y + 98.0, width, 22.0}, 14, true)
    // Private, Friends, Everyone.
    labels: [3]string = .["Only you", "Friends", "Everyone"]
    values: [3]s32 = .[Collections.COLLECTION_PRIVATE, Collections.COLLECTION_FRIENDS, Collections.COLLECTION_PUBLIC]
    third := (width - 20.0) / 3.0
    for index: 0..2 {
        chosen := share_choice == values[index]
        if Button(session, ButtonProps.{.key = cast(u64)(43010 + index),
                .bounds = Rectangle.{left + cast(float32)index * (third + 10.0), area.y + 140.0, third, 48.0},
                .label = Locale.Text(labels[index]), .pill = true, .disabled = waiting,
                .tone = ifx chosen then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral,
                .emphasis = ifx chosen then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            share_choice = values[index]
            share_notice = ""
        }
    }
    published := TextUntilNul(Own.own_publication[:]) != ""
    action := ""
    if share_choice == Collections.COLLECTION_PRIVATE {
        if published { action = "Stop sharing" }
    } else {
        action = ifx published then "Update share" else "Share now"
    }
    if action != "" && Button(session, ButtonProps.{.key = 43020, .bounds = Rectangle.{left, area.y + 206.0, width, 52.0},
            .label = Locale.Text(action), .pill = true, .disabled = waiting,
            .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        if share_choice == Collections.COLLECTION_PRIVATE {
            EditorShareStarted(Sharing.ShareUnpublish(), "Sharing…", now)
        } else {
            title: [160]u8
            title[CopyInto(title[:], 0, TextUntilNul(Own.own_title[:]))] = 0
            EditorShareStarted(Sharing.SharePublish(TextUntilNul(title[:]), share_choice), "Sharing…", now)
        }
    }
    if share_notice != "" {
        GameText(session, 43021, share_notice, Rectangle.{left, area.y + 272.0, width, 24.0}, 15, true, true)
    }
}

EditorOpenCommunity :: (now: s64) {
    editor_notice = ""
    community_scroll = 0
    editor_page = EDITOR_PAGE_COMMUNITY
    if !Account.SharingAvailable() { share_notice = ShareProblem(Sharing.SHARE_UNAVAILABLE); return }
    if Sharing.share_kind == Sharing.SHARE_IDLE {
        EditorShareStarted(Sharing.ShareFind(TextView(community_query.bytes[0:community_query.length])), "Searching…", now)
    }
}

// Collections other players shared: newest first, or one player's by name.
// Adding one makes a private copy in My levels.
DrawEditorCommunity :: (session: Session, area: Rectangle, now: s64) {
    EditorSharePump(now)
    unused Box(session, BoxProps.{.key = 43100, .bounds = area, .fill = Appearance.Canvas()})
    waiting := Sharing.share_kind != Sharing.SHARE_IDLE
    if Button(session, ButtonProps.{.key = 43101, .bounds = Rectangle.{area.x + 12.0, area.y + 10.0, 84.0, 40.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 {
        community_query.focused = false
        editor_page = EDITOR_PAGE_HOME
        return
    }
    CentreText(session, 43102, "Community", Rectangle.{area.x + 104.0, area.y + 14.0, area.width - 208.0, 30.0}, 22)
    width := area.width - 24.0
    if width > 640.0 { width = 640.0 }
    left := area.x + (area.width - width) / 2.0
    committed := DrawNameField(session, *community_query, 43103, Rectangle.{left, area.y + 60.0, width - 120.0, 52.0},
        Locale.Text("Player name"), 40)
    search := Button(session, ButtonProps.{.key = 43104, .bounds = Rectangle.{left + width - 110.0, area.y + 62.0, 110.0, 48.0},
            .label = Locale.Text("Search"), .pill = true, .disabled = waiting || !Account.SharingAvailable(),
            .tone = ButtonTone.ButtonToneSuccess, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
    if (committed || search) && !waiting && Account.SharingAvailable() {
        community_query.focused = false
        community_scroll = 0
        EditorShareStarted(Sharing.ShareFind(TextView(community_query.bytes[0:community_query.length])), "Searching…", now)
    }
    top := area.y + 124.0
    if share_notice != "" {
        GameText(session, 43105, share_notice, Rectangle.{left, top, width, 24.0}, 15, true, true)
        top += 32.0
    }
    if waiting { return }
    list := Rectangle.{left, top, width, area.y + area.height - top - 12.0}
    count := Sharing.share_result_count
    if count <= 0 { return }
    scroller := Scroll(session, ScrollProps.{.key = 43106, .bounds = list,
        .content_height = count * 76, .scroll_offset = community_scroll})
    community_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    chosen: s32 = -1
    for index: 0..count - 1 {
        meta := *Sharing.share_results[index]
        key := cast(u64)(43110 + index * 6)
        bounds := Rectangle.{list.x, scroller.content.y + cast(float32)index * 76.0, list.width, 68.0}
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = Appearance.Border(), .radius = 14.0})
        PlainText(session, key + 1, TextUntilNul(meta.title[:]), Rectangle.{bounds.x + 16.0, bounds.y + 10.0, bounds.width - 190.0, 24.0}, 17)
        digits: [21]u8
        line: [128]u8
        at := CopyInto(line[:], 0, FormatInteger(cast(s64)meta.levels, digits[:]))
        at = CopyInto(line[:], at, " · ")
        at = CopyInto(line[:], at, ifx TextUntilNul(meta.alias[:]) != "" then TextUntilNul(meta.alias[:]) else "?")
        line[at] = 0
        PlainText(session, key + 2, TextUntilNul(line[:]), Rectangle.{bounds.x + 16.0, bounds.y + 38.0, bounds.width - 190.0, 20.0}, 13)
        if Button(session, ButtonProps.{.key = key + 3, .bounds = Rectangle.{bounds.x + bounds.width - 168.0, bounds.y + 14.0, 156.0, 40.0},
                .label = Locale.Text("Add to My levels"), .pill = true, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 { chosen = cast(s32)index }
    }
    unused End(session)
    if chosen >= 0 { EditorShareStarted(Sharing.ShareFetch(chosen), "Adding…", now) }
}

// The campaign levels you changed before own levels existed. They still
// play as you made them; Reset brings back the published level.
DrawEditorChanges :: (session: Session, area: Rectangle) {
    unused Box(session, BoxProps.{.key = 40700, .bounds = area, .fill = Appearance.Canvas()})
    if Button(session, ButtonProps.{.key = 40701, .bounds = Rectangle.{area.x + 12.0, area.y + 10.0, 84.0, 40.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { editor_page = EDITOR_PAGE_HOME; return }
    CentreText(session, 40702, "Campaign changes", Rectangle.{area.x + 104.0, area.y + 14.0, area.width - 208.0, 30.0}, 22)
    content_width := area.width - 24.0
    if content_width > 640.0 { content_width = 640.0 }
    left := area.x + (area.width - content_width) / 2.0
    GameText(session, 40703, "These levels play as you changed them. Reset one to play the original again.",
        Rectangle.{left, area.y + 58.0, content_width, 40.0}, 14, true)
    count := EditorChangeCount()
    list := Rectangle.{left, area.y + 104.0, content_width, area.height - 116.0}
    scroller := Scroll(session, ScrollProps.{.key = 40704, .bounds = list,
        .content_height = count * 60, .scroll_offset = changes_scroll})
    changes_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    reset: s32 = -1
    for index: 0..count - 1 {
        portrait: bool
        level := EditorChangeAt(cast(s32)index, *portrait)
        key := cast(u64)(40710 + index * 4)
        bounds := Rectangle.{list.x, scroller.content.y + cast(float32)index * 60.0, list.width, 52.0}
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = Appearance.Border(), .radius = 12.0})
        digits: [21]u8
        at := CopyInto(editor_label[:], 0, Locale.Text(StageName(StageOf(level))))
        at = CopyInto(editor_label[:], at, " ")
        at = CopyInto(editor_label[:], at, FormatInteger(cast(s64)(level - StageFirst(StageOf(level)) + 1), digits[:]))
        at = CopyInto(editor_label[:], at, " · ")
        at = CopyInto(editor_label[:], at, Locale.Text(ifx portrait then "Portrait" else "Landscape"))
        editor_label[at] = 0
        unused Text(session, TextProps.{.key = key + 1, .bounds = Rectangle.{bounds.x + 16.0, bounds.y + 14.0, bounds.width - 140.0, 24.0},
            .text = TextUntilNul(editor_label[:]), .font = 16, .wrap = TextWrap.TextWrapNone})
        armed := changes_armed == cast(s32)index
        if Button(session, ButtonProps.{.key = key + 2, .bounds = Rectangle.{bounds.x + bounds.width - 116.0, bounds.y + 6.0, 108.0, 40.0},
                .label = Locale.Text(ifx armed then "Sure?" else "Reset"), .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ifx armed then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            if armed { reset = cast(s32)index } else { changes_armed = cast(s32)index }
        }
    }
    unused End(session)
    if reset >= 0 {
        portrait: bool
        level := EditorChangeAt(reset, *portrait)
        unused Custom.ClearCustomLevel(level, portrait)
        changes_armed = -1
        if EditorChangeCount() == 0 { editor_page = EDITOR_PAGE_HOME }
    }
}

// One card for each landscape reached, its painting on top. The page itself
// shows the furthest landscape's painting, so it changes with the journey.
DrawEditorStages :: (session: Session, area: Rectangle) {
    furthest := EditorFurthestStage()
    unused Box(session, BoxProps.{.key = 40100, .bounds = area, .fill = Color.{34, 66, 39, 255}})
    unused Image(session, ImageProps.{.key = 40101, .asset_path = ART_STAGE_COVERS, .bounds = area,
        .source = Rectangle.{0.0, cast(float32)furthest * COVER_HEIGHT, 960.0, COVER_HEIGHT},
        .fit = ImageFit.ImageFitCover, .smooth = true, .alt_text = StageName(furthest)})
    unused Box(session, BoxProps.{.key = 40102, .bounds = area, .fill = Appearance.ArtworkShade()})
    if Button(session, ButtonProps.{.key = 40103, .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 84.0, 44.0},
            .label = Locale.Text("Back"), .class_name = 11}) != 0 { editor_page = EDITOR_PAGE_HOME; return }
    title := Rectangle.{area.x + 108.0, area.y + 14.0, area.width - 216.0, 40.0}
    surface := Appearance.Surface()
    surface.a = 225
    unused Box(session, BoxProps.{.key = 40104, .bounds = title, .fill = surface, .radius = 14.0})
    CentreText(session, 40105, ifx editor_pick == EDITOR_PICK_BLANK then "New level" else ifx editor_pick == EDITOR_PICK_TEMPLATE then "From a level" else "Choose landscape",
        Rectangle.{title.x + 8.0, title.y + 6.0, title.width - 16.0, 28.0}, 20)
    shown: [5]s32
    open_count: s32 = 0
    for stage: 0..STAGE_COUNT - 1 {
        if EditorStageOpen(cast(s32)stage) { shown[open_count] = cast(s32)stage; open_count += 1 }
    }
    grid := Rectangle.{area.x + 12.0, area.y + 68.0, area.width - 24.0, area.height - 80.0}
    columns: s32 = ifx grid.width >= 900.0 then 2 else 1
    card_width := (grid.width - cast(float32)(columns - 1) * 12.0) / cast(float32)columns
    if card_width > 560.0 { card_width = 560.0 }
    left := grid.x + (grid.width - card_width * cast(float32)columns - cast(float32)(columns - 1) * 12.0) / 2.0
    picture_height := (card_width - 12.0) / 3.0
    card_height := picture_height + 52.0
    rows := (open_count + columns - 1) / columns
    hint := open_count < STAGE_COUNT
    content := cast(float32)rows * (card_height + 12.0) + (ifx hint then 36.0 else 0.0)
    scroller := Scroll(session, ScrollProps.{.key = 40106, .bounds = grid,
        .content_height = cast(s32)content, .scroll_offset = editor_stage_scroll})
    editor_stage_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    chosen: s32 = -1
    for index: 0..open_count - 1 {
        stage := shown[index]
        key := cast(u64)(40110 + index * 8)
        bounds := Rectangle.{left + cast(float32)(index % columns) * (card_width + 12.0),
            scroller.content.y + cast(float32)(index / columns) * (card_height + 12.0), card_width, card_height}
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = ifx stage == furthest then ColorFromPacked(Appearance.Palette().selected) else Appearance.Border(), .radius = 16.0})
        if Button(session, ButtonProps.{.key = key + 1, .bounds = bounds, .label = Locale.Text(StageName(stage)),
                .invisible = true}) != 0 { chosen = stage }
        unused Image(session, ImageProps.{.key = key + 2,
            .bounds = Rectangle.{bounds.x + 6.0, bounds.y + 6.0, card_width - 12.0, picture_height},
            .asset_path = ART_STAGE_COVERS, .source = Rectangle.{0.0, cast(float32)stage * COVER_HEIGHT, 960.0, COVER_HEIGHT},
            .fit = ImageFit.ImageFitCover, .smooth = true, .radius = 12.0, .alt_text = StageName(stage)})
        GameText(session, key + 3, StageName(stage), Rectangle.{bounds.x + 14.0, bounds.y + picture_height + 16.0, card_width - 110.0, 26.0}, 20)
        digits: [48]u8
        total: [21]u8
        at := CopyInto(digits[:], 0, FormatInteger(cast(s64)EditorOpenLevels(stage), total[:]))
        at = CopyInto(digits[:], at, " / ")
        at = CopyInto(digits[:], at, FormatInteger(cast(s64)StageLevels(stage), total[:]))
        digits[at] = 0
        GameText(session, key + 4, TextUntilNul(digits[:]), Rectangle.{bounds.x + card_width - 96.0, bounds.y + picture_height + 18.0, 82.0, 22.0}, 15, true)
    }
    if hint {
        GameText(session, 40160, "Finish levels to unlock more",
            Rectangle.{grid.x, scroller.content.y + cast(float32)rows * (card_height + 12.0) + 6.0, grid.width, 24.0}, 15, false, true)
    }
    unused End(session)
    if chosen >= 0 && editor_pick == EDITOR_PICK_BLANK { EditorNewOwn(chosen, -1) }
    else if chosen >= 0 { EditorOpenStage(chosen) }
}

DrawEditor :: (session: Session, area: Rectangle, now: s64) {
    if editor_page == EDITOR_PAGE_HOME { DrawEditorHome(session, area, now); return }
    if editor_page == EDITOR_PAGE_STAGES { DrawEditorStages(session, area); return }
    if editor_page == EDITOR_PAGE_MINE { DrawEditorMine(session, area, now); return }
    if editor_page == EDITOR_PAGE_CHANGES { DrawEditorChanges(session, area); return }
    if editor_page == EDITOR_PAGE_SHARE { DrawEditorShare(session, area, now); return }
    if editor_page == EDITOR_PAGE_COMMUNITY { DrawEditorCommunity(session, area, now); return }
    if editor.browsing { DrawLevelBrowser(session, area); return }
    stage_of_level := StageOf(editor.level)
    fancy_garden = true
    tiles := Sheet(stage_of_level)
    panel := Rectangle.{area.x + area.width - EDITOR_PANEL_WIDTH, area.y, EDITOR_PANEL_WIDTH, area.height}
    canvas := Rectangle.{area.x, area.y, area.width - EDITOR_PANEL_WIDTH, area.height}
    // The board keeps whatever orientation EditorLoad or EditorTurn last set.
    stage := BoardIn(canvas)

    pointer := GamePointer(session)
    secondary := GameSecondaryPointer(session)
    stroke := EditorInput.StrokeUpdate(*editor.stroke,pointer,secondary,stage)
    scale := stage.width / (cast(float32)board_columns * 16.0)
    if stroke != 0 {
        cell_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        cell_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(cell_x, cell_y) {
            at := Index(cell_x, cell_y)
            if (stroke & 1) != 0 {
                if editor.brush == BRUSH_SMART_WALL {
                    ApplyWallBrush(editor.board[:], cell_x, cell_y)
                    editor.dirty = true
                } else if editor.board[at] != cast(u8)editor.brush {
                    ApplyFloorBrush(editor.board[:], cell_x, cell_y, cast(u8)editor.brush)
                    editor.dirty = true
                }
            }
            if (stroke & 2) != 0 {
                if editor.objects[at] != 0 {
                    editor.objects[at] = 0
                    editor.dirty = true
                } else {
                    default_board: [CELLS]u8
                    Custom.DefaultBoard(editor.level,default_board[:],editor.turned)
                    original := default_board[at]
                    if editor.board[at] != original {
                        editor.board[at] = original
                        editor.dirty = true
                    }
                }
            }
        }
    }

    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            raw := cast(s32)editor.board[at]
            kind := (raw & 127) - 39
            tile := raw & 127
            if kind >= 1 && kind <= 6 { tile = 0 }
            Tile(session, 5000 + cast(u64)at, stage, cast(s32)x, cast(s32)y, tile, tiles)
            DrawWallEdges(session, 5000 + cast(u64)at, stage, cast(s32)x, cast(s32)y, tile, editor.board[:])
            if kind >= 1 && kind <= 6 {
                Sprite(session, 6200 + cast(u64)at, stage, Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8},
                    Rectangle.{cast(float32)(kind - 1) * 16.0, 32.0, 16.0, 16.0}, tiles)
            }
        }
    }
    // The fixed entrance and exit the game carves at runtime, marked so a
    // level is never drawn without its way in and out. These keys sit below
    // the canvas tile range, which starts at 5000.
    gate_x := stage.x + cast(float32)(board_columns / 2 - 1) * 16.0 * scale
    unused Box(session, BoxProps.{.key = 4998, .bounds = Rectangle.{gate_x,
        stage.y + cast(float32)(board_rows - 1) * 16.0 * scale, 48.0 * scale, 16.0 * scale},
        .fill = Color.{90, 220, 120, 70}})
    unused Box(session, BoxProps.{.key = 4999, .bounds = Rectangle.{gate_x,
        stage.y, 48.0 * scale, 16.0 * scale}, .fill = Color.{240, 90, 90, 70}})
    if !pointer.down && !secondary.down && Input.PointInBounds(pointer.x, pointer.y, stage) {
        hover_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        hover_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(hover_x, hover_y) {
            left := Snap(stage.x + cast(float32)hover_x * 16.0 * scale)
            top := Snap(stage.y + cast(float32)hover_y * 16.0 * scale)
            unused Box(session, BoxProps.{.key = 4997,
                .bounds = Rectangle.{left, top, Snap(stage.x + cast(float32)(hover_x + 1) * 16.0 * scale) - left,
                    Snap(stage.y + cast(float32)(hover_y + 1) * 16.0 * scale) - top},
                .fill = Color.{255, 255, 255, 60}})
        }
    }

    unused Box(session, BoxProps.{.key = 8200, .bounds = panel, .fill = Appearance.Surface()})
    level_text := FormatInteger(cast(s64)(StageNumber(editor.level)), editor_digits[:])
    TextLine(session, 8202, "LEVEL", Rectangle.{panel.x + 8.0, panel.y + 8.0, 50.0, 20.0}, 14)
    TextLine(session, 8203, level_text, Rectangle.{panel.x + 60.0, panel.y + 8.0, 30.0, 20.0}, 14)
    TextLine(session, 8204, StageName(stage_of_level), Rectangle.{panel.x + 110.0, panel.y + 8.0, 90.0, 20.0}, 14)
    if editor.dirty {
        TextLine(session, 8205, "unsaved", Rectangle.{panel.x + 140.0, panel.y + 8.0, 60.0, 20.0}, 13)
    } else if editor.save_failed {
        unused Box(session, BoxProps.{.key = 8206, .bounds = Rectangle.{panel.x + 168.0, panel.y + 6.0, 74.0, 22.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8207, "SAVE FAILED", Rectangle.{panel.x + 170.0, panel.y + 8.0, 72.0, 18.0}, 12)
    }
    unused Box(session, BoxProps.{.key = 8208, .bounds = Rectangle.{panel.x + 8.0, panel.y + 34.0, 40.0, 40.0},
        .fill = Color.{255, 255, 255, 30}, .radius = 8.0})
    Picture(session, 8209, tiles, Rectangle.{panel.x + 9.0, panel.y + 35.0, 38.0, 38.0},
        Rectangle.{cast(float32)(editor.brush % 20) * 16.0, cast(float32)(editor.brush / 20) * 16.0, 16.0, 16.0})
    TextLine(session, 8210, "BRUSH", Rectangle.{panel.x + 56.0, panel.y + 34.0, 70.0, 18.0}, 13)
    brush_text := FormatInteger(cast(s64)editor.brush, brush_digits[:])
    TextLine(session, 8211, brush_text, Rectangle.{panel.x + 56.0, panel.y + 54.0, 40.0, 18.0}, 13)
    if Custom.IsMirroredLayout(editor.level,editor.turned) {
        // A mirror that would lose a passage shows the fallback instead.
        guessed := Custom.MirrorFallback(editor.level,editor.turned)
        TextLine(session,8224,ifx guessed then "Best guess — edit and save" else "Mirrored — edit and save",Rectangle.{panel.x + 8.0,panel.y + 80.0,232.0,20.0},12)
    }
    blocked := LevelBlockages(editor.board[:])
    if blocked != 0 {
        note := "entrance blocked"
        if blocked == 2 { note = "exit blocked" }
        else if blocked == 3 { note = "entry and exit blocked" }
        unused Box(session, BoxProps.{.key = 8212, .bounds = Rectangle.{panel.x + 8.0, panel.y + 80.0, 232.0, 20.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8213, note, Rectangle.{panel.x + 14.0, panel.y + 82.0, 220.0, 16.0}, 12)
    }

    inner := Rectangle.{panel.x + 8.0, panel.y + 104.0, panel.width - 16.0, panel.height - 254.0}
    palette := Scroll(session, ScrollProps.{.key = 8214, .bounds = inner, .content_height = 270,
        .scroll_offset = editor.palette_scroll})
    editor.palette_scroll = palette.scroll_offset
    if palette.opened {
        palette_press := pointer.pressed && Input.PointInBounds(pointer.x,pointer.y,inner)
        cursor := DrawPalettePart(session, 8300, palette.content, 6, "FLOOR", floor_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        cursor = DrawPalettePart(session, 8400, palette.content, cursor, "OBSTACLES", wall_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        cursor = DrawPalettePart(session, 8500, palette.content, cursor, "ENEMIES", enemy_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        unused End(session)
    }

    bottom := panel.y + panel.height - 142.0
    TextLine(session, 8215, "APPLES", Rectangle.{panel.x + 8.0, bottom + 8.0, 64.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8216, .bounds = Rectangle.{panel.x + 76.0, bottom, 36.0, 32.0},
            .label = Locale.Text("Fewer apples"), .icon_shape = "S2rr:M5 12L19 12", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(-1)
    }
    apple_text := FormatInteger(cast(s64)editor.apples, apple_digits[:])
    TextLine(session, 8217, apple_text, Rectangle.{panel.x + 120.0, bottom + 8.0, 28.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8218, .bounds = Rectangle.{panel.x + 152.0, bottom, 36.0, 32.0},
            .label = Locale.Text("More apples"), .icon_shape = "S2rr:M12 5L12 19", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(1)
    }
    if Button(session, ButtonProps.{.key = 8219, .bounds = Rectangle.{panel.x + 8.0, bottom + 40.0, 110.0, 40.0},
            .label = Locale.Text("Save"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorSave() }
    reset_label := ifx editor.reset_armed then "Sure?" else "Reset"
    if Button(session, ButtonProps.{.key = 8220, .bounds = Rectangle.{panel.x + 130.0, bottom + 40.0, 110.0, 40.0},
            .label = reset_label, .tone = ButtonTone.ButtonToneNeutral, .disabled = editor.own && !editor.turned,
            .emphasis = ifx editor.reset_armed then ButtonEmphasis.ButtonEmphasisFilled
                else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        if editor.reset_armed { EditorReset() }
        else { editor.reset_armed = true }
    }
    if Button(session, ButtonProps.{.key = 8221, .bounds = Rectangle.{panel.x + 8.0, bottom + 88.0, 110.0, 40.0},
            .label = Locale.Text("Playtest"), .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorPlaytest(now) }
    if Button(session, ButtonProps.{.key = 8222, .bounds = Rectangle.{panel.x + 130.0, bottom + 88.0, 110.0, 40.0},
            .label = Locale.Text("Title"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorExit() }
}

coin_text: [64]u8;
CoinText :: (amount: s32) -> string {
    digits: [21]u8
    at := CopyInto(coin_text[:], 0, FormatInteger(cast(s64)amount, digits[:]))
    at = CopyInto(coin_text[:], at, " ")
    at = CopyInto(coin_text[:], at, Locale.Text("Coins"))
    coin_text[at] = 0
    return TextUntilNul(coin_text[:])
}

// The chest's card: today's gift and the next days, one icon each, so there
// is always a reason to come back tomorrow. Later days stay a surprise.
reward_day_label: [5][32]u8;
DrawRewardsModal :: (session: Session, area: Rectangle) {
    unused Box(session, BoxProps.{.key = 29620, .bounds = area, .fill = Color.{8, 18, 12, 150}})
    width := area.width - 32.0
    if width > 440.0 { width = 440.0 }
    guest := !Rewards.SignedIn()
    #if #defined(WURM_PORTABLE) {
        // Hosts supply their own sign-in.
        guest = false
    }
    height: float32 = ifx guest then 368.0 else 324.0
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0 + 24.0, width, height}
    // A tap beside the card closes it.
    pointer := GamePointer(session)
    if pointer.pressed && !Input.PointInBounds(pointer.x, pointer.y, card) &&
        !Input.PointInBounds(pointer.x, pointer.y, Rectangle.{card.x + (width - 120.0) / 2.0, card.y - 56.0, 120.0, 64.0}) {
        game.mode = MODE_STAGES
        return
    }
    ready := Rewards.ClaimReady()
    unused Box(session, BoxProps.{.key = 29621, .bounds = card, .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 24.0})
    chest := Rectangle.{card.x + (width - 120.0) / 2.0, card.y - 60.0, 120.0, 120.0}
    if ready { chest.y += RewardBob() }
    RewardIcon(session, 29622, chest, ifx ready then 1 else 0, "Daily rewards")
    if Button(session, ButtonProps.{.key = 29623, .bounds = Rectangle.{card.x + width - 48.0, card.y + 10.0, 38.0, 38.0},
            .label = Locale.Text("Close"), .icon_only = true, .icon_shape = "S2rr:M7 7L17 17M17 7L7 17",
            .tone = ButtonTone.ButtonToneNeutral}) != 0 { game.mode = MODE_STAGES; return }
    CentreText(session, 29624, "Daily rewards", Rectangle.{card.x + 16.0, card.y + 66.0, width - 32.0, 32.0}, 24)
    GameText(session, 29625, ifx ready then "Your gift is ready!" else "Come back tomorrow",
        Rectangle.{card.x + 16.0, card.y + 100.0, width - 32.0, 22.0}, 15, true, true)
    // The next five plan days, the one to claim first.
    gap: float32 = 8.0
    tile_width := (width - 32.0 - gap * 4.0) / 5.0
    for index: 0..4 {
        day := Rewards.Day() + 1 + cast(s32)index
        key := cast(u64)(29630 + index * 8)
        tile := Rectangle.{card.x + 16.0 + cast(float32)index * (tile_width + gap), card.y + 136.0, tile_width, 112.0}
        first := index == 0
        unused Box(session, BoxProps.{.key = key, .bounds = tile,
            // A warm wash keeps the theme's text readable on today's gift.
            .fill = ifx first && ready then Color.{255, 190, 64, 64} else Appearance.Canvas(),
            .border = ifx first then ColorFromPacked(Appearance.Palette().selected) else Appearance.Border(), .radius = 14.0})
        // Today or tomorrow by name, later days by number.
        label := ""
        if first { label = Locale.Text(ifx ready then "Today" else "Tomorrow") }
        else if index == 1 && ready { label = Locale.Text("Tomorrow") }
        else {
            digits: [21]u8
            number := FormatInteger(cast(s64)((day - 1) % Rewards.DAILY_DAYS + 1), digits[:])
            // Each language places the number at its "%".
            pattern := Locale.Text("Day %")
            at: s32 = 0
            for byte: pattern {
                if byte == #char "%" { at = CopyInto(reward_day_label[index][:], at, number) }
                else if at < 31 { reward_day_label[index][at] = byte; at += 1 }
            }
            reward_day_label[index][at] = 0
            label = TextUntilNul(reward_day_label[index][:])
        }
        unused Text(session, TextProps.{.key = key + 1, .bounds = Rectangle.{tile.x + 2.0, tile.y + 6.0, tile.width - 4.0, 18.0},
            .text = label, .font = 12, .align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapNone})
        icon_size: float32 = ifx tile_width < 64.0 then tile_width - 12.0 else 52.0
        icon := Rectangle.{tile.x + (tile.width - icon_size) / 2.0, tile.y + 28.0, icon_size, icon_size}
        skin := Rewards.DaySkin(day)
        amount: s32 = 0
        if skin > 0 {
            Character(session, key + 2, icon, skin, true)
        } else {
            dew := Rewards.DayDew(day)
            amount = ifx dew > 0 then dew else Rewards.DayCoins(day)
            RewardIcon(session, key + 2, icon, ifx dew > 0 then 3 else 2, ifx dew > 0 then "Dew" else "Coins")
        }
        digits: [21]u8
        GameText(session, key + 3, ifx skin > 0 then SkinName(skin) else FormatInteger(cast(s64)amount, digits[:]),
            Rectangle.{tile.x + 2.0, tile.y + 84.0, tile.width - 4.0, 22.0}, ifx skin > 0 then 11 else 17, false, true)
    }
    y := card.y + 262.0
    #if !#defined(WURM_PORTABLE) {
        if guest {
            if Button(session, ButtonProps.{.key = 29670, .bounds = Rectangle.{card.x + 16.0, y, width - 32.0, 36.0},
                    .label = Locale.Text("Sign in to collect Dew"), .icon_shape = DewIcon.Shape,
                    .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 { Account.OpenProfile() }
            y += 44.0
        }
    }
    if Button(session, ButtonProps.{.key = 29671, .bounds = Rectangle.{card.x + 16.0, y, width - 32.0, 52.0},
            .label = Locale.Text(ifx ready then "Claim" else "Come back tomorrow"), .disabled = !ready, .pill = true,
            .tone = ButtonTone.ButtonToneSuccess, .emphasis = ButtonEmphasis.ButtonEmphasisFilled,
            .class_name = 10}) != 0 { unused Rewards.Claim() }
}

LocalPlayerText :: (id: s32, output: []u8) -> string {
    name := *local_names[id]
    at: s32 = 0
    if name.length > 0 {
        for index: 0..name.length - 1 { output[index] = name.bytes[index] }
        at = name.length
    } else {
        digits: [21]u8
        at = CopyInto(output, 0, Locale.Text("Player"))
        at = CopyInto(output, at, " ")
        at = CopyInto(output, at, FormatInteger(cast(s64)(id + 1), digits[:]))
    }
    output[at] = 0
    return TextUntilNul(output)
}
// Every player may keep the plain worm; an owned skin dresses one player.
LocalSkinFree :: (id: s32, skin: s32) -> bool {
    if !Wardrobe.Available(skin) { return false }
    if skin == 0 { return true }
    for other: 0..local_players - 1 {
        if cast(s32)other != id && local_skins[other] == skin { return false }
    }
    return true
}
LocalCycleSkin :: (id: s32, step: s32) {
    skin := local_skins[id]
    for tries: 1..Rewards.SKIN_COUNT {
        skin = (skin + step + Rewards.SKIN_COUNT) % Rewards.SKIN_COUNT
        if LocalSkinFree(id, skin) { local_skins[id] = skin; return }
    }
}
// Player 1 starts in the profile's skin, the others in the next free ones.
// Later visits keep the names and skins chosen before.
OpenLocalSetup :: () {
    if !local_skins_chosen {
        local_skins_chosen = true
        local_skins[0] = Wardrobe.skin
        for id: 1..3 { local_skins[id] = 0; LocalCycleSkin(cast(s32)id, 1) }
    }
    local_round.phase = Local.SETUP
    game.mode = MODE_LOCAL
}
#if !#defined(WURM_PORTABLE) {
    // Draws one player's name field and applies its edit.
    LocalNameField :: (session: Session, id: s32, bounds: Rectangle, key: s32) {
        name := *local_names[id]
        // Only the focused field takes this frame's typing.
        input: TextFieldInput
        typed: [256]u8
        if name.focused { input = TextFieldInputFor(key, KeyboardModifiers(session), TypedTextTake(session, typed[:])) }
        shown: [24]u8
        for index: 0..name.length - 1 { shown[index] = name.bytes[index] }
        placeholder: [48]u8
        digits: [21]u8
        at := CopyInto(placeholder[:], 0, Locale.Text("Player"))
        at = CopyInto(placeholder[:], at, " ")
        at = CopyInto(placeholder[:], at, FormatInteger(cast(s64)(id + 1), digits[:]))
        placeholder[at] = 0
        edited := TextField(session, TextFieldProps.{.key = cast(u64)(30000 + id), .bounds = bounds,
            .value = TextView(shown[0:name.length]), .label = Locale.Text("Name"),
            .placeholder = TextUntilNul(placeholder[:]), .cursor = name.cursor, .anchor = name.anchor,
            .scroll_x = name.scroll_x, .focused = name.focused, .focus_id = 30000 + id,
            .max_bytes = 16, .max_codepoints = 16, .input = input})
        if edited.edit.changed {
            start := edited.edit.start; end := edited.edit.end
            replacement := edited.edit.replacement
            if start >= 0 && end >= start && end <= name.length &&
            cast(s64)(name.length - (end - start)) + replacement.count <= 16 {
                joined: [48]u8
                length: s32 = 0
                for index: 0..start - 1 { joined[length] = name.bytes[index]; length += 1 }
                for byte: replacement { joined[length] = byte; length += 1 }
                for index: end..name.length - 1 { joined[length] = name.bytes[index]; length += 1 }
                for index: 0..length - 1 { name.bytes[index] = joined[index] }
                name.length = length
            }
        }
        name.cursor = edited.cursor
        name.anchor = edited.anchor
        name.scroll_x = edited.scroll_x
        name.focused = edited.focused
    }
}
LocalControls :: (id: s32) -> string {
    if id == 0 { return "Arrow keys" }
    if id == 1 { return "W A S D" }
    if id == 2 { return "I J K L" }
    return "Numpad 8 4 5 6"
}
LocalColour :: (id: s32) -> u32 {
    colours: [4]u32 = .[0xffffffff, 0xaaffddff, 0xaacfffff, 0xffaaccff]
    return colours[id]
}
LocalKey :: (key: s32, now: s64) {
    if key == 77 || key == 109 { ToggleSound(); return }
    if key == Input.KeyEscape || key == 32 {
        if local_round.phase == Local.PLAYING { local_round.phase = Local.PAUSED }
        else if local_round.phase == Local.PAUSED { local_round.phase = Local.PLAYING; local_round.next_step = now + 44 }
    } else { unused Local.Input(*local_round, key) }
}
DrawLocalPiece :: (session: Session, key: u64, stage: Rectangle, at: Point, id: s32, head: bool, direction: s32) {
    scale := stage.width / 640.0
    skin := local_skins[id]
    size: float32 = ifx head then (ifx skin > 0 then 17.0 else 19.0) else 16.5
    bounds := Rectangle.{stage.x + (cast(float32)at.x - size / 2.0) * scale,
        stage.y + (cast(float32)at.y - size / 2.0) * scale, size * scale, size * scale}
    if bounds.y < stage.y || bounds.y + bounds.height > stage.y + stage.height { return }
    if skin > 0 {
        if !head { bounds.x += 2.25 * scale; bounds.y += 2.25 * scale; bounds.width = 12.0 * scale; bounds.height = bounds.width }
        Character(session, key, bounds, skin, head, direction)
        return
    }
    source := Rectangle.{cast(float32)(ifx head then direction else 4) * 32.0, 96.0, 32.0, 32.0}
    unused Image(session, ImageProps.{.key = key, .asset_path = Sheet(0), .bounds = bounds,
        .source = source, .tint = LocalColour(id), .smooth = true, .alt_text = Locale.Text("Player")})
}
DrawLocal :: (session: Session, area: Rectangle, key: s32, now: s64) {
    BoardSize(COLUMNS, ROWS)
    unused Box(session, BoxProps.{.key = 31000, .bounds = area, .fill = Appearance.Canvas()})
    if local_round.phase == Local.SETUP {
        // A focused name takes the typing; Enter or Escape only leave it.
        editing := false
        for id: 0..local_players - 1 { if local_names[id].focused { editing = true } }
        if key == Input.KeyEscape && !editing { OpenStages(); return }
        PageHeading(session, area, "Local multiplayer")
        CentreText(session, 31001, "Players", Rectangle.{area.x + 16.0, area.y + 82.0, area.width - 32.0, 30.0}, 20)
        for count: 2..4 {
            digits: [21]u8
            x := area.x + area.width / 2.0 - 94.0 + cast(float32)(count - 2) * 64.0
            if Button(session, ButtonProps.{.key = cast(u64)(31010 + count), .bounds = Rectangle.{x, area.y + 124.0, 60.0, 44.0},
                    .label = FormatInteger(count, digits[:]), .selected = local_players == count}) != 0 { local_players = cast(s32)count }
        }
        // One row a player: name, skin and keys. Narrow windows drop the
        // skin's name before anything else.
        wide := area.width >= 760.0
        row_width: float32 = ifx wide then 712.0 else 560.0
        if row_width > area.width - 32.0 { row_width = area.width - 32.0 }
        left := area.x + (area.width - row_width) / 2.0
        field_width: float32 = ifx row_width >= 560.0 then 200.0 else 150.0
        for index: 0..local_players - 1 {
            id := cast(s32)index
            if !LocalSkinFree(id, local_skins[id]) { local_skins[id] = 0 }
            y := area.y + 184.0 + cast(float32)index * 60.0
            #if !#defined(WURM_PORTABLE) {
                LocalNameField(session, id, Rectangle.{left, y, field_width, 44.0}, key)
            } else {
                name: [48]u8
                GameText(session, cast(u64)(31020 + id), LocalPlayerText(id, name[:]), Rectangle.{left, y + 8.0, field_width, 28.0}, 18)
            }
            x := left + field_width + 12.0
            if Button(session, ButtonProps.{.key = cast(u64)(30010 + id), .bounds = Rectangle.{x, y, 40.0, 44.0},
                    .label = Locale.Text("Previous skin"), .icon_only = true, .icon_shape = "S2rr:M15 6L9 12L15 18"}) != 0 { LocalCycleSkin(id, -1) }
            CharacterPreview(session, cast(u64)(30100 + id * 32), Rectangle.{x + 46.0, y, 96.0, 44.0}, local_skins[id])
            if Button(session, ButtonProps.{.key = cast(u64)(30020 + id), .bounds = Rectangle.{x + 148.0, y, 40.0, 44.0},
                    .label = Locale.Text("Next skin"), .icon_only = true, .icon_shape = "S2rr:M9 6L15 12L9 18"}) != 0 { LocalCycleSkin(id, 1) }
            x += 200.0
            if wide {
                GameText(session, cast(u64)(30030 + id), SkinName(local_skins[id]), Rectangle.{x, y + 10.0, 140.0, 26.0}, 16, true)
                x += 148.0
            }
            GameText(session, cast(u64)(31030 + id), LocalControls(id), Rectangle.{x, y + 10.0, left + row_width - x, 26.0}, 16)
        }
        CentreText(session, 31040, "Last worm wins. Everyone enters from the bottom.", Rectangle.{area.x + 16.0, area.y + area.height - 120.0, area.width - 32.0, 26.0}, 15)
        if Button(session, ButtonProps.{.key = 31041,
                .bounds = Rectangle.{area.x + (area.width - 240.0) / 2.0, area.y + area.height - 72.0, 240.0, 48.0},
                .label = Locale.Text("Start round"), .class_name = 10}) != 0 || (key == Input.KeyEnter && !editing) {
            unused Local.Start(*local_round, local_players, now, cast(u32)(now & 4294967295))
        }
        return
    }
    native_keys := false
    first := key
    if native_keys_ready {
        next := native_next_key()
        if next != 0 { native_keys = true; first = next }
    }
    LocalKey(first, now)
    #if !#defined(WURM_PORTABLE) {
        for pending: 0..31 {
            next := KeyboardTake(session)
            if native_keys { next = native_next_key() }
            if next == 0 { break }
            LocalKey(next, now)
        }
    }
    Local.Advance(*local_round, now)
    header := Rectangle.{area.x, area.y, area.width, 72.0}
    for id: 0..local_round.count - 1 {
        name: [48]u8
        width := (area.width - 100.0) / cast(float32)local_round.count
        x := header.x + 8.0 + cast(float32)id * width
        GameText(session, cast(u64)(31100 + id), LocalPlayerText(cast(s32)id, name[:]), Rectangle.{x, header.y + 6.0, width - 8.0, 24.0}, 16)
        score: [21]u8
        GameText(session, cast(u64)(31110 + id), ifx local_round.players[id].alive then FormatInteger(cast(s64)local_round.players[id].score, score[:]) else "Out",
            Rectangle.{x, header.y + 34.0, width - 8.0, 24.0}, 16, !local_round.players[id].alive)
    }
    if Button(session, ButtonProps.{.key = 31120, .bounds = Rectangle.{area.x + area.width - 88.0, area.y + 14.0, 76.0, 42.0},
            .label = Locale.Text("Pause"), .disabled = local_round.phase != Local.PLAYING}) != 0 {
        local_round.phase = Local.PAUSED
    }
    stage := BoardIn(Rectangle.{area.x, area.y + 72.0, area.width, area.height - 72.0})
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 {
            tile: s32 = ifx x == 0 || x == COLUMNS - 1 || y == 0 || y == ROWS - 1 then 20 else 0
            if y == ROWS - 1 {
                for id: 0..local_round.count - 1 {
                    column := COLUMNS * (cast(s32)id + 1) / (local_round.count + 1)
                    // An open entrance has rock posts beside it, as in a level.
                    if local_round.players[id].worm[local_round.players[id].length - 1].y >= (ROWS - 1) * 16 {
                        if x == column { tile = 0 }
                        else if x == column - 1 || x == column + 1 { tile = 21 }
                    }
                }
            }
            Tile(session, cast(u64)(31200 + y * COLUMNS + x), stage, cast(s32)x, cast(s32)y, tile, Sheet(0))
        }
    }
    Sprite(session, 33000, stage, local_round.apple, Rectangle.{0.0,112.0,16.0,16.0}, Sheet(0))
    for id: 0..local_round.count - 1 {
        player := *local_round.players[id]
        if !player.alive { continue }
        index := player.length - 1
        while index > 0 {
            DrawLocalPiece(session, cast(u64)(34000 + id * 1100 + index), stage, player.worm[index], cast(s32)id, false, player.direction)
            index -= 3
        }
        DrawLocalPiece(session, cast(u64)(34000 + id * 1100), stage, player.worm[0], cast(s32)id, true, player.direction)
    }
    if local_round.phase == Local.PAUSED || local_round.phase == Local.FINISHED {
        panel := Rectangle.{area.x + (area.width - 300.0) / 2.0, area.y + (area.height - 236.0) / 2.0, 300.0, 236.0}
        unused Box(session, BoxProps.{.key = 39000, .bounds = panel, .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 18.0})
        title := ifx local_round.phase == Local.PAUSED then "Paused" else ifx local_round.winner < 0 then "Draw" else "Winner"
        CentreText(session, 39001, title, Rectangle.{panel.x + 12.0, panel.y + 14.0, 276.0, 32.0}, 24)
        if local_round.phase == Local.FINISHED && local_round.winner >= 0 {
            name: [48]u8
            CentreText(session, 39002, LocalPlayerText(local_round.winner, name[:]), Rectangle.{panel.x + 12.0, panel.y + 52.0, 276.0, 28.0}, 20)
        }
        if Button(session, ButtonProps.{.key = 39003, .bounds = Rectangle.{panel.x + 16.0, panel.y + 100.0, 268.0, 48.0},
                .label = Locale.Text(ifx local_round.phase == Local.PAUSED then "Resume" else "Play again"), .class_name = 10}) != 0 {
            if local_round.phase == Local.PAUSED { local_round.phase = Local.PLAYING; local_round.next_step = now + 44 }
            else { unused Local.Start(*local_round, local_players, now, cast(u32)(now & 4294967295)) }
        }
        if Button(session, ButtonProps.{.key = 39004, .bounds = Rectangle.{panel.x + 16.0, panel.y + 164.0, 268.0, 48.0},
                .label = Locale.Text("Back to title"), .class_name = 11}) != 0 { OpenStages() }
    }
}

// Play starts a full run; Continue replays the furthest unlocked level.
// Return 1 for Play, 2 for Continue, 3 for levels, 4 for the editor.
continue_label: [48]u8;
DrawTitle :: (session: Session, area: Rectangle, key: s32, play_button: bool = true) -> s32 {
    portrait := area.height > area.width
    artwork := ifx portrait then ART_TITLE_PORTRAIT else ART_TITLE
    art_bounds := area
    source: Rectangle
    // Wide landscape crops the lower grass first, preserving the logo.
    if !portrait && area.width > area.height * 1.6 {
        source = Rectangle.{0.0, 0.0, 1536.0, 1536.0 * area.height / area.width}
    }
    unused Box(session, BoxProps.{.key = 800, .bounds = area, .fill = Color.{34, 66, 39, 255}})
    unused Image(session, ImageProps.{.key = 801, .asset_path = artwork, .bounds = art_bounds, .source = source,
        .fit = ImageFit.ImageFitCover, .smooth = true,
        .alt_text = "Apfelwurm: a cheerful worm and an apple, from the garden into the forest"})
    unused Box(session, BoxProps.{.key = 803, .bounds = area, .fill = Appearance.ArtworkShade()})
    // The artwork keeps this lower strip clear for the real interactive button.
    unused Box(session, BoxProps.{.key = 802,
        .bounds = Rectangle.{area.x, area.y + area.height - 140.0, area.width, 140.0},
        .fill = Color.{20, 47, 22, 0}, .fill_bottom = Color.{20, 47, 22, 170}, .has_fill_bottom = true})
    if !play_button { return 0 }
    Progress.Load()
    TitleActions(session, area)
    footer_width := (area.width - 40.0) / 2.0
    if footer_width > 164.0 { footer_width = 164.0 }
    footer_x := area.x + (area.width - footer_width * 2.0 - 12.0) / 2.0
    if Button(session, ButtonProps.{.key = 810,
            .bounds = Rectangle.{footer_x, area.y + area.height - 56.0, footer_width, 40.0},
            .label = Locale.Text("Choose level"), .pill = true, .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 || key == 76 || key == 108 { return 3 }
    #if !#defined(WURM_CRAZYGAMES) {
        if Button(session, ButtonProps.{.key = 811,
                .bounds = Rectangle.{footer_x + footer_width + 12.0, area.y + area.height - 56.0, footer_width, 40.0},
                .label = Locale.Text("Level editor"), .pill = true, .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { return 4 }
    }
    width := area.width - 48.0
    if width > 280.0 { width = 280.0 }
    if Progress.unlocked > 0 {
        digits: [21]u8
        at := CopyInto(continue_label[:], 0, "Continue · Level ")
        at = CopyInto(continue_label[:], at, FormatInteger(cast(s64)(Progress.unlocked + 1), digits[:]))
        continue_label[at] = 0
        if Button(session, ButtonProps.{.key = 809,
                .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + area.height - 202.0, width, 60.0},
                .label = TextUntilNul(continue_label[:]), .class_name = 13, .pill = true,
                .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 || key == 67 || key == 99 { return 2 }
    }
    clicked := Button(session, ButtonProps.{.key = 808,
        .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + area.height - 128.0, width, 60.0},
        .label = ifx Progress.unlocked > 0 then "Play from start" else "Play", .class_name = 13,
        .icon_shape = "F:M8 5L19 12L8 19Z", .pill = true,
        .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
        .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
    return ifx clicked || key == Input.KeyEnter || key == 32 then 1 else 0
}

recorded_level: s32 = -1;
// Reload the current run without resetting the score or lives it carried in.
StartRun :: (now: s64) {
    Progress.Load()
    StartLevel(Progress.level, now, cast(u32)(now & 4294967295))
    game.lives = Progress.lives
    game.score = Progress.score
}
requested_level: s32;
StartChosenRun :: (now: s64) {
    if !Progress.Select(requested_level, Wardrobe.MountainsAvailable()) { return }
    StartRun(now)
    if Portal.Guest() {
        game.mode = MODE_PLAYING
        game.next_step = now + TickInterval(game.level)
        touch_steering.active = false
    }
}
PlaySelected :: (level: s32, now: s64) -> bool {
    Progress.Load()
    if !LevelAvailable(level) { return false }
    requested_level = level
    if Portal.Guest() && !Controls.Chosen() { unused Controls.SetPad(false) }
    if Controls.Chosen() || KeyboardOnly() || Portal.Guest() { StartChosenRun(now) }
    else { AskControls() }
    return true
}
Play :: (now: s64, from_unlocked: bool = false) {
    Progress.Load()
    unused PlaySelected(ifx from_unlocked then Progress.unlocked else 0, now)
}

level_chapter: s32;
mountains_confirm: bool;
LevelAvailable :: (level: s32) -> bool {
    if level < 0 || level >= LEVEL_COUNT { return false }
    // A bought Mountains chapter opens whole; portal copies unlock it level by level.
    if level >= 160 && !Portal.Guest() { return Wardrobe.MountainsAvailable() }
    return level <= Progress.unlocked
}
level_scroll: s32;
level_label: [32]u8;
LevelLabel :: (level: s32) -> string {
    digits: [21]u8
    at := CopyInto(level_label[:], 0, "Level ")
    at = CopyInto(level_label[:], at, FormatInteger(cast(s64)(level + 1), digits[:]))
    level_label[at] = 0
    return TextUntilNul(level_label[:])
}
OpenLevels :: () {
    Progress.Load()
    level_chapter = StageOf(Progress.unlocked)
    level_scroll = 0
    game.mode = MODE_LEVELS
    touch_steering.active = false
}
DrawLevels :: (session: Session, area: Rectangle, now: s64) {
    if Button(session, ButtonProps.{.key = 26001,
            .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 88.0, 48.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { OpenStages(); return }
    GameText(session, 26002, "Choose level", Rectangle.{area.x + 112.0, area.y + 20.0, area.width - 124.0, 32.0}, 24)
    if Button(session, ButtonProps.{.key = 26003,
            .bounds = Rectangle.{area.x + 12.0, area.y + 72.0, 48.0, 48.0},
            .label = Locale.Text("Previous landscape"), .icon_only = true, .icon_shape = "S2rr:M15 6L9 12L15 18",
            .disabled = level_chapter == 0}) != 0 { level_chapter -= 1; level_scroll = 0 }
    if Button(session, ButtonProps.{.key = 26004,
            .bounds = Rectangle.{area.x + area.width - 60.0, area.y + 72.0, 48.0, 48.0},
            .label = Locale.Text("Next landscape"), .icon_only = true, .icon_shape = "S2rr:M9 6L15 12L9 18",
            .disabled = level_chapter == STAGE_COUNT - 1}) != 0 { level_chapter += 1; level_scroll = 0 }
    GameText(session, 26005, StageName(level_chapter), Rectangle.{area.x + 68.0, area.y + 72.0, area.width - 136.0, 26.0}, 20, false, true)
    if level_chapter != 4 {
        GameText(session, 26006, "Finish levels to unlock more", Rectangle.{area.x + 64.0, area.y + 100.0, area.width - 128.0, 20.0}, 12, true, true)
    }
    grid := Rectangle.{area.x + 12.0, area.y + 132.0, area.width - 24.0, area.height - 144.0}
    if level_chapter == 4 && !Wardrobe.MountainsAvailable() {
        cover := Rectangle.{grid.x, grid.y, grid.width, grid.height - 64.0}
        unused Image(session, ImageProps.{.key = 26008, .asset_path = ART_MOUNTAINS, .bounds = cover,
            .fit = ImageFit.ImageFitCover, .smooth = true, .radius = 16.0, .alt_text = Locale.Text("Mountains")})
        pending := TextUntilNul(Wardrobe.status[:]) == "pending"
        signin := Progress.owner[0] == 0 || TextUntilNul(Wardrobe.status[:]) == "signin"
        if mountains_confirm {
            if Button(session, ButtonProps.{.key = 26009, .bounds = Rectangle.{grid.x, grid.y + grid.height - 52.0, grid.width * 0.5 - 6.0, 44.0},
                .label = Locale.Text(ifx signin then "Sign in" else ifx pending then "Please wait…" else "Confirm purchase"), .disabled = pending && !signin}) != 0 {
                if signin { Account.OpenProfile() }
                else { unused Account.Service("entity.game-shop", "wurm.mountains"); Wardrobe.poll_at = 0 }
            }
            if Button(session, ButtonProps.{.key = 26010, .bounds = Rectangle.{grid.x + grid.width * 0.5 + 6.0, grid.y + grid.height - 52.0, grid.width * 0.5 - 6.0, 44.0},
                .label = Locale.Text("Cancel"), .disabled = pending}) != 0 { mountains_confirm = false }
            GameText(session, 26011, "20 Dew", Rectangle.{grid.x + 12.0, grid.y + 12.0, grid.width - 24.0, 32.0}, 24, false, true)
            if TextUntilNul(Wardrobe.status[:]) == "failed" || TextUntilNul(Wardrobe.status[:]) == "insufficient" {
                GameText(session, 26012, "Purchase not confirmed. Check your Dew and retry.", Rectangle.{grid.x + 12.0, grid.y + 52.0, grid.width - 24.0, 48.0}, 12, true, true)
            }
        } else if Button(session, ButtonProps.{.key = 26009, .bounds = Rectangle.{grid.x, grid.y + grid.height - 52.0, grid.width, 44.0},
            .label = "20 Dew"}) != 0 { mountains_confirm = true }
        Wardrobe.poll_at = 0
        return
    }
    columns: s32 = ifx grid.width < 560.0 then 2 else ifx grid.width < 900.0 then 3 else 4
    width := (grid.width - 16.0 - cast(float32)(columns - 1) * 12.0) / cast(float32)columns
    height := (width - 16.0) * (ifx game_portrait then 4.0 / 3.0 else 0.75) + 44.0
    count := StageLevels(level_chapter)
    rows := (count + columns - 1) / columns
    scroller := Scroll(session, ScrollProps.{.key = 26007, .bounds = grid,
        .content_height = cast(s32)(cast(float32)rows * (height + 10.0)), .scroll_offset = level_scroll})
    level_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    chosen: s32 = -1
    for index: 0..count - 1 {
        level := StageFirst(level_chapter) + cast(s32)index
        bounds := Rectangle.{scroller.content.x + cast(float32)(index % columns) * (width + 12.0),
            scroller.content.y + cast(float32)(index / columns) * (height + 10.0), width, height}
        locked := !LevelAvailable(level)
        current := level == Progress.unlocked
        key := cast(u64)27000 + cast(u64)level * 10
        label := LevelLabel(level)
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = ifx current then ColorFromPacked(Appearance.Palette().selected) else Appearance.Border(), .radius = 14.0})
        if Button(session, ButtonProps.{.key = key + 1, .bounds = bounds, .label = ifx locked then Locale.Text("Locked") else label,
                .detail = ifx Progress.Completed(level) then Locale.Text("Completed") else "", .disabled = locked,
                .invisible = true}) != 0 { chosen = level }
        if locked {
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + (width - 30.0) / 2.0,
                    bounds.y + (height - 30.0) / 2.0, 30.0, 30.0},
                .shape = LockIcon.Shape, .color = Appearance.Border()})
        } else {
            unused Image(session, ImageProps.{.key = key + 2,
                .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 8.0, width - 16.0, height - 44.0},
                .asset_path = PreviewPath(level_chapter, cast(s32)index + 1, game_portrait),
                .fit = ImageFit.ImageFitContain, .smooth = true, .radius = 8.0, .alt_text = "Level board preview"})
            GameText(session, key + 3, label, Rectangle.{bounds.x + 8.0, bounds.y + height - 30.0, width - 16.0, 22.0}, 15, false, true)
            if Progress.Completed(level) {
                SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + width - 28.0, bounds.y + height - 29.0, 18.0, 18.0},
                    .shape = "S2rr:M5 12L10 17L20 6", .color = ColorFromPacked(Appearance.Palette().selected)})
            }
        }
    }
    unused End(session)
    if chosen >= 0 { unused PlaySelected(chosen, now) }
}

controls_previous_mode: s32 = MODE_STAGES;
AskControls :: () {
    controls_previous_mode = game.mode
    game.mode = MODE_CONTROLS
    touch_steering.active = false
}
ChooseControls :: (pad: bool, now: s64) {
    unused Controls.SetPad(pad)
    PreferencesChanged()
    touch_steering.active = false
    if controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS { StartChosenRun(now) }
    else { game.mode = controls_previous_mode; game.next_step = now + TickInterval(game.level) }
}
DrawControls :: (session: Session, area: Rectangle, now: s64) {
    unused Box(session, BoxProps.{.key = 23000, .bounds = area, .fill = Color.{17, 38, 27, 175}})
    width := area.width - 24.0
    if width > 560.0 { width = 560.0 }
    height: float32 = ifx area.height < 400.0 then 248.0 else 342.0
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    unused Box(session, BoxProps.{.key = 23001, .bounds = card, .fill = Appearance.Surface(), .radius = 24.0})
    CentreText(session, 23002, "How do you want to move?", Rectangle.{card.x + 12.0, card.y + 18.0, width - 24.0, 28.0}, 20)
    CentreText(session, 23003, "Change this later in Pause > Controls.", Rectangle.{card.x + 12.0, card.y + 50.0, width - 24.0, 22.0}, 13)
    tile_width := (width - 42.0) / 2.0
    tile_height := height - 96.0
    for choice: 0..1 {
        tile := Rectangle.{card.x + 14.0 + cast(float32)choice * (tile_width + 14.0), card.y + 80.0, tile_width, tile_height}
        unused Box(session, BoxProps.{.key = 23010 + cast(u64)choice, .bounds = tile,
            .fill = Appearance.Canvas(), .border = Appearance.Border(), .radius = 16.0})
        art_height := tile.height - 56.0
        side := art_height - 12.0
        if side > tile.width - 16.0 { side = tile.width - 16.0 }
        square := Rectangle.{tile.x + (tile.width - side) / 2.0, tile.y + (art_height - side) / 2.0, side, side}
        if choice == 0 {
            Picture(session, 23020, Sheet(0), square, Rectangle.{0.0, 48.0, 16.0, 16.0})
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{square.x + side * 0.4, square.y + side * 0.35, side * 0.65, side * 0.65},
                .shape = FingerSwipe.Shape, .color = Appearance.Surface()})
        } else {
            preview := DirectionPad(session, DirectionPadProps.{.key = 23021, .bounds = square,
                .label = Locale.Text("Try the direction pad"), .now = cast(float64)now / 1000.0})
            if preview.step { ChooseControls(true, now) }
        }
        label := ifx choice == 0 then "Swipe" else "Direction pad"
        if Button(session, ButtonProps.{.key = 23030 + cast(u64)choice,
                .bounds = Rectangle.{tile.x + 6.0, tile.y + tile.height - 50.0, tile.width - 12.0, 44.0},
                .label = Locale.Text(label), .class_name = 10, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { ChooseControls(choice == 1, now) }
    }
}

HandleInput :: (key: s32, now: s64) {
    if key == 77 || key == 109 { ToggleSound(); return }
    if game.mode == MODE_SHOP || game.mode == MODE_SETTINGS || game.mode == MODE_REWARDS {
        if key == Input.KeyEscape { game.mode = MODE_STAGES; buy_skin = 0 }
        return
    }
    if game.mode == MODE_CONTROLS {
        if key == 49 { ChooseControls(false, now) }
        else if key == 50 { ChooseControls(true, now) }
        else if key == Input.KeyEscape { game.mode = controls_previous_mode }
        return
    }
    #if #defined(WURM_CRAZYGAMES) {
        if game.mode == MODE_STAGES && (key == 69 || key == 101) { return }
    }
    if game.mode == MODE_STAGES && (key == 69 || key == 101) {
        OpenEditorHome()
        return
    }
    if game.mode == MODE_LEVELS {
        if key == Input.KeyEscape { OpenStages() }
        return
    }
    if game.mode == MODE_PLAYING {
        // R restarts the level as the run entered it.
        if key == 82 || key == 114 {
            if editor.playtest { ReloadLevel(game.level, now) }
            else { StartRun(now) }
        }
        else { unused ApplyInput(*game, key) }
    } else if game.mode == MODE_PAUSED {
        unused ApplyInput(*game, key)
        if game.mode == MODE_PLAYING { game.next_step = now + TickInterval(game.level) }
        if game.mode == MODE_STAGES { LeavePlay() }
    } else if game.mode == MODE_READY {
        if key == Input.KeyEnter || key == 32 {
            game.mode = MODE_PLAYING
            game.next_step = now + TickInterval(game.level)
            touch_steering.active = false
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_DIED {
        if key == Input.KeyEnter || key == 32 {
            if editor.playtest { StartLevel(game.level, now, 1) }
            else { Play(now, true) }
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_VICTORY {
        if key == Input.KeyEnter || key == 32 {
            if editor.playtest { StartLevel(0, now, 1) }
            else { StartRun(now) }
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_EDITOR {
        // Escape climbs one page: board, levels, landscapes, editor title.
        if editor_page == EDITOR_PAGE_HOME {
            if key == Input.KeyEscape || key == 69 || key == 101 { OpenStages() }
            else if key == Input.KeyEnter || key == 32 {
                if editor_board_open && (editor.own || EditorLevelOpen(editor.level)) { EditorResume() }
                else { EditorPick(EDITOR_PICK_BLANK) }
            }
        } else if editor_page == EDITOR_PAGE_MINE || editor_page == EDITOR_PAGE_CHANGES || editor_page == EDITOR_PAGE_COMMUNITY {
            if key == Input.KeyEscape { editor_page = EDITOR_PAGE_HOME }
        } else if editor_page == EDITOR_PAGE_SHARE {
            if key == Input.KeyEscape { editor_page = EDITOR_PAGE_MINE }
        } else if editor_page == EDITOR_PAGE_STAGES {
            if key == Input.KeyEscape { editor_page = EDITOR_PAGE_HOME }
            else if key == 69 || key == 101 { OpenStages() }
        } else if editor.browsing {
            if key == Input.KeyEscape { EditorOpenStages() }
            else if (key == 76 || key == 108 || key == 69 || key == 101) && editor_board_open && EditorLevelOpen(editor.level) {
                editor.browsing = false
            }
        } else if key == Input.KeyEscape { EditorBrowse() }
        else if key == 69 || key == 101 { EditorExit() }
        else if key == 76 || key == 108 { EditorBrowse() }
        else if key == 84 || key == 116 { EditorTurn() }
        else if key == 265 || key == 87 || key == 119 { EditorSwitch(-1) }
        else if key == 264 || key == 83 || key == 115 { EditorSwitch(1) }
        else if key == Input.KeyEnter || key == 32 || key == Input.KeyTab { EditorPlaytest(now) }
        else if key == 82 || key == 114 { EditorReloadSaved() }
        else if key == 45 || key == 95 { EditorSetApples(-1) }
        else if key == 61 || key == 43 { EditorSetApples(1) }
    }
}

// Normal play follows the window shape; editor playtests keep their explicit
// layout. Steering stays in screen directions in either case.
game_portrait: bool;
touch_steering: Touch.TouchSteering;
stage_digits: [21]u8;
stage_total: [24]u8;

// Finger movement steers like arrow keys, without waiting for release.
Steer :: (direction: s32) {
    if game.length >= 8 && direction != (game.direction + 2) % 4 { game.next_direction = direction }
}

// One icon and one number per status chip: widths stay fixed as lives and
// scores grow, so they cannot collide with the pause target on a phone.
StatusChip :: (session: Session, key: u64, bounds: Rectangle, shape: string, color: Color, value: string) {
    unused Box(session, BoxProps.{.key = key, .bounds = bounds,
        .fill = Appearance.Surface(), .radius = 16.0})
    SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + 10.0, bounds.y + (bounds.height - 21.0) / 2.0, 21.0, 21.0},
        .shape = shape, .color = color})
    GameText(session, key + 1, value, Rectangle.{bounds.x + 37.0, bounds.y + (bounds.height - 24.0) / 2.0,
        bounds.width - 43.0, 24.0}, 18)
}

LivesChip :: (session: Session, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = 17, .bounds = bounds,
        .fill = Appearance.Surface(), .radius = 16.0})
    slots := game.lives
    if slots < 3 { slots = 3 }
    columns := slots
    if columns > 5 { columns = 5 }
    rows := (slots + columns - 1) / columns
    size := (bounds.width - 16.0) / cast(float32)columns - 2.0
    if size > 21.0 { size = 21.0 }
    height_size := (bounds.height - 6.0) / cast(float32)rows - 2.0
    if size > height_size { size = height_size }
    width := cast(float32)columns * (size + 2.0) - 2.0
    height := cast(float32)rows * (size + 2.0) - 2.0
    for heart: 0..slots - 1 {
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + (bounds.width - width) / 2.0 +
                cast(float32)(heart % columns) * (size + 2.0), bounds.y + (bounds.height - height) / 2.0 +
                cast(float32)(heart / columns) * (size + 2.0), size, size},
            .shape = HeartIcon.Shape, .color = ifx heart < game.lives then Color.{218, 105, 104, 255}
                else Color.{201, 211, 185, 255}})
    }
}

DrawTopBar :: (session: Session, hud: Rectangle) {
    unused Box(session, BoxProps.{.key = 10, .bounds = hud, .fill = Appearance.Surface()})
    unused Box(session, BoxProps.{.key = 15,
        .bounds = Rectangle.{hud.x, hud.y + hud.height - 2.0, hud.width, 2.0}, .fill = Appearance.Border()})
    if game.mode == MODE_EDITOR {
        if Button(session,ButtonProps.{.key = 8228,.bounds = Rectangle.{hud.x + 12.0,hud.y + 5.0,38.0,32.0},
                .label = Locale.Text("Previous level"),.icon_only = true,
                .icon_shape = "S2rr:M15 6L9 12L15 18"}) != 0 { EditorSwitch(-1) }
        if Button(session,ButtonProps.{.key = 8229,.bounds = Rectangle.{hud.x + 54.0,hud.y + 5.0,38.0,32.0},
                .label = Locale.Text("Next level"),.icon_only = true,
                .icon_shape = "S2rr:M9 6L15 12L9 18"}) != 0 { EditorSwitch(1) }
        if Button(session, ButtonProps.{.key = 8225, .bounds = Rectangle.{hud.x + 102.0, hud.y + 5.0, 88.0, 32.0},
                .label = Locale.Text("Levels"), .tone = ButtonTone.ButtonToneSuccess}) != 0 {
            EditorBrowse()
        }
        if Button(session,ButtonProps.{.key = 8226,.bounds = Rectangle.{hud.x + 202.0,hud.y + 5.0,96.0,32.0},
                .label = Locale.Text("Landscape"),.tone = ifx !editor.turned then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral}) != 0 && editor.turned { EditorTurn() }
        if Button(session,ButtonProps.{.key = 8227,.bounds = Rectangle.{hud.x + 306.0,hud.y + 5.0,86.0,32.0},
                .label = Locale.Text("Portrait"),.tone = ifx editor.turned then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral}) != 0 && !editor.turned { EditorTurn() }
        return
    }
    narrow := hud.width < 520.0
    chapter := StageName(StageOf(game.level))
    total := FormatInteger(cast(s64)StageLevels(StageOf(game.level)), stage_digits[:])
    stage_total[0] = #char "/"; stage_total[1] = #char " "
    total_end := CopyInto(stage_total[:], 2, total)
    stage_total[total_end] = 0
    total_label := TextUntilNul(stage_total[:])
    GameText(session, 11, chapter, Rectangle.{hud.x + 16.0, hud.y + 10.0, 100.0, 22.0}, 17)
    level_text := FormatInteger(cast(s64)(StageNumber(game.level)), level_digits[:])
    if narrow {
        GameText(session, 12, level_text, Rectangle.{hud.x + 112.0, hud.y + 12.0, 26.0, 20.0}, 15)
        GameText(session, 13, total_label, Rectangle.{hud.x + 138.0, hud.y + 12.0, 38.0, 20.0}, 14, true)
    } else {
        GameText(session, 12, level_text, Rectangle.{hud.x + 16.0, hud.y + 36.0, 26.0, 20.0}, 15)
        GameText(session, 13, total_label, Rectangle.{hud.x + 42.0, hud.y + 36.0, 38.0, 20.0}, 14, true)
    }
    group_x := hud.x + 124.0
    group_width := hud.width - 200.0
    if group_width > 340.0 { group_x += (group_width - 340.0) / 2.0; group_width = 340.0 }
    chip_y := hud.y + 16.0
    chip_height: float32 = 40.0
    if narrow {
        group_x = hud.x + 12.0
        group_width = hud.width - 24.0
        chip_y = hud.y + 60.0
        chip_height = 34.0
    }
    chip_width := (group_width - 16.0) / 3.0
    apples_text := FormatInteger(cast(s64)game.apples, apple_digits[:])
    score_text := FormatInteger(cast(s64)game.score, score_digits[:])
    LivesChip(session, Rectangle.{group_x, chip_y, chip_width, chip_height})
    StatusChip(session, 19, Rectangle.{group_x + chip_width + 8.0, chip_y, chip_width, chip_height}, AppleIcon.Shape, Color.{210, 78, 65, 255}, apples_text)
    StatusChip(session, 21, Rectangle.{group_x + (chip_width + 8.0) * 2.0, chip_y, chip_width, chip_height}, StarIcon.Shape, Color.{210, 152, 46, 255}, score_text)
    if game.mode == MODE_PLAYING {
        sound_bounds := Rectangle.{hud.x+hud.width-116.0,hud.y+8.0,48.0,48.0}
        if Button(session,ButtonProps.{.key=24110,.bounds=sound_bounds,
            .label=Locale.Text("Volume"),.icon_only=true,.class_name=10,
            .icon_shape="S1.8rr:M4 9H8L13 5V19L8 15H4ZM16 8C19 10 19 14 16 16M19 5C24 9 24 15 19 19",
            .tone=ButtonTone.ButtonToneSuccess,.emphasis=ButtonEmphasis.ButtonEmphasisFilled}) != 0 { sound_popup = !sound_popup }
        if Button(session, ButtonProps.{.key = 59,
                .bounds = Rectangle.{hud.x + hud.width - 60.0, hud.y + 8.0, 48.0, 48.0},
                .label = Locale.Text("Pause"), .icon_only = true, .class_name = 10,
                .icon_shape = "F:M7 5H10V19H7ZM14 5H17V19H14Z", .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { HandleInput(Input.KeyEscape, Timer.MonotonicMilliseconds()) }
        DrawSoundPopup(session,hud,sound_bounds)
    }
}

portal_ad_was_pending: bool;

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Portal.ConfigureLanguage()
    unused WidgetPaletteUse(session, Appearance.Palette())
    #if #defined(PLATFORM_WEB) {
        if !browser_storage_started {
            browser_storage_started = true
            // Escape belongs to pause/back navigation, including the selector.
            BrowserCanvas.CanvasSetExitKey(0)
            unused BrowserStorage.BundleStorageOpen()
        }
        if !BrowserStorage.BundleStorageReady() && !BrowserStorage.BundleStorageFailed() {
            CentreText(session,25000,"Opening your journey…",viewport,20)
            return 0
        }
    }
    now := Timer.MonotonicMilliseconds()
    #if #defined(PLATFORM_WEB) {
        Audio.EnforceMute()
    }
    ad_pending := Portal.AdPending()
    if ad_pending || portal_ad_was_pending {
        portal_ad_was_pending = ad_pending
        Portal.Gameplay(false)
        #if !#defined(WURM_PORTABLE) {
            while KeyboardTake(session) != 0 {}
        }
        touch_steering.active = false
        game.next_step = now + 25
        unused Box(session, BoxProps.{.key = 29990, .bounds = viewport, .fill = Appearance.Canvas()})
        CentreText(session, 29991, "Please wait…", viewport, 20)
        return 0
    }
    #if !#defined(WURM_PORTABLE) {
        // Every scrollable page shares the same input path, including the
        // skin shop, calendar and settings on small windows and phones.
        pointer := GamePointer(session)
        ScrollDevice.BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
            pointer.down, pointer.released, TreeInput.PointerWheelTake(session, viewport), cast(float64)now / 1000.0)
    }
    Account.Pump()
    Portal.PumpAccount()
    Appearance.ApplyShared(Account.SharedTheme(), Account.SharedAccent(), Account.SharedMaterial(), Account.SystemDark())
    unused WidgetPaletteUse(session, Appearance.Palette())
    LoadSound()
    // Account changes can finish while Profile or Leaderboard is open. Keep
    // the game records and that account's board current before drawing it.
    if Progress.Pump(now) {
        Wardrobe.Reset(); preferences_poll = 0; preferences_dirty = false
        Account.RefreshProfile()
        if game.mode == MODE_PLAYING || game.mode == MODE_PAUSED || game.mode == MODE_READY || game.mode == MODE_FINISHED || game.mode == MODE_DIED || game.mode == MODE_VICTORY {
            game.mode = MODE_STAGES
            touch_steering.active = false
        }
    }
    if Portal.ProfileVisible() {
        profile_key: s32
        #if !#defined(WURM_PORTABLE) {
            profile_key = KeyboardTake(session)
        }
        unused Box(session, BoxProps.{.key = 29000, .bounds = viewport, .fill = Appearance.Canvas()})
        GameText(session, 29001, "Profile", Rectangle.{viewport.x + 100.0, viewport.y + 14.0, viewport.width - 112.0, 32.0}, 22)
        PlainText(session, 29003, Portal.ProfileTitle(), Rectangle.{viewport.x + 32.0, viewport.y + 84.0, viewport.width - 64.0, 34.0}, 24)
        if Portal.SaveLimited() {
            GameText(session, 29004, "Progress is kept only until this page closes.",
                Rectangle.{viewport.x + 32.0, viewport.y + 128.0, viewport.width - 64.0, 24.0}, 15, false, true)
        }
        if !Portal.SignedIn() {
            width: float32 = 220.0
            if Button(session, ButtonProps.{.key = 29005, .bounds =
                    Rectangle.{viewport.x + (viewport.width - width) / 2.0, viewport.y + 180.0, width, 48.0},
                    .label = Locale.Text("Sign in")}) != 0 { Portal.SignIn() }
        }
        if Button(session, ButtonProps.{.key = 29002, .bounds = Rectangle.{viewport.x + 12.0, viewport.y + 8.0, 76.0, 44.0},
                .label = Locale.Text("Back")}) != 0 || profile_key == Input.KeyEscape { Portal.BackProfile(); Progress.poll_at = 0 }
        #if #defined(PLATFORM_WEB) {
            Audio.UpdateAudio(false, game.level, game.apples, game.death_ticks, game.transition_ticks, false)
        }
        return 0
    }
    if Account.ProfileVisible() {
        profile_key: s32
        #if !#defined(WURM_PORTABLE) {
            profile_key = KeyboardTake(session)
        }
        unused Box(session, BoxProps.{.key = 29000, .bounds = viewport, .fill = Appearance.Canvas()})
        GameText(session, 29001, Account.ProfileTitle(), Rectangle.{viewport.x + 100.0, viewport.y + 14.0, viewport.width - 112.0, 32.0}, 22)
        Account.DrawProfile(session, Rectangle.{viewport.x, viewport.y + 64.0, viewport.width, viewport.height - 64.0}, profile_key, Appearance.mode != 2)
        if Button(session, ButtonProps.{.key = 29002, .bounds = Rectangle.{viewport.x + 12.0, viewport.y + 8.0, 76.0, 44.0}, .label = Locale.Text("Back")}) != 0 || profile_key == Input.KeyEscape { Account.Back(); Progress.poll_at = 0; Wardrobe.poll_at = 0 }
        return 0
    }
    PreferencesPump(now)
    Wardrobe.Pump(now, game.mode == MODE_PLAYING && !editor.playtest && game.death_ticks == 0 && game.transition_ticks == 0)
    if reward_serial != Rewards.toast_serial {
        reward_serial = Rewards.toast_serial
        reward_until = now + 2500
    }
    was_portrait := game_portrait
    game_portrait = viewport.height > viewport.width
    if !game.started {
        game.started = true
        OpenStages()
        if rewards_at_start && !EditorApp() { game.mode = MODE_REWARDS }
    } else if was_portrait != game_portrait && !editor.playtest && (game.mode == MODE_PLAYING || game.mode == MODE_PAUSED || game.mode == MODE_READY) {
        previous_mode := game.mode
        ReloadLevel(game.level,now)
        game.mode = previous_mode
    }
    // The editor app has no game title: every way out of a page lands on
    // the editor's own title, and Back there leaves the app.
    if EditorApp() && game.mode == MODE_STAGES { OpenEditorHome() }
    water_frame = cast(s32)((now / 130) % 3)
    enemy_frame = cast(s32)((now / 110) % 4)
    key: s32
    #if #defined(WURM_PORTABLE) {
        key = Timer.PressedKey()
    } else {
        key = KeyboardTake(session)
    }
    if game.mode == MODE_LOCAL {
        Audio.UpdateAudio(local_round.phase == Local.PLAYING || local_round.phase == Local.PAUSED, 0, 1, 0, 0)
        Portal.Gameplay(local_round.phase == Local.PLAYING)
        DrawLocal(session, viewport, key, now)
        return 0
    }
    // A key that returns to the stages must not also start a level there.
    stage_key := ifx game.mode == MODE_STAGES then key else 0
    if sound_popup && key == Input.KeyEscape { sound_popup = false; key = 0 }
    editor_field_key = key
    if game.mode == MODE_EDITOR && editor_page == EDITOR_PAGE_MINE && mine_name.focused {
        if key == Input.KeyEscape { mine_name.focused = false }
        key = 0
    }
    if game.mode == MODE_EDITOR && editor_page == EDITOR_PAGE_COMMUNITY && community_query.focused {
        if key == Input.KeyEscape { community_query.focused = false }
        key = 0
    }
    if game.mode != MODE_PLAYING { sound_popup = false }
    if key == Input.KeyEscape {
        if !NavigateBack(now) {
            #if #defined(ANDROID_BUILD) {
                // The Android host finishes the activity for unused Back.
                unused KeyboardSend(session, key)
            }
        }
    } else { HandleInput(key, now) }
    unused Box(session, BoxProps.{.key = 1, .bounds = viewport, .fill = Appearance.Canvas()})
    // The stages screen is one full-bleed cover; every other mode carries the
    // green icon bar across the top with the board letterboxed below it, so
    // portrait and landscape both keep their proportions.
    showing_bar := game.mode != MODE_STAGES && game.mode != MODE_LEVELS &&
        game.mode != MODE_SETTINGS && game.mode != MODE_SHOP && game.mode != MODE_REWARDS &&
        !(game.mode == MODE_CONTROLS && (controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS)) &&
        !(game.mode == MODE_EDITOR && editor_page != EDITOR_PAGE_EDIT)
    bar_height: float32 = 0.0
    if showing_bar { bar_height = ifx viewport.width < 520.0 then 104.0 else 72.0 }
    if game.mode == MODE_EDITOR && showing_bar { bar_height = 42.0 }
    hud := Rectangle.{viewport.x, viewport.y, viewport.width, bar_height}
    available_height := viewport.height - bar_height
    if available_height < 1.0 { available_height = 1.0 }
    stage := BoardIn(Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height})
    // Read the held pointer before simulation, so the next 25 ms step can
    // already use this frame's direction. SwipeArea supplies captured contact;
    // its release-only swipe result is deliberately unused.
    contact: SwipeAreaResult
    if game.mode == MODE_PLAYING && !sound_popup && (!Controls.Pad() || KeyboardOnly()) && game.death_ticks == 0 && game.transition_ticks == 0 {
        contact = SwipeArea(session, SwipeAreaProps.{.key = PLAY_STEERING_KEY, .bounds = stage,
            .label = Locale.Text("Steer the worm"), .now = cast(float64)now / 1000.0,
            .min_distance = 6.0})
        direction := Touch.TouchDirection(*touch_steering, contact.down, contact.at_x, contact.at_y)
        if direction >= 0 { Steer(direction) }
    } else { touch_steering.active = false }
    lives_before := game.lives
    unused Step(*game, now)
    // Save the next unlocked level on completion, before loading its board.
    if game.mode == MODE_FINISHED && !editor.playtest && recorded_level != game.level {
        Progress.Complete(game.level)
        if game.level == 159 && !Wardrobe.MountainsAvailable() {
            Progress.RecordRun(160, game.score)
            level_chapter = 4
            level_scroll = 0
            mountains_confirm = false
            game.mode = MODE_LEVELS
        }
    }
    if game.mode == MODE_FINISHED && !editor.playtest && recorded_level != game.level {
        if Progress.Begin(game.level + 1, game.lives, game.score) || Portal.Guest() { recorded_level = game.level }
        Progress.RecordRun(game.level + 2, game.score)
        Portal.LevelFinished(Progress.best_score)
    }
    if game.mode == MODE_FINISHED && editor.playtest && editor.own { EditorResume() }
    if game.mode == MODE_FINISHED {
        // Load after saving completion, then wait indefinitely for Start.
        // No simulation or stale steering can cross into this new board.
        ReloadLevel(game.level + 1, now)
        game.mode = MODE_READY
    }
    // The run keeps each lost life; a game over or the finished journey
    // starts the next run at level one.
    if !editor.playtest && game.lives < lives_before {
        if game.mode == MODE_DIED {
            Progress.RecordRun(game.level + 1, game.score)
            unused Progress.Restart()
        }
        else { unused Progress.LoseLife() }
    }
    if game.mode == MODE_VICTORY && !editor.playtest && recorded_level != game.level {
        Progress.Complete(game.level)
        Progress.RecordRun(LEVEL_COUNT, game.score)
        Portal.LevelFinished(Progress.best_score)
        if Progress.Restart() || Portal.Guest() { recorded_level = game.level }
    }
    Audio.UpdateAudio(game.mode == MODE_PLAYING || game.mode == MODE_PAUSED || (game.mode == MODE_READY && Audio.was_playing),
        game.level, game.apples, game.death_ticks, game.transition_ticks, game.mode != MODE_READY)
    Portal.Gameplay(game.mode == MODE_PLAYING && game.death_ticks == 0 && game.transition_ticks == 0)
    if game.mode == MODE_STAGES {
        area := Rectangle.{viewport.x, viewport.y, viewport.width, viewport.height}
        action := DrawTitle(session, area, stage_key)
        if action == 3 { OpenLevels() }
        else if action == 4 { OpenEditorHome() }
        else if action == 5 { OpenLocalSetup() }
        else if action != 0 { Play(now, action == 2) }
    } else if game.mode == MODE_SHOP {
        DrawShop(session, viewport)
    } else if game.mode == MODE_SETTINGS {
        DrawSettings(session, viewport)
    } else if game.mode == MODE_REWARDS {
        unused DrawTitle(session, viewport, 0, false)
        DrawRewardsModal(session, viewport)
    } else if game.mode == MODE_LEVELS {
        DrawLevels(session, viewport, now)
    } else if game.mode == MODE_CONTROLS {
        if controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS { unused DrawTitle(session, viewport, 0, false) }
        else { DrawBoard(session, stage) }
        DrawControls(session, viewport, now)
    } else if game.mode == MODE_EDITOR {
        area := Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height}
        DrawEditor(session, area, now)
    } else {
        DrawBoard(session, stage)
        if game.mode == MODE_PLAYING && (!Controls.Pad() || KeyboardOnly()) && game.death_ticks == 0 && game.transition_ticks == 0 {
            SwipeFeedback(session, SwipeFeedbackProps.{.key = 24010, .gesture = contact})
        }
        if game.mode == MODE_PLAYING && Controls.Pad() && !KeyboardOnly() {
            pad := DirectionPad(session, DirectionPadProps.{.key = PLAY_STEERING_KEY,
                .bounds = DirectionPadBounds(Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height}),
                .label = Locale.Text("Direction pad"), .now = cast(float64)now / 1000.0, .repeat_seconds = 0.08,
                .floating = true, .disabled = game.death_ticks > 0 || game.transition_ticks > 0})
            if pad.step { Steer(pad.direction) }
        }
    }
    if showing_bar { DrawTopBar(session, hud) }
    if game.mode == MODE_READY { DrawLevelReady(session, stage) }
    else if game.mode == MODE_PAUSED { Overlay(session, viewport, "Paused", "Your worm is waiting.") }
    else if game.mode == MODE_DIED { Overlay(session, viewport, "Game over", "Another apple adventure?", game.score) }
    else if game.mode == MODE_VICTORY { Overlay(session, viewport, "You did it!", "You reached the mountain!", game.score) }
    if !Portal.Guest() && now < reward_until && (Rewards.toast_coins > 0 || Rewards.toast_dew > 0) {
        toast := Rectangle.{viewport.x + (viewport.width - 200.0) / 2.0, viewport.y + 116.0, 200.0, 44.0}
        unused Box(session, BoxProps.{.key = 29990, .bounds = toast, .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 12.0})
        text: Vec(u8)
        if Rewards.toast_coins > 0 { BuilderPrint(*text, "+%", CoinText(Rewards.toast_coins)) }
        else { BuilderPrint(*text, "+% Dew", Rewards.toast_dew) }
        GameText(session, 29991, BuilderFinish(text), Rectangle.{toast.x + 8.0, toast.y + 8.0, 184.0, 28.0}, 20, false, true)
    }
    return 0
}
