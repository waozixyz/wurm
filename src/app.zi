// A computer steers with its keyboard; only touch editions offer swipe
// or the on-screen direction pad.
KeyboardOnly :: () -> bool {
    #if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) && !#defined(WURM_PORTABLE) {
        return true
    } else {
        return false
    }
}
// Arcade's separate Apfelwurm Editor app opens straight into the editor.
EditorApp :: () -> bool {
    #if #defined(WURM_EDITOR_APP) {
        return true
    } else {
        return false
    }
}
