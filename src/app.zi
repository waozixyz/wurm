}
// The editor's pages before a board: its title, then the landscapes. The
// level grid (editor.browsing) and the board share EDITOR_PAGE_EDIT.
EDITOR_PAGE_EDIT :: 0;
EDITOR_PAGE_HOME :: 1;
EDITOR_PAGE_STAGES :: 2;
// Your own levels in named collections, and the campaign levels you changed.
EDITOR_PAGE_MINE :: 3;
EDITOR_PAGE_CHANGES :: 4;
EDITOR_PAGE_SHARE :: 5;
EDITOR_PAGE_COMMUNITY :: 6;
// What the landscape and level pages start: an empty board in a landscape,
// a copy of a level reached, or (developer entry only) the campaign itself.
EDITOR_PICK_BLANK :: 0;
EDITOR_PICK_TEMPLATE :: 1;
EDITOR_PICK_CAMPAIGN :: 2;
