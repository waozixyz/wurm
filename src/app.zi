using UI :: #import "kryon/Widgets";
#import "kryon/joystick";
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
HeartIcon :: #import "mingcute/mingcute_filled_heart";
AppleIcon :: #import "mingcute/mingcute_filled_apple_fruit";
StarIcon :: #import "mingcute/mingcute_filled_star";
Input :: #import "kryon/input_protocol";
Timer :: #import "std/timer_linux";
#import "std/number_text"
#import "std/text_buffer"
#import, file "game.zi";
#import, file "original_levels.zi";
Custom :: #import, file "custom_levels.zi";
Audio :: #import, file "audio.zi";

// The playable board: the recovered 40x30 grid of 16-pixel cells.
BOARD_WIDTH :: 640.0;
BOARD_HEIGHT :: 480.0;

game: Game;
level_digits: [21]u8;
score_digits: [21]u8;
apple_digits: [21]u8;
lives_digits: [21]u8;

// The stage pager: `selected` keeps counting past either end so the pages
// wrap, and `position` eases towards it or follows a dragging pointer.
StagePager :: struct { selected: s32; position: float32; time: float64; }
pager: StagePager;
stage_levels: [STAGE_COUNT]s32;
// Only Garden is open for now. Space and Factory keep their levels and art,
// and come back by raising this. The title screen pages stage covers and,
// after them, one Level Editor page you swipe to.
OPEN_STAGES :: 1;
PAGE_COUNT :: OPEN_STAGES + 1;

// The level editor paints one level's raw tiles and apple count, and saves
// them as an override beside the recovered originals (custom_levels.zi).
EDITOR_PANEL_WIDTH :: 248.0;
EditorState :: struct {
    level: s32
    board: [CELLS]u8
    apples: s32
    brush: s32
    dirty: bool
    save_failed: bool
    reset_armed: bool
    palette_scroll: s32
    playtest: bool
    browsing: bool
    turned: bool
}
editor: EditorState;
editor_digits: [21]u8;
brush_digits: [21]u8;

Wrap :: (page: s32) -> s32 { return ((page % PAGE_COUNT) + PAGE_COUNT) % PAGE_COUNT }

StageName :: (stage: s32) -> string {
    if stage == 1 { return "SPACE" }
    if stage == 2 { return "FACTORY" }
    return "GARDEN"
}
StageHero :: (stage: s32) -> string {
    if stage == 1 { return "Play as the Rocket" }
    if stage == 2 { return "Play as the Fire Snake" }
    return "Play as the Worm"
}
StageClear :: (stage: s32) -> string {
    if stage == 1 { return "SPACE CLEAR" }
    if stage == 2 { return "FACTORY CLEAR" }
    return "GARDEN CLEAR"
}

// Each stage's tiles, character, monsters, pickup and effects share one
// sheet in the original 20x12 layout of 16-unit cells, drawn at 2x (32-pixel
// cells) so the sprites keep their detail; floors and walls are opaque.
SHEET_SCALE :: 2.0;
Sheet :: (stage: s32) -> string {
    if stage == 1 { return "assets/art/space.png" }
    if stage == 2 { return "assets/art/factory.png" }
    return "assets/art/garden.png"
}
preview_path: [64]u8;
PreviewPath :: (stage: s32, number: s32) -> string {
    prefix := "garden-"
    if stage == 1 { prefix = "space-" }
    else if stage == 2 { prefix = "factory-" }
    digits: [16]u8
    at := CopyInto(preview_path[:], 0, "assets/art/previews/")
    at = CopyInto(preview_path[:], at, prefix)
    at = CopyInto(preview_path[:], at, FormatInteger(cast(s64)number, digits[:]))
    at = CopyInto(preview_path[:], at, ".png")
    preview_path[at] = 0
    return TextUntilNul(preview_path[:])
}
CopyInto :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}
Cover :: (stage: s32) -> string {
    if stage == 1 { return "assets/art/space-cover.png" }
    if stage == 2 { return "assets/art/factory-cover.png" }
    return "assets/art/garden-cover.png"
}

Picture :: (session: Session, key: u64, asset: string, bounds: Rectangle, source: Rectangle) {
    unused Image(session, ImageProps.{.key = key, .asset_path = asset, .bounds = bounds,
        .source = Rectangle.{source.x * SHEET_SCALE, source.y * SHEET_SCALE,
            source.width * SHEET_SCALE, source.height * SHEET_SCALE},
        .smooth = false, .alt_text = "Worm artwork"})
}

TextLine :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text,
        .font = size, .wrap = TextWrap.TextWrapNone})
}

CentreText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text,
        .font = size, .align = TextAlign.TextAlignCenter})
}

// Pause, game over and stage clear: a dim veil over the board and one cream
// card with a green cap, the title, the score when the run ended, and the
// keys that move on.
Overlay :: (session: Session, stage: Rectangle, title: string, message: string, score: s32 = -1) {
    unused Box(session, BoxProps.{.key = 50, .bounds = stage, .fill = Color.{10, 18, 12, 150}})
    card_width := stage.width * 0.74
    if card_width > 400.0 { card_width = 400.0 }
    if card_width < 220.0 { card_width = 220.0 }
    card_height: float32 = ifx score >= 0 then 138.0 else 104.0
    card := Rectangle.{stage.x + (stage.width - card_width) / 2.0,
        stage.y + stage.height * 0.34, card_width, card_height}
    unused Box(session, BoxProps.{.key = 51, .bounds = card, .fill = Color.{240, 242, 232, 250}, .radius = 14.0})
    unused Box(session, BoxProps.{.key = 55,
        .bounds = Rectangle.{card.x + 14.0, card.y, card.width - 28.0, 5.0},
        .fill = Color.{46, 125, 74, 255}, .radius = 2.0})
    CentreText(session, 52, title, Rectangle.{card.x, card.y + 16.0, card.width, 34.0}, 28)
    if score >= 0 {
        score_text := FormatInteger(cast(s64)score, score_digits[:])
        CentreText(session, 53, score_text, Rectangle.{card.x, card.y + 52.0, card.width, 34.0}, 26)
        CentreText(session, 56, message, Rectangle.{card.x + 10.0, card.y + 96.0, card.width - 20.0, 36.0}, 14)
    } else {
        CentreText(session, 53, message, Rectangle.{card.x + 10.0, card.y + 56.0, card.width - 20.0, 40.0}, 15)
    }
}

// A logical-pixel sprite square on the live board.
Sprite :: (session: Session, key: u64, stage: Rectangle, position: Point, source: Rectangle,
    sheet: string) {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + cast(float32)(position.x - 8) * scale)
    top := Snap(stage.y + cast(float32)(position.y - 8) * scale)
    bounds := Rectangle.{left, top, Snap(stage.x + cast(float32)(position.x + 8) * scale) - left,
        Snap(stage.y + cast(float32)(position.y + 8) * scale) - top}
    if bounds.y < Snap(stage.y) || bounds.y + bounds.height > Snap(stage.y + stage.height) { return }
    Picture(session, key, sheet, bounds, source)
}

// Garden-only dressage: animated water frames and grass floor variants,
// both chosen per frame and per cell so boards feel alive without any
// change to the level data.
water_frame: s32;
fancy_garden: bool;
GRASS_TILES :: 9;

Snap :: (value: float32) -> float32 { return cast(float32)cast(s32)(value + 0.5) }

// Tile edges land on whole pixels, so scaled neighbours meet without seams.
Tile :: (session: Session, key: u64, stage: Rectangle, x: s32, y: s32, tile: s32, sheet: string) {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + cast(float32)x * 16.0 * scale)
    top := Snap(stage.y + cast(float32)y * 16.0 * scale)
    bounds := Rectangle.{left, top, Snap(stage.x + cast(float32)(x + 1) * 16.0 * scale) - left,
        Snap(stage.y + cast(float32)(y + 1) * 16.0 * scale) - top}
    source := Rectangle.{cast(float32)(tile % 20) * 16.0,
        cast(float32)(tile / 20) * 16.0, 16.0, 16.0}
    if fancy_garden {
        if tile == 22 {
            source = Rectangle.{cast(float32)(water_frame % 3) * 16.0, 176.0, 16.0, 16.0}
        } else if tile == 0 || tile == 3 || tile == 4 || tile == 5 ||
            tile == 6 || tile == 15 || tile == 16 || tile == 17 || tile == 19 {
            variant := (x * 7 + y * 13) % 4
            source = Rectangle.{cast(float32)(4 + variant) * 16.0, 176.0, 16.0, 16.0}
        }
    }
    Picture(session, key, sheet, bounds, source)
}

// The live board scaled to fit inside an area: 640x480 in landscape, the
// same level standing 480x640 in portrait, so a phone screen fills edge to
// edge while the worm keeps entering from the bottom and leaving at the top.
BoardIn :: (area: Rectangle) -> Rectangle {
    wide := cast(float32)board_columns * 16.0
    tall := cast(float32)board_rows * 16.0
    scale := area.width / wide
    if area.height / tall < scale { scale = area.height / tall }
    return Rectangle.{area.x + (area.width - wide * scale) / 2.0,
        area.y + (area.height - tall * scale) / 2.0, wide * scale, tall * scale}
}

AppleFlash :: (session: Session, stage: Rectangle) {
    if game.apple_flash <= 0 { return }
    frame := (game.apple_flash / 4) % 6
    source := Rectangle.{112.0, 144.0, 30.0, 30.0}
    offset := Vector2.{15.0, 15.0}
    if frame == 1 { source = Rectangle.{142.0, 144.0, 28.0, 28.0}; offset = Vector2.{14.0, 14.0} }
    else if frame == 2 { source = Rectangle.{170.0, 144.0, 28.0, 26.0}; offset = Vector2.{14.0, 13.0} }
    else if frame == 3 { source = Rectangle.{198.0, 144.0, 26.0, 24.0}; offset = Vector2.{13.0, 12.0} }
    else if frame == 4 { source = Rectangle.{224.0, 144.0, 28.0, 26.0}; offset = Vector2.{14.0, 13.0} }
    else if frame == 5 { source = Rectangle.{252.0, 144.0, 28.0, 28.0}; offset = Vector2.{14.0, 14.0} }
    scale := stage.width / (cast(float32)board_columns * 16.0)
    bounds := Rectangle.{stage.x + (cast(float32)game.apple.x - offset.x) * scale,
        stage.y + (cast(float32)game.apple.y - offset.y) * scale,
        source.width * scale, source.height * scale}
    Picture(session, 1401, Sheet(StageOf(game.level)), bounds, source)
}

DrawBoard :: (session: Session, stage: Rectangle) {
    fancy_garden = StageOf(game.level) == 0
    tiles := Sheet(StageOf(game.level))
    sprites := tiles
    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            Tile(session, 100 + cast(u64)at, stage, cast(s32)x, cast(s32)y,
                cast(s32)(game.board[at] & 127), tiles)
        }
    }
    if game.apples > 0 && game.apple.x >= 0 {
        Sprite(session, 1400, stage, game.apple, Rectangle.{0.0, 112.0, 16.0, 16.0}, sprites)
        AppleFlash(session, stage)
    }
    index: s32 = 0
    while index < game.length {
        column := 4
        if index == 0 { column = game.direction }
        else if index >= game.length - 4 { column = -1 }
        else if index >= game.length - 8 { column = 6 }
        else if index >= game.length - 12 { column = 5 }
        if column >= 0 && (game.death_ticks == 0 || game.death_ticks / 2 > 2) {
            Sprite(session, 2000 + cast(u64)index, stage, game.worm[index],
                Rectangle.{cast(float32)column * 16.0, 48.0, 16.0, 16.0}, sprites)
        }
        if game.death_ticks > 0 && index < game.length - 4 {
            Sprite(session, 4000 + cast(u64)index, stage, game.worm[index],
                Rectangle.{cast(float32)(5 - game.death_ticks / 4) * 16.0, 144.0, 16.0, 16.0}, sprites)
        }
        index += 4
    }
    for monster: 0..game.monster_count - 1 {
        Sprite(session, 6000 + cast(u64)monster, stage, game.monsters[monster].position,
            Rectangle.{cast(float32)(game.monsters[monster].kind - 1) * 16.0, 32.0, 16.0, 16.0}, sprites)
    }
    for particle: 0..99 {
        life := game.particles[particle].life
        if life > 1 && life <= 12 {
            Sprite(session, 7000 + cast(u64)particle, stage, game.particles[particle].position,
                Rectangle.{cast(float32)(life / 2) * 16.0, 160.0, 16.0, 16.0}, sprites)
        }
    }
}

// A stage page: its cover filling the page. The editor page shows the
// garden cover under a working veil, so it reads as a place, not a stage.
DrawStagePage :: (session: Session, page: Rectangle, stage: s32) {
    cover := ifx stage >= OPEN_STAGES then Cover(0) else Cover(stage)
    unused Image(session, ImageProps.{.key = 9000 + cast(u64)stage, .asset_path = cover, .bounds = page,
        .fit = ImageFit.ImageFitCover, .smooth = true, .alt_text = StageName(stage)})
    if stage >= OPEN_STAGES {
        unused Box(session, BoxProps.{.key = 9500 + cast(u64)stage, .bounds = page,
            .fill = Color.{14, 34, 20, 190}})
    }
}

OpenStages :: () {
    BoardSize(COLUMNS, ROWS)
    game.mode = MODE_STAGES
    stage := StageOf(game.level)
    if stage >= OPEN_STAGES { stage = 0 }
    else { stage_levels[stage] = game.level % STAGE_LEVELS }
    pager.selected = stage
    pager.position = cast(float32)stage
}

// Levels play from the effective source: the owner's saved override when one
// exists, otherwise the recovered original. A portrait window stands the
// same level on its side (30x40), so the worm still enters from the bottom
// and leaves at the top.
PlayBoard :: (level: s32, now: s64, seed: u32, restart: bool, force_turn: bool = false) {
    board: [CELLS]u8
    turned: [CELLS]u8
    Custom.EnsureLoaded()
    Custom.EffectiveBoard(level, board[:])
    apples := Custom.EffectiveApples(level)
    source := board[:]
    columns: s32 = COLUMNS
    rows: s32 = ROWS
    if game_portrait || force_turn {
        TurnForward(board[:], turned[:])
        source = turned[:]
        columns = ROWS
        rows = COLUMNS
    }
    if restart { LoadLevelData(*game, level, now, source, apples, columns, rows) }
    else { StartGameData(*game, level, now, seed, source, apples, columns, rows) }
}
StartLevel :: (level: s32, now: s64, seed: u32) { PlayBoard(level, now, seed, false) }
ReloadLevel :: (level: s32, now: s64) { PlayBoard(level, now, 1, true) }

// Leaving a paused or finished playtest returns to the editor; a normal game
// returns to the stages.
LeavePlay :: () {
    if editor.playtest { OpenEditor(editor.level) }
    else { OpenStages() }
}

// The desktop host's WURM_START=editor entry: straight into the editor,
// facing its all-levels view.
EditorAtStartup :: (level: s32) {
    game.started = true
    editor.browsing = true
    OpenEditor(level)
}

EditorLoad :: (level: s32) {
    board: [CELLS]u8
    Custom.EnsureLoaded()
    Custom.EffectiveBoard(level, board[:])
    if editor.turned {
        TurnForward(board[:], editor.board[:])
        BoardSize(ROWS, COLUMNS)
    } else {
        editor.board = board
        BoardSize(COLUMNS, ROWS)
    }
    editor.apples = Custom.EffectiveApples(level)
}

OpenEditor :: (level: s32) {
    if level < 0 { level = 0 }
    if level >= LEVEL_COUNT { level = LEVEL_COUNT - 1 }
    if game.mode != MODE_EDITOR || editor.level != level { EditorLoad(level); editor.dirty = false }
    editor.level = level
    editor.reset_armed = false
    editor.save_failed = false
    game.mode = MODE_EDITOR
}

// T stands the working level up on its side, exactly as portrait plays it,
// and back again; the working tiles and edits turn with it.
EditorTurn :: () {
    turned: [CELLS]u8
    if editor.turned {
        TurnBack(editor.board[:], turned[:])
        editor.board = turned
        editor.turned = false
        BoardSize(COLUMNS, ROWS)
    } else {
        TurnForward(editor.board[:], turned[:])
        editor.board = turned
        editor.turned = true
        BoardSize(ROWS, COLUMNS)
    }
}

EditorSave :: () {
    if !editor.dirty { return }
    if editor.turned {
        canonical: [CELLS]u8
        TurnBack(editor.board[:], canonical[:])
        if Custom.SaveCustomLevel(editor.level, canonical[:], editor.apples) {
            editor.dirty = false
            editor.save_failed = false
        } else { editor.save_failed = true }
        return
    }
    if Custom.SaveCustomLevel(editor.level, editor.board[:], editor.apples) {
        editor.dirty = false
        editor.save_failed = false
    } else { editor.save_failed = true }
}

// Deleting the override restores the recovered original in the working copy.
EditorReset :: () {
    unused Custom.ClearCustomLevel(editor.level)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
}

// R throws the working copy away and takes the saved level back in.
EditorReloadSaved :: () {
    EditorLoad(editor.level)
    editor.dirty = false
}

EditorExit :: () {
    EditorSave()
    editor.playtest = false
    editor.turned = false
    OpenStages()
    pager.selected = OPEN_STAGES
    pager.position = cast(float32)OPEN_STAGES
}

EditorPlaytest :: (now: s64) {
    EditorSave()
    editor.playtest = true
    PlayBoard(editor.level, now, cast(u32)(now & 4294967295), false, editor.turned)
}

EditorSwitch :: (delta: s32) {
    EditorSave()
    within := editor.level % STAGE_LEVELS + delta
    if within < 0 { within = STAGE_LEVELS - 1 }
    if within >= STAGE_LEVELS { within = 0 }
    OpenEditor(StageOf(editor.level) * STAGE_LEVELS + within)
}

EditorSetApples :: (delta: s32) {
    editor.apples += delta
    if editor.apples < 1 { editor.apples = 1 }
    if editor.apples > 12 { editor.apples = 12 }
    editor.dirty = true
}

// One titled run of palette swatches. Returns the content cursor below it.
DrawPalettePart :: (session: Session, key: u64, content: Rectangle, cursor: s32, label: string,
                    first: s32, count: s32, tiles: string,
                    pointer_x: float32, pointer_y: float32, pointer_pressed: bool) -> s32 {
    TextLine(session, key, label, Rectangle.{content.x, content.y + cast(float32)cursor, content.width, 22.0}, 13)
    for index: 0..count - 1 {
        column := index % 6
        row := index / 6
        bounds := Rectangle.{content.x + cast(float32)(column * 38),
            content.y + cast(float32)(cursor + 26 + row * 38), 34.0, 34.0}
        value := first + index
        if pointer_pressed && Input.PointInBounds(pointer_x, pointer_y, bounds) { editor.brush = value }
        selected := editor.brush == value
        unused Box(session, BoxProps.{.key = key + 10 + cast(u64)index, .bounds = bounds,
            .fill = ifx selected then Color.{46, 125, 74, 235} else Color.{255, 255, 255, 30}, .radius = 6.0})
        Picture(session, key + 80 + cast(u64)index, tiles, Rectangle.{bounds.x + 1.0, bounds.y + 1.0, 32.0, 32.0},
            Rectangle.{cast(float32)(value % 20) * 16.0, cast(float32)(value / 20) * 16.0, 16.0, 16.0})
    }
    rows := (count + 5) / 6
    return cursor + 26 + rows * 38 + 10
}

// The editor screen: the level as raw tiles on the left, brush palette and
// actions on the right. The held left button paints, the right button
// restores the recovered original tile under it.
// The level selector, Shovey-style: one card per level with its board
// sampled small as the picture, the number as the caption, a green frame on
// saved edits, the current level filled, one click to edit. Back returns.
DrawLevelBrowser :: (session: Session, area: Rectangle) {
    unused Box(session, BoxProps.{.key = 8700, .bounds = area, .fill = Color.{18, 26, 20, 255}})
    if Button(session, ButtonProps.{.key = 8703, .bounds = Rectangle.{area.x + 10.0, area.y + 8.0, 88.0, 36.0},
            .label = "Back", .tone = ButtonTone.ButtonToneNeutral}) != 0 { editor.browsing = false; return }
    CentreText(session, 8701, "Levels",
        Rectangle.{area.x + 110.0, area.y + 10.0, area.width - 220.0, 28.0}, 20)
    first := StageOf(editor.level) * STAGE_LEVELS
    columns: s32 = 8
    for candidate: 4..11 {
        rows := (STAGE_LEVELS + candidate - 1) / candidate
        item_width := (area.width - 16.0 - cast(float32)(candidate - 1) * 8.0) / cast(float32)candidate
        total := cast(float32)rows * (item_width * 0.75 + 30.0) + cast(float32)(rows - 1) * 8.0 + 56.0
        if total <= area.height { columns = cast(s32)candidate; break }
    }
    rows := (STAGE_LEVELS + columns - 1) / columns
    item_width := (area.width - 16.0 - cast(float32)(columns - 1) * 8.0) / cast(float32)columns
    item_height := item_width * 0.75 + 30.0
    pointer := PointerSample(session)
    for index: 0..STAGE_LEVELS - 1 {
        column := index % columns
        row := index / columns
        bounds := Rectangle.{area.x + 8.0 + cast(float32)column * (item_width + 8.0),
            area.y + 56.0 + cast(float32)row * (item_height + 8.0), item_width, item_height}
        level := first + cast(s32)index
        current := level == editor.level
        edited := Custom.HasCustomLevel(level)
        if pointer.pressed && Input.PointInBounds(pointer.x, pointer.y, bounds) {
            EditorSave()
            editor.browsing = false
            OpenEditor(level)
            return
        }
        unused Box(session, BoxProps.{.key = 8710 + cast(u64)index, .bounds = bounds,
            .fill = ifx current then Color.{46, 125, 74, 250} else Color.{240, 242, 232, 26},
            .border = ifx edited then Color.{120, 220, 150, 255} else Color.{240, 242, 232, 90},
            .radius = 10.0})
        // The picture: the level's rendered preview board.
        thumb := Rectangle.{bounds.x + 6.0, bounds.y + 6.0, bounds.width - 12.0, (bounds.width - 12.0) * 0.75}
        unused Image(session, ImageProps.{.key = 88000 + cast(u64)index,
            .asset_path = PreviewPath(StageOf(editor.level), cast(s32)index + 1),
            .bounds = thumb, .fit = ImageFit.ImageFitStretch, .smooth = false, .alt_text = "Level board preview"})
        number := FormatInteger(cast(s64)(index + 1), editor_digits[:])
        CentreText(session, 8760 + cast(u64)index, number,
            Rectangle.{bounds.x, bounds.y + bounds.height - 26.0, bounds.width, 22.0}, 15)
        if edited {
            unused Box(session, BoxProps.{.key = 8850 + cast(u64)index,
                .bounds = Rectangle.{bounds.x + bounds.width - 14.0, bounds.y + 6.0, 8.0, 8.0},
                .fill = Color.{120, 220, 150, 255}, .radius = 4.0})
        }
    }
}

DrawEditor :: (session: Session, area: Rectangle, now: s64) {
    if editor.browsing { DrawLevelBrowser(session, area); return }
    stage_of_level := StageOf(editor.level)
    fancy_garden = stage_of_level == 0
    tiles := Sheet(stage_of_level)
    panel := Rectangle.{area.x + area.width - EDITOR_PANEL_WIDTH, area.y, EDITOR_PANEL_WIDTH, area.height}
    canvas := Rectangle.{area.x, area.y, area.width - EDITOR_PANEL_WIDTH, area.height}
    // The board keeps whatever orientation EditorLoad or EditorTurn last set.
    stage := BoardIn(canvas)

    pointer := PointerSample(session)
    secondary := SecondaryPointerSample(session)
    scale := stage.width / (cast(float32)board_columns * 16.0)
    if (pointer.down || secondary.down) && Input.PointInBounds(pointer.x, pointer.y, stage) {
        cell_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        cell_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(cell_x, cell_y) {
            at := Index(cell_x, cell_y)
            if pointer.down && editor.board[at] != cast(u8)editor.brush {
                editor.board[at] = cast(u8)editor.brush
                editor.dirty = true
            }
            if secondary.down {
                original := OriginalTile(editor.level, cell_x, cell_y)
                if editor.board[at] != original {
                    editor.board[at] = original
                    editor.dirty = true
                }
            }
        }
    }

    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            raw := cast(s32)editor.board[at]
            kind := (raw & 127) - 39
            tile := raw & 127
            if kind >= 1 && kind <= 6 { tile = 0 }
            Tile(session, 5000 + cast(u64)at, stage, cast(s32)x, cast(s32)y, tile, tiles)
            if kind >= 1 && kind <= 6 {
                Sprite(session, 6200 + cast(u64)at, stage, Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8},
                    Rectangle.{cast(float32)(kind - 1) * 16.0, 32.0, 16.0, 16.0}, tiles)
            }
        }
    }
    // The fixed entrance and exit the game carves at runtime, marked so a
    // level is never drawn without its way in and out. These keys sit below
    // the canvas tile range, which starts at 5000.
    gate_x := stage.x + cast(float32)(board_columns / 2 - 1) * 16.0 * scale
    unused Box(session, BoxProps.{.key = 4998, .bounds = Rectangle.{gate_x,
        stage.y + cast(float32)(board_rows - 1) * 16.0 * scale, 48.0 * scale, 16.0 * scale},
        .fill = Color.{90, 220, 120, 70}})
    unused Box(session, BoxProps.{.key = 4999, .bounds = Rectangle.{gate_x,
        stage.y, 48.0 * scale, 16.0 * scale}, .fill = Color.{240, 90, 90, 70}})
    if !pointer.down && !secondary.down && Input.PointInBounds(pointer.x, pointer.y, stage) {
        hover_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        hover_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(hover_x, hover_y) {
            left := Snap(stage.x + cast(float32)hover_x * 16.0 * scale)
            top := Snap(stage.y + cast(float32)hover_y * 16.0 * scale)
            unused Box(session, BoxProps.{.key = 4997,
                .bounds = Rectangle.{left, top, Snap(stage.x + cast(float32)(hover_x + 1) * 16.0 * scale) - left,
                    Snap(stage.y + cast(float32)(hover_y + 1) * 16.0 * scale) - top},
                .fill = Color.{255, 255, 255, 60}})
        }
    }

    unused Box(session, BoxProps.{.key = 8200, .bounds = panel, .fill = Color.{24, 28, 36, 235}})
    level_text := FormatInteger(cast(s64)(editor.level % STAGE_LEVELS + 1), editor_digits[:])
    TextLine(session, 8202, "LEVEL", Rectangle.{panel.x + 8.0, panel.y + 8.0, 50.0, 20.0}, 14)
    TextLine(session, 8203, level_text, Rectangle.{panel.x + 60.0, panel.y + 8.0, 30.0, 20.0}, 14)
    TextLine(session, 8204, StageName(stage_of_level), Rectangle.{panel.x + 110.0, panel.y + 8.0, 90.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8224, .bounds = Rectangle.{panel.x + panel.width - 74.0, panel.y + 6.0, 30.0, 30.0},
            .label = "Turn the level", .icon_shape = "S2rr:M20 12A8 8 0 1 1 12 4M12 4L16 4M12 4L12 8",
            .icon_only = true, .tone = ifx editor.turned then ButtonTone.ButtonToneSuccess
                else ButtonTone.ButtonToneNeutral,
            .emphasis = ifx editor.turned then ButtonEmphasis.ButtonEmphasisFilled
                else ButtonEmphasis.ButtonEmphasisSoft}) != 0 { EditorTurn() }
    if editor.dirty {
        TextLine(session, 8205, "unsaved", Rectangle.{panel.x + 140.0, panel.y + 8.0, 60.0, 20.0}, 13)
    } else if editor.save_failed {
        unused Box(session, BoxProps.{.key = 8206, .bounds = Rectangle.{panel.x + 168.0, panel.y + 6.0, 74.0, 22.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8207, "SAVE FAILED", Rectangle.{panel.x + 170.0, panel.y + 8.0, 72.0, 18.0}, 12)
    }
    unused Box(session, BoxProps.{.key = 8208, .bounds = Rectangle.{panel.x + 8.0, panel.y + 34.0, 40.0, 40.0},
        .fill = Color.{255, 255, 255, 30}, .radius = 8.0})
    Picture(session, 8209, tiles, Rectangle.{panel.x + 9.0, panel.y + 35.0, 38.0, 38.0},
        Rectangle.{cast(float32)(editor.brush % 20) * 16.0, cast(float32)(editor.brush / 20) * 16.0, 16.0, 16.0})
    TextLine(session, 8210, "BRUSH", Rectangle.{panel.x + 56.0, panel.y + 34.0, 70.0, 18.0}, 13)
    brush_text := FormatInteger(cast(s64)editor.brush, brush_digits[:])
    TextLine(session, 8211, brush_text, Rectangle.{panel.x + 56.0, panel.y + 54.0, 40.0, 18.0}, 13)
    blocked := LevelBlockages(editor.board[:])
    if blocked != 0 {
        note := "entrance blocked"
        if blocked == 2 { note = "exit blocked" }
        else if blocked == 3 { note = "entry and exit blocked" }
        unused Box(session, BoxProps.{.key = 8212, .bounds = Rectangle.{panel.x + 8.0, panel.y + 80.0, 232.0, 20.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8213, note, Rectangle.{panel.x + 14.0, panel.y + 82.0, 220.0, 16.0}, 12)
    }

    inner := Rectangle.{panel.x + 8.0, panel.y + 104.0, panel.width - 16.0, panel.height - 254.0}
    palette := Scroll(session, ScrollProps.{.key = 8214, .bounds = inner, .content_height = 530,
        .scroll_offset = editor.palette_scroll})
    editor.palette_scroll = palette.scroll_offset
    if palette.opened {
        cursor := DrawPalettePart(session, 8300, palette.content, 6, "FLOOR", 0, 19, tiles,
            pointer.x, pointer.y, pointer.pressed)
        cursor = DrawPalettePart(session, 8400, palette.content, cursor, "WALL", 20, 17, tiles,
            pointer.x, pointer.y, pointer.pressed)
        cursor = DrawPalettePart(session, 8500, palette.content, cursor, "FALSE WALL", 128, 12, tiles,
            pointer.x, pointer.y, pointer.pressed)
        unused DrawPalettePart(session, 8600, palette.content, cursor, "MONSTERS", 40, 6, tiles,
            pointer.x, pointer.y, pointer.pressed)
        unused End(session)
    }

    bottom := panel.y + panel.height - 142.0
    TextLine(session, 8215, "APPLES", Rectangle.{panel.x + 8.0, bottom + 8.0, 64.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8216, .bounds = Rectangle.{panel.x + 76.0, bottom, 36.0, 32.0},
            .label = "Fewer apples", .icon_shape = "S2rr:M5 12L19 12", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(-1)
    }
    apple_text := FormatInteger(cast(s64)editor.apples, apple_digits[:])
    TextLine(session, 8217, apple_text, Rectangle.{panel.x + 120.0, bottom + 8.0, 28.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8218, .bounds = Rectangle.{panel.x + 152.0, bottom, 36.0, 32.0},
            .label = "More apples", .icon_shape = "S2rr:M12 5L12 19", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(1)
    }
    if Button(session, ButtonProps.{.key = 8219, .bounds = Rectangle.{panel.x + 8.0, bottom + 40.0, 110.0, 40.0},
            .label = "Save", .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorSave() }
    reset_label := ifx editor.reset_armed then "Sure?" else "Reset"
    if Button(session, ButtonProps.{.key = 8220, .bounds = Rectangle.{panel.x + 130.0, bottom + 40.0, 110.0, 40.0},
            .label = reset_label, .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ifx editor.reset_armed then ButtonEmphasis.ButtonEmphasisFilled
                else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        if editor.reset_armed { EditorReset() }
        else { editor.reset_armed = true }
    }
    if Button(session, ButtonProps.{.key = 8221, .bounds = Rectangle.{panel.x + 8.0, bottom + 88.0, 110.0, 40.0},
            .label = "Playtest", .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorPlaytest(now) }
    if Button(session, ButtonProps.{.key = 8222, .bounds = Rectangle.{panel.x + 130.0, bottom + 88.0, 110.0, 40.0},
            .label = "Stages", .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorExit() }
}

// The title screen: swipe, drag or arrow between the stage covers and the
// Level Editor page behind them. The play button starts the game where the
// run stands; picking a level is the editor's business, not the title's.
DrawStages :: (session: Session, area: Rectangle, key: s32, now: float64) -> bool {
    gesture := SwipeArea(session, SwipeAreaProps.{.key = 800, .bounds = area,
        .label = "Pages", .now = now, .min_distance = 48.0})
    delta: s32 = 0
    if gesture.swiped == 0 || key == 262 || key == 68 || key == 100 { delta = 1 }
    if gesture.swiped == 2 || key == 263 || key == 65 || key == 97 { delta = -1 }
    stage := Wrap(pager.selected)
    editor_page := stage == OPEN_STAGES
    level := ifx editor_page then game.level % STAGE_LEVELS else stage_levels[stage]
    start := (key == Input.KeyEnter || key == 32) && !editor_page
    open_editor := (key == Input.KeyEnter || key == 32) && editor_page

    pager.selected += delta
    elapsed := cast(float32)(now - pager.time)
    pager.time = now
    if elapsed < 0.0 || elapsed > 0.2 { elapsed = 0.016 }
    rate := elapsed * 10.0
    if rate > 1.0 { rate = 1.0 }
    if gesture.down {
        pager.position = cast(float32)pager.selected - (gesture.at_x - gesture.start_x) / area.width
    } else {
        pager.position += (cast(float32)pager.selected - pager.position) * rate
        distance := pager.position - cast(float32)pager.selected
        if distance < 0.002 && distance > -0.002 {
            pager.selected = Wrap(pager.selected)
            pager.position = cast(float32)pager.selected
        }
    }
    first := cast(s32)pager.position
    if cast(float32)first > pager.position { first -= 1 }
    for page: first..first + 1 {
        offset := (cast(float32)page - pager.position) * area.width
        if offset <= -area.width || offset >= area.width { continue }
        shown := Wrap(page)
        DrawStagePage(session, Rectangle.{area.x + offset, area.y, area.width, area.height}, shown)
    }

    stage = Wrap(pager.selected)
    banner := Rectangle.{area.x + (area.width - 430.0) / 2.0, area.y + 22.0, 430.0, 92.0}
    unused Box(session, BoxProps.{.key = 801, .bounds = banner, .fill = Color.{240, 242, 232, 248}, .radius = 16.0})
    unused Box(session, BoxProps.{.key = 811,
        .bounds = Rectangle.{banner.x + 18.0, banner.y, banner.width - 36.0, 5.0},
        .fill = Color.{46, 125, 74, 255}, .radius = 2.0})
    title := StageName(stage)
    subtitle := StageHero(stage)
    if editor_page {
        title = "LEVEL EDITOR"
        subtitle = "Remix the Garden's levels, then play them"
    }
    unused Text(session, TextProps.{.key = 802, .bounds = Rectangle.{banner.x, banner.y + 14.0, banner.width, 40.0},
        .text = title, .font = 32, .align = TextAlign.TextAlignCenter})
    unused Text(session, TextProps.{.key = 803, .bounds = Rectangle.{banner.x, banner.y + 58.0, banner.width, 24.0},
        .text = subtitle, .font = 16, .align = TextAlign.TextAlignCenter})
    middle := area.y + area.height / 2.0 - 26.0
    if Button(session, ButtonProps.{.key = 804, .bounds = Rectangle.{area.x + 14.0, middle, 52.0, 52.0},
            .label = "Previous page", .icon_shape = "S2rr:M15 5L8 12L15 19", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        pager.selected -= 1
    }
    if Button(session, ButtonProps.{.key = 805, .bounds = Rectangle.{area.x + area.width - 66.0, middle, 52.0, 52.0},
            .label = "Next page", .icon_shape = "S2rr:M9 5L16 12L9 19", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        pager.selected += 1
    }
    row := area.y + area.height - 78.0
    centre := area.x + area.width / 2.0
    // A quiet veil behind the controls keeps them readable on any cover.
    unused Box(session, BoxProps.{.key = 812,
        .bounds = Rectangle.{area.x, row - 22.0, area.width, area.height - (row - 22.0 - area.y)},
        .fill = Color.{10, 18, 12, 130}})
    if editor_page {
        if Button(session, ButtonProps.{.key = 808, .bounds = Rectangle.{centre - 150.0, row, 300.0, 52.0},
                .label = "Open the editor", .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { open_editor = true }
    } else {
        stage_levels[stage] = level
        play_text := FormatInteger(cast(s64)(level + 1), level_digits[:])
        if Button(session, ButtonProps.{.key = 808, .bounds = Rectangle.{centre - 150.0, row, 300.0, 52.0},
                .label = "Play level", .detail = play_text, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { start = true }
    }
    for page: cast(s32)0..PAGE_COUNT - 1 {
        unused Box(session, BoxProps.{.key = 810 + cast(u64)page,
            .bounds = Rectangle.{centre - cast(float32)(PAGE_COUNT - 1) * 12.0 + cast(float32)page * 24.0,
                row - 26.0, 12.0, 12.0},
            .fill = ifx page == stage then Color.{46, 125, 74, 235} else Color.{255, 255, 255, 210}, .radius = 6.0})
    }
    if open_editor {
        editor.browsing = true
        OpenEditor(game.level)
    }
    return start
}

HandleInput :: (key: s32, now: s64) {
    if key == 77 || key == 109 { Audio.ToggleMute(); return }
    if game.mode == MODE_PLAYING {
        if key == 82 || key == 114 { ReloadLevel(game.level, now) }
        else { unused ApplyInput(*game, key) }
    } else if game.mode == MODE_PAUSED {
        unused ApplyInput(*game, key)
        if game.mode == MODE_PLAYING { game.next_step = now + TICK_MS }
        if game.mode == MODE_STAGES { LeavePlay() }
    } else if game.mode == MODE_FINISHED {
        ReloadLevel(game.level + 1, now)
    } else if game.mode == MODE_DIED {
        if key == Input.KeyEnter || key == 32 { StartLevel(game.level, now, 1) }
        else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_VICTORY {
        if key == Input.KeyEnter || key == 32 || key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_EDITOR {
        if editor.browsing {
            if key == Input.KeyEscape || key == 76 || key == 108 || key == 69 || key == 101 {
                editor.browsing = false
            }
        } else if key == Input.KeyEscape || key == 69 || key == 101 { EditorExit() }
        else if key == 76 || key == 108 { EditorSave(); editor.browsing = true }
        else if key == 84 || key == 116 { EditorTurn() }
        else if key == 265 || key == 87 || key == 119 { EditorSwitch(-1) }
        else if key == 264 || key == 83 || key == 115 { EditorSwitch(1) }
        else if key == Input.KeyEnter || key == 32 || key == Input.KeyTab { EditorPlaytest(now) }
        else if key == 82 || key == 114 { EditorReloadSaved() }
        else if key == 45 || key == 95 { EditorSetApples(-1) }
        else if key == 61 || key == 43 { EditorSetApples(1) }
    }
}

// True while the window stands portrait: the board turns sideways and the
// steering keys turn with it, so Up always means visually up.
game_portrait: bool;

// A swipe steers like the arrow keys: never into the worm's own neck.
Steer :: (direction: s32) {
    if game.length >= 8 && direction != (game.direction + 2) % 4 { game.next_direction = direction }
}

// One cream value chip on the green bar; the default text colour stays
// readable on it the way it does on the stage banner.
Badge :: (session: Session, key: u64, text: string, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Color.{240, 242, 232, 248}, .radius = 7.0})
    TextLine(session, key + 1, text, Rectangle.{bounds.x, bounds.y + 4.0, bounds.width, bounds.height - 8.0}, 13)
}

// The green top bar: hearts for lives, the apple goal and the star score in
// play, the level and its stage at the right edge; the stages and the editor
// carry their hint instead of the play icons.
DrawTopBar :: (session: Session, hud: Rectangle) {
    unused Box(session, BoxProps.{.key = 10, .bounds = hud, .fill = Color.{31, 78, 46, 255}})
    icon: float32 = 20.0
    top := hud.y + (hud.height - icon) / 2.0
    at: float32 = hud.x + 12.0
    level_number := game.level % STAGE_LEVELS
    if game.mode == MODE_STAGES { level_number = stage_levels[Wrap(pager.selected)] }
    else if game.mode == MODE_EDITOR { level_number = editor.level % STAGE_LEVELS }
    level_text := FormatInteger(cast(s64)(level_number + 1), level_digits[:])
    // In play the level sits on the right; in the editor it is the left sign.
    if game.mode != MODE_EDITOR {
        Badge(session, 11, level_text, Rectangle.{hud.x + hud.width - 92.0, hud.y + 10.0, 36.0, 22.0})
        TextLine(session, 13, "/33", Rectangle.{hud.x + hud.width - 54.0, hud.y + 12.0, 30.0, 18.0}, 12)
    }

    if game.mode == MODE_EDITOR {
        // The level sign is the way into the level selector, Shovey-style.
        if Button(session, ButtonProps.{.key = 8225, .bounds = Rectangle.{hud.x + 12.0, hud.y + 5.0, 124.0, 32.0},
                .label = "Levels", .detail = level_text, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
            EditorSave()
            editor.browsing = true
        }
    } else {
        lives := game.lives
        if lives < 0 { lives = 0 }
        shown := lives
        if shown > 5 { shown = 5 }
        for index: 0..shown - 1 {
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{at, top, icon, icon},
                .shape = HeartIcon.Shape, .color = Color.{236, 90, 90, 255}})
            at += 23.0
        }
        if lives > 5 {
            extra := FormatInteger(cast(s64)(lives - 5), lives_digits[:])
            Badge(session, 17, extra, Rectangle.{at, hud.y + 10.0, 34.0, 22.0})
            at += 40.0
        }
        at += 8.0
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{at, top, icon, icon},
            .shape = AppleIcon.Shape, .color = Color.{242, 240, 224, 255}})
        apple_text := FormatInteger(cast(s64)game.apples, apple_digits[:])
        Badge(session, 18, apple_text, Rectangle.{at + 24.0, hud.y + 10.0, 32.0, 22.0})
        at += 66.0
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{at, top, icon, icon},
            .shape = StarIcon.Shape, .color = Color.{247, 203, 77, 255}})
        score_text := FormatInteger(cast(s64)game.score, score_digits[:])
        Badge(session, 19, score_text, Rectangle.{at + 24.0, hud.y + 10.0, 52.0, 22.0})
    }
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    now := Timer.MonotonicMilliseconds()
    // The game opens on the stages.
    if !game.started { game.started = true; OpenStages() }
    game_portrait = viewport.height > viewport.width
    water_frame = cast(s32)((now / 130) % 3)
    key := KeyboardTake(session)
    // A key that returns to the stages must not also start a level there.
    stage_key := ifx game.mode == MODE_STAGES then key else 0
    HandleInput(key, now)
    unused Step(*game, now)
    Audio.UpdateAudio(game.mode == MODE_PLAYING || game.mode == MODE_PAUSED,
        game.level, game.apples, game.death_ticks, game.transition_ticks)
    unused Box(session, BoxProps.{.key = 1, .bounds = viewport, .fill = Color.{0, 0, 0, 255}})
    // The stages screen is one full-bleed cover; every other mode carries the
    // green icon bar across the top with the board letterboxed below it, so
    // portrait and landscape both keep their proportions.
    showing_bar := game.mode != MODE_STAGES
    bar_height: float32 = ifx showing_bar then 42.0 else 0.0
    hud := Rectangle.{viewport.x, viewport.y, viewport.width, bar_height}
    available_height := viewport.height - bar_height
    if available_height < 1.0 { available_height = 1.0 }
    stage := BoardIn(Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height})
    if game.mode == MODE_STAGES {
        area := Rectangle.{viewport.x, viewport.y, viewport.width, viewport.height}
        if DrawStages(session, area, stage_key, cast(float64)now / 1000.0) {
            chosen := Wrap(pager.selected)
            StartLevel(chosen * STAGE_LEVELS + stage_levels[chosen], now, cast(u32)(now & 4294967295))
        }
    } else if game.mode == MODE_EDITOR {
        area := Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height}
        DrawEditor(session, area, now)
    } else {
        DrawBoard(session, stage)
        // A swipe steers like the arrow keys, so touch plays in any orientation.
        if game.mode == MODE_PLAYING {
            gesture := SwipeArea(session, SwipeAreaProps.{.key = 820, .bounds = stage,
                .label = "Steer the worm", .now = cast(float64)now / 1000.0, .min_distance = 20.0})
            if gesture.swiped == 0 { Steer(DIR_LEFT) }
            else if gesture.swiped == 1 { Steer(DIR_UP) }
            else if gesture.swiped == 2 { Steer(DIR_RIGHT) }
            else if gesture.swiped == 3 { Steer(DIR_DOWN) }
        }
    }
    if showing_bar { DrawTopBar(session, hud) }
    if game.mode == MODE_PAUSED { Overlay(session, stage, "PAUSED", "Esc resumes   Q returns to the stages") }
    else if game.mode == MODE_DIED { Overlay(session, stage, "GAME OVER", "Enter retries · Esc returns to the stages", game.score) }
    else if game.mode == MODE_VICTORY { Overlay(session, stage, StageClear(StageOf(game.level)), "All 33 levels done · Enter returns to the stages", game.score) }
    return 0
}
