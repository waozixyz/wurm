PLAY_STEERING_KEY :: 100000;
WORM_BODY_SIZE :: 16.5;
WORM_HEAD_SIZE :: 19.0;
WORM_DRAW_STEP :: 3;

// The playable board: the recovered 40x30 grid of 16-pixel cells.
BOARD_WIDTH :: 640.0;
BOARD_HEIGHT :: 480.0;

game: Game;
level_digits: [21]u8;
score_digits: [21]u8;
apple_digits: [21]u8;

// The level editor paints one level's raw tiles and apple count, and saves
// them as an override beside the recovered originals (custom_levels.zi).
EDITOR_PANEL_WIDTH :: 248.0;
// Brush values: 0..127 paint tiles; 128 is the smart hedge.
BRUSH_SMART_WALL :: 128;
EditorState :: struct {
    level: s32
    board: [CELLS]u8
    objects: [CELLS]u8
    apples: s32
    brush: s32
    dirty: bool
    save_failed: bool
    reset_armed: bool
    palette_scroll: s32
    playtest: bool
    browsing: bool
    turned: bool
}
editor: EditorState;
editor_digits: [21]u8;
brush_digits: [21]u8;

StageName :: (stage: s32) -> string {
    if stage == 1 { return "Leafwood" }
    if stage == 2 { return "Pinewood" }
    if stage == 3 { return "Lake" }
    if stage == 4 { return "Mountains" }
    return "Meadow"
}
StageKey :: (stage: s32) -> string {
    if stage == 1 { return "leafwood-" }
    if stage == 2 { return "pinewood-" }
    if stage == 3 { return "lake-" }
    if stage == 4 { return "mountains-" }
    return "meadow-"
}

// Terrain keeps the stable 20-column tile coordinates; every landscape
// shares the same orange worm and apples.
SHEET_SCALE :: 2.0;
Sheet :: (stage: s32) -> string {
    if stage == 1 { return ART_LEAFWOOD }
    if stage == 2 { return ART_PINEWOOD }
    if stage == 3 { return ART_LAKE }
    if stage == 4 { return ART_MOUNTAINS }
    return ART_MEADOW
}
preview_path: [64]u8;
PreviewPath :: (stage: s32, number: s32, portrait: bool = false) -> string {
    digits: [16]u8
    at := CopyInto(preview_path[:], 0, ART_PREVIEWS)
    at = CopyInto(preview_path[:], at, StageKey(stage))
    at = CopyInto(preview_path[:], at, FormatInteger(cast(s64)number, digits[:]))
    if portrait { at = CopyInto(preview_path[:], at, "-portrait") }
    at = CopyInto(preview_path[:], at, ".png")
    preview_path[at] = 0
    return TextUntilNul(preview_path[:])
}
CopyInto :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}
Picture :: (session: Session, key: u64, asset: string, bounds: Rectangle, source: Rectangle) {
    unused Image(session, ImageProps.{.key = key, .asset_path = asset, .bounds = bounds,
        .source = Rectangle.{source.x * SHEET_SCALE, source.y * SHEET_SCALE,
            source.width * SHEET_SCALE, source.height * SHEET_SCALE},
        .smooth = true, .alt_text = "Worm artwork"})
}

TextLine :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text,
        .font = size, .wrap = TextWrap.TextWrapNone})
}

CentreText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text,
        .font = size, .align = TextAlign.TextAlignCenter})
}

#if !#defined(WURM_PORTABLE) {
// A single visual language for the title, HUD and every dialog. These are
// ordinary Kryon style rules, shared by desktop and Android.
styles_ready: bool;
GameSelector :: (kind: s32, class_name: s32 = 0) -> StyleSelector {
    return StyleSelector.{.kind = kind, .class_name = class_name, .role = -1,
        .tone = -1, .emphasis = -1, .size = -1, .state = -1, .validation = -1,
        .orientation = -1, .placement = -1}
}
GameStyles :: () {
    if styles_ready { return }
    rules := ActiveStyleRules()
    at := rules.count
    rules.items[at] = StyleRule.{.selector = GameSelector(StyleKindText()),
        .style = StyleData.{.fields = 2, .foreground = 0x244734FF}}
    rules.items[at + 1] = StyleRule.{.selector = GameSelector(StyleKindText(), 2),
        .style = StyleData.{.fields = 2, .foreground = 0x596D54FF}}
    rules.items[at + 2] = StyleRule.{.selector = GameSelector(StyleKindButton()),
        .style = StyleData.{.fields = 1040, .font_size = 16.0, .radius = 16.0}}
    // Filled and quiet actions keep readable contrast in every host theme.
    rules.items[at + 3] = StyleRule.{.selector = GameSelector(StyleKindButton(), 10),
        .style = StyleData.{.fields = 1079, .background = 0x326A45FF, .foreground = 0xFFF9E9FF,
            .border = 0x265437FF, .border_width = 2.0, .radius = 24.0, .font_size = 21.0}}
    rules.items[at + 4] = StyleRule.{.selector = GameSelector(StyleKindButton(), 11),
        .style = StyleData.{.fields = 1079, .background = 0xE8EEDAFF, .foreground = 0x31533EFF,
            .border = 0xD5DFC4FF, .border_width = 1.0, .radius = 20.0, .font_size = 17.0}}
    rules.items[at + 5] = StyleRule.{.selector = GameSelector(StyleKindButton(), 13),
        .style = StyleData.{.fields = 1079, .background = 0xF5CE64FF, .foreground = 0x274734FF,
            .border = 0xD8AE4BFF, .border_width = 2.0, .radius = 30.0, .font_size = 22.0}}
    rules.items[at + 6] = StyleRule.{.selector = GameSelector(StyleKindButton(), 14),
        .style = StyleData.{.fields = 3639,
            .background = 0xFFFAEAFF, .foreground = 0x244734FF, .border = 0x508658FF,
            .border_width = 1.0, .radius = 12.0, .font_size = 17.0, .icon_size = 80.0, .gap = 6.0}}
    rules.count = at + 7
    styles_ready = InstallStyleRules(rules)
}
}

