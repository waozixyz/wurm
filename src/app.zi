StageName :: (stage: s32) -> string {
    if stage == 1 { return "Leafwood" }
    if stage == 2 { return "Pinewood" }
    if stage == 3 { return "Lake" }
    if stage == 4 { return "Mountains" }
    return "Meadow"
}
StageKey :: (stage: s32) -> string {
    if stage == 1 { return "leafwood-" }
    if stage == 2 { return "pinewood-" }
    if stage == 3 { return "lake-" }
    if stage == 4 { return "mountains-" }
    return "meadow-"
}

// Terrain keeps the stable 20-column tile coordinates; every landscape
// shares the same orange worm and apples.
SHEET_SCALE :: 2.0;
Sheet :: (stage: s32) -> string {
    if stage == 1 { return ART_LEAFWOOD }
    if stage == 2 { return ART_PINEWOOD }
    if stage == 3 { return ART_LAKE }
    if stage == 4 { return ART_MOUNTAINS }
    return ART_MEADOW
}
preview_path: [64]u8;
PreviewPath :: (stage: s32, number: s32, portrait: bool = false) -> string {
    digits: [16]u8
    at := CopyInto(preview_path[:], 0, ART_PREVIEWS)
    at = CopyInto(preview_path[:], at, StageKey(stage))
    at = CopyInto(preview_path[:], at, FormatInteger(cast(s64)number, digits[:]))
    if portrait { at = CopyInto(preview_path[:], at, "-portrait") }
    at = CopyInto(preview_path[:], at, ".png")
    preview_path[at] = 0
    return TextUntilNul(preview_path[:])
}
CopyInto :: (buffer: []u8, at: s32, text: string) -> s32 {
    for index: 0..text.count - 1 { buffer[at + index] = text[index] }
    return at + cast(s32)text.count
}
Picture :: (session: Session, key: u64, asset: string, bounds: Rectangle, source: Rectangle) {
    unused Image(session, ImageProps.{.key = key, .asset_path = asset, .bounds = bounds,
        .source = Rectangle.{source.x * SHEET_SCALE, source.y * SHEET_SCALE,
            source.width * SHEET_SCALE, source.height * SHEET_SCALE},
        .smooth = true, .alt_text = "Worm artwork"})
}

TextLine :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text),
        .font = size, .wrap = TextWrap.TextWrapNone})
}

CentreText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text),
        .font = size, .align = TextAlign.TextAlignCenter})
}


GamePointer :: (session: Session) -> Input.PointerFrame {
    #if #defined(WURM_PORTABLE) {
        unused session
        return SamplePointer()
    } else {
        return PointerSample(session)
    }
}
GameSecondaryPointer :: (session: Session) -> Input.SecondaryPointerFrame {
    #if #defined(WURM_PORTABLE) {
        unused session
        return Input.SecondaryPointerFrame.{}
    } else {
        return SecondaryPointerSample(session)
    }
}

NavigateBack :: (now: s64) -> bool {
    if game.mode == MODE_STAGES { return false }
    HandleInput(Input.KeyEscape, now)
    return true
}
GameText :: (session: Session, key: u64, text: string, bounds: Rectangle, size: s32, muted: bool = false,
             centre: bool = false) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = Locale.Text(text), .font = size,
        .class_name = ifx muted then 2 else 0, .align = ifx centre then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
        .wrap = TextWrap.TextWrapNone})
}

sound_loaded: bool;
preferences_dirty: bool;
preferences_poll: s64;
PreferencesChanged :: () { preferences_dirty = true; preferences_poll = 0 }
PreferencesPump :: (now: s64) {
    if now < preferences_poll || Progress.owner[0] == 0 { return }
    preferences_poll = now + 5000
    if preferences_dirty {
        out: Vec(u8)
        BuilderPrint(*out, "{\"operation\":\"put\",\"kind\":\"wurm-settings\",\"id\":\"00000000000000000000000000000001\",\"schema\":\"wurm.settings.v1\",\"document\":{\"theme\":%,\"pad\":%,\"muted\":%,\"skin\":%,\"volume\":%}}",
            Appearance.mode, Controls.Pad(), Audio.muted, Wardrobe.skin, Audio.volume)
        answer := Account.Service("entity.records", TextView(VecSlice(out, 0, out.count)))
        done: [16]u8
        preferences_dirty = ReadStringText(answer, FieldAt(answer, 0, "status"), done[:]) < 0 || TextUntilNul(done[:]) != "done"
        VecFree(out)
        return
    }
    reply := Account.Service("entity.records", "{\"operation\":\"get\",\"kind\":\"wurm-settings\",\"id\":\"00000000000000000000000000000001\"}")
    document := FieldAt(reply, 0, "document")
    if document < 0 { return }
    theme := ReadNumber(reply, FieldAt(reply, document, "theme"))
    if Account.SharedTheme() < 0 && theme.valid && theme.value >= 0.0 && theme.value <= 2.0 && theme.value == cast(float64)cast(s32)theme.value &&
    cast(s32)theme.value != Appearance.mode { Appearance.Set(cast(s32)theme.value) }
    pad := FieldAt(reply, document, "pad")
    if pad >= 0 && (reply[pad] == #char "t" || reply[pad] == #char "f") {
        desired := reply[pad] == #char "t"
        if !Controls.Chosen() || Controls.Pad() != desired { unused Controls.SetPad(desired) }
    }
    sound := FieldAt(reply, document, "muted")
    if sound >= 0 && (reply[sound] == #char "t" || reply[sound] == #char "f") &&
    Audio.muted != (reply[sound] == #char "t") { Audio.ToggleMute() }
    gain := ReadNumber(reply,FieldAt(reply,document,"volume"))
    if gain.valid && gain.value >= 0.0 && gain.value <= 100.0 && gain.value == cast(float64)cast(s32)gain.value {
        Audio.SetVolume(cast(s32)gain.value)
    }
    chosen := ReadNumber(reply, FieldAt(reply, document, "skin"))
    if chosen.valid && chosen.value >= 0.0 && chosen.value <= 8.0 && chosen.value == cast(float64)cast(s32)chosen.value &&
    Wardrobe.Available(cast(s32)chosen.value) {
        Wardrobe.skin = cast(s32)chosen.value
        Wardrobe.Save()
    }
}
LoadSound :: () {
    if sound_loaded { return }
    sound_loaded = true
    bytes: [2]u8
    count := Controls.ReadRecord("sound.dat", bytes[:])
    if count >= 1 && bytes[0] == 1 && !Audio.muted { Audio.ToggleMute() }
    if count == 2 && bytes[1] <= 100 { Audio.SetVolume(cast(s32)bytes[1]) }
}
SaveSound :: () {
    bytes: [2]u8 = .[ifx Audio.muted then cast(u8)1 else cast(u8)0,cast(u8)Audio.volume]
    unused Controls.WriteRecord("sound.dat", bytes[:])
    PreferencesChanged()
}
ToggleSound :: () {
    LoadSound()
    if Audio.volume == 0 {
        Audio.SetVolume(100)
        if Audio.muted { Audio.ToggleMute() }
    } else { Audio.ToggleMute() }
    SaveSound()
}
sound_popup: bool;
sound_percent: [24]u8;
DrawSoundPopup :: (session: Session, hud: Rectangle, trigger: Rectangle) {
    if !sound_popup { return }
    width: float32 = 248.0
    if width > hud.width - 16.0 { width = hud.width - 16.0 }
    left := trigger.x + trigger.width - width
    if left < hud.x + 8.0 { left = hud.x + 8.0 }
    panel := Rectangle.{left,trigger.y + trigger.height + 8.0,width,140.0}
    popup := Popup(session,PopupProps.{.key=24100,.bounds=panel,.keep_bounds=trigger})
    if popup.closed { sound_popup = false; return }
    if popup.panel_node < 0 || !TreePushScope(session,popup.panel_node) { return }
    unused Box(session,BoxProps.{.key=24101,.bounds=panel,.fill=Appearance.Surface(),.border=Appearance.Border(),.radius=12.0})
    GameText(session,24102,Locale.Text("Sound"),Rectangle.{panel.x+16.0,panel.y+14.0,panel.width-120.0,32.0},16)
    if Button(session,ButtonProps.{.key=24103,.bounds=Rectangle.{panel.x+panel.width-96.0,panel.y+10.0,80.0,40.0},
        .label=Locale.Text(ifx Audio.muted || Audio.volume == 0 then "Off" else "On"),.selected=!Audio.muted && Audio.volume>0}) != 0 { ToggleSound() }
    if Audio.CanSetVolume() {
        text := FormatInteger(cast(s64)Audio.volume,sound_percent[:])
        result := Slider(session,SliderProps.{.key=24104,.id=24104,
            .bounds=Rectangle.{panel.x+16.0,panel.y+66.0,panel.width-32.0,58.0},
            .label=Locale.Text("Volume"),.value_text=text,.semantic_label=Locale.Text("Volume"),
            .value=cast(float32)Audio.volume,.min=0.0,.max=100.0})
        if result.changed {
            Audio.SetVolume(cast(s32)(result.value+0.5))
            if Audio.volume > 0 && Audio.muted { Audio.ToggleMute() }
            SaveSound()
        }
    }
    unused End(session)
}
dew_text: [32]u8;
skin_price_text: [64]u8;
SkinPriceText :: (id: s32) -> string {
    digits: [32]u8
    if !DewFormat(ShopModel.GameShopPrice(id), DewUnits, digits[:]) { return "" }
    at := CopyInto(skin_price_text[:], 0, TextUntilNul(digits[:]))
    at = CopyInto(skin_price_text[:], at, " Dew")
    skin_price_text[at] = 0
    return TextUntilNul(skin_price_text[:])
}
DewText :: () -> string {
    reply := Account.Service("entity.dew", "balance")
    units := ReadNumber(reply, FieldAt(reply, 0, "units"))
    if units.valid && units.value < 0.0 { return "…" }
    value := ifx units.valid && units.value >= 0.0 then cast(s64)units.value else cast(s64)0
    if !DewFormat(value, DewUnits, dew_text[:]) { return "0" }
    return TextUntilNul(dew_text[:])
}
TitleActions :: (session: Session, area: Rectangle) {
    right := area.x + area.width - 12.0
    top := area.y + 12.0
    shop_right := right - 224.0
    #if #defined(WURM_PORTABLE) {
        // Embedded games use the enclosing host's navigation and account UI.
        shop_right = right - 48.0
    }
    if Button(session, ButtonProps.{.key = 28000, .bounds = Rectangle.{shop_right - 44.0, top, 44.0, 44.0},
            .label = Locale.Text("Skin shop"), .icon_only = true, .icon_shape = "S1.8rr:M5 8H19L20 21H4ZM8 8V6C8 1 16 1 16 6V8",
            .class_name = 11}) != 0 { game.mode = MODE_SHOP; Wardrobe.poll_at = 0; unused Account.Service("entity.game-shop", "refresh") }
    #if !#defined(WURM_PORTABLE) {
        if Button(session, ButtonProps.{.key = 28001, .bounds = Rectangle.{right - 216.0, top, 68.0, 44.0},
                .label = DewText(), .icon_shape = DewIcon.Shape,
                .class_name = 11}) != 0 { Account.OpenDew() }
        if Button(session, ButtonProps.{.key = 28002, .bounds = Rectangle.{right - 140.0, top, 44.0, 44.0},
                .label = Locale.Text("Profile"), .icon_only = true, .icon_shape = ProfileIcon.Shape,
                .class_name = 11}) != 0 { Account.OpenProfile() }
        if Button(session, ButtonProps.{.key = 28004, .bounds = Rectangle.{right - 92.0, top, 44.0, 44.0},
                .label = Locale.Text("Leaderboard"), .icon_only = true, .icon_shape = "S1.8rr:M4 21V13H8V21M10 21V4H14V21M16 21V9H20V21",
                .class_name = 11}) != 0 { Account.OpenLeaderboard() }
    }
    if Button(session, ButtonProps.{.key = 28003, .bounds = Rectangle.{right - 44.0, top, 44.0, 44.0},
            .label = Locale.Text("Settings"), .icon_only = true, .icon_shape = "S1.8rr:M4 6H20M4 12H20M4 18H20M8 3V9M16 9V15M10 15V21",
            .class_name = 11}) != 0 { game.mode = MODE_SETTINGS }
}
PageHeading :: (session: Session, area: Rectangle, title: string) {
    unused Box(session, BoxProps.{.key = 28100, .bounds = area, .fill = Appearance.Canvas()})
    GameText(session, 28101, title, Rectangle.{area.x + 108.0, area.y + 18.0, area.width - 124.0, 32.0}, 24)
    if Button(session, ButtonProps.{.key = 28102, .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 84.0, 44.0},
            .label = Locale.Text("Back"), .class_name = 11}) != 0 { game.mode = MODE_STAGES; buy_skin = 0 }
}
settings_scroll: s32;
DrawSettings :: (session: Session, area: Rectangle) {
    PageHeading(session, area, "Settings")
    width := area.width - 32.0
    if width > 540.0 { width = 540.0 }
    scroller := Scroll(session, ScrollProps.{.key = 28200,
        .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + 76.0, width, area.height - 88.0},
        .content_height = 370, .scroll_offset = settings_scroll})
    settings_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    x := scroller.content.x; y := scroller.content.y; width = scroller.content.width
    if Button(session, ButtonProps.{.key = 28201, .bounds = Rectangle.{x, y, width, 60.0},
            .label = Locale.Text("Appearance"), .class_name = 11}) != 0 { Account.OpenAppearance() }
    GameText(session, 28220, "Controls", Rectangle.{x, y + 150.0, width, 28.0}, 20)
    half := (width - 8.0) / 2.0
    if Button(session, ButtonProps.{.key = 28221, .bounds = Rectangle.{x, y + 188.0, half, 52.0},
            .label = Locale.Text("Swipe"), .selected = !Controls.Pad(), .class_name = 11}) != 0 { unused Controls.SetPad(false); PreferencesChanged() }
    if Button(session, ButtonProps.{.key = 28222, .bounds = Rectangle.{x + half + 8.0, y + 188.0, half, 52.0},
            .label = Locale.Text("Direction pad"), .selected = Controls.Pad(), .class_name = 11}) != 0 { unused Controls.SetPad(true); PreferencesChanged() }
    GameText(session, 28230, "Sound", Rectangle.{x, y + 270.0, width - 104.0, 32.0}, 20)
    if Button(session, ButtonProps.{.key = 28231, .bounds = Rectangle.{x + width - 100.0, y + 260.0, 100.0, 52.0},
            .label = Locale.Text(ifx Audio.muted then "Off" else "On"), .selected = !Audio.muted, .class_name = 11}) != 0 { ToggleSound() }
    GameText(session, 28240, "Version", Rectangle.{x, y + 332.0, width - 104.0, 24.0}, 14, true)
    GameText(session, 28241, Version.AppVersion, Rectangle.{x + width - 100.0, y + 332.0, 100.0, 24.0}, 14, true)
    unused End(session)
}

SkinName :: (id: s32) -> string {
    if id == 1 { return "Mint" }
    if id == 2 { return "Berry" }
    if id == 3 { return "Rose" }
    if id == 4 { return "Night owl" }
    if id == 5 { return "Golden apple" }
    if id == 6 { return "Explorer" }
    if id == 7 { return "Moon dragon" }
    if id == 8 { return "Winter cheer" }
    return "Apfelwurm"
}
SkinColor :: (id: s32) -> Color {
    if id == 1 { return Color.{94, 192, 151, 255} }
    if id == 2 { return Color.{154, 119, 207, 255} }
    if id == 3 { return Color.{221, 133, 151, 255} }
    if id == 4 { return Color.{107, 139, 199, 255} }
    if id == 5 { return Color.{227, 185, 80, 255} }
    if id == 6 { return Color.{135, 173, 91, 255} }
    return Color.{236, 151, 67, 255}
}
CharacterPreview :: (session: Session, key: u64, bounds: Rectangle, id: s32) {
    for segment: 0..2 {
        size := 21.0 + cast(float32)segment * 4.0
        x := bounds.x + cast(float32)segment * 16.0
        y := bounds.y + 22.0 - cast(float32)segment * 5.0
        Character(session, key + cast(u64)segment * 8, Rectangle.{x, y, size, size}, id, false)
    }
    Character(session, key + 24, Rectangle.{bounds.x + 43.0, bounds.y + 1.0, 42.0, 42.0}, id, true, 1)
}
Character :: (session: Session, key: u64, bounds: Rectangle, id: s32, head: bool, direction: s32 = 2) {
    if id == 0 {
        column := ifx head then direction else 4
        Picture(session, key, Sheet(0), bounds,
            Rectangle.{cast(float32)column * 16.0, 48.0, 16.0, 16.0})
        return
    }
    if id == 7 || id == 8 {
        column := ifx id == 7 then 0 else 2
        if !head { column += 1 }
        unused Image(session, ImageProps.{.key = key, .asset_path = "assets/art/special-skins.png",
            .bounds = bounds, .source = Rectangle.{cast(float32)column * 543.0, 0.0, 543.0, 724.0},
            .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = Locale.Text(SkinName(id))})
        return
    }
    size := bounds.width
    if bounds.height < size { size = bounds.height }
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = SkinColor(id), .radius = size / 2.0,
        .border = Color.{30, 48, 35, 100}})
    if !head { return }
    dx: float32 = ifx direction == 0 then -1.0 else ifx direction == 2 then 1.0 else 0.0
    dy: float32 = ifx direction == 1 then -1.0 else ifx direction == 3 then 1.0 else 0.0
    cx := bounds.x + bounds.width / 2.0 + dx * size * 0.14
    cy := bounds.y + bounds.height / 2.0 + dy * size * 0.14
    eye := size * 0.18
    for side: 0..1 {
        sign: float32 = ifx side == 0 then -1.0 else 1.0
        x := cx - dy * size * 0.2 * sign - eye / 2.0
        y := cy + dx * size * 0.2 * sign - eye / 2.0
        unused Box(session, BoxProps.{.key = key + 1 + cast(u64)side, .bounds = Rectangle.{x, y, eye, eye},
            .fill = Color.{246, 244, 223, 255}, .radius = eye / 2.0})
        unused Box(session, BoxProps.{.key = key + 3 + cast(u64)side,
            .bounds = Rectangle.{x + eye * 0.3, y + eye * 0.3, eye * 0.5, eye * 0.5},
            .fill = Color.{28, 44, 35, 255}, .radius = eye / 2.0})
    }
    if id >= 4 {
        shape := ifx id == 4 then MoonIcon.Shape else ifx id == 5 then StarIcon.Shape else "S2rr:M3 19L9 5L15 15L18 10L22 19Z"
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + size * 0.3, bounds.y - size * 0.18, size * 0.4, size * 0.4},
            .shape = shape, .color = Color.{249, 229, 157, 255}})
    }
}
shop_scroll: s32;
buy_skin: s32;
DrawShop :: (session: Session, area: Rectangle) {
    PageHeading(session, area, "Skin shop")
    GameText(session, 28300, "A little change of character.", Rectangle.{area.x + 16.0, area.y + 68.0, area.width - 32.0, 24.0}, 15, true)
    if buy_skin > 0 {
        id := buy_skin
        width := area.width - 32.0
        if width > 360.0 { width = 360.0 }
        x := area.x + (area.width - width) / 2.0; y := area.y + 112.0
        Character(session, 28320, Rectangle.{x + width / 2.0 - 26.0, y, 52.0, 52.0}, id, true)
        GameText(session, 28311, SkinName(id), Rectangle.{x, y + 68.0, width, 28.0}, 22, false, true)
        price := SkinPriceText(id)
        GameText(session, 28312, price, Rectangle.{x, y + 106.0, width, 24.0}, 18, false, true)
        pending := TextUntilNul(Wardrobe.status[:]) == "pending"
        signin := Progress.owner[0] == 0 || TextUntilNul(Wardrobe.status[:]) == "signin"
        if Wardrobe.Available(id) { buy_skin = 0; Wardrobe.Select(id); PreferencesChanged(); return }
        if Button(session, ButtonProps.{.key = 28313, .bounds = Rectangle.{x, y + 150.0, width, 48.0},
                .label = Locale.Text(ifx signin then "Sign in" else ifx pending then "Please wait…" else "Confirm purchase"),
                .disabled = pending && !signin, .class_name = 10}) != 0 {
            if signin { Account.OpenProfile() }
            else {
                product := ShopModel.GameShopProduct(id)
                unused Account.Service("entity.game-shop", product)
                Wardrobe.poll_at = 0
            }
        }
        if Button(session, ButtonProps.{.key = 28314, .bounds = Rectangle.{x, y + 210.0, width, 44.0}, .label = Locale.Text("Cancel"), .class_name = 11}) != 0 { buy_skin = 0 }
        failed := TextUntilNul(Wardrobe.status[:]) == "failed" || TextUntilNul(Wardrobe.status[:]) == "insufficient"
        if failed { GameText(session, 28315, "Purchase not confirmed. Check your Dew and retry.", Rectangle.{x, y + 264.0, width, 24.0}, 12, true, true) }
        Wardrobe.poll_at = 0
        return
    }
    grid := Rectangle.{area.x + 16.0, area.y + 108.0, area.width - 32.0, area.height - 120.0}
    columns: s32 = ifx grid.width >= 650.0 then 3 else 2
    width := (grid.width - 16.0 - cast(float32)(columns - 1) * 12.0) / cast(float32)columns
    skin_count: s32 = ifx Wardrobe.christmas_claimable || Wardrobe.Available(8) then 9 else ifx Wardrobe.special_supported || Wardrobe.Available(7) then 8 else 7
    rows := (skin_count + columns - 1) / columns
    scroller := Scroll(session, ScrollProps.{.key = 28400, .bounds = grid, .content_height = rows * 196, .scroll_offset = shop_scroll})
    shop_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    for id: 0..skin_count - 1 {
        x := scroller.content.x + cast(float32)(id % columns) * (width + 12.0)
        y := scroller.content.y + cast(float32)(id / columns) * 196.0
        key := cast(u64)28500 + cast(u64)id * 100
        unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x, y, width, 184.0}, .fill = Appearance.Surface(), .radius = 16.0})
        CharacterPreview(session, key + 20, Rectangle.{x + width / 2.0 - 42.0, y + 10.0, 84.0, 50.0}, cast(s32)id)
        GameText(session, key + 8, SkinName(cast(s32)id), Rectangle.{x + 4.0, y + 68.0, width - 8.0, 24.0}, 17, false, true)
        available := Wardrobe.Available(cast(s32)id)
        detail := ifx id == 0 then "Your first companion" else ifx id <= 3 || id == 7 then SkinPriceText(cast(s32)id) else ifx id == 4 then "Play for 5 hours" else ifx id == 5 then "Reach level 40" else ifx id == 8 then "Free · December 2026" else "Visit waozi.xyz"
        GameText(session, key + 9, detail, Rectangle.{x + 4.0, y + 99.0, width - 8.0, 22.0}, 12, true, true)
        label := ifx Wardrobe.skin == id then "Wearing" else ifx available then "Wear" else ifx id <= 3 || id == 7 then "Buy" else ifx id == 8 then "Claim" else ifx id == 6 then "Visit" else "Locked"
        if Button(session, ButtonProps.{.key = key + 10, .bounds = Rectangle.{x + 10.0, y + 132.0, width - 20.0, 42.0},
                .label = Locale.Text(label), .disabled = Wardrobe.skin == id || (!available && (id == 4 || id == 5)),
                .selected = Wardrobe.skin == id, .class_name = 11}) != 0 {
            if available { Wardrobe.Select(cast(s32)id); PreferencesChanged() }
            else if id <= 3 || id == 7 { buy_skin = cast(s32)id }
            else if id == 8 { unused Account.Service("entity.game-shop", "wurm.christmas-2026"); Wardrobe.poll_at = 0 }
            else if id == 6 && Account.VisitWebsite() { Wardrobe.Visit(); Wardrobe.Select(6); PreferencesChanged() }
        }
    }
    unused End(session)
}

// Pause, game over and completion use the same roomy card, with full-width
// touch actions. Short landscape screens use the compact composition.
Overlay :: (session: Session, area: Rectangle, title: string, message: string, score: s32 = -1) {
    unused Box(session, BoxProps.{.key = 50, .bounds = area, .fill = Color.{17, 38, 27, 155}})
    compact := area.height < 400.0
    width := area.width - 32.0
    if width > 360.0 { width = 360.0 }
    height: float32 = ifx compact then 252.0 else 292.0
    if score >= 0 { height = ifx compact then 288.0 else 340.0 }
    if game.mode == MODE_PAUSED { height += 56.0 }
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    unused Box(session, BoxProps.{.key = 51,
        .bounds = Rectangle.{card.x, card.y + 6.0, card.width, card.height},
        .fill = Color.{10, 30, 18, 70}, .radius = 28.0})
    unused Box(session, BoxProps.{.key = 52, .bounds = card,
        .fill = Appearance.Surface(), .border = Appearance.Border(), .radius = 28.0})
    title_y: float32 = ifx compact then 22.0 else 86.0
    if !compact {
        centre := card.x + card.width / 2.0
        unused Box(session, BoxProps.{.key = 53,
            .bounds = Rectangle.{centre - 27.0, card.y + 22.0, 54.0, 54.0},
            .fill = Appearance.Canvas(), .radius = 27.0})
        shape := "F:M7 5H10V19H7ZM14 5H17V19H14Z"
        color := Color.{65, 113, 68, 255}
        if game.mode == MODE_DIED { shape = HeartIcon.Shape; color = Color.{213, 95, 89, 255} }
        else if game.mode == MODE_VICTORY { shape = StarIcon.Shape; color = Color.{218, 153, 45, 255} }
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{centre - 14.0, card.y + 35.0, 28.0, 28.0},
            .shape = shape, .color = color})
    }
    GameText(session, 54, title, Rectangle.{card.x + 12.0, card.y + title_y, card.width - 24.0, 36.0}, 28, false, true)
    GameText(session, 55, message, Rectangle.{card.x + 16.0, card.y + title_y + 42.0, card.width - 32.0, 24.0}, 15, true, true)
    if score >= 0 {
        score_y := card.y + title_y + 80.0
        GameText(session, 56, "SCORE", Rectangle.{card.x + 22.0, score_y + 4.0, card.width / 2.0 - 22.0, 22.0}, 12, true)
        score_text := FormatInteger(cast(s64)score, score_digits[:])
        GameText(session, 60, score_text, Rectangle.{card.x + card.width / 2.0, score_y, card.width / 2.0 - 22.0, 32.0}, 24)
    }
    primary := ifx game.mode == MODE_PAUSED then "Resume" else "Try again"
    if game.mode == MODE_VICTORY { primary = "Play again" }
    primary_offset: float32 = ifx game.mode == MODE_PAUSED then 176.0 else 120.0
    if Button(session, ButtonProps.{.key = 57,
            .bounds = Rectangle.{card.x + 20.0, card.y + card.height - primary_offset, card.width - 40.0, 48.0},
            .label = primary, .class_name = 10, .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        key: s32 = cast(s32)(ifx game.mode == MODE_PAUSED then Input.KeyEscape else Input.KeyEnter)
        HandleInput(key, Timer.MonotonicMilliseconds())
    }
    if game.mode == MODE_PAUSED {
        if Button(session, ButtonProps.{.key = 61,
                .bounds = Rectangle.{card.x + 20.0, card.y + card.height - 120.0, card.width - 40.0, 48.0},
                .label = Locale.Text("Controls"), .class_name = 11, .tone = ButtonTone.ButtonToneNeutral}) != 0 { AskControls() }
    }
    if Button(session, ButtonProps.{.key = 58,
            .bounds = Rectangle.{card.x + 20.0, card.y + card.height - 60.0, card.width - 40.0, 48.0},
            .label = Locale.Text("Back to title"), .class_name = 11, .tone = ButtonTone.ButtonToneNeutral}) != 0 { LeavePlay() }
}

// Keep the next board readable while its worm and enemies wait for Start.
DrawLevelReady :: (session: Session, area: Rectangle) {
    width := area.width - 32.0
    if width > 320.0 { width = 320.0 }
    height: float32 = ifx area.height < 180.0 then 132.0 else 164.0
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    overlay := DismissibleOverlay(session, DismissibleOverlayProps.{.key = 24200,
        .bounds = card, .scrim = Color.{0, 0, 0, 64}, .dismiss_disabled = true})
    if overlay.panel_node < 0 || !TreePushScope(session, overlay.panel_node) { return }
    defer { unused End(session) }
    unused Box(session, BoxProps.{.key = 24201, .bounds = card, .fill = Appearance.Surface(),
        .border = Appearance.Border(), .radius = 24.0})
    CentreText(session, 24202, "Level", Rectangle.{card.x + 12.0, card.y + 12.0, width - 24.0, 22.0}, 16)
    digits: [21]u8
    number := FormatInteger(cast(s64)game.level + 1, digits[:])
    CentreText(session, 24203, number, Rectangle.{card.x + 12.0, card.y + 36.0, width - 24.0, 32.0}, 28)
    if Button(session, ButtonProps.{.key = 24204, .id = 24204,
        .bounds = Rectangle.{card.x + 20.0, card.y + height - 64.0, width - 40.0, 48.0},
        .label = Locale.Text("Start level"), .class_name = 10,
        .tone = ButtonTone.ButtonToneSuccess, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        HandleInput(Input.KeyEnter, Timer.MonotonicMilliseconds())
    }
}

// A logical-pixel sprite square on the live board.
Sprite :: (session: Session, key: u64, stage: Rectangle, position: Point, source: Rectangle,
    sheet: string, size: float32 = 16.0) {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + (cast(float32)position.x - size / 2.0) * scale)
    top := Snap(stage.y + (cast(float32)position.y - size / 2.0) * scale)
    right := Snap(stage.x + (cast(float32)position.x + size / 2.0) * scale)
    bottom := Snap(stage.y + (cast(float32)position.y + size / 2.0) * scale)
    width := right - left
    height := bottom - top
    if width <= 0.0 || height <= 0.0 { return }
    // Clip, rather than hide, a sprite moving through an edge gate.
    clipped_left := left
    clipped_top := top
    clipped_right := right
    clipped_bottom := bottom
    if clipped_left < Snap(stage.x) { clipped_left = Snap(stage.x) }
    if clipped_top < Snap(stage.y) { clipped_top = Snap(stage.y) }
    if clipped_right > Snap(stage.x + stage.width) { clipped_right = Snap(stage.x + stage.width) }
    if clipped_bottom > Snap(stage.y + stage.height) { clipped_bottom = Snap(stage.y + stage.height) }
    if clipped_right <= clipped_left || clipped_bottom <= clipped_top { return }
    fragment := Rectangle.{source.x + (clipped_left - left) / width * source.width,
        source.y + (clipped_top - top) / height * source.height,
        (clipped_right - clipped_left) / width * source.width,
        (clipped_bottom - clipped_top) / height * source.height}
    bounds := Rectangle.{clipped_left, clipped_top, clipped_right - clipped_left, clipped_bottom - clipped_top}
    if Wardrobe.skin > 0 && source.y == 48.0 && key >= 2000 && key < 3000 {
        Character(session, key * 8 + 300000, bounds, Wardrobe.skin, key == 2000, game.direction)
    } else { Picture(session, key, sheet, bounds, fragment) }
}

// Garden-only dressage: animated water frames and grass floor variants,
// both chosen per frame and per cell so boards feel alive without any
// change to the level data.
water_frame: s32;
enemy_frame: s32;
fancy_garden: bool;
GRASS_TILES :: 9;

Snap :: (value: float32) -> float32 { return cast(float32)cast(s32)(value + 0.5) }

// Shared bounds keep neighbouring textures and their outside edges aligned.
TileBounds :: (stage: Rectangle, x: s32, y: s32) -> Rectangle {
    scale := stage.width / (cast(float32)board_columns * 16.0)
    left := Snap(stage.x + cast(float32)x * 16.0 * scale)
    top := Snap(stage.y + cast(float32)y * 16.0 * scale)
    return Rectangle.{left, top, Snap(stage.x + cast(float32)(x + 1) * 16.0 * scale) - left,
        Snap(stage.y + cast(float32)(y + 1) * 16.0 * scale) - top}
}

WallMaterial :: (tile: s32) -> s32 {
    value := tile & 127
    if value == 20 || (value >= 50 && value <= 58) { return 20 }
    if value == 21 || value == 22 { return value }
    return 0
}

// Only exposed edges have an outline. Equal touching materials share one
// continuous surface, including corners and walls painted in the editor.
WallEdges :: (board: []u8, x: s32, y: s32, tile: s32) -> s32 {
    material := WallMaterial(tile)
    if material == 0 { return 0 }
    mask: s32
    for side: 0..3 {
        nx := x
        ny := y
        if side == 0 { nx -= 1 }
        else if side == 1 { ny -= 1 }
        else if side == 2 { nx += 1 }
        else { ny += 1 }
        if !Inside(nx, ny) || WallMaterial(cast(s32)board[Index(nx, ny)]) != material {
            mask |= 1 << cast(s32)side
        }
    }
    return mask
}

DrawWallEdges :: (session: Session, key: u64, stage: Rectangle, x: s32, y: s32, tile: s32, board: []u8) {
    mask := WallEdges(board, x, y, tile)
    if mask == 0 { return }
    bounds := TileBounds(stage, x, y)
    edge := Snap(stage.width / (cast(float32)board_columns * 16.0) * 1.2)
    if edge < 1.0 { edge = 1.0 }
    material := WallMaterial(tile)
    dark := Color.{31, 76, 42, 255}
    light := Color.{94, 143, 67, 255}
    if material == 21 { dark = Color.{82, 83, 75, 255}; light = Color.{176, 174, 153, 255} }
    else if material == 22 { dark = Color.{36, 105, 113, 255}; light = Color.{110, 190, 177, 255} }
    for side: 0..3 {
        if (mask & (1 << cast(s32)side)) == 0 { continue }
        line := bounds
        if side == 0 { line.width = edge }
        else if side == 1 { line.height = edge }
        else if side == 2 { line.x += line.width - edge; line.width = edge }
        else { line.y += line.height - edge; line.height = edge }
        unused Box(session, BoxProps.{.key = 20000 + key * 4 + cast(u64)side, .bounds = line,
            .fill = ifx side < 2 then light else dark})
    }
}

// Tile edges land on whole pixels, so scaled neighbours meet without seams.
MeadowGround :: (session: Session, key: u64, bounds: Rectangle, x: s32, y: s32) {
    width := 1448.0 / cast(float32)board_columns
    height := 1086.0 / cast(float32)board_rows
    unused Image(session, ImageProps.{.key = key, .asset_path = ART_GROUND, .bounds = bounds,
        .source = Rectangle.{cast(float32)x * width, cast(float32)y * height, width, height},
        .smooth = true, .alt_text = "Continuous meadow ground"})
}
Tile :: (session: Session, key: u64, stage: Rectangle, x: s32, y: s32, tile: s32, sheet: string) {
    bounds := TileBounds(stage, x, y)
    kind := tile & 127
    if kind == 22 {
        // One field spans the board. Touching water cells sample touching
        // regions, so painting a lake never repeats a shoreline per tile.
        width := 1448.0 / cast(float32)board_columns
        height := 1086.0 / cast(float32)board_rows
        unused Image(session, ImageProps.{.key = key, .asset_path = ART_WATER, .bounds = bounds,
            .source = Rectangle.{cast(float32)x * width,cast(float32)y * height,width,height},
            .smooth = true, .alt_text = "Continuous water"})
        return
    }
    if kind >= 40 && kind <= 45 {
        if sheet == Sheet(0) { MeadowGround(session, key, bounds, x, y) }
        else { Picture(session, key, sheet, bounds, Rectangle.{0.0, 0.0, 16.0, 16.0}) }
        column := kind - 40
        if kind == 40 { column = 6 + enemy_frame }
        Picture(session, key + 1000000, sheet, bounds, Rectangle.{cast(float32)column * 16.0, 32.0, 16.0, 16.0})
        return
    }
    if sheet == Sheet(0) && (kind == 0 || kind == 3 || kind == 4 || kind == 5 || kind == 6 ||
        kind == 15 || kind == 16 || kind == 17 || kind == 19) {
        MeadowGround(session, key, bounds, x, y)
        return
    }
    if WallMaterial(tile) == 20 && sheet == Sheet(1) {
        // Sample one continuous forest field in board coordinates. Turning
        // the board also turns the field, so every shared tile edge matches.
        canopy := ifx board_columns == ROWS then ART_CANOPY_PORTRAIT else ART_CANOPY
        unused Image(session, ImageProps.{.key = key, .asset_path = canopy, .bounds = bounds,
            .source = Rectangle.{cast(float32)x * 16.0 * SHEET_SCALE, cast(float32)y * 16.0 * SHEET_SCALE,
                16.0 * SHEET_SCALE, 16.0 * SHEET_SCALE},
            .smooth = true, .alt_text = "Forest wall"})
        return
    }
    source := Rectangle.{cast(float32)(tile % 20) * 16.0,
        cast(float32)(tile / 20) * 16.0, 16.0, 16.0}
    if fancy_garden {
        if tile == 22 {
            source = Rectangle.{cast(float32)(water_frame % 3) * 16.0, 176.0, 16.0, 16.0}
        } else if tile == 0 || tile == 3 || tile == 4 || tile == 5 ||
            tile == 6 || tile == 15 || tile == 16 || tile == 17 || tile == 19 {
            variant := (x * 7 + y * 13) % 4
            source = Rectangle.{cast(float32)(4 + variant) * 16.0, 176.0, 16.0, 16.0}
        }
    }
    Picture(session, key, sheet, bounds, source)
}

// The live board scaled to fit inside an area: 640x480 in landscape, the
// same level standing 480x640 in portrait, so a phone screen fills edge to
// edge while the worm keeps entering from the bottom and leaving at the top.
BoardIn :: (area: Rectangle) -> Rectangle {
    wide := cast(float32)board_columns * 16.0
    tall := cast(float32)board_rows * 16.0
    scale := area.width / wide
    if area.height / tall < scale { scale = area.height / tall }
    return Rectangle.{area.x + (area.width - wide * scale) / 2.0,
        area.y + (area.height - tall * scale) / 2.0, wide * scale, tall * scale}
}

AppleFlash :: (session: Session, stage: Rectangle) {
    if game.apple_flash <= 0 { return }
    // A quiet sparkle uses the same clean icon art as the interface.
    if (game.apple_flash / 8) % 2 == 0 { return }
    scale := stage.width / (cast(float32)board_columns * 16.0)
    SvgIcon(session, SvgIconProps.{
        .bounds = Rectangle.{stage.x + cast(float32)(game.apple.x + 3) * scale,
            stage.y + cast(float32)(game.apple.y - 13) * scale, 7.0 * scale, 7.0 * scale},
        .shape = StarIcon.Shape, .color = Color.{255, 227, 116, 220}})
}

// Each portal pair glows in its own colour and breathes slowly, so the two
// rings that belong together are easy to tell apart.
portal_frame: s32;
DrawPortals :: (session: Session, stage: Rectangle) {
    if game.portal_count == 0 { return }
    portal_frame = (portal_frame + 1) % 120
    scale := stage.width / (cast(float32)board_columns * 16.0)
    breath := cast(float32)(ifx portal_frame < 60 then portal_frame else 120 - portal_frame) / 60.0
    for pair: 0..game.portal_count - 1 {
        glow := ifx pair == 0 then Color.{150, 112, 255, 255} else Color.{255, 160, 70, 255}
        core := ifx pair == 0 then Color.{58, 30, 120, 235} else Color.{120, 58, 12, 235}
        for end: 0..1 {
            centre := ifx end == 0 then game.portals[pair].a else game.portals[pair].b
            key := 12000 + cast(u64)pair * 8 + cast(u64)end * 4
            outer := (13.0 + 2.0 * breath) * scale
            inner := 8.0 * scale
            x := stage.x + cast(float32)centre.x * scale
            y := stage.y + cast(float32)centre.y * scale
            unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x - outer, y - outer, outer * 2.0, outer * 2.0},
                    .fill = Color.{glow.r, glow.g, glow.b, cast(u8)(70.0 + 50.0 * breath)}, .radius = outer})
            unused Box(session, BoxProps.{.key = key + 1, .bounds = Rectangle.{x - inner, y - inner, inner * 2.0, inner * 2.0},
                    .fill = core, .border = glow, .radius = inner})
        }
    }
}

// Stone posts mark each open gate throughout the journey. Their tiles and the
// centre opening keep their existing collision data and width.
DrawGatePosts :: (session: Session, stage: Rectangle) {
    half := board_columns / 2
    for gate: 0..1 {
        row := ifx gate == 0 then board_rows - 1 else 0
        centre := game.board[Index(half, row)]
        if centre >= 20 && centre < 128 { continue }
        for side: 0..1 {
            column := half - 1 + cast(s32)side * 2
            Tile(session, 11000 + cast(u64)gate * 2 + cast(u64)side, stage, column, row, 21, Sheet(0))
        }
    }
}

DrawBoard :: (session: Session, stage: Rectangle) {
    fancy_garden = true
    tiles := Sheet(StageOf(game.level))
    sprites := tiles
    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            Tile(session, 100 + cast(u64)at, stage, cast(s32)x, cast(s32)y,
                cast(s32)(game.board[at] & 127), tiles)
            DrawWallEdges(session, 100 + cast(u64)at, stage, cast(s32)x, cast(s32)y,
                cast(s32)game.board[at], game.board[:])
        }
    }
    DrawGatePosts(session, stage)
    DrawPortals(session, stage)
    // A closed gate, the key that opens it or the switch stone that flips it.
    if game.gate >= 0 && !game.gate_open {
        for part: 0..game.gate_span - 1 {
            cell := game.gate + cast(s32)part * game.gate_step
            Sprite(session, 12110 + cast(u64)part, stage, Point.{(cell % board_columns) * 16 + 8, (cell / board_columns) * 16 + 8},
                Rectangle.{(ifx game.gate_step == 1 then 11.0 else 12.0) * 16.0, 64.0, 16.0, 16.0}, sprites)
        }
    }
    if game.key.x >= 0 { Sprite(session, 12101, stage, game.key, Rectangle.{8.0 * 16.0, 64.0, 16.0, 16.0}, sprites) }
    if game.switch_stone.x >= 0 {
        Sprite(session, 12102, stage, game.switch_stone,
            Rectangle.{(ifx game.gate_open then 10.0 else 9.0) * 16.0, 64.0, 16.0, 16.0}, sprites)
    }
    if game.apples > 0 && game.apple.x >= 0 {
        Sprite(session, 1400, stage, game.apple, Rectangle.{0.0, 112.0, 16.0, 16.0}, sprites)
        AppleFlash(session, stage)
    }
    // Follow the full movement history with overlapping segments. Drawing
    // tail first leaves the larger face cleanly above the neck.
    index := game.length - 1
    while index > 0 {
        column := 4
        from_tail := game.length - 1 - index
        if from_tail < 2 { column = 6 }
        else if from_tail < 8 { column = 5 }
        if game.death_ticks == 0 || game.death_ticks / 2 > 2 {
            Sprite(session, 2000 + cast(u64)index, stage, game.worm[index],
                Rectangle.{cast(float32)column * 16.0, 48.0, 16.0, 16.0}, sprites, WORM_BODY_SIZE)
        }
        if game.death_ticks > 0 && index < game.length - 4 {
            Sprite(session, 4000 + cast(u64)index, stage, game.worm[index],
                Rectangle.{cast(float32)(5 - game.death_ticks / 4) * 16.0, 144.0, 16.0, 16.0}, sprites)
        }
        index -= WORM_DRAW_STEP
    }
    if game.length > 0 && (game.death_ticks == 0 || game.death_ticks / 2 > 2) {
        Sprite(session, 2000, stage, game.worm[0],
            Rectangle.{cast(float32)game.direction * 16.0, 48.0, 16.0, 16.0}, sprites, WORM_HEAD_SIZE)
    }
    for monster: 0..game.monster_count - 1 {
        creature := game.monsters[monster]
        column := creature.kind - 1
        row: float32 = 32.0
        if creature.kind == 1 { column = 6 + enemy_frame }
        // The animals met after the meadow share row four of every sheet.
        if creature.animal != ANIMAL_CLASSIC { row = 64.0 }
        if creature.animal == ANIMAL_SQUIRREL { column = (creature.timer / 4) % 2 }
        if creature.animal == ANIMAL_HEDGEHOG { column = ifx creature.timer < 0 then 3 else 2 }
        if creature.animal == ANIMAL_FROG { column = ifx creature.timer >= 14 && creature.timer % 14 < 4 then 5 else 4 }
        if creature.animal == ANIMAL_STONE { column = 6 + (creature.timer / 3) % 2 }
        Sprite(session, 6000 + cast(u64)monster, stage, creature.position,
            Rectangle.{cast(float32)column * 16.0, row, 16.0, 16.0}, sprites)
    }
    for particle: 0..99 {
        life := game.particles[particle].life
        if life > 1 && life <= 12 {
            Sprite(session, 7000 + cast(u64)particle, stage, game.particles[particle].position,
                Rectangle.{cast(float32)(life / 2) * 16.0, 160.0, 16.0, 16.0}, sprites)
        }
    }
}

OpenStages :: () {
    BoardSize(COLUMNS, ROWS)
    game.mode = MODE_STAGES
}

// Play the selected layout from its own private override, authored board
// or best guess. An explicit editor mode takes precedence over window shape.
PlayBoard :: (level: s32, now: s64, seed: u32, restart: bool, layout: s32 = -1) {
    touch_steering.active = false
    recorded_level = -1
    board: [CELLS]u8
    objects: [CELLS]u8
    portrait := ifx layout < 0 then game_portrait else layout == 1
    Custom.EffectiveBoard(level,board[:],portrait)
    Custom.EffectiveObjects(level,objects[:],portrait)
    apples := Custom.EffectiveApples(level,portrait)
    columns: s32 = ifx portrait then ROWS else COLUMNS
    rows: s32 = ifx portrait then COLUMNS else ROWS
    if restart { LoadLevelData(*game,level,now,board[:],apples,columns,rows,objects[:]) }
    else { StartGameData(*game,level,now,seed,board[:],apples,columns,rows,objects[:]) }
}
StartLevel :: (level: s32, now: s64, seed: u32) { PlayBoard(level, now, seed, false) }
ReloadLevel :: (level: s32, now: s64) {
    layout: s32 = -1
    if editor.playtest { layout = ifx editor.turned then 1 else 0 }
    PlayBoard(level,now,1,true,layout)
}

// Leaving a paused or finished playtest returns to the editor; a normal game
// returns to the stages.
LeavePlay :: () {
    if editor.playtest { OpenEditor(editor.level) }
    else { OpenStages() }
}

// The desktop host's WURM_START=editor entry: straight into the editor,
// facing its all-levels view.
EditorAtStartup :: (level: s32) {
    game.started = true
    editor.browsing = true
    OpenEditor(level)
}

EditorLoad :: (level: s32) {
    Custom.EffectiveBoard(level,editor.board[:],editor.turned)
    Custom.EffectiveObjects(level,editor.objects[:],editor.turned)
    BoardSize(ifx editor.turned then ROWS else COLUMNS,ifx editor.turned then COLUMNS else ROWS)
    editor.apples = Custom.EffectiveApples(level,editor.turned)
}

OpenEditor :: (level: s32) {
    if level < 0 { level = 0 }
    if level >= LEVEL_COUNT { level = LEVEL_COUNT - 1 }
    if game.mode != MODE_EDITOR || editor.level != level { EditorLoad(level); editor.dirty = false }
    editor.level = level
    editor.reset_armed = false
    editor.save_failed = false
    EditorInput.StrokeReset(*editor.stroke)
    game.mode = MODE_EDITOR
}

// T switches independently saved layouts. An unsaved portrait starts from
// a best guess; editing either layout never rotates changes into its sibling.
EditorTurn :: () {
    EditorSave()
    if editor.save_failed { return }
    editor.turned = !editor.turned
    EditorInput.StrokeReset(*editor.stroke)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
}

EditorSave :: () {
    if !editor.dirty && (!editor.turned || Custom.HasCustomLevel(editor.level,true)) { return }
    if Custom.SaveCustomLevel(editor.level,editor.board[:],editor.objects[:],editor.apples,editor.turned) {
        editor.dirty = false
        editor.save_failed = false
    } else { editor.save_failed = true }
}

// Deleting the override restores the recovered original in the working copy.
EditorReset :: () {
    unused Custom.ClearCustomLevel(editor.level,editor.turned)
    EditorLoad(editor.level)
    editor.dirty = false
    editor.reset_armed = false
}

// R throws the working copy away and takes the saved level back in.
EditorReloadSaved :: () {
    EditorLoad(editor.level)
    editor.dirty = false
}

EditorExit :: () {
    EditorSave()
    if editor.save_failed { return }
    editor.playtest = false
    editor.turned = false
    OpenStages()
}

EditorPlaytest :: (now: s64) {
    EditorSave()
    if editor.save_failed { return }
    editor.playtest = true
    PlayBoard(editor.level, now, cast(u32)(now & 4294967295), false, ifx editor.turned then 1 else 0)
}

EditorSwitch :: (delta: s32) {
    EditorSave()
    if editor.save_failed { return }
    level := (editor.level + delta + LEVEL_COUNT) % LEVEL_COUNT
    OpenEditor(level)
}

EditorSetApples :: (delta: s32) {
    editor.apples += delta
    if editor.apples < 1 { editor.apples = 1 }
    if editor.apples > 12 { editor.apples = 12 }
    editor.dirty = true
}

// One palette swatch: the brush value it selects and its sheet art.
PaletteEntry :: struct { brush: s32; source_x: float32; source_y: float32 }
floor_entries: [3]PaletteEntry = PaletteEntry.[
    PaletteEntry.{.brush = 0, .source_x = 0.0, .source_y = 0.0},
    PaletteEntry.{.brush = 1, .source_x = 16.0, .source_y = 0.0},
    PaletteEntry.{.brush = 2, .source_x = 32.0, .source_y = 0.0}];
wall_entries: [4]PaletteEntry = PaletteEntry.[
    PaletteEntry.{.brush = BRUSH_SMART_WALL, .source_x = 160.0, .source_y = 32.0},
    PaletteEntry.{.brush = 20, .source_x = 0.0, .source_y = 16.0},
    PaletteEntry.{.brush = 21, .source_x = 16.0, .source_y = 16.0},
    PaletteEntry.{.brush = 22, .source_x = 32.0, .source_y = 16.0}];
enemy_entries: [6]PaletteEntry = .[
    PaletteEntry.{.brush = 40, .source_x = 96.0, .source_y = 32.0},
    PaletteEntry.{.brush = 41, .source_x = 16.0, .source_y = 32.0},
    PaletteEntry.{.brush = 42, .source_x = 32.0, .source_y = 32.0},
    PaletteEntry.{.brush = 43, .source_x = 48.0, .source_y = 32.0},
    PaletteEntry.{.brush = 44, .source_x = 64.0, .source_y = 32.0},
    PaletteEntry.{.brush = 45, .source_x = 80.0, .source_y = 32.0}];
// One titled run of palette swatches. Returns the content cursor below it.
DrawPalettePart :: (session: Session, key: u64, content: Rectangle, cursor: s32, label: string,
                    entries: []PaletteEntry, tiles: string,
                    pointer_x: float32, pointer_y: float32, pointer_pressed: bool) -> s32 {
    TextLine(session, key, label, Rectangle.{content.x, content.y + cast(float32)cursor, content.width, 22.0}, 13)
    count := cast(s32)entries.count
    for index: 0..count - 1 {
        column := index % 6
        row := index / 6
        bounds := Rectangle.{content.x + cast(float32)(column * 38),
            content.y + cast(float32)(cursor + 26 + row * 38), 34.0, 34.0}
        value := entries[index].brush
        if pointer_pressed && Input.PointInBounds(pointer_x, pointer_y, bounds) { editor.brush = value }
        selected := editor.brush == value
        unused Box(session, BoxProps.{.key = key + 10 + cast(u64)index, .bounds = bounds,
            .fill = ifx selected then Color.{46, 125, 74, 235} else Color.{255, 255, 255, 30}, .radius = 6.0})
        Picture(session, key + 80 + cast(u64)index, tiles, Rectangle.{bounds.x + 1.0, bounds.y + 1.0, 32.0, 32.0},
            Rectangle.{entries[index].source_x, entries[index].source_y, 16.0, 16.0})
    }
    rows := (count + 5) / 6
    return cursor + 26 + rows * 38 + 10
}

// The editor screen: the level as raw tiles on the left, brush palette and
// actions on the right. The held left button paints, the right button
// restores the recovered original tile under it.
// The level selector, Shovey-style: one card per level with its board
// sampled small as the picture, the number as the caption, a green frame on
// saved edits, the current level filled, one click to edit. Back returns.
DrawLevelBrowser :: (session: Session, area: Rectangle) {
    unused Box(session, BoxProps.{.key = 8700, .bounds = area, .fill = Appearance.Canvas()})
    if Button(session, ButtonProps.{.key = 8703, .bounds = Rectangle.{area.x + 10.0, area.y + 8.0, 88.0, 36.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { editor.browsing = false; return }
    chapter := StageOf(editor.level)
    if Button(session, ButtonProps.{.key = 8704, .bounds = Rectangle.{area.x + area.width - 94.0, area.y + 8.0, 38.0, 36.0},
            .label = Locale.Text("Previous landscape"), .icon_only = true, .icon_shape = "S2rr:M15 6L9 12L15 18"}) != 0 {
        EditorSave(); OpenEditor(StageFirst((chapter + STAGE_COUNT - 1) % STAGE_COUNT)); editor.browsing = true; return
    }
    if Button(session, ButtonProps.{.key = 8705, .bounds = Rectangle.{area.x + area.width - 48.0, area.y + 8.0, 38.0, 36.0},
            .label = Locale.Text("Next landscape"), .icon_only = true, .icon_shape = "S2rr:M9 6L15 12L9 18"}) != 0 {
        EditorSave(); OpenEditor(StageFirst((chapter + 1) % STAGE_COUNT)); editor.browsing = true; return
    }
    CentreText(session, 8701, StageName(chapter),
        Rectangle.{area.x + 102.0, area.y + 10.0, area.width - 204.0, 28.0}, 18)
    first := StageFirst(chapter)
    count := StageLevels(chapter)
    columns: s32 = 8
    for candidate: 4..11 {
        rows := (count + candidate - 1) / candidate
        item_width := (area.width - 16.0 - cast(float32)(candidate - 1) * 8.0) / cast(float32)candidate
        total := cast(float32)rows * (item_width * 0.75 + 30.0) + cast(float32)(rows - 1) * 8.0 + 56.0
        if total <= area.height { columns = cast(s32)candidate; break }
    }
    rows := (count + columns - 1) / columns
    item_width := (area.width - 16.0 - cast(float32)(columns - 1) * 8.0) / cast(float32)columns
    item_height := item_width * 0.75 + 30.0
    pointer := GamePointer(session)
    for index: 0..count - 1 {
        column := index % columns
        row := index / columns
        bounds := Rectangle.{area.x + 8.0 + cast(float32)column * (item_width + 8.0),
            area.y + 56.0 + cast(float32)row * (item_height + 8.0), item_width, item_height}
        level := first + cast(s32)index
        current := level == editor.level
        edited := Custom.HasCustomLevel(level,editor.turned)
        if pointer.pressed && Input.PointInBounds(pointer.x, pointer.y, bounds) {
            EditorSave()
            editor.browsing = false
            OpenEditor(level)
            return
        }
        unused Box(session, BoxProps.{.key = 8710 + cast(u64)index, .bounds = bounds,
            .fill = ifx current then Color.{207, 225, 175, 255} else Appearance.Surface(),
            .border = ifx edited then Color.{120, 220, 150, 255} else Color.{240, 242, 232, 90},
            .radius = 10.0})
        // The picture: the level's rendered preview board.
        thumb := Rectangle.{bounds.x + 6.0, bounds.y + 6.0, bounds.width - 12.0, (bounds.width - 12.0) * 0.75}
        unused Image(session, ImageProps.{.key = 88000 + cast(u64)index,
            .asset_path = PreviewPath(StageOf(editor.level), cast(s32)index + 1,editor.turned),
            .bounds = thumb, .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = "Level board preview"})
        number := FormatInteger(cast(s64)(index + 1), editor_digits[:])
        CentreText(session, 8760 + cast(u64)index, number,
            Rectangle.{bounds.x, bounds.y + bounds.height - 26.0, bounds.width, 22.0}, 15)
        if edited {
            unused Box(session, BoxProps.{.key = 8850 + cast(u64)index,
                .bounds = Rectangle.{bounds.x + bounds.width - 14.0, bounds.y + 6.0, 8.0, 8.0},
                .fill = Color.{120, 220, 150, 255}, .radius = 4.0})
        }
    }
}

DrawEditor :: (session: Session, area: Rectangle, now: s64) {
    if editor.browsing { DrawLevelBrowser(session, area); return }
    stage_of_level := StageOf(editor.level)
    fancy_garden = true
    tiles := Sheet(stage_of_level)
    panel := Rectangle.{area.x + area.width - EDITOR_PANEL_WIDTH, area.y, EDITOR_PANEL_WIDTH, area.height}
    canvas := Rectangle.{area.x, area.y, area.width - EDITOR_PANEL_WIDTH, area.height}
    // The board keeps whatever orientation EditorLoad or EditorTurn last set.
    stage := BoardIn(canvas)

    pointer := GamePointer(session)
    secondary := GameSecondaryPointer(session)
    stroke := EditorInput.StrokeUpdate(*editor.stroke,pointer,secondary,stage)
    scale := stage.width / (cast(float32)board_columns * 16.0)
    if stroke != 0 {
        cell_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        cell_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(cell_x, cell_y) {
            at := Index(cell_x, cell_y)
            if (stroke & 1) != 0 {
                if editor.brush == BRUSH_SMART_WALL {
                    ApplyWallBrush(editor.board[:], cell_x, cell_y)
                    editor.dirty = true
                } else if editor.board[at] != cast(u8)editor.brush {
                    ApplyFloorBrush(editor.board[:], cell_x, cell_y, cast(u8)editor.brush)
                    editor.dirty = true
                }
            }
            if (stroke & 2) != 0 {
                if editor.objects[at] != 0 {
                    editor.objects[at] = 0
                    editor.dirty = true
                } else {
                    default_board: [CELLS]u8
                    Custom.DefaultBoard(editor.level,default_board[:],editor.turned)
                    original := default_board[at]
                    if editor.board[at] != original {
                        editor.board[at] = original
                        editor.dirty = true
                    }
                }
            }
        }
    }

    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            at := Index(x, y)
            raw := cast(s32)editor.board[at]
            kind := (raw & 127) - 39
            tile := raw & 127
            if kind >= 1 && kind <= 6 { tile = 0 }
            Tile(session, 5000 + cast(u64)at, stage, cast(s32)x, cast(s32)y, tile, tiles)
            DrawWallEdges(session, 5000 + cast(u64)at, stage, cast(s32)x, cast(s32)y, tile, editor.board[:])
            if kind >= 1 && kind <= 6 {
                Sprite(session, 6200 + cast(u64)at, stage, Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8},
                    Rectangle.{cast(float32)(kind - 1) * 16.0, 32.0, 16.0, 16.0}, tiles)
            }
        }
    }
    // The fixed entrance and exit the game carves at runtime, marked so a
    // level is never drawn without its way in and out. These keys sit below
    // the canvas tile range, which starts at 5000.
    gate_x := stage.x + cast(float32)(board_columns / 2 - 1) * 16.0 * scale
    unused Box(session, BoxProps.{.key = 4998, .bounds = Rectangle.{gate_x,
        stage.y + cast(float32)(board_rows - 1) * 16.0 * scale, 48.0 * scale, 16.0 * scale},
        .fill = Color.{90, 220, 120, 70}})
    unused Box(session, BoxProps.{.key = 4999, .bounds = Rectangle.{gate_x,
        stage.y, 48.0 * scale, 16.0 * scale}, .fill = Color.{240, 90, 90, 70}})
    if !pointer.down && !secondary.down && Input.PointInBounds(pointer.x, pointer.y, stage) {
        hover_x := cast(s32)((pointer.x - stage.x) / (16.0 * scale))
        hover_y := cast(s32)((pointer.y - stage.y) / (16.0 * scale))
        if Inside(hover_x, hover_y) {
            left := Snap(stage.x + cast(float32)hover_x * 16.0 * scale)
            top := Snap(stage.y + cast(float32)hover_y * 16.0 * scale)
            unused Box(session, BoxProps.{.key = 4997,
                .bounds = Rectangle.{left, top, Snap(stage.x + cast(float32)(hover_x + 1) * 16.0 * scale) - left,
                    Snap(stage.y + cast(float32)(hover_y + 1) * 16.0 * scale) - top},
                .fill = Color.{255, 255, 255, 60}})
        }
    }

    unused Box(session, BoxProps.{.key = 8200, .bounds = panel, .fill = Appearance.Surface()})
    level_text := FormatInteger(cast(s64)(StageNumber(editor.level)), editor_digits[:])
    TextLine(session, 8202, "LEVEL", Rectangle.{panel.x + 8.0, panel.y + 8.0, 50.0, 20.0}, 14)
    TextLine(session, 8203, level_text, Rectangle.{panel.x + 60.0, panel.y + 8.0, 30.0, 20.0}, 14)
    TextLine(session, 8204, StageName(stage_of_level), Rectangle.{panel.x + 110.0, panel.y + 8.0, 90.0, 20.0}, 14)
    if editor.dirty {
        TextLine(session, 8205, "unsaved", Rectangle.{panel.x + 140.0, panel.y + 8.0, 60.0, 20.0}, 13)
    } else if editor.save_failed {
        unused Box(session, BoxProps.{.key = 8206, .bounds = Rectangle.{panel.x + 168.0, panel.y + 6.0, 74.0, 22.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8207, "SAVE FAILED", Rectangle.{panel.x + 170.0, panel.y + 8.0, 72.0, 18.0}, 12)
    }
    unused Box(session, BoxProps.{.key = 8208, .bounds = Rectangle.{panel.x + 8.0, panel.y + 34.0, 40.0, 40.0},
        .fill = Color.{255, 255, 255, 30}, .radius = 8.0})
    Picture(session, 8209, tiles, Rectangle.{panel.x + 9.0, panel.y + 35.0, 38.0, 38.0},
        Rectangle.{cast(float32)(editor.brush % 20) * 16.0, cast(float32)(editor.brush / 20) * 16.0, 16.0, 16.0})
    TextLine(session, 8210, "BRUSH", Rectangle.{panel.x + 56.0, panel.y + 34.0, 70.0, 18.0}, 13)
    brush_text := FormatInteger(cast(s64)editor.brush, brush_digits[:])
    TextLine(session, 8211, brush_text, Rectangle.{panel.x + 56.0, panel.y + 54.0, 40.0, 18.0}, 13)
    if editor.turned && !Custom.HasCustomLevel(editor.level,true) && !Custom.HasAuthoredLevel(editor.level,true) && (!HasPortraitDesign(editor.level) || Custom.HasCustomLevel(editor.level)) {
        TextLine(session,8224,"Best guess — edit and save",Rectangle.{panel.x + 8.0,panel.y + 80.0,232.0,20.0},12)
    }
    blocked := LevelBlockages(editor.board[:])
    if blocked != 0 {
        note := "entrance blocked"
        if blocked == 2 { note = "exit blocked" }
        else if blocked == 3 { note = "entry and exit blocked" }
        unused Box(session, BoxProps.{.key = 8212, .bounds = Rectangle.{panel.x + 8.0, panel.y + 80.0, 232.0, 20.0},
            .fill = Color.{170, 40, 40, 235}, .radius = 6.0})
        TextLine(session, 8213, note, Rectangle.{panel.x + 14.0, panel.y + 82.0, 220.0, 16.0}, 12)
    }

    inner := Rectangle.{panel.x + 8.0, panel.y + 104.0, panel.width - 16.0, panel.height - 254.0}
    palette := Scroll(session, ScrollProps.{.key = 8214, .bounds = inner, .content_height = 270,
        .scroll_offset = editor.palette_scroll})
    editor.palette_scroll = palette.scroll_offset
    if palette.opened {
        palette_press := pointer.pressed && Input.PointInBounds(pointer.x,pointer.y,inner)
        cursor := DrawPalettePart(session, 8300, palette.content, 6, "FLOOR", floor_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        cursor = DrawPalettePart(session, 8400, palette.content, cursor, "OBSTACLES", wall_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        cursor = DrawPalettePart(session, 8500, palette.content, cursor, "ENEMIES", enemy_entries[:], tiles,
            pointer.x, pointer.y, palette_press)
        unused End(session)
    }

    bottom := panel.y + panel.height - 142.0
    TextLine(session, 8215, "APPLES", Rectangle.{panel.x + 8.0, bottom + 8.0, 64.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8216, .bounds = Rectangle.{panel.x + 76.0, bottom, 36.0, 32.0},
            .label = Locale.Text("Fewer apples"), .icon_shape = "S2rr:M5 12L19 12", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(-1)
    }
    apple_text := FormatInteger(cast(s64)editor.apples, apple_digits[:])
    TextLine(session, 8217, apple_text, Rectangle.{panel.x + 120.0, bottom + 8.0, 28.0, 20.0}, 14)
    if Button(session, ButtonProps.{.key = 8218, .bounds = Rectangle.{panel.x + 152.0, bottom, 36.0, 32.0},
            .label = Locale.Text("More apples"), .icon_shape = "S2rr:M12 5L12 19", .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        EditorSetApples(1)
    }
    if Button(session, ButtonProps.{.key = 8219, .bounds = Rectangle.{panel.x + 8.0, bottom + 40.0, 110.0, 40.0},
            .label = Locale.Text("Save"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorSave() }
    reset_label := ifx editor.reset_armed then "Sure?" else "Reset"
    if Button(session, ButtonProps.{.key = 8220, .bounds = Rectangle.{panel.x + 130.0, bottom + 40.0, 110.0, 40.0},
            .label = reset_label, .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ifx editor.reset_armed then ButtonEmphasis.ButtonEmphasisFilled
                else ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        if editor.reset_armed { EditorReset() }
        else { editor.reset_armed = true }
    }
    if Button(session, ButtonProps.{.key = 8221, .bounds = Rectangle.{panel.x + 8.0, bottom + 88.0, 110.0, 40.0},
            .label = Locale.Text("Playtest"), .tone = ButtonTone.ButtonToneSuccess,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { EditorPlaytest(now) }
    if Button(session, ButtonProps.{.key = 8222, .bounds = Rectangle.{panel.x + 130.0, bottom + 88.0, 110.0, 40.0},
            .label = Locale.Text("Title"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { EditorExit() }
}

// Play starts a full run; Continue replays the furthest unlocked level.
// Return 1 for Play, 2 for Continue and 3 for the level selector.
continue_label: [48]u8;
DrawTitle :: (session: Session, area: Rectangle, key: s32, play_button: bool = true) -> s32 {
    portrait := area.height > area.width
    artwork := ifx portrait then ART_TITLE_PORTRAIT else ART_TITLE
    art_bounds := area
    source: Rectangle
    // Wide landscape crops the lower grass first, preserving the logo.
    if !portrait && area.width > area.height * 1.6 {
        source = Rectangle.{0.0, 0.0, 1536.0, 1536.0 * area.height / area.width}
    }
    unused Box(session, BoxProps.{.key = 800, .bounds = area, .fill = Color.{34, 66, 39, 255}})
    unused Image(session, ImageProps.{.key = 801, .asset_path = artwork, .bounds = art_bounds, .source = source,
        .fit = ImageFit.ImageFitCover, .smooth = true,
        .alt_text = "Apfelwurm: a cheerful worm and an apple, from the garden into the forest"})
    unused Box(session, BoxProps.{.key = 803, .bounds = area, .fill = Appearance.ArtworkShade()})
    // The artwork keeps this lower strip clear for the real interactive button.
    unused Box(session, BoxProps.{.key = 802,
        .bounds = Rectangle.{area.x, area.y + area.height - 140.0, area.width, 140.0},
        .fill = Color.{20, 47, 22, 0}, .fill_bottom = Color.{20, 47, 22, 170}, .has_fill_bottom = true})
    if !play_button { return 0 }
    Progress.Load()
    TitleActions(session, area)
    if Button(session, ButtonProps.{.key = 810,
            .bounds = Rectangle.{area.x + (area.width - 164.0) / 2.0, area.y + area.height - 56.0, 164.0, 40.0},
            .label = Locale.Text("Choose level"), .pill = true, .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 || key == 76 || key == 108 { return 3 }
    width := area.width - 48.0
    if width > 280.0 { width = 280.0 }
    if Progress.unlocked > 0 {
        digits: [21]u8
        at := CopyInto(continue_label[:], 0, "Continue · Level ")
        at = CopyInto(continue_label[:], at, FormatInteger(cast(s64)(Progress.unlocked + 1), digits[:]))
        continue_label[at] = 0
        if Button(session, ButtonProps.{.key = 809,
                .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + area.height - 202.0, width, 60.0},
                .label = TextUntilNul(continue_label[:]), .class_name = 13, .pill = true,
                .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 || key == 67 || key == 99 { return 2 }
    }
    clicked := Button(session, ButtonProps.{.key = 808,
        .bounds = Rectangle.{area.x + (area.width - width) / 2.0, area.y + area.height - 128.0, width, 60.0},
        .label = ifx Progress.unlocked > 0 then "Play from start" else "Play", .class_name = 13,
        .icon_shape = "F:M8 5L19 12L8 19Z", .pill = true,
        .size = ControlSize.ControlSizeLarge, .tone = ButtonTone.ButtonToneSuccess,
        .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
    return ifx clicked || key == Input.KeyEnter || key == 32 then 1 else 0
}

recorded_level: s32 = -1;
// Reload the current run without resetting the score or lives it carried in.
StartRun :: (now: s64) {
    Progress.Load()
    StartLevel(Progress.level, now, cast(u32)(now & 4294967295))
    game.lives = Progress.lives
    game.score = Progress.score
}
requested_level: s32;
StartChosenRun :: (now: s64) {
    unused Progress.Select(requested_level)
    StartRun(now)
}
PlaySelected :: (level: s32, now: s64) -> bool {
    Progress.Load()
    if level < 0 || level > Progress.unlocked || level >= LEVEL_COUNT { return false }
    requested_level = level
    if Controls.Chosen() { StartChosenRun(now) }
    else { AskControls() }
    return true
}
Play :: (now: s64, from_unlocked: bool = false) {
    Progress.Load()
    unused PlaySelected(ifx from_unlocked then Progress.unlocked else 0, now)
}

level_chapter: s32;
level_scroll: s32;
level_label: [32]u8;
LevelLabel :: (level: s32) -> string {
    digits: [21]u8
    at := CopyInto(level_label[:], 0, "Level ")
    at = CopyInto(level_label[:], at, FormatInteger(cast(s64)(level + 1), digits[:]))
    level_label[at] = 0
    return TextUntilNul(level_label[:])
}
OpenLevels :: () {
    Progress.Load()
    level_chapter = StageOf(Progress.unlocked)
    level_scroll = 0
    game.mode = MODE_LEVELS
    touch_steering.active = false
}
DrawLevels :: (session: Session, area: Rectangle, now: s64) {
    #if !#defined(WURM_PORTABLE) {
        // This game supplies its own frame loop on desktop. Feed Scroll's
        // standard device from the same pointer and wheel as the board.
        pointer := GamePointer(session)
        ScrollDevice.BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
            pointer.down, pointer.released, TreeInput.PointerWheelTake(session, area), cast(float64)now / 1000.0)
    }
    if Button(session, ButtonProps.{.key = 26001,
            .bounds = Rectangle.{area.x + 12.0, area.y + 12.0, 88.0, 48.0},
            .label = Locale.Text("Back"), .tone = ButtonTone.ButtonToneNeutral}) != 0 { OpenStages(); return }
    GameText(session, 26002, "Choose level", Rectangle.{area.x + 112.0, area.y + 20.0, area.width - 124.0, 32.0}, 24)
    if Button(session, ButtonProps.{.key = 26003,
            .bounds = Rectangle.{area.x + 12.0, area.y + 72.0, 48.0, 48.0},
            .label = Locale.Text("Previous landscape"), .icon_only = true, .icon_shape = "S2rr:M15 6L9 12L15 18",
            .disabled = level_chapter == 0}) != 0 { level_chapter -= 1; level_scroll = 0 }
    if Button(session, ButtonProps.{.key = 26004,
            .bounds = Rectangle.{area.x + area.width - 60.0, area.y + 72.0, 48.0, 48.0},
            .label = Locale.Text("Next landscape"), .icon_only = true, .icon_shape = "S2rr:M9 6L15 12L9 18",
            .disabled = level_chapter == STAGE_COUNT - 1}) != 0 { level_chapter += 1; level_scroll = 0 }
    GameText(session, 26005, StageName(level_chapter), Rectangle.{area.x + 68.0, area.y + 72.0, area.width - 136.0, 26.0}, 20, false, true)
    GameText(session, 26006, "Finish levels to unlock more", Rectangle.{area.x + 64.0, area.y + 100.0, area.width - 128.0, 20.0}, 12, true, true)
    grid := Rectangle.{area.x + 12.0, area.y + 132.0, area.width - 24.0, area.height - 144.0}
    columns: s32 = ifx grid.width < 560.0 then 2 else ifx grid.width < 900.0 then 3 else 4
    width := (grid.width - 16.0 - cast(float32)(columns - 1) * 12.0) / cast(float32)columns
    height := (width - 16.0) * (ifx game_portrait then 4.0 / 3.0 else 0.75) + 44.0
    count := StageLevels(level_chapter)
    rows := (count + columns - 1) / columns
    scroller := Scroll(session, ScrollProps.{.key = 26007, .bounds = grid,
        .content_height = cast(s32)(cast(float32)rows * (height + 10.0)), .scroll_offset = level_scroll})
    level_scroll = scroller.scroll_offset
    if !scroller.opened { return }
    chosen: s32 = -1
    for index: 0..count - 1 {
        level := StageFirst(level_chapter) + cast(s32)index
        bounds := Rectangle.{scroller.content.x + cast(float32)(index % columns) * (width + 12.0),
            scroller.content.y + cast(float32)(index / columns) * (height + 10.0), width, height}
        locked := level > Progress.unlocked
        current := level == Progress.unlocked
        key := cast(u64)27000 + cast(u64)level * 10
        label := LevelLabel(level)
        unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = Appearance.Surface(),
            .border = ifx current then ColorFromPacked(Appearance.Palette().selected) else Appearance.Border(), .radius = 14.0})
        if Button(session, ButtonProps.{.key = key + 1, .bounds = bounds, .label = ifx locked then Locale.Text("Locked") else label,
                .detail = ifx Progress.Completed(level) then Locale.Text("Completed") else "", .disabled = locked,
                .invisible = true}) != 0 { chosen = level }
        if locked {
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + (width - 30.0) / 2.0,
                    bounds.y + (height - 30.0) / 2.0, 30.0, 30.0},
                .shape = LockIcon.Shape, .color = Appearance.Border()})
        } else {
            unused Image(session, ImageProps.{.key = key + 2,
                .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 8.0, width - 16.0, height - 44.0},
                .asset_path = PreviewPath(level_chapter, cast(s32)index + 1, game_portrait),
                .fit = ImageFit.ImageFitContain, .smooth = true, .radius = 8.0, .alt_text = "Level board preview"})
            GameText(session, key + 3, label, Rectangle.{bounds.x + 8.0, bounds.y + height - 30.0, width - 16.0, 22.0}, 15, false, true)
            if Progress.Completed(level) {
                SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + width - 28.0, bounds.y + height - 29.0, 18.0, 18.0},
                    .shape = "S2rr:M5 12L10 17L20 6", .color = ColorFromPacked(Appearance.Palette().selected)})
            }
        }
    }
    unused End(session)
    if chosen >= 0 { unused PlaySelected(chosen, now) }
}

controls_previous_mode: s32 = MODE_STAGES;
AskControls :: () {
    controls_previous_mode = game.mode
    game.mode = MODE_CONTROLS
    touch_steering.active = false
}
ChooseControls :: (pad: bool, now: s64) {
    unused Controls.SetPad(pad)
    PreferencesChanged()
    touch_steering.active = false
    if controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS { StartChosenRun(now) }
    else { game.mode = controls_previous_mode; game.next_step = now + TickInterval(game.level) }
}
DrawControls :: (session: Session, area: Rectangle, now: s64) {
    unused Box(session, BoxProps.{.key = 23000, .bounds = area, .fill = Color.{17, 38, 27, 175}})
    width := area.width - 24.0
    if width > 560.0 { width = 560.0 }
    height: float32 = ifx area.height < 400.0 then 248.0 else 342.0
    card := Rectangle.{area.x + (area.width - width) / 2.0, area.y + (area.height - height) / 2.0, width, height}
    unused Box(session, BoxProps.{.key = 23001, .bounds = card, .fill = Appearance.Surface(), .radius = 24.0})
    CentreText(session, 23002, "How do you want to move?", Rectangle.{card.x + 12.0, card.y + 18.0, width - 24.0, 28.0}, 20)
    CentreText(session, 23003, "Change this later in Pause > Controls.", Rectangle.{card.x + 12.0, card.y + 50.0, width - 24.0, 22.0}, 13)
    tile_width := (width - 42.0) / 2.0
    tile_height := height - 96.0
    for choice: 0..1 {
        tile := Rectangle.{card.x + 14.0 + cast(float32)choice * (tile_width + 14.0), card.y + 80.0, tile_width, tile_height}
        unused Box(session, BoxProps.{.key = 23010 + cast(u64)choice, .bounds = tile,
            .fill = Appearance.Canvas(), .border = Appearance.Border(), .radius = 16.0})
        art_height := tile.height - 56.0
        side := art_height - 12.0
        if side > tile.width - 16.0 { side = tile.width - 16.0 }
        square := Rectangle.{tile.x + (tile.width - side) / 2.0, tile.y + (art_height - side) / 2.0, side, side}
        if choice == 0 {
            Picture(session, 23020, Sheet(0), square, Rectangle.{0.0, 48.0, 16.0, 16.0})
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{square.x + side * 0.4, square.y + side * 0.35, side * 0.65, side * 0.65},
                .shape = FingerSwipe.Shape, .color = Appearance.Surface()})
        } else {
            preview := DirectionPad(session, DirectionPadProps.{.key = 23021, .bounds = square,
                .label = Locale.Text("Try the direction pad"), .now = cast(float64)now / 1000.0})
            if preview.step { ChooseControls(true, now) }
        }
        label := ifx choice == 0 then "Swipe" else "Direction pad"
        if Button(session, ButtonProps.{.key = 23030 + cast(u64)choice,
                .bounds = Rectangle.{tile.x + 6.0, tile.y + tile.height - 50.0, tile.width - 12.0, 44.0},
                .label = Locale.Text(label), .class_name = 10, .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { ChooseControls(choice == 1, now) }
    }
}

HandleInput :: (key: s32, now: s64) {
    if key == 77 || key == 109 { ToggleSound(); return }
    if game.mode == MODE_SHOP || game.mode == MODE_SETTINGS {
        if key == Input.KeyEscape { game.mode = MODE_STAGES; buy_skin = 0 }
        return
    }
    if game.mode == MODE_CONTROLS {
        if key == 49 { ChooseControls(false, now) }
        else if key == 50 { ChooseControls(true, now) }
        else if key == Input.KeyEscape { game.mode = controls_previous_mode }
        return
    }
    if game.mode == MODE_STAGES && (key == 69 || key == 101) {
        editor.browsing = true
        OpenEditor(game.level)
        return
    }
    if game.mode == MODE_LEVELS {
        if key == Input.KeyEscape { OpenStages() }
        return
    }
    if game.mode == MODE_PLAYING {
        // R restarts the level as the run entered it.
        if key == 82 || key == 114 {
            if editor.playtest { ReloadLevel(game.level, now) }
            else { StartRun(now) }
        }
        else { unused ApplyInput(*game, key) }
    } else if game.mode == MODE_PAUSED {
        unused ApplyInput(*game, key)
        if game.mode == MODE_PLAYING { game.next_step = now + TickInterval(game.level) }
        if game.mode == MODE_STAGES { LeavePlay() }
    } else if game.mode == MODE_READY {
        if key == Input.KeyEnter || key == 32 {
            game.mode = MODE_PLAYING
            game.next_step = now + TickInterval(game.level)
            touch_steering.active = false
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_DIED {
        if key == Input.KeyEnter || key == 32 {
            if editor.playtest { StartLevel(game.level, now, 1) }
            else { Play(now, true) }
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_VICTORY {
        if key == Input.KeyEnter || key == 32 {
            if editor.playtest { StartLevel(0, now, 1) }
            else { StartRun(now) }
        } else if key == Input.KeyEscape { LeavePlay() }
    } else if game.mode == MODE_EDITOR {
        if editor.browsing {
            if key == Input.KeyEscape || key == 76 || key == 108 || key == 69 || key == 101 {
                editor.browsing = false
            }
        } else if key == Input.KeyEscape || key == 69 || key == 101 { EditorExit() }
        else if key == 76 || key == 108 { EditorSave(); editor.browsing = true }
        else if key == 84 || key == 116 { EditorTurn() }
        else if key == 265 || key == 87 || key == 119 { EditorSwitch(-1) }
        else if key == 264 || key == 83 || key == 115 { EditorSwitch(1) }
        else if key == Input.KeyEnter || key == 32 || key == Input.KeyTab { EditorPlaytest(now) }
        else if key == 82 || key == 114 { EditorReloadSaved() }
        else if key == 45 || key == 95 { EditorSetApples(-1) }
        else if key == 61 || key == 43 { EditorSetApples(1) }
    }
}

// Normal play follows the window shape; editor playtests keep their explicit
// layout. Steering stays in screen directions in either case.
game_portrait: bool;
touch_steering: Touch.TouchSteering;
stage_digits: [21]u8;
stage_total: [24]u8;

// Finger movement steers like arrow keys, without waiting for release.
Steer :: (direction: s32) {
    if game.length >= 8 && direction != (game.direction + 2) % 4 { game.next_direction = direction }
}

// One icon and one number per status chip: widths stay fixed as lives and
// scores grow, so they cannot collide with the pause target on a phone.
StatusChip :: (session: Session, key: u64, bounds: Rectangle, shape: string, color: Color, value: string) {
    unused Box(session, BoxProps.{.key = key, .bounds = bounds,
        .fill = Appearance.Surface(), .radius = 16.0})
    SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + 10.0, bounds.y + (bounds.height - 21.0) / 2.0, 21.0, 21.0},
        .shape = shape, .color = color})
    GameText(session, key + 1, value, Rectangle.{bounds.x + 37.0, bounds.y + (bounds.height - 24.0) / 2.0,
        bounds.width - 43.0, 24.0}, 18)
}

LivesChip :: (session: Session, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = 17, .bounds = bounds,
        .fill = Appearance.Surface(), .radius = 16.0})
    slots := game.lives
    if slots < 3 { slots = 3 }
    columns := slots
    if columns > 5 { columns = 5 }
    rows := (slots + columns - 1) / columns
    size := (bounds.width - 16.0) / cast(float32)columns - 2.0
    if size > 21.0 { size = 21.0 }
    height_size := (bounds.height - 6.0) / cast(float32)rows - 2.0
    if size > height_size { size = height_size }
    width := cast(float32)columns * (size + 2.0) - 2.0
    height := cast(float32)rows * (size + 2.0) - 2.0
    for heart: 0..slots - 1 {
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + (bounds.width - width) / 2.0 +
                cast(float32)(heart % columns) * (size + 2.0), bounds.y + (bounds.height - height) / 2.0 +
                cast(float32)(heart / columns) * (size + 2.0), size, size},
            .shape = HeartIcon.Shape, .color = ifx heart < game.lives then Color.{218, 105, 104, 255}
                else Color.{201, 211, 185, 255}})
    }
}

DrawTopBar :: (session: Session, hud: Rectangle) {
    unused Box(session, BoxProps.{.key = 10, .bounds = hud, .fill = Appearance.Surface()})
    unused Box(session, BoxProps.{.key = 15,
        .bounds = Rectangle.{hud.x, hud.y + hud.height - 2.0, hud.width, 2.0}, .fill = Appearance.Border()})
    if game.mode == MODE_EDITOR {
        if Button(session, ButtonProps.{.key = 8225, .bounds = Rectangle.{hud.x + 12.0, hud.y + 5.0, 88.0, 32.0},
                .label = Locale.Text("Levels"), .tone = ButtonTone.ButtonToneSuccess}) != 0 {
            EditorSave(); editor.browsing = true
        }
        if Button(session,ButtonProps.{.key = 8226,.bounds = Rectangle.{hud.x + 108.0,hud.y + 5.0,96.0,32.0},
                .label = Locale.Text("Landscape"),.tone = ifx !editor.turned then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral}) != 0 && editor.turned { EditorTurn() }
        if Button(session,ButtonProps.{.key = 8227,.bounds = Rectangle.{hud.x + 212.0,hud.y + 5.0,86.0,32.0},
                .label = Locale.Text("Portrait"),.tone = ifx editor.turned then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral}) != 0 && !editor.turned { EditorTurn() }
        return
    }
    narrow := hud.width < 520.0
    chapter := StageName(StageOf(game.level))
    total := FormatInteger(cast(s64)StageLevels(StageOf(game.level)), stage_digits[:])
    stage_total[0] = #char "/"; stage_total[1] = #char " "
    total_end := CopyInto(stage_total[:], 2, total)
    stage_total[total_end] = 0
    total_label := TextUntilNul(stage_total[:])
    GameText(session, 11, chapter, Rectangle.{hud.x + 16.0, hud.y + 10.0, 100.0, 22.0}, 17)
    level_text := FormatInteger(cast(s64)(StageNumber(game.level)), level_digits[:])
    if narrow {
        GameText(session, 12, level_text, Rectangle.{hud.x + 112.0, hud.y + 12.0, 26.0, 20.0}, 15)
        GameText(session, 13, total_label, Rectangle.{hud.x + 138.0, hud.y + 12.0, 38.0, 20.0}, 14, true)
    } else {
        GameText(session, 12, level_text, Rectangle.{hud.x + 16.0, hud.y + 36.0, 26.0, 20.0}, 15)
        GameText(session, 13, total_label, Rectangle.{hud.x + 42.0, hud.y + 36.0, 38.0, 20.0}, 14, true)
    }
    group_x := hud.x + 124.0
    group_width := hud.width - 200.0
    if group_width > 340.0 { group_x += (group_width - 340.0) / 2.0; group_width = 340.0 }
    chip_y := hud.y + 16.0
    chip_height: float32 = 40.0
    if narrow {
        group_x = hud.x + 12.0
        group_width = hud.width - 24.0
        chip_y = hud.y + 60.0
        chip_height = 34.0
    }
    chip_width := (group_width - 16.0) / 3.0
    apples_text := FormatInteger(cast(s64)game.apples, apple_digits[:])
    score_text := FormatInteger(cast(s64)game.score, score_digits[:])
    LivesChip(session, Rectangle.{group_x, chip_y, chip_width, chip_height})
    StatusChip(session, 19, Rectangle.{group_x + chip_width + 8.0, chip_y, chip_width, chip_height}, AppleIcon.Shape, Color.{210, 78, 65, 255}, apples_text)
    StatusChip(session, 21, Rectangle.{group_x + (chip_width + 8.0) * 2.0, chip_y, chip_width, chip_height}, StarIcon.Shape, Color.{210, 152, 46, 255}, score_text)
    if game.mode == MODE_PLAYING {
        sound_bounds := Rectangle.{hud.x+hud.width-116.0,hud.y+8.0,48.0,48.0}
        if Button(session,ButtonProps.{.key=24110,.bounds=sound_bounds,
            .label=Locale.Text("Volume"),.icon_only=true,.class_name=10,
            .icon_shape="S1.8rr:M4 9H8L13 5V19L8 15H4ZM16 8C19 10 19 14 16 16M19 5C24 9 24 15 19 19",
            .tone=ButtonTone.ButtonToneSuccess,.emphasis=ButtonEmphasis.ButtonEmphasisFilled}) != 0 { sound_popup = !sound_popup }
        if Button(session, ButtonProps.{.key = 59,
                .bounds = Rectangle.{hud.x + hud.width - 60.0, hud.y + 8.0, 48.0, 48.0},
                .label = Locale.Text("Pause"), .icon_only = true, .class_name = 10,
                .icon_shape = "F:M7 5H10V19H7ZM14 5H17V19H14Z", .tone = ButtonTone.ButtonToneSuccess,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { HandleInput(Input.KeyEscape, Timer.MonotonicMilliseconds()) }
        DrawSoundPopup(session,hud,sound_bounds)
    }
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    unused WidgetPaletteUse(session, Appearance.Palette())
    #if #defined(PLATFORM_WEB) {
        if !browser_storage_started {
            browser_storage_started = true
            // Escape belongs to pause/back navigation, including the selector.
            BrowserCanvas.CanvasSetExitKey(0)
            unused BrowserStorage.BundleStorageOpen()
        }
        if !BrowserStorage.BundleStorageReady() && !BrowserStorage.BundleStorageFailed() {
            CentreText(session,25000,"Opening your journey…",viewport,20)
            return 0
        }
    }
    now := Timer.MonotonicMilliseconds()
    Account.Pump()
    Appearance.ApplyShared(Account.SharedTheme(), Account.SharedAccent(), Account.SharedMaterial(), Account.SystemDark())
    unused WidgetPaletteUse(session, Appearance.Palette())
    LoadSound()
    if Account.ProfileVisible() {
        profile_key: s32
        #if !#defined(WURM_PORTABLE) {
            profile_key = KeyboardTake(session)
        }
        unused Box(session, BoxProps.{.key = 29000, .bounds = viewport, .fill = Appearance.Canvas()})
        GameText(session, 29001, Account.ProfileTitle(), Rectangle.{viewport.x + 100.0, viewport.y + 14.0, viewport.width - 112.0, 32.0}, 22)
        Account.DrawProfile(session, Rectangle.{viewport.x, viewport.y + 64.0, viewport.width, viewport.height - 64.0}, profile_key, Appearance.mode != 2)
        if Button(session, ButtonProps.{.key = 29002, .bounds = Rectangle.{viewport.x + 12.0, viewport.y + 8.0, 76.0, 44.0}, .label = Locale.Text("Back")}) != 0 || profile_key == Input.KeyEscape { Account.Back(); Progress.poll_at = 0; Wardrobe.poll_at = 0 }
        return 0
    }
    if Progress.Pump(now) {
        Wardrobe.Reset(); preferences_poll = 0; preferences_dirty = false
        if game.mode == MODE_PLAYING || game.mode == MODE_PAUSED || game.mode == MODE_READY || game.mode == MODE_FINISHED || game.mode == MODE_DIED || game.mode == MODE_VICTORY {
            game.mode = MODE_STAGES
            touch_steering.active = false
        }
    }
    PreferencesPump(now)
    Wardrobe.Pump(now, game.mode == MODE_PLAYING && !editor.playtest && game.death_ticks == 0 && game.transition_ticks == 0)
    was_portrait := game_portrait
    game_portrait = viewport.height > viewport.width
    if !game.started {
        game.started = true
        OpenStages()
    } else if was_portrait != game_portrait && !editor.playtest && (game.mode == MODE_PLAYING || game.mode == MODE_PAUSED || game.mode == MODE_READY) {
        previous_mode := game.mode
        ReloadLevel(game.level,now)
        game.mode = previous_mode
    }
    water_frame = cast(s32)((now / 130) % 3)
    enemy_frame = cast(s32)((now / 110) % 4)
    key: s32
    #if #defined(WURM_PORTABLE) {
        key = Timer.PressedKey()
    } else {
        key = KeyboardTake(session)
    }
    // A key that returns to the stages must not also start a level there.
    stage_key := ifx game.mode == MODE_STAGES then key else 0
    if sound_popup && key == Input.KeyEscape { sound_popup = false; key = 0 }
    if game.mode != MODE_PLAYING { sound_popup = false }
    HandleInput(key, now)
    unused Box(session, BoxProps.{.key = 1, .bounds = viewport, .fill = Appearance.Canvas()})
    // The stages screen is one full-bleed cover; every other mode carries the
    // green icon bar across the top with the board letterboxed below it, so
    // portrait and landscape both keep their proportions.
    showing_bar := game.mode != MODE_STAGES && game.mode != MODE_LEVELS &&
        game.mode != MODE_SETTINGS && game.mode != MODE_SHOP &&
        !(game.mode == MODE_CONTROLS && (controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS))
    bar_height: float32 = 0.0
    if showing_bar { bar_height = ifx viewport.width < 520.0 then 104.0 else 72.0 }
    if game.mode == MODE_EDITOR { bar_height = 42.0 }
    hud := Rectangle.{viewport.x, viewport.y, viewport.width, bar_height}
    available_height := viewport.height - bar_height
    if available_height < 1.0 { available_height = 1.0 }
    stage := BoardIn(Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height})
    // Read the held pointer before simulation, so the next 25 ms step can
    // already use this frame's direction. SwipeArea supplies captured contact;
    // its release-only swipe result is deliberately unused.
    contact: SwipeAreaResult
    if game.mode == MODE_PLAYING && !sound_popup && !Controls.Pad() && game.death_ticks == 0 && game.transition_ticks == 0 {
        contact = SwipeArea(session, SwipeAreaProps.{.key = PLAY_STEERING_KEY, .bounds = stage,
            .label = Locale.Text("Steer the worm"), .now = cast(float64)now / 1000.0,
            .min_distance = 6.0})
        direction := Touch.TouchDirection(*touch_steering, contact.down, contact.at_x, contact.at_y)
        if direction >= 0 { Steer(direction) }
    } else { touch_steering.active = false }
    lives_before := game.lives
    unused Step(*game, now)
    // Save the next unlocked level on completion, before loading its board.
    if game.mode == MODE_FINISHED && !editor.playtest && recorded_level != game.level {
        Progress.Complete(game.level)
        if Progress.Begin(game.level + 1, game.lives, game.score) { recorded_level = game.level }
        Progress.RecordRun(game.level + 2, game.score)
    }
    if game.mode == MODE_FINISHED {
        // Load after saving completion, then wait indefinitely for Start.
        // No simulation or stale steering can cross into this new board.
        ReloadLevel(game.level + 1, now)
        game.mode = MODE_READY
    }
    // The run keeps each lost life; a game over or the finished journey
    // starts the next run at level one.
    if !editor.playtest && game.lives < lives_before {
        if game.mode == MODE_DIED {
            Progress.RecordRun(game.level + 1, game.score)
            unused Progress.Restart()
        }
        else { unused Progress.LoseLife() }
    }
    if game.mode == MODE_VICTORY && !editor.playtest && recorded_level != game.level {
        Progress.Complete(game.level)
        Progress.RecordRun(LEVEL_COUNT, game.score)
        if Progress.Restart() { recorded_level = game.level }
    }
    Audio.UpdateAudio(game.mode == MODE_PLAYING || game.mode == MODE_PAUSED,
        game.level, game.apples, game.death_ticks, game.transition_ticks)
    if game.mode == MODE_STAGES {
        area := Rectangle.{viewport.x, viewport.y, viewport.width, viewport.height}
        action := DrawTitle(session, area, stage_key)
        if action == 3 { OpenLevels() }
        else if action != 0 { Play(now, action == 2) }
    } else if game.mode == MODE_SHOP {
        DrawShop(session, viewport)
    } else if game.mode == MODE_SETTINGS {
        DrawSettings(session, viewport)
    } else if game.mode == MODE_LEVELS {
        DrawLevels(session, viewport, now)
    } else if game.mode == MODE_CONTROLS {
        if controls_previous_mode == MODE_STAGES || controls_previous_mode == MODE_LEVELS { unused DrawTitle(session, viewport, 0, false) }
        else { DrawBoard(session, stage) }
        DrawControls(session, viewport, now)
    } else if game.mode == MODE_EDITOR {
        area := Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height}
        DrawEditor(session, area, now)
    } else {
        DrawBoard(session, stage)
        if game.mode == MODE_PLAYING && !Controls.Pad() && game.death_ticks == 0 && game.transition_ticks == 0 {
            SwipeFeedback(session, SwipeFeedbackProps.{.key = 24010, .gesture = contact})
        }
        if game.mode == MODE_PLAYING && Controls.Pad() {
            pad := DirectionPad(session, DirectionPadProps.{.key = PLAY_STEERING_KEY,
                .bounds = DirectionPadBounds(Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, available_height}),
                .label = Locale.Text("Direction pad"), .now = cast(float64)now / 1000.0, .repeat_seconds = 0.08,
                .floating = true, .disabled = game.death_ticks > 0 || game.transition_ticks > 0})
            if pad.step { Steer(pad.direction) }
        }
    }
    if showing_bar { DrawTopBar(session, hud) }
    if game.mode == MODE_READY { DrawLevelReady(session, stage) }
    else if game.mode == MODE_PAUSED { Overlay(session, viewport, "Paused", "Your worm is waiting.") }
    else if game.mode == MODE_DIED { Overlay(session, viewport, "Game over", "Another apple adventure?", game.score) }
    else if game.mode == MODE_VICTORY { Overlay(session, viewport, "You did it!", "You reached the mountain!", game.score) }
    return 0
}
