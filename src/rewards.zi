// Coins and the daily reward plan. Coins are cosmetic and follow from what
// the player did: cleared levels, replays and claimed days, minus the skins
// bought with them. Retrying, a restart or a second device therefore never
// counts anything twice. The plan advances only on consecutive UTC days: the
// claim after a missed day is day 1 again, and what the ended run earned stays.
// Dew days are granted only by the node, once per account, after its own
// unbroken check-ins: the game names the reward and shows what the node answered.
Account :: #import, file "account.zi";
Progress :: #import, file "progress.zi";
Records :: #import, file "controls.zi";
Portal :: #import, file "portal.zi";
#if #defined(WURM_PORTABLE) {
    // Seconds since 1970, from the collection's host.
    host_api :: #system_library "host_api";
    AppNowHost :: () -> float64 #foreign host_api;
} else {
    Clock :: #import "kryon/bundle_time";
}
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"

SKIN_COUNT :: 13;
DAILY_DAYS :: 30;
CLEAR_COINS :: 10;
REPLAY_COINS :: 2;
// A gift skin bought before its day, and every gift day after the first plan.
GIFT_COINS :: 100;
// Guests, and every Dew day after the first plan.
DEW_DAY_COINS :: 50;
// Skins 9 to 12, which coins can buy or the plan gives.
REWARD_SKINS :: 7680;
MILESTONES :: 5;
RECORD_V1_SIZE :: 12;
RECORD_SIZE :: 19;
KEPT_COINS_LIMIT :: 2000000000;
// The account's plan shares the cosmetics kind; record 1 is the holiday claim.
RECORD_ID :: "00000000000000000000000000000002";

loaded: bool;
owner: [65]u8;
// Claimed days of the current run, and the UTC day of the latest claim (days
// since 1970). Stays as saved until the claim that restarts it; Day() reads 0
// once a day was missed.
days: s32;
last_day: s64 = -1;
// The latest claim's place in its week of consecutive days, 1 to 7; 0 none.
week: s32;
coin_skins: s32;
// Bit N: the node credited Dew milestone N.
dew_done: s32;
// What earlier runs earned: their coins, the gift skins they reached and the
// Dew they were credited. A kept gift or Dew pays coins when reached again.
kept_coins: s32;
kept_skins: s32;
kept_dew: s32;
// A claim since the node last counted a check-in.
checkin: bool;
dirty: bool;
poll_at: s64;
today: s64 = -1;
today_at: s64;
// Tests set the UTC day; -1 reads the clock.
test_day: s64 = -1;
// Replays on this account's other devices, summed by the wardrobe sync.
other_replays: s64;
// Coins the signed-in account bought with Dew, from the node's receipts.
bought_coins: s32;
// Verified cumulative, never-consumed SDK inventory credits, not a balance.
portal_credits: s64;
portal_verified: bool;
portal_loaded: bool;
portal_read_ready: bool;
DataAvailable :: #type () -> bool;
data_active: DataAvailable = Portal.DataActive;
PortalActive :: () -> bool {
    #if #defined(WURM_CRAZYGAMES) {
        return data_active()
    } else {
        return false
    }
}
// Call after account reset and each inventory refresh. Invalid/unverified data
// revokes spendable credits; a refresh replaces the total, never increments it.
SetPortalCredits :: (credits: s64, verified: bool) -> bool {
    Load()
    portal_credits = 0; portal_verified = false
    if !PortalActive() || !verified || credits < 0 || credits > 1000000000 { return false }
    portal_credits = credits; portal_verified = true
    return true
}
// Each award a player should see: coins and whole Dew.
toast_coins: s32;
toast_dew: s32;
toast_serial: s32;
seen_clears: s32 = -1;
claim_active: s32 = -1;
claim_at: s64;

PlanCoins :: (day: s32) -> s32 {
    plan: [30]s32 = .[20, 25, 30, 35, 40, 40, 0, 30, 35, 0, 40, 45, 50, 75, 50,
        40, 45, 50, 55, 60, 60, 50, 55, 60, 0, 65, 70, 75, 80, 0]
    if day < 1 || day > DAILY_DAYS { return 0 }
    return plan[day - 1]
}
// Dew is rare: only days 10 and 25, milestones 1 and 4. The node's other
// daily rewards (milestones 0, 2 and 3) are no longer offered.
Milestone :: (day: s32) -> s32 {
    if day == 10 { return 1 }
    if day == 25 { return 4 }
    return -1
}
Offered :: (index: s32) -> bool { return index == 1 || index == 4 }
MilestoneDew :: (index: s32) -> s32 {
    if index == 0 { return 1 }
    if index >= 1 && index <= 3 { return 2 }
    if index == 4 { return 3 }
    return 0
}
// The node's reward names; it alone sets their Dew.
MilestoneReward :: (index: s32) -> string {
    if index == 0 { return "wurm.daily-05" }
    if index == 1 { return "wurm.daily-10" }
    if index == 2 { return "wurm.daily-15" }
    if index == 3 { return "wurm.daily-20" }
    if index == 4 { return "wurm.daily-25" }
    return ""
}
GiftSkin :: (day: s32) -> s32 {
    if day == 7 { return 11 }
    if day == 30 { return 12 }
    return 0
}
CoinPrice :: (id: s32) -> s32 {
    if id == 9 { return 120 }
    if id == 10 { return 240 }
    if id == 11 { return 360 }
    return 0
}
SignedIn :: () -> bool { return Progress.owner[0] != 0 }

ValidRecord :: (count: s64, version: u8) -> bool {
    return (count == RECORD_V1_SIZE && version == 1) || (count == RECORD_SIZE && version == 2)
}
// Each signed-in account and the guest keep their own plan and coins.
Load :: () {
    active := PortalActive()
    same := loaded && portal_loaded == active && TextUntilNul(owner[:]) == TextUntilNul(Progress.owner[:])
    if same && (!active || portal_read_ready) { return }
    if !same { portal_credits = 0; portal_verified = false }
    portal_loaded = active; portal_read_ready = false
    loaded = true
    owner = Progress.owner
    days = 0; last_day = -1; week = 0; coin_skins = 0; dew_done = 0; checkin = false; dirty = false
    kept_coins = 0; kept_skins = 0; kept_dew = 0
    other_replays = 0; poll_at = 0; claim_active = -1; claim_at = 0
    bytes: [RECORD_SIZE + 1]u8
    count: s64
    if active {
        count = Portal.ReadByteRecord(Progress.RecordName("rewards.dat"), bytes[:])
        if count == -2 { portal_read_ready = true; return }
        // Unknown/corrupt snapshots must never be replaced by empty state.
        if !ValidRecord(count, bytes[0]) { return }
        portal_read_ready = true
    } else {
        count = Records.ReadRecord(Progress.RecordName("rewards.dat"), bytes[:])
        if !ValidRecord(count, bytes[0]) { return }
    }
    days = cast(s32)bytes[1] | (cast(s32)bytes[2] << 8)
    stored: s64 = 0
    for index: 0..3 { stored |= cast(s64)bytes[index + 3] << (index * 8) }
    last_day = ifx stored == 4294967295 then -1 else stored
    coin_skins = (cast(s32)bytes[7] | (cast(s32)bytes[8] << 8)) & REWARD_SKINS
    dew_done = cast(s32)bytes[9] & 31
    dirty = (bytes[10] & 1) != 0
    checkin = (bytes[10] & 2) != 0
    // Records from before the week count only their latest claim.
    week = cast(s32)bytes[11]
    if week > 7 || (week == 0 && days > 0) { week = 1 }
    // A first-version record has nothing kept. Its plan day and everything it
    // earned stay as they were; only its next missed day restarts the plan.
    if count == RECORD_SIZE {
        stored_coins: s64 = 0
        for index: 0..3 { stored_coins |= cast(s64)bytes[index + 12] << (index * 8) }
        kept_coins = ifx stored_coins > KEPT_COINS_LIMIT then KEPT_COINS_LIMIT else cast(s32)stored_coins
        kept_skins = (cast(s32)bytes[16] | (cast(s32)bytes[17] << 8)) & REWARD_SKINS
        kept_dew = cast(s32)bytes[18] & 31
    }
}
Save :: () -> bool {
    // Do not retry a read here: callers may already have mutated the snapshot.
    if PortalActive() && (!loaded || !portal_loaded || !portal_read_ready ||
        TextUntilNul(owner[:]) != TextUntilNul(Progress.owner[:])) { return false }
    bytes: [RECORD_SIZE]u8
    // Nothing kept yet stays in the first version's twelve bytes.
    kept := kept_coins != 0 || kept_skins != 0 || kept_dew != 0
    bytes[0] = ifx kept then 2 else 1
    bytes[1] = cast(u8)(days & 255); bytes[2] = cast(u8)((days >> 8) & 255)
    stored: s64 = ifx last_day < 0 then 4294967295 else last_day
    for index: 0..3 { bytes[index + 3] = cast(u8)((stored >> (index * 8)) & 255) }
    bytes[7] = cast(u8)(coin_skins & 255); bytes[8] = cast(u8)((coin_skins >> 8) & 255)
    bytes[9] = cast(u8)dew_done
    bytes[10] = cast(u8)((ifx dirty then 1 else 0) | (ifx checkin then 2 else 0))
    bytes[11] = cast(u8)week
    for index: 0..3 { bytes[index + 12] = cast(u8)((kept_coins >> (index * 8)) & 255) }
    bytes[16] = cast(u8)(kept_skins & 255); bytes[17] = cast(u8)((kept_skins >> 8) & 255)
    bytes[18] = cast(u8)kept_dew
    size: s64 = ifx kept then RECORD_SIZE else RECORD_V1_SIZE
    if PortalActive() { return Portal.WriteByteRecord(Progress.RecordName("rewards.dat"), bytes[:size]) }
    return Records.WriteRecord(Progress.RecordName("rewards.dat"), bytes[:size])
}
Reset :: () {
    loaded = false
    today = -1; today_at = 0
    seen_clears = -1
    Load()
}

// UTC days, the same boundary the node counts check-ins by.
Today :: () -> s64 {
    if test_day >= 0 { return test_day }
    seconds: s64 = 0
    #if #defined(WURM_PORTABLE) {
        seconds = cast(s64)AppNowHost()
    } else {
        seconds = Clock.BundleUnixMilliseconds() / 1000
    }
    if seconds <= 0 { return -1 }
    return seconds / 86400
}
CurrentDay :: () -> s64 {
    if test_day >= 0 || today < 0 { today = Today() }
    return today
}

// What a plan day gives, given what earlier runs kept. Days after the first
// plan, and a gift or Dew already earned, give coins only.
RunDayCoins :: (day: s32, skins: s32, dew: s32) -> s32 {
    if day < 1 { return 0 }
    cycle := (day - 1) % DAILY_DAYS + 1
    first := day <= DAILY_DAYS
    coins := PlanCoins(cycle)
    if coins > 0 { return coins }
    index := Milestone(cycle)
    if index >= 0 { return ifx first && SignedIn() && (dew & (1 << index)) == 0 then 0 else DEW_DAY_COINS }
    gift := GiftSkin(cycle)
    if first && ((coin_skins | skins) & (1 << gift)) == 0 { return 0 }
    return GIFT_COINS
}
DayCoins :: (day: s32) -> s32 { return RunDayCoins(day, kept_skins, kept_dew) }
// The coins of a run's first COUNT days.
RunCoins :: (count: s32, skins: s32, dew: s32) -> s64 {
    earned: s64 = 0
    day: s32 = 1
    while day <= count { earned += cast(s64)RunDayCoins(day, skins, dew); day += 1 }
    return earned
}
ReachedGifts :: (count: s32) -> s32 {
    gifts: s32 = 0
    if count >= 7 { gifts |= 1 << GiftSkin(7) }
    if count >= 30 { gifts |= 1 << GiftSkin(30) }
    return gifts
}
KeepCoins :: (coins: s64) {
    capped := ifx coins > KEPT_COINS_LIMIT then cast(s64)KEPT_COINS_LIMIT else coins
    if capped > cast(s64)kept_coins { kept_coins = cast(s32)capped }
}
// Keeps what the current run earned and empties it for day 1.
EndRun :: () {
    KeepCoins(cast(s64)kept_coins + RunCoins(days, kept_skins, kept_dew))
    kept_skins |= ReachedGifts(days)
    kept_dew |= dew_done
    days = 0
}
// Whole Dew a day offers; guests see it and sign in to receive it.
DayDew :: (day: s32) -> s32 {
    Load()
    if day < 1 || day > DAILY_DAYS { return 0 }
    index := Milestone(day)
    if index >= 0 && (kept_dew & (1 << index)) != 0 { return 0 }
    return MilestoneDew(index)
}
DaySkin :: (day: s32) -> s32 {
    Load()
    if day < 1 || day > DAILY_DAYS { return 0 }
    gift := GiftSkin(day)
    if gift == 0 || ((coin_skins | kept_skins) & (1 << gift)) != 0 { return 0 }
    return gift
}
// 0 upcoming, 1 collecting from the node, 2 collected, 3 sign in.
DewState :: (day: s32) -> s32 {
    Load()
    index := ifx day >= 1 && day <= DAILY_DAYS then Milestone(day) else -1
    if index < 0 { return 0 }
    if !SignedIn() { return 3 }
    if (dew_done & (1 << index)) != 0 { return 2 }
    return ifx day <= Day() then 1 else 0
}

// True once a whole UTC day passed without a claim.
RunMissed :: () -> bool {
    return last_day >= 0 && CurrentDay() > last_day + 1
}
// The current streak's plan day; 0 once a day was missed.
Day :: () -> s32 {
    Load()
    return ifx RunMissed() then 0 else days
}
// Days of the chest's week already claimed. Today's claim stays shown, and a
// full week until the next day starts another; a missed UTC day clears it.
WeekClaimed :: () -> s32 {
    Load()
    if week <= 0 || last_day < 0 { return 0 }
    current := CurrentDay()
    claimed := week
    if current == last_day + 1 { claimed = week % 7 }
    else if current > last_day + 1 { claimed = 0 }
    return ifx claimed > days then days else claimed
}
ClaimReady :: () -> bool {
    Load()
    if PortalActive() && !portal_read_ready { return false }
    current := CurrentDay()
    return current >= 0 && current > last_day && days < 65535
}
// Claims today's plan day: the next one after yesterday's claim, otherwise day
// 1. Coins and skins follow at once; on a Dew day the node credits the Dew.
// Every signed-in claim also checks in with the node.
Claim :: () -> bool {
    if !ClaimReady() { return false }
    previous_day := last_day
    previous_dirty := dirty
    previous_checkin := checkin
    previous_week := week
    previous_days := days
    previous_kept_coins := kept_coins
    previous_kept_skins := kept_skins
    previous_kept_dew := kept_dew
    if RunMissed() { EndRun() }
    days += 1
    week = ifx week > 0 && CurrentDay() == last_day + 1 then week % 7 + 1 else 1
    last_day = CurrentDay()
    if SignedIn() { dirty = true; checkin = true; claim_at = 0; poll_at = 0 }
    if !Save() {
        days = previous_days; last_day = previous_day; week = previous_week
        kept_coins = previous_kept_coins; kept_skins = previous_kept_skins; kept_dew = previous_kept_dew
        dirty = previous_dirty; checkin = previous_checkin
        return false
    }
    toast_coins = DayCoins(days)
    toast_dew = 0
    toast_serial += 1
    return true
}

Owns :: (id: s32) -> bool {
    Load()
    if id < 9 || id >= SKIN_COUNT { return false }
    if ((coin_skins | kept_skins | ReachedGifts(days)) & (1 << id)) != 0 { return true }
    return false
}
Coins :: () -> s32 {
    Load()
    Progress.Load()
    earned: s64 = 0
    for index: 0..Progress.LEVELS - 1 { if Progress.completed[index] == 1 { earned += CLEAR_COINS } }
    // Bound before adding/multiplying untrusted persisted replay counts.
    replay_counts: [2]s64 = .[Progress.replays, other_replays]
    for count: replay_counts {
        if count > 0 { earned += REPLAY_COINS * (ifx count > 2000000000 then cast(s64)2000000000 else count) }
    }
    earned += cast(s64)kept_coins + RunCoins(days, kept_skins, kept_dew)
    if PortalActive() {
        if portal_verified { earned += portal_credits }
    } else if SignedIn() { earned += cast(s64)bought_coins }
    for id: 9..11 { if (coin_skins & (1 << id)) != 0 { earned -= cast(s64)CoinPrice(cast(s32)id) } }
    if earned < 0 { return 0 }
    if earned > 2000000000 { return 2000000000 }
    return cast(s32)earned
}
// Spends coins at once, even offline. An owned skin is never bought twice.
Buy :: (id: s32) -> bool {
    Load()
    if PortalActive() && !portal_read_ready { return false }
    price := CoinPrice(id)
    if price <= 0 || Owns(id) || Coins() < price { return false }
    previous_dirty := dirty
    coin_skins |= 1 << id
    if SignedIn() { dirty = true; poll_at = 0 }
    if !Save() { coin_skins &= ~(1 << id); dirty = previous_dirty; return false }
    return true
}

Pump :: (now: s64) {
    Load()
    if now >= today_at { today = Today(); today_at = now + 5000 }
    if seen_clears != Progress.clear_events {
        if seen_clears >= 0 {
            toast_coins = Progress.clear_first_count * CLEAR_COINS + Progress.clear_replay_count * REPLAY_COINS
            toast_dew = 0
            toast_serial += 1
        }
        seen_clears = Progress.clear_events
    }
    if !SignedIn() { return }
    DewPump(now)
    SyncPump(now)
}

// The current account, as entity.records sees it, must be this plan's owner.
SameAccount :: () -> bool {
    status := Account.Service("entity.records", "{\"operation\":\"status\"}")
    current: [65]u8
    return ReadStringText(status, FieldAt(status, 0, "account"), current[:]) >= 0 &&
        TextUntilNul(current[:]) == TextUntilNul(owner[:])
}

// One claim at a time. The first uncredited milestone is claimed after each
// signed-in claim: the node counts that UTC day as a check-in and answers
// "ineligible" until it has counted enough days. A due milestone retries.
DewPump :: (now: s64) {
    if claim_active >= 0 {
        reply := Account.Service("entity.dew", "claim-status")
        status: [16]u8
        unused ReadStringText(reply, FieldAt(reply, 0, "status"), status[:])
        state := TextUntilNul(status[:])
        if state == "pending" { return }
        index := claim_active
        claim_active = -1
        reward: [80]u8
        unused ReadStringText(reply, FieldAt(reply, 0, "reward"), reward[:])
        if TextUntilNul(reward[:]) != MilestoneReward(index) { claim_at = now + 5000; return }
        if state == "done" {
            dew_done |= 1 << index
            checkin = false
            dirty = true; poll_at = 0
            if MatchLiteral(reply, FieldAt(reply, 0, "credited"), "true") {
                toast_coins = 0
                toast_dew = MilestoneDew(index)
                toast_serial += 1
            }
            claim_at = now
        } else if state == "ineligible" {
            checkin = false
            claim_at = now + 1800000
        } else { claim_at = now + 300000 }
        unused Save()
        return
    }
    if now < claim_at { return }
    index: s32 = 0
    while index < MILESTONES && (!Offered(index) || (dew_done & (1 << index)) != 0) { index += 1 }
    if index >= MILESTONES { checkin = false; return }
    due := (index + 1) * 5 <= Day()
    if !checkin && !due { return }
    if !SameAccount() { claim_at = now + 5000; return }
    request: [96]u8
    out: Vec(u8)
    BuilderPrint(*out, "claim:%", MilestoneReward(index))
    unused CopyText(TextView(VecSlice(out, 0, out.count)), request[:])
    VecFree(out)
    answer := Account.Service("entity.dew", TextUntilNul(request[:]))
    status: [16]u8
    unused ReadStringText(answer, FieldAt(answer, 0, "status"), status[:])
    state := TextUntilNul(status[:])
    if state == "pending" { claim_active = index }
    else if state == "busy" { claim_at = now + 5000 }
    else { claim_at = now + 300000 }
}

CopyText :: (text: string, output: []u8) -> bool {
    if text.count >= output.count { output[0] = 0; return false }
    for byte, at: text { output[at] = byte }
    output[text.count] = 0
    return true
}

// A whole number in a stored plan, 0 when a record from an older version lacks
// it, or -1 when it is malformed.
StoredCount :: (reply: string, document: s32, name: string, limit: float64) -> s64 {
    at := FieldAt(reply, document, name)
    if at < 0 { return 0 }
    number := ReadNumber(reply, at)
    if !number.valid || number.value < 0.0 || number.value > limit || number.value != cast(float64)cast(s64)number.value { return -1 }
    return cast(s64)number.value
}
// Merges another device's plan. The later claim names the current run, or the
// longer run when both claimed the same day; a run it replaces keeps its coins,
// gifts and Dew, and shared history is never counted twice.
MergePlan :: (stored_days: s32, stored_last: s64, stored_skins: s32, stored_dew: s32,
    stored_kept_coins: s32, stored_kept_skins: s32, stored_kept_dew: s32) {
    if stored_last > last_day {
        // Another device's next-day claim continues the week; anything else
        // it claimed starts a new one there.
        week = ifx week > 0 && stored_last == last_day + 1 && stored_days == days + 1 then week % 7 + 1 else 1
    }
    if stored_last > last_day || (stored_last == last_day && stored_days > days) {
        if stored_days < days { EndRun() }
        days = stored_days
        last_day = stored_last
    } else if stored_days > days {
        KeepCoins(cast(s64)stored_kept_coins + RunCoins(stored_days, stored_kept_skins, stored_kept_dew))
        kept_skins |= ReachedGifts(stored_days)
        kept_dew |= stored_dew
    }
    KeepCoins(cast(s64)stored_kept_coins)
    kept_skins |= stored_kept_skins
    kept_dew |= stored_kept_dew
    coin_skins |= stored_skins
    dew_done |= stored_dew
}

// The account's plan, skins bought with coins and credited milestones,
// merged so that no device's claim or purchase is lost.
SyncPump :: (now: s64) {
    if now < poll_at { return }
    poll_at = now + 10000
    if !SameAccount() { return }
    reply := Account.Service("entity.records", "{\"operation\":\"get\",\"kind\":\"wurm-cosmetics\",\"id\":\"00000000000000000000000000000002\"}")
    document := FieldAt(reply, 0, "document")
    status: [16]u8
    unused ReadStringText(reply, FieldAt(reply, 0, "status"), status[:])
    if document >= 0 {
        remote_days := ReadNumber(reply, FieldAt(reply, document, "days"))
        remote_last := ReadNumber(reply, FieldAt(reply, document, "last"))
        remote_skins := ReadNumber(reply, FieldAt(reply, document, "skins"))
        remote_dew := ReadNumber(reply, FieldAt(reply, document, "dew"))
        valid := remote_days.valid && remote_days.value >= 0.0 && remote_days.value <= 65535.0 &&
            remote_days.value == cast(float64)cast(s32)remote_days.value &&
            remote_last.valid && remote_last.value >= -1.0 && remote_last.value <= 4000000.0 &&
            remote_skins.valid && remote_skins.value >= 0.0 && remote_skins.value <= 65535.0 &&
            remote_dew.valid && remote_dew.value >= 0.0 && remote_dew.value <= 31.0
        remote_kept_coins := StoredCount(reply, document, "kept_coins", cast(float64)KEPT_COINS_LIMIT)
        remote_kept_skins := StoredCount(reply, document, "kept_skins", 65535.0)
        remote_kept_dew := StoredCount(reply, document, "kept_dew", 31.0)
        valid = valid && remote_kept_coins >= 0 && remote_kept_skins >= 0 && remote_kept_dew >= 0
        if valid {
            stored_days := cast(s32)remote_days.value
            stored_last := cast(s64)remote_last.value
            stored_skins := cast(s32)remote_skins.value & REWARD_SKINS
            stored_dew := cast(s32)remote_dew.value & 31
            stored_kept_coins := cast(s32)remote_kept_coins
            stored_kept_skins := cast(s32)remote_kept_skins & REWARD_SKINS
            stored_kept_dew := cast(s32)remote_kept_dew & 31
            MergePlan(stored_days, stored_last, stored_skins, stored_dew, stored_kept_coins, stored_kept_skins, stored_kept_dew)
            if days != stored_days || last_day != stored_last || coin_skins != stored_skins || dew_done != stored_dew ||
                kept_coins != stored_kept_coins || kept_skins != stored_kept_skins || kept_dew != stored_kept_dew { dirty = true }
            unused Save()
        }
    } else if TextUntilNul(status[:]) == "missing" && (days > 0 || coin_skins != 0 || dew_done != 0 || kept_coins != 0 || kept_skins != 0 || kept_dew != 0) { dirty = true }
    if !dirty { return }
    out: Vec(u8)
    BuilderPrint(*out, "{\"operation\":\"put\",\"kind\":\"wurm-cosmetics\",\"schema\":\"wurm.rewards.v1\",\"id\":\"%\",\"document\":{\"days\":%,\"last\":%,\"skins\":%,\"dew\":%,\"kept_coins\":%,\"kept_skins\":%,\"kept_dew\":%}}",
        RECORD_ID, days, last_day, coin_skins, dew_done, kept_coins, kept_skins, kept_dew)
    answer := Account.Service("entity.records", TextView(VecSlice(out, 0, out.count)))
    done: [16]u8
    dirty = ReadStringText(answer, FieldAt(answer, 0, "status"), done[:]) < 0 || TextUntilNul(done[:]) != "done"
    VecFree(out)
    unused Save()
}
