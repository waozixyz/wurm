// Portable games receive only bounded services. Native editions keep keys in
// Entity's provider, in this application's private profile directory.
#import "kryon/session"
#import "kryon/geometry"
#if #defined(WURM_ACCOUNT_TEST) {
    test_api :: #system_library "host_api";
    WurmAccountService :: (name: string, request: string) -> string #foreign test_api;
    Service :: (name: string, request: string) -> string { return WurmAccountService(name, request) }
    // Whether level sharing (the "publications" service) is offered here.
    SharingAvailable :: () -> bool { return true }
} else #if #defined(WURM_PORTABLE) {
    Runtime :: #import "portable_runtime";
    Controls :: #import, file "controls.zi";
    #import "std/text_buffer"
    shop_request: [128]u8;
    Service :: (name: string, request: string) -> string {
        if name == "entity.game-shop" && request.count < 120 {
            prefix := "shop:"
            for byte, index: prefix { shop_request[index] = byte }
            for byte, index: request { shop_request[index + 5] = byte }
            shop_request[request.count + 5] = 0
            return Runtime.Service("entity.dew", TextUntilNul(shop_request[:]))
        }
        return Runtime.Service(name, request)
    }
    SharingAvailable :: () -> bool { return Controls.HostSupports("publications") }
    Pump :: () {}
    OpenProfile :: () { unused Service("entity.profile", "open") }
    OpenLeaderboard :: () { unused Service("entity.profile", "leaderboard") }
    OpenDew :: () { unused Service("entity.profile", "dew") }
    ShowDew :: () {}
    OpenAppearance :: () { unused Service("entity.profile", "appearance") }
    ProfileTitle :: () -> string { return "Profile" }
    SharedTheme :: () -> s32 { return -1 }
    SharedAccent :: () -> s32 { return 0 }
    SharedMaterial :: () -> bool { return false }
    SystemDark :: () -> bool { return true }
    ProfileVisible :: () -> bool { return false }
    RefreshProfile :: () {}
    DrawProfile :: (session: Session, bounds: Rectangle, key: s32, dark: bool) {}
    Back :: () {}
    VisitWebsite :: () -> bool { return Service("entity.game-shop", "visit") == "queued" }
} else #if #defined(WURM_ACCOUNTS) {
    Entity :: #import "entity/native_host";
    Records :: #import "entity/entity_records";
    Dew :: #import "entity/entity_dew";
    Shop :: #import "entity/game_shop_native";
    Leaderboard :: #import "entity/leaderboard_native";
    Publications :: #import "entity/publications";
    Files :: #import "entity/native_files";
    File :: #import "std/file";
    Locale :: #import, file "localization.zi";
    #import "std/text_buffer"
    #import "kryon/app_files"
    #import "kryon/tree_input"
    #import "kryon/key_input"
    #import "kryon/text_input_props"
    #import "kryon/text_props"
    #import "kryon/text_align"
    #import "kryon/text_widget"
    #import "kryon/open_uri"
    #if #defined(ANDROID_BUILD) {
        #import "kryon/android_jni"
        Device :: #import "kryon/android_device";
        Assets :: #import "kryon/app_asset";
    }
    started: bool;
    ready: bool;
    visible: bool;
    profile_title: string = "Profile";
    profile_bytes: string;
    InstalledGame :: (id: string) -> bool { return id == "xyz.waozi.wurm" }
    Root :: (output: []u8) -> string {
        #if #defined(PLATFORM_WEB) {
            return "/kryon-apps/wurm-profile"
        }
        override := Files.NativeEnvironment("WURM_PROFILE_DIR")
        if override != "" { return override }
        base: [4096]u8
        #if #defined(ANDROID_BUILD) {
            return Files.NativeJoin(output, AndroidPrivateDataPath(base[:]), "profile")
        } else {
            data := Files.NativeEnvironment("XDG_DATA_HOME")
            if data == "" { data = Files.NativeJoin(base[:], Files.NativeEnvironment("HOME"), ".local/share") }
            app: [4096]u8
            return Files.NativeJoin(output, Files.NativeJoin(app[:], data, "wurm"), "profile")
        }
    }
    Pump :: () {
        if !started {
            started = true
            #if #defined(ANDROID_BUILD) {
                profile_bytes = Assets.ReadAppAsset("assets/entity.zx")
            } else {
                bytes, found := File.ReadEntireFile("assets/entity.zx")
                if found { profile_bytes = bytes }
            }
            root: [4096]u8
            Leaderboard.leaderboard_installed = InstalledGame
            Entity.EntityHostProfileSections(10)
            Entity.EntityHostGameContext("wurm")
            if profile_bytes != "" { ready = Entity.EntityHostOpen(profile_bytes, Root(root[:]), "arcade", true) }
        }
        if ready { Entity.EntityHostPump() }
    }
    Service :: (name: string, request: string) -> string {
        if !ready { return "" }
        if name == "entity.records" { return Records.EntityRecordsAnswer(request) }
        if name == "entity.dew" { return Dew.EntityDewAnswer(request) }
        if name == "entity.game-shop" { return Shop.EntityGameShopAnswer(request) }
        if name == "publications" { return Publications.PublicationsAnswer(request) }
        // The best run, on the board Arcade names after the game's catalog id.
        if name == "leaderboard" {
            saved := Leaderboard.EntityLeaderboardReport("wurm", "Apfelwurm", "xyz.waozi.wurm", "Apfelwurm", request)
            return ifx saved then "saved" else "rejected"
        }
        if name == "entity.profile" && request == "open" { OpenProfile(); return "available" }
        return ""
    }
    SharingAvailable :: () -> bool { return ready }
    // The Profile always opens. One that could not start tries again and,
    // if it still cannot, says why instead of doing nothing.
    OpenProfile :: () {
        profile_title = "Profile"
        if !ready && started && profile_bytes != "" {
            root: [4096]u8
            ready = Entity.EntityHostOpen(profile_bytes, Root(root[:]), "arcade", true)
        }
        if ready { unused Entity.EntityHostPage("profile") }
        visible = true
    }
    ProfileVisible :: () -> bool { return visible }
    // Only an account change invalidates the open Profile's loaded owner.
    // Preserve a direct title destination when refreshing its saved state.
    RefreshProfile :: () {
        if !ready { return }
        Entity.EntityHostReload()
        if !visible { return }
        page := "profile"
        if profile_title == "Leaderboard" { page = "leaderboard" }
        else if profile_title == "Dew" { page = "dew" }
        else if profile_title == "Appearance" { page = "appearance" }
        unused Entity.EntityHostPage(page)
    }
    OpenLeaderboard :: () { OpenProfile(); profile_title = "Leaderboard"; if ready { unused Entity.EntityHostLeaderboard() } }
    OpenDew :: () { OpenProfile(); profile_title = "Dew"; if ready { unused Entity.EntityHostPage("dew") } }
    // The Dew page drawn inside the shop, without the Profile overlay.
    ShowDew :: () { if ready { unused Entity.EntityHostPage("dew") } }
    OpenAppearance :: () { OpenProfile(); profile_title = "Appearance"; if ready { unused Entity.EntityHostPage("appearance") } }
    ProfileTitle :: () -> string { return profile_title }
    SharedTheme :: () -> s32 { return ifx ready then Entity.EntityHostAppearance().theme else -1 }
    SharedAccent :: () -> s32 { return ifx ready then Entity.EntityHostAppearance().accent else 0 }
    SharedMaterial :: () -> bool { return ready && Entity.EntityHostAppearance().material }
    SystemDark :: () -> bool {
        #if #defined(ANDROID_BUILD) {
            return Device.AndroidSystemDark() != 0
        }
        return true
    }
    // A Profile that stops starts again by itself; when it cannot, say why
    // instead of leaving the page blank.
    DrawProfile :: (session: Session, bounds: Rectangle, key: s32, dark: bool) {
        if ready {
            typed: [1024]u8
            input := TextFieldInputFor(key, KeyboardModifiers(session), TypedTextTake(session, typed[:]))
            if Entity.EntityHostFrame(session, bounds, key, KeyboardModifiers(session), input, dark) { return }
        }
        problem := Entity.EntityHostProblem()
        if !ready && problem == "" { problem = "The profile could not start. Reload the page to try again." }
        if problem == "" { return }
        unused Text(session, TextProps.{.key = 29010, .text = Locale.Text(problem), .font = 18, .wrap = TextWrap.TextWrapAuto,
                .align = TextAlign.TextAlignCenter,
                .bounds = Rectangle.{bounds.x + 24.0, bounds.y + 48.0, bounds.width - 48.0, 120.0}})
    }
    Back :: () {
        if !ready { visible = false; return }
        if !Entity.EntityHostBack() && Entity.EntityHostSave() { visible = false }
    }
    VisitWebsite :: () -> bool { return OpenUri("https://waozi.xyz/") }
} else {
    #import "kryon/open_uri"
    Service :: (name: string, request: string) -> string { unused name; unused request; return "" }
    SharingAvailable :: () -> bool { return false }
    Pump :: () {}
    OpenProfile :: () {}
    OpenLeaderboard :: () {}
    OpenDew :: () {}
    ShowDew :: () {}
    OpenAppearance :: () {}
    ProfileTitle :: () -> string { return "Profile" }
    SharedTheme :: () -> s32 { return -1 }
    SharedAccent :: () -> s32 { return 0 }
    SharedMaterial :: () -> bool { return false }
    SystemDark :: () -> bool { return true }
    ProfileVisible :: () -> bool { return false }
    RefreshProfile :: () {}
    DrawProfile :: (session: Session, bounds: Rectangle, key: s32, dark: bool) {}
    Back :: () {}
    // Portal copies keep players in the game: no links away.
    #if #defined(WURM_CRAZYGAMES) {
        VisitWebsite :: () -> bool { return false }
    } else {
        VisitWebsite :: () -> bool { return OpenUri("https://waozi.xyz/") }
    }
}
