// Wurm owns the mixer; the current app owner owns the bounded PCM stream.
#import "kryon/media_audio"
#import "kryon/session"
#import "std/text_buffer"
session: Session;
Bind :: (value: Session) { session = value }
Available :: () -> bool {
    result := MediaAudio(session, MediaAudioCommand.{.operation = .Capabilities})
    return result.code == .Ok && (result.capabilities & cast(u32)8) != 0
}
Open :: () -> u32 {
    result := MediaAudio(session, MediaAudioCommand.{.operation = .CreateStream, .voice = 1,
        .format = .S16LE, .sample_rate = 22050, .channels = 1, .frames_per_block = 2048, .gain = 1.0})
    if result.code != .Ok { return 0 }
    result = MediaAudio(session, MediaAudioCommand.{.operation = .Play, .voice = 1})
    if result.code == .Ok { return 1 }
    unused MediaAudio(session, MediaAudioCommand.{.operation = .Unload, .voice = 1})
    return 0
}
Ready :: (device: u32) -> bool {
    if device == 0 { return false }
    result := MediaAudio(session, MediaAudioCommand.{.operation = .Status, .voice = 1})
    return result.code == .Ok && result.writable
}
Submit :: (device: u32, samples: []s16) -> bool {
    if device == 0 || samples.count != 2048 { return false }
    // Encode explicitly, including NULs, independently of host endianness.
    bytes: [4096]u8
    for at: 0..2047 {
        value := cast(u16)samples[at]
        bytes[at * 2] = cast(u8)(value & 255)
        bytes[at * 2 + 1] = cast(u8)(value >> 8)
    }
    result := MediaAudio(session, MediaAudioCommand.{.operation = .SubmitStream, .voice = 1, .pcm = TextView(bytes[:])})
    return result.code == .Ok
}
Clear :: (device: u32) {
    if device == 0 { return }
    unused MediaAudio(session, MediaAudioCommand.{.operation = .Stop, .voice = 1})
    unused MediaAudio(session, MediaAudioCommand.{.operation = .Play, .voice = 1})
}
