// The score submits bounded PCM blocks to the standard audio mixer.
Mixer :: #import "std/audio";
Frame :: #import, file "audio_frame.zi";
#import "kryon/session"
// The score's PCM boundary also admits a deterministic sink in local tests.
CanOpen :: #type () -> bool;
OpenStream :: #type () -> u32;
StreamReady :: #type (device: u32) -> bool;
SubmitBlock :: #type (device: u32, samples: []s16) -> bool;
ClearStream :: #type (device: u32) -> void;
PcmSink :: struct {
    available: CanOpen
    open: OpenStream
    ready: StreamReady
    submit: SubmitBlock
    clear: ClearStream
}
session: Session;
voice: Mixer.AudioVoice = .{-1, 0};
Bind :: (value: Session) {
    if value.slot != session.slot || value.epoch != session.epoch { Close() }
    session = value
}
Available :: () -> bool { return Frame.Ready() }
Valid :: (device: u32) -> bool { return device != 0 && Mixer.AudioState(voice) != .Unloaded }
Open :: () -> u32 {
    voice = Mixer.AudioOpenStream(22050, 1, 2048)
    if voice.slot < 0 { return 0 }
    if Mixer.AudioPlay(voice) { return 1 }
    Close()
    return 0
}
Ready :: (device: u32) -> bool { return Valid(device) && Mixer.AudioState(voice) == .Playing && Mixer.AudioStreamWritable(voice) }
Submit :: (device: u32, samples: []s16) -> bool {
    return Valid(device) && samples.count == 2048 && Mixer.AudioStreamSubmit(voice, samples)
}
Clear :: (device: u32) {
    if !Valid(device) { return }
    Mixer.AudioStop(voice)
    unused Mixer.AudioPlay(voice)
}
Close :: () { Mixer.AudioUnload(voice); voice = .{-1, 0} }
