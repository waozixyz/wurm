#import, file "own_levels.zi";
#import, file "level_json.zi";
Collections :: #import "entity/level_collections";
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"

// Asynchronous publish/find/fetch of level collections over the
// "publications" service. One request is in flight at a time: start it with
// SharePublish, ShareUnpublish, ShareFind or ShareFetch, then call SharePoll
// until it stops returning SHARE_WAITING.
SHARE_IDLE :: 0;
SHARE_PUBLISH :: 1;
SHARE_UNPUBLISH :: 2;
SHARE_FIND :: 3;
SHARE_FETCH :: 4;

SHARE_OK :: 0;
SHARE_WAITING :: 1;
SHARE_UNAVAILABLE :: 2;
SHARE_SIGNED_OUT :: 3;
SHARE_OFFLINE :: 4;
SHARE_NOT_FOUND :: 5;
SHARE_TOO_LARGE :: 6;
SHARE_REFUSED :: 7;
SHARE_BUSY :: 8;

SHARE_RESULTS :: 24;

share_kind: s32;
share_request: s32;
share_visibility: s32;
share_result: s32;
share_results: [SHARE_RESULTS]Collections.CollectionMeta;
share_result_count: s32;
share_imported: s32;

ShareErrorResult :: (error: string) -> s32 {
    if error == "signed-out" { return SHARE_SIGNED_OUT }
    if error == "offline" { return SHARE_OFFLINE }
    if error == "not-found" { return SHARE_NOT_FOUND }
    if error == "too-large" { return SHARE_TOO_LARGE }
    if error == "busy" { return SHARE_BUSY }
    return SHARE_REFUSED
}

// ShareFinish ends the request in flight and remembers its result.
ShareFinish :: (result: s32) -> s32 {
    share_kind = SHARE_IDLE
    share_result = result
    return result
}

// ShareReplyResult maps a non-done reply; SHARE_OK means the reply was done.
ShareReplyResult :: (reply: Collections.CollectionReply) -> s32 {
    if reply.status == Collections.COLLECTION_PENDING { return SHARE_WAITING }
    if reply.status == Collections.COLLECTION_DONE { return SHARE_OK }
    if reply.status == Collections.COLLECTION_REJECTED || reply.status == Collections.COLLECTION_FAILED {
        return ShareErrorResult(TextUntilNul(reply.error[:]))
    }
    return SHARE_UNAVAILABLE
}

ShareStart :: (kind: s32, request: Vec(u8)) -> s32 {
    reply := own_service(Collections.COLLECTIONS_PUBLISH_SERVICE, TextView(VecSlice(request, 0, request.count)))
    VecFree(request)
    read := Collections.CollectionReplyRead(reply)
    result := ShareReplyResult(read)
    if result == SHARE_WAITING && read.request >= 0 {
        share_kind = kind
        share_request = read.request
        share_result = SHARE_WAITING
        return SHARE_WAITING
    }
    if result == SHARE_OK || result == SHARE_WAITING { result = SHARE_UNAVAILABLE }
    share_result = result
    return result
}

SharePublish :: (title: string, visibility: s32) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    OwnRename(title)
    document: Vec(u8)
    OwnDocument(*document, false)
    request: Vec(u8)
    Collections.CollectionPublishRequest(*request, WURM_LEVELS_FORMAT, TextUntilNul(own_title[:]),
        visibility, TextView(VecSlice(document, 0, document.count)), TextUntilNul(own_publication[:]))
    VecFree(document)
    share_visibility = visibility
    return ShareStart(SHARE_PUBLISH, request)
}

ShareUnpublish :: () -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    if TextUntilNul(own_publication[:]) == "" { return SHARE_REFUSED }
    request: Vec(u8)
    Collections.CollectionUnpublishRequest(*request, TextUntilNul(own_publication[:]))
    return ShareStart(SHARE_UNPUBLISH, request)
}

ShareFind :: (query: string) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    request: Vec(u8)
    Collections.CollectionFindRequest(*request, WURM_LEVELS_FORMAT, query)
    return ShareStart(SHARE_FIND, request)
}

ShareFetch :: (index: s32) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    if index < 0 || index >= share_result_count { return SHARE_NOT_FOUND }
    request: Vec(u8)
    Collections.CollectionFetchRequest(*request, TextUntilNul(share_results[index].id[:]))
    return ShareStart(SHARE_FETCH, request)
}

SharePoll :: () -> s32 {
    if share_kind == SHARE_IDLE { return share_result }
    request: Vec(u8)
    Collections.CollectionStatusRequest(*request, share_request)
    reply := own_service(Collections.COLLECTIONS_PUBLISH_SERVICE, TextView(VecSlice(request, 0, request.count)))
    VecFree(request)
    read := Collections.CollectionReplyRead(reply)
    result := ShareReplyResult(read)
    if result == SHARE_WAITING { return SHARE_WAITING }
    if result != SHARE_OK { return ShareFinish(result) }

    kind := share_kind
    if kind == SHARE_UNPUBLISH {
        own_publication[0] = 0
        own_visibility = Collections.COLLECTION_PRIVATE
        return ShareFinish(ifx OwnSave() then SHARE_OK else SHARE_REFUSED)
    }

    if kind == SHARE_FIND {
        found := Collections.CollectionFindRead(reply, WURM_LEVELS_FORMAT, share_results[:])
        if found < 0 { return ShareFinish(SHARE_REFUSED) }
        share_result_count = found
        return ShareFinish(SHARE_OK)
    }

    meta: Collections.CollectionMeta
    if !Collections.CollectionPublicationRead(reply, WURM_LEVELS_FORMAT, *meta) {
        return ShareFinish(SHARE_REFUSED)
    }
    if kind == SHARE_PUBLISH {
        for byte, index: meta.id { own_publication[index] = byte }
        own_visibility = share_visibility
        return ShareFinish(ifx OwnSave() then SHARE_OK else SHARE_REFUSED)
    }

    // Fetch: the imported collection is a new private draft of our own.
    title: [160]u8
    for byte, index: meta.title { title[index] = byte }
    if TextUntilNul(title[:]) == "" {
        for byte, index: "Shared levels" { title[index] = byte }
        title[13] = 0
    }
    document_at := FieldAt(reply, 0, "document")
    if document_at < 0 { return ShareFinish(SHARE_REFUSED) }
    imported := OwnImport(reply, document_at, TextUntilNul(title[:]))
    if imported < 0 { return ShareFinish(SHARE_REFUSED) }
    share_imported = imported
    return ShareFinish(SHARE_OK)
}
