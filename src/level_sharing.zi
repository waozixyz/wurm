#import, file "own_levels.zi";
#import, file "level_json.zi";
Collections :: #import "entity/level_collections";
#import "entity/collection_client";
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"

// Asynchronous publish/find/fetch of level collections over the
// "publications" service. One request is in flight at a time: start it with
// SharePublish, ShareUnpublish, ShareFind or ShareFetch, then call SharePoll
// until it stops returning SHARE_WAITING.
SHARE_IDLE :: 0;
SHARE_PUBLISH :: 1;
SHARE_UNPUBLISH :: 2;
SHARE_FIND :: 3;
SHARE_FETCH :: 4;

SHARE_OK :: 0;
SHARE_WAITING :: 1;
SHARE_UNAVAILABLE :: 2;
SHARE_SIGNED_OUT :: 3;
SHARE_OFFLINE :: 4;
SHARE_NOT_FOUND :: 5;
SHARE_TOO_LARGE :: 6;
SHARE_REFUSED :: 7;
SHARE_BUSY :: 8;

SHARE_RESULTS :: 24;

share_kind: s32;
share_client: CollectionClient;
share_owner: [129]u8;
share_visibility: s32;
share_result: s32;
share_results: [SHARE_RESULTS]Collections.CollectionMeta;
share_result_count: s32;
share_imported: s32;

ShareErrorResult :: (error: string) -> s32 {
    if error == "signed-out" { return SHARE_SIGNED_OUT }
    if error == "offline" { return SHARE_OFFLINE }
    if error == "not-found" { return SHARE_NOT_FOUND }
    if error == "too-large" { return SHARE_TOO_LARGE }
    if error == "busy" { return SHARE_BUSY }
    return SHARE_REFUSED
}

// ShareFinish ends the request in flight and remembers its result.
ShareFinish :: (result: s32) -> s32 {
    share_kind = SHARE_IDLE
    share_result = result
    return result
}

// The records provider supplies a verified public ID (or its stable local
// profile identity). Read it fresh: the progress cache polls less frequently.
ShareOwner :: (context: *void) -> string {
    unused context
    reply := own_service(Collections.COLLECTIONS_DRAFTS_SERVICE, "{\"operation\":\"status\"}")
    share_owner[0] = 0
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 ||
    TextUntilNul(status[:]) != "done" { return "" }
    length := ReadStringText(reply, FieldAt(reply, 0, "account"), share_owner[:])
    if length < 0 { return "" }
    // Entity keeps guest drafts in this host profile; the publications service
    // still decides whether a guest may share (normally signed-out).
    if length == 0 { return "local" }
    return TextUntilNul(share_owner[:])
}
ShareService :: (context: *void, service: string, request: string) -> string {
    unused context
    return own_service(service, request)
}

// Reset on profile navigation too, including a logout/relogin as the same ID.
ShareReset :: () {
    CollectionClientReset(*share_client)
    share_kind = SHARE_IDLE
    share_result = SHARE_REFUSED
    share_result_count = 0
    share_imported = 0
}

ShareClientResult :: (result: CollectionClientResult) -> s32 {
    if result.error == .Busy { return SHARE_BUSY }
    if result.state == .Pending { return SHARE_WAITING }
    if result.state == .Done { return SHARE_OK }
    if result.state == .Unavailable { return SHARE_UNAVAILABLE }
    if result.state == .Cancelled { share_result_count = 0; return SHARE_REFUSED }
    if result.error == .TooLarge { return SHARE_TOO_LARGE }
    if result.error == .SignedOut { return SHARE_SIGNED_OUT }
    if result.error == .Offline { return SHARE_OFFLINE }
    if result.error == .NotFound { return SHARE_NOT_FOUND }
    if result.error == .Malformed { return SHARE_UNAVAILABLE }
    return ShareErrorResult(TextUntilNul(result.detail[:]))
}

// Recheck before/after draft callbacks as well as the publications callback.
ShareCancelled :: () -> bool { return share_client.result.state == .Cancelled }
ShareCompleted :: () -> bool { return CollectionClientPump(*share_client, 0).state == .Done }
ShareCurrent :: () -> bool { return share_kind != SHARE_IDLE && ShareCompleted() }

ShareStart :: (kind: s32, request: Vec(u8)) -> s32 {
    if share_kind != SHARE_IDLE { VecFree(request); return SHARE_BUSY }
    // A previous terminal result still belongs to its original account.
    if CollectionClientPump(*share_client, 0).state == .Cancelled {
        share_result_count = 0
    }
    share_client.service = ShareService
    share_client.owner = ShareOwner
    // Keep the editor's first 600 ms poll; Entity owns every deadline.
    share_client.poll_delay = 600
    operation: CollectionClientOperation = .None
    if kind == SHARE_PUBLISH { operation = .Publish }
    else if kind == SHARE_UNPUBLISH { operation = .Unpublish }
    else if kind == SHARE_FIND { operation = .Find }
    else if kind == SHARE_FETCH { operation = .Fetch }
    result := ShareClientResult(CollectionClientStart(*share_client, operation,
        TextView(VecSlice(request, 0, request.count))))
    VecFree(request)
    if result == SHARE_WAITING { share_kind = kind; share_imported = 0 }
    share_result = result
    return result
}

SharePublish :: (title: string, visibility: s32) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    OwnRename(title)
    document: Vec(u8)
    OwnDocument(*document, false)
    request: Vec(u8)
    Collections.CollectionPublishRequest(*request, WURM_LEVELS_FORMAT, TextUntilNul(own_title[:]),
        visibility, TextView(VecSlice(document, 0, document.count)), TextUntilNul(own_publication[:]))
    VecFree(document)
    share_visibility = visibility
    return ShareStart(SHARE_PUBLISH, request)
}

ShareUnpublish :: () -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    if TextUntilNul(own_publication[:]) == "" { return SHARE_REFUSED }
    request: Vec(u8)
    Collections.CollectionUnpublishRequest(*request, TextUntilNul(own_publication[:]))
    return ShareStart(SHARE_UNPUBLISH, request)
}

ShareFind :: (query: string) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    request: Vec(u8)
    Collections.CollectionFindRequest(*request, WURM_LEVELS_FORMAT, query)
    return ShareStart(SHARE_FIND, request)
}

ShareFetch :: (index: s32) -> s32 {
    if share_kind != SHARE_IDLE { return SHARE_BUSY }
    if CollectionClientPump(*share_client, 0).state == .Cancelled {
        share_result_count = 0
    }
    if index < 0 || index >= share_result_count { return SHARE_NOT_FOUND }
    request: Vec(u8)
    Collections.CollectionFetchRequest(*request, TextUntilNul(share_results[index].id[:]))
    return ShareStart(SHARE_FETCH, request)
}

SharePoll :: (now: s64) -> s32 {
    state := CollectionClientPump(*share_client, now)
    share_client.poll_delay = 1000
    if share_kind == SHARE_IDLE {
        if state.state == .Cancelled {
            share_result_count = 0; share_imported = 0; share_result = SHARE_REFUSED
        }
        return share_result
    }
    result := ShareClientResult(state)
    if result == SHARE_WAITING { return SHARE_WAITING }
    if result != SHARE_OK { return ShareFinish(result) }
    retained: Vec(u8)
    CollectionClientReadReply(*share_client, *retained)
    if !ShareCurrent() { return ShareFinish(SHARE_REFUSED) }
    reply := TextView(VecSlice(retained, 0, retained.count))

    kind := share_kind
    if kind == SHARE_UNPUBLISH {
        own_publication[0] = 0
        own_visibility = Collections.COLLECTION_PRIVATE
        return ShareFinish(ifx OwnSave(ShareCurrent) then SHARE_OK else SHARE_REFUSED)
    }

    if kind == SHARE_FIND {
        found := Collections.CollectionFindRead(reply, WURM_LEVELS_FORMAT, share_results[:])
        if found < 0 { return ShareFinish(SHARE_REFUSED) }
        share_result_count = found
        return ShareFinish(SHARE_OK)
    }

    meta: Collections.CollectionMeta
    if !Collections.CollectionPublicationRead(reply, WURM_LEVELS_FORMAT, *meta) {
        return ShareFinish(SHARE_REFUSED)
    }
    if kind == SHARE_PUBLISH {
        for byte, index: meta.id { own_publication[index] = byte }
        own_visibility = share_visibility
        return ShareFinish(ifx OwnSave(ShareCurrent) then SHARE_OK else SHARE_REFUSED)
    }

    // Fetch: the imported collection is a new private draft of our own.
    title: [160]u8
    for byte, index: meta.title { title[index] = byte }
    if TextUntilNul(title[:]) == "" {
        for byte, index: "Shared levels" { title[index] = byte }
        title[13] = 0
    }
    document_at := FieldAt(reply, 0, "document")
    if document_at < 0 { return ShareFinish(SHARE_REFUSED) }
    imported := OwnImport(reply, document_at, TextUntilNul(title[:]), ShareCurrent)
    if imported < 0 { return ShareFinish(SHARE_REFUSED) }
    share_imported = imported
    return ShareFinish(SHARE_OK)
}
