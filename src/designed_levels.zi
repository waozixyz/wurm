DesignedTile :: (level: s32, x: s32, y: s32) -> u8 {
    text := DesignedLevelText(level)
    code := text[x * 30 + y]
    for index: 0..DesignedAlphabet.count - 1 {
        if DesignedAlphabet[index] == code { return DesignedCodebook[index] }
    }
    return 20
}
