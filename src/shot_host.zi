// The display-free host supplies decoded image pixels through Kryon's public
// pixmap asset API. Each .argb beside a picture holds its width, height and
// BGRA pixels.
using P :: #import "kryon/pixmap";
using UI :: #import "kryon/Widgets";
#import "kryon/session";
#import "kryon/tree";
#import "kryon/Frame";
App :: #import "app";
Game :: #import, file "game.zi";
File :: #import "std/file_linux";
using Vectors :: #import "std/vec";
#import "std/c_string";
libc :: #system_library "libc";
GetEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
ParseNumber :: (text: *u8) -> s32 #foreign libc "atoi";

U32 :: (bytes: []u8, at: s32) -> u32 {
    return cast(u32)bytes[at] | (cast(u32)bytes[at + 1] << 8) |
        (cast(u32)bytes[at + 2] << 16) | (cast(u32)bytes[at + 3] << 24)
}

ReadPicture :: (binary: string) -> (pixels: Vec(u32), width: s32, height: s32) {
    pixels: Vec(u32)
    width: s32
    height: s32
    file := File.OpenRead(binary)
    if file.valid {
        bytes: [4096]u8
        if File.ReadAt(file, bytes[0:8], 0) == 8 {
            width = cast(s32)U32(bytes[:], 0)
            height = cast(s32)U32(bytes[:], 4)
            if width <= 0 || height <= 0 || width > 2048 || height > 2048 || width * height > 2097152 {
                width = 0; height = 0
            }
            count := width * height
            pixel: s32 = 0
            ok := true
            while pixel < count && ok {
                next := count - pixel
                if next > 1024 { next = 1024 }
                if File.ReadAt(file, bytes[0:next * 4], 8 + cast(s64)pixel * 4) != next * 4 {
                    ok = false
                } else {
                    for index: 0..next - 1 {
                        if !VecPush(pixels, U32(bytes[:], cast(s32)index * 4)) { ok = false; break }
                    }
                }
                pixel += next
            }
            if !ok { width = 0; height = 0 }
        }
        File.CloseFile(file)
    }
    return pixels, width, height
}

#program_export
main :: () -> s32 {
    // Keep the owned image buffers in this scope while the raster host
    // borrows them. Full-size title pixels preserve desktop crop coordinates.
    garden, garden_w, garden_h := ReadPicture("assets/art/garden.argb")
    campaign_meadow, campaign_meadow_w, campaign_meadow_h := ReadPicture("assets/art/campaign-meadow.argb")
    campaign_leafwood, campaign_leafwood_w, campaign_leafwood_h := ReadPicture("assets/art/campaign-leafwood.argb")
    campaign_pinewood, campaign_pinewood_w, campaign_pinewood_h := ReadPicture("assets/art/campaign-pinewood.argb")
    campaign_lake, campaign_lake_w, campaign_lake_h := ReadPicture("assets/art/campaign-lake.argb")
    campaign_mountains, campaign_mountains_w, campaign_mountains_h := ReadPicture("assets/art/campaign-mountains.argb")
    stage_covers, stage_covers_w, stage_covers_h := ReadPicture("assets/art/stage-covers.argb")
    title, title_w, title_h := ReadPicture("assets/art/title.argb")
    title_portrait, title_portrait_w, title_portrait_h := ReadPicture("assets/art/title-portrait.argb")
    forest_canopy, forest_canopy_w, forest_canopy_h := ReadPicture("assets/art/forest-canopy.argb")
    forest_canopy_portrait, forest_canopy_portrait_w, forest_canopy_portrait_h := ReadPicture("assets/art/forest-canopy-portrait.argb")
    ground, ground_w, ground_h := ReadPicture("assets/art/ground-meadow.argb")
    if !PixmapSetImage(11, "assets/art/ground-meadow.png", ground_w, ground_h, VecSlice(ground, 0, ground.count)) { return 1 }
    if !PixmapSetImage(0, "assets/art/garden.png", garden_w, garden_h, VecSlice(garden, 0, garden.count)) ||
        !PixmapSetImage(1, "assets/art/campaign-meadow.png", campaign_meadow_w, campaign_meadow_h, VecSlice(campaign_meadow, 0, campaign_meadow.count)) ||
        !PixmapSetImage(2, "assets/art/campaign-leafwood.png", campaign_leafwood_w, campaign_leafwood_h, VecSlice(campaign_leafwood, 0, campaign_leafwood.count)) ||
        !PixmapSetImage(3, "assets/art/campaign-pinewood.png", campaign_pinewood_w, campaign_pinewood_h, VecSlice(campaign_pinewood, 0, campaign_pinewood.count)) ||
        !PixmapSetImage(4, "assets/art/campaign-lake.png", campaign_lake_w, campaign_lake_h, VecSlice(campaign_lake, 0, campaign_lake.count)) ||
        !PixmapSetImage(5, "assets/art/campaign-mountains.png", campaign_mountains_w, campaign_mountains_h, VecSlice(campaign_mountains, 0, campaign_mountains.count)) ||
        !PixmapSetImage(6, "assets/art/stage-covers.png", stage_covers_w, stage_covers_h, VecSlice(stage_covers, 0, stage_covers.count)) ||
        !PixmapSetImage(7, "assets/art/title.png", title_w, title_h, VecSlice(title, 0, title.count)) ||
        !PixmapSetImage(8, "assets/art/title-portrait.png", title_portrait_w, title_portrait_h, VecSlice(title_portrait, 0, title_portrait.count)) ||
        !PixmapSetImage(9, "assets/art/forest-canopy.png", forest_canopy_w, forest_canopy_h, VecSlice(forest_canopy, 0, forest_canopy.count)) ||
        !PixmapSetImage(10, "assets/art/forest-canopy-portrait.png", forest_canopy_portrait_w, forest_canopy_portrait_h, VecSlice(forest_canopy_portrait, 0, forest_canopy_portrait.count)) { return 1 }
    name: [32]u8
    unused CopyCString("WORM_SHOT_LEVEL", name[:])
    level := GetEnvironment(*name[0])
    if level != null {
        Game.StartGame(*App.game, ParseNumber(level) - 1, 0)
        for i: 0..31 { Game.Tick(*App.game) }
        App.game.mode = Game.MODE_PAUSED
    }
    unused CopyCString("WORM_SHOT_STAGES", name[:])
    if GetEnvironment(*name[0]) != null {
        App.game.started = true
        App.OpenStages()
    }
    unused CopyCString("WORM_SHOT_EDITOR", name[:])
    if GetEnvironment(*name[0]) != null {
        // WORM_SHOT_LEVEL picks which level the editor frame shows; the
        // started flag keeps Frame's first-run OpenStages from overriding it.
        App.game.started = true
        if level != null { App.OpenEditor(ParseNumber(level) - 1) }
        else { App.OpenEditor(0) }
        unused CopyCString("WORM_SHOT_BROWSER", name[:])
        if GetEnvironment(*name[0]) != null { App.editor.browsing = true }
        unused CopyCString("WORM_SHOT_TURN", name[:])
        if GetEnvironment(*name[0]) != null { App.EditorTurn() }
    }
    session := SessionOpen()
    if !SessionValid(session) { return 2 }
    defer { PixmapCloseWorkers(); CloseSession(session) }
    viewport := Rectangle.{0.0, 0.0, cast(float32)PixmapWidth, cast(float32)PixmapHeight}
    frame: s32 = 0
    while frame < 2 {
        PixmapBegin(cast(u32)PixmapBackground)
        if cast(s32)BeginFrame(session, 1, viewport) != 0 { return 3 }
        if App.Frame(session, viewport) != 0 { return 4 }
        if cast(s32)EndFrame(session) != 0 { return 5 }
        frame += 1
    }
    PixmapPresent()
    return 0
}
