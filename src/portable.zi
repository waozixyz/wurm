Apps :: #import "apps/node_types";
Node :: #import "apps/node_app";
#import "kryon/geometry"
UiSession :: #import "kryon/session";
App :: #import, file "app.zi";
Runtime :: #import "portable_runtime";
Locale :: #import, file "localization.zi";
host_api :: #system_library "host_api";

ReadAppUiHost :: () -> Apps.AppUiFrame #foreign host_api;

#program_export
Main :: () -> s32 { return Node.RunNodeApp(WurmFrame, WurmBack) }

WurmFrame :: (message: Apps.AppMessage) -> bool {
    Locale.SetLanguage(message.locale)
    frame := ReadAppUiHost()
    Runtime.FrameTime(frame.now)
    area := Rectangle.{0.0, cast(float32)frame.top, cast(float32)frame.width,
        cast(float32)(frame.height - frame.top - frame.bottom)}
    // The portable entry and Apps may use different Kryon revisions.
    session := UiSession.Session.{.slot = frame.session.slot, .epoch = frame.session.epoch}
    return App.Frame(session, area) == 0
}

WurmBack :: (message: Apps.AppMessage) -> bool {
    Locale.SetLanguage(message.locale)
    return App.NavigateBack(Runtime.MonotonicMilliseconds())
}
