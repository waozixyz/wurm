#import, file "original_levels.zi";
#import, file "designed_levels.zi";

// Rules recovered from the owner's WURM.EXE. Coordinates are original pixels.
// COLUMNS x ROWS is the recovered canonical grid, also the archive and
// editor layout. The playing board may stand the same level turned a
// quarter (30x40) for portrait windows; loaders set the live dimensions.
COLUMNS :: 40;
ROWS :: 30;
CELLS :: 1200;
board_columns: s32 = 40;
board_rows: s32 = 30;
BoardSize :: (columns: s32, rows: s32) {
    board_columns = columns
    board_rows = rows
}
// Five connected landscapes, played as the same worm. The complete recovered
// 99-level archive remains untouched as reference data.
STAGE_COUNT :: 5;
LEVEL_COUNT :: 200;
WORM_LIMIT :: 1000;
MONSTER_LIMIT :: 100;
TICK_MS :: 25;
DIR_LEFT :: 0;
DIR_UP :: 1;
DIR_RIGHT :: 2;
DIR_DOWN :: 3;
MODE_STAGES :: 0;
MODE_PLAYING :: 1;
MODE_PAUSED :: 2;
MODE_DIED :: 3;
MODE_FINISHED :: 4;
MODE_VICTORY :: 5;
MODE_EDITOR :: 6;
MODE_CONTROLS :: 7;
MODE_LEVELS :: 8;
MODE_SETTINGS :: 9;
MODE_SHOP :: 10;
// The next board is visible, but its clock starts only on confirmation.
MODE_READY :: 11;

// A gentle Meadow introduction, reaching the recovered pace at Leafwood.
TickInterval :: (level: s32) -> s64 {
    interval := 32 - level / 2
    if interval < TICK_MS { interval = TICK_MS }
    return cast(s64)interval
}

Point :: struct { x: s32; y: s32; }
// Two rings joined: stepping into one comes out of the other.
Portal :: struct { a: Point; b: Point; }
PORTAL_PAIRS :: 2;
// The certificate drives routes on the plain boards; animals stay active.
features_enabled: bool = true;
// animal: one of ANIMAL_*; timer counts the creature's own ticks.
Monster :: struct { position: Point; kind: s32; direction: s32; animal: s32; timer: s32; }
Particle :: struct { position: Point; life: s32; }
Game :: struct {
    mode: s32
    level: s32
    score: s32
    lives: s32
    board: [CELLS]u8
    objects: [CELLS]u8
    worm: [WORM_LIMIT]Point
    length: s32
    target_length: s32
    direction: s32
    next_direction: s32
    next_step: s64
    apples: s32
    apple: Point
    apple_flash: s32
    monster_count: s32
    // Points per apple on this board; see LevelMultiplier.
    multiplier: s32
    // Portal pairs on this board and the ticks before the next jump.
    portal_count: s32
    portals: [PORTAL_PAIRS]Portal
    portal_wait: s32
    // This board's puzzle idea: a gate (a doorway up to four cells across,
    // gate_span cells gate_step apart), its key or switch stone.
    feature: s32
    gate: s32
    gate_span: s32
    gate_step: s32
    gate_tiles: [4]u8
    gate_open: bool
    key: Point
    switch_stone: Point
    on_switch: bool
    monsters: [MONSTER_LIMIT]Monster
    particles: [100]Particle
    death_ticks: s32
    transition_ticks: s32
    random: u32
    started: bool
}

Index :: (x: s64, y: s64) -> s32 { return cast(s32)(y * board_columns + x) }
StageOf :: (level: s32) -> s32 {
    for stage: 0..STAGE_COUNT - 2 {
        if level < DesignedStageStarts[stage + 1] { return cast(s32)stage }
    }
    return STAGE_COUNT - 1
}
StageFirst :: (stage: s32) -> s32 { return DesignedStageStarts[stage] }
StageLevels :: (stage: s32) -> s32 { return DesignedStageStarts[stage + 1] - DesignedStageStarts[stage] }
StageNumber :: (level: s32) -> s32 { return level - StageFirst(StageOf(level)) + 1 }
Inside :: (x: s64, y: s64) -> bool { return x >= 0 && x < board_columns && y >= 0 && y < board_rows }
Abs :: (v: s32) -> s32 { if v < 0 { return -v }; return v }
Near :: (a: Point, b: Point, distance: s32) -> bool {
    return Abs(a.x - b.x) < distance && Abs(a.y - b.y) < distance
}

// Watcom rand(), WURM.EXE 0x4091dd: 32-bit LCG, high 15 bits.
Random :: (game: *Game, limit: s32) -> s32 {
    next := (cast(u64)game.random * 1103515245 + 12345) & 4294967295
    game.random = cast(u32)next
    return cast(s32)((game.random >> 16) & 32767) % limit
}

TileAt :: (game: *Game, position: Point) -> s32 {
    if position.x < 0 || position.y < 0 || position.x >= board_columns * 16 || position.y >= board_rows * 16 { return 20 }
    return cast(s32)game.board[Index(position.x / 16, position.y / 16)]
}
WallAt :: (game: *Game, position: Point) -> bool {
    tile := TileAt(game, position)
    // Bit 7 marks a visible but passable tile, including false walls.
    return tile >= 20 && tile < 128
}
WormNear :: (game: *Game, position: Point, start: s32, distance: s32) -> bool {
    index := start
    while index < game.length - 4 {
        if Near(position, game.worm[index], distance) { return true }
        index += 4
    }
    return false
}
SpawnApple :: (game: *Game) {
    if game.apples <= 0 { game.apple = Point.{-1, -1}; return }
    // Original apples use pixel coordinates, not cell centers.
    for attempt: 0..32767 {
        // Temporary edge gates can close behind the tail. Apples belong on
        // the permanent interior floor, never inside those gate cells.
        candidate := Point.{16 + Random(game, (board_columns - 2) * 16),
            16 + Random(game, (board_rows - 2) * 16)}
        if TileAt(game, candidate) < 20 && !WormNear(game, candidate, 0, 10) && !OnPortal(game, candidate) {
            game.apple = candidate
            game.apple_flash = 128
            return
        }
    }
    for at: 0..CELLS - 1 {
        candidate := Point.{cast(s32)(at % board_columns) * 16 + 8, cast(s32)(at / board_columns) * 16 + 8}
        if candidate.x < 16 || candidate.y < 16 || candidate.x >= (board_columns - 1) * 16 || candidate.y >= (board_rows - 1) * 16 { continue }
        if TileAt(game, candidate) < 20 && !WormNear(game, candidate, 0, 10) && !OnPortal(game, candidate) {
            game.apple = candidate
            game.apple_flash = 128
            return
        }
    }
    game.apple = Point.{-1, -1}
}
// The gates keep their neighbouring tiles: only the hole is carved.
OpenEntrance :: (game: *Game) {
    half := board_columns / 2
    game.board[Index(half, board_rows - 1)] = game.board[Index(half, board_rows - 2)] & 127
}
CloseEntrance :: (game: *Game) { game.board[Index(board_columns / 2, board_rows - 1)] = 20 }
// About one second of straight travel at the fastest campaign pace, with
// room to take either first corner. Keep this relative to the live layout
// so portrait starts receive the same clearance as landscape starts.
START_CLEAR_ROWS :: 8;
START_CLEAR_HALF_WIDTH :: 2;
StartClearance :: (x: s32, y: s32) -> bool {
    return Abs(x - board_columns / 2) <= START_CLEAR_HALF_WIDTH &&
        y >= board_rows - 1 - START_CLEAR_ROWS && y < board_rows - 1
}

ClearStart :: (game: *Game) {
    half := board_columns / 2
    for y: board_rows - 1 - START_CLEAR_ROWS..board_rows - 2 {
        for x: half - START_CLEAR_HALF_WIDTH..half + START_CLEAR_HALF_WIDTH {
            at := Index(x, y)
            if game.board[at] >= 20 { game.board[at] = 0 }
            game.objects[at] = 0
        }
    }
    // A nearby chaser can cover several cells while the head enters. Keep
    // that approach clear too, including on a later life, rather than
    // requiring an immediate reversal to escape a creature at the gate.
    kept: s32 = 0
    for index: 0..game.monster_count - 1 {
        monster := game.monsters[index]
        near_start := Abs(monster.position.x / 16 - half) <= START_CLEAR_HALF_WIDTH + 3 &&
            monster.position.y / 16 >= board_rows - 1 - START_CLEAR_ROWS - 3
        if !near_start {
            game.monsters[kept] = monster
            kept += 1
        }
    }
    game.monster_count = kept
}

OpenExit :: (game: *Game) {
    half := board_columns / 2
    game.board[Index(half, 0)] = game.board[Index(half, 1)] & 127
}
Respawn :: (game: *Game) {
    ClearStart(game)
    game.length = 1
    game.target_length = 2
    game.direction = DIR_UP
    game.next_direction = DIR_UP
    game.death_ticks = 0
    game.worm[0] = Point.{board_columns / 2 * 16 + 8, board_rows * 16 + 16}
    OpenEntrance(game)
}
LoadLevelData :: (game: *Game, level: s32, now: s64, board: []u8, apples: s32, columns: s32, rows: s32, objects: []u8) {
    BoardSize(columns, rows)
    for at: 0..CELLS - 1 { game.objects[at] = objects[at] }
    if level < 0 { level = 0 }
    if level >= LEVEL_COUNT { level = LEVEL_COUNT - 1 }
    game.mode = MODE_PLAYING
    game.level = level
    game.apples = apples
    game.monster_count = 0
    game.transition_ticks = 0
    for index: 0..99 { game.particles[index].life = 0 }
    game.next_step = now + TickInterval(level)
    game.started = true
    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            tile := board[Index(x, y)]
            game.board[Index(x, y)] = tile
            kind := cast(s32)(tile & 127) - 39
            if kind >= 1 && kind <= 6 && game.monster_count < MONSTER_LIMIT {
                index := game.monster_count
                game.monsters[index].position = Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8}
                game.monsters[index].kind = kind
                game.monsters[index].direction = ifx kind == 1 then Random(game, 4) else kind - 2
                animal: s32 = ANIMAL_CLASSIC
                if kind == 1 { animal = RoamerAnimal(level, index) }
                else if kind >= 2 && kind <= 5 { animal = PatrolAnimal(level, index) }
                game.monsters[index].animal = animal
                game.monsters[index].timer = 0
                game.monster_count += 1
                game.board[Index(x, y)] = tile & 128
            }
        }
    }
    game.length = 0
    // Carve the entrance before the apple chooses its spot, so it can never
    // land on a cell the carving turns into wall.
    Respawn(game)
    PlaceIdeas(game)
    SpawnApple(game)
    game.multiplier = LevelMultiplier(game)
}

// New ideas arrive one at a time, about twenty levels apart, and keep coming
// back afterwards in a clean mix: squirrels from level 45, portals from 61,
// hedgehogs from 85, keys and gates from 101, frogs from 125, switch stones
// from 141, rolling stones from 165 and portal rooms from 181. A board's ideas
// follow from its number and layout alone, so every player meets the same.
IDEA_SQUIRREL :: 44
IDEA_PORTALS :: 60
IDEA_HEDGEHOG :: 84
IDEA_KEY :: 100
IDEA_FROG :: 124
IDEA_SWITCH :: 140
IDEA_STONE :: 164
IDEA_PORTAL_ROOM :: 180
// At most one puzzle idea per board.
FEATURE_NONE :: 0
FEATURE_PORTALS :: 1
FEATURE_KEY :: 2
FEATURE_SWITCH :: 3
FEATURE_PORTAL_ROOM :: 4
ANIMAL_CLASSIC :: 0
ANIMAL_SQUIRREL :: 1
ANIMAL_HEDGEHOG :: 2
ANIMAL_FROG :: 3
ANIMAL_STONE :: 4
HEDGEHOG_CURL :: 60

// A well-spread number for each value, the same on every platform: no step
// overflows 63 bits.
Mix :: (value: s64) -> s32 {
    mixed := (value % 2147483648 + 2147483648) % 2147483648
    for round: 0..1 {
        mixed = (mixed * 1103515245 + 12345) % 2147483648
        mixed = mixed ^ (mixed >> 16)
    }
    return cast(s32)(mixed % 1000003)
}

// A new puzzle idea takes every other board for its first ten levels; then
// the ideas so far take turns, with up to two plain boards between them.
IdeaIntros: [4]s32 = .[IDEA_PORTALS, IDEA_KEY, IDEA_SWITCH, IDEA_PORTAL_ROOM];
IdeasMet :: (level: s32) -> s32 {
    count: s32 = 0
    for index: 0..3 { if level >= IdeaIntros[index] { count = cast(s32)index + 1 } }
    return count
}
BoardFeature :: (level: s32) -> s32 {
    count := IdeasMet(level)
    if count == 0 { return FEATURE_NONE }
    newest := IdeaIntros[count - 1]
    if level - newest < 10 { return ifx (level - newest) % 2 == 0 then count else FEATURE_NONE }
    // Never more than two plain boards in a row.
    plain := Mix(cast(s64)level) % 10 < 4
    if plain && !(PlainMix(level - 1) && PlainMix(level - 2)) { return FEATURE_NONE }
    return 1 + Mix(cast(s64)level * 7 + 3) % count
}
PlainMix :: (level: s32) -> bool {
    count := IdeasMet(level)
    return count == 0 || level - IdeaIntros[count - 1] < 10 || Mix(cast(s64)level) % 10 < 4
}

AnimalIntro :: (animal: s32) -> s32 {
    if animal == ANIMAL_SQUIRREL { return IDEA_SQUIRREL }
    if animal == ANIMAL_HEDGEHOG { return IDEA_HEDGEHOG }
    if animal == ANIMAL_FROG { return IDEA_FROG }
    if animal == ANIMAL_STONE { return IDEA_STONE }
    return 0
}

// Wanderers: a landscape's own animal fills its first ten boards, then the
// animals met so far mix with the classic flames.
RoamerAnimal :: (level: s32, index: s32) -> s32 {
    available: [3]s32
    count: s32 = 0
    if level >= IDEA_SQUIRREL { available[count] = ANIMAL_SQUIRREL; count += 1 }
    if level >= IDEA_HEDGEHOG { available[count] = ANIMAL_HEDGEHOG; count += 1 }
    if level >= IDEA_FROG { available[count] = ANIMAL_FROG; count += 1 }
    if count == 0 { return ANIMAL_CLASSIC }
    stage := StageOf(level)
    native: s32 = ifx stage == 1 then ANIMAL_SQUIRREL else ifx stage == 2 then ANIMAL_HEDGEHOG else ifx stage == 3 then ANIMAL_FROG else ANIMAL_CLASSIC
    ready := native != ANIMAL_CLASSIC && level >= AnimalIntro(native)
    if ready && level - AnimalIntro(native) < 10 { return native }
    roll := Mix(cast(s64)level * 131 + cast(s64)index) % 10
    if roll < 3 { return ANIMAL_CLASSIC }
    if ready && roll < 7 { return native }
    return available[Mix(cast(s64)level * 17 + cast(s64)index) % count]
}

// Patrols become rolling stones in the mountains.
PatrolAnimal :: (level: s32, index: s32) -> s32 {
    if level < IDEA_STONE { return ANIMAL_CLASSIC }
    if level - IDEA_STONE < 10 || Mix(cast(s64)level * 29 + cast(s64)index) % 2 == 0 { return ANIMAL_STONE }
    return ANIMAL_CLASSIC
}

Passable :: (game: *Game, at: s32) -> bool {
    tile := game.board[at]
    return tile < 20 || tile >= 128
}

// Every cell the worm can reach from the entrance with a doorway closed: span
// cells from door, step apart.
FloodFrom :: (game: *Game, start: s32, door: s32, reached: []bool, span: s32 = 1, step: s32 = 1) -> s32 {
    closed: [CELLS]bool
    for at: 0..CELLS - 1 { reached[at] = false; closed[at] = false }
    if door >= 0 { for cell: 0..span - 1 { closed[door + cast(s32)cell * step] = true } }
    if !Passable(game, start) || closed[start] { return 0 }
    queue: [CELLS]s32
    head: s32 = 0
    tail: s32 = 1
    queue[0] = start
    reached[start] = true
    while head < tail {
        at := queue[head]
        head += 1
        x := at % board_columns
        y := at / board_columns
        neighbours: [4]s32 = .[ifx x > 0 then at - 1 else -1, ifx x < board_columns - 1 then at + 1 else -1,
            ifx y > 0 then at - board_columns else -1, ifx y < board_rows - 1 then at + board_columns else -1]
        for next: neighbours {
            if next < 0 || closed[next] || reached[next] || !Passable(game, next) { continue }
            reached[next] = true
            queue[tail] = next
            tail += 1
        }
    }
    return tail
}

// A doorway: a straight run of one to four floor cells across a corridor,
// walled at both ends and open on both sides, that once closed cuts the board
// into two sizable halves, the far one holding the exit when the board allows.
// reached marks the entrance side.
Floor :: (game: *Game, x: s32, y: s32) -> bool { return Inside(x, y) && Passable(game, Index(x, y)) && game.board[Index(x, y)] < 128 }
Solid :: (game: *Game, x: s32, y: s32) -> bool { return Inside(x, y) && !Passable(game, Index(x, y)) }
DoorwaySpan :: (game: *Game, x: s32, y: s32, dx: s32, dy: s32) -> s32 {
    half := board_columns / 2
    if !Solid(game, x - dx, y - dy) { return 0 }
    for span: 1..4 {
        cx := x + dx * cast(s32)(span - 1)
        cy := y + dy * cast(s32)(span - 1)
        if cy < 2 || cy > board_rows - 4 || StartClearance(cx, cy) ||
        (Abs(cx - half) <= 3 && (cy <= 3 || cy >= board_rows - 4)) { return 0 }
        if !Floor(game, cx, cy) || !Floor(game, cx - dy, cy - dx) || !Floor(game, cx + dy, cy + dx) { return 0 }
        if Solid(game, cx + dx, cy + dy) { return cast(s32)span }
    }
    return 0
}
FindDoorway :: (game: *Game, reached: []bool, span: *s32, step: *s32, feature: s32) -> s32 {
    half := board_columns / 2
    start := Index(half, board_rows - 2)
    exit := Index(half, 1)
    firsts: [2 * CELLS]s32
    spans: [2 * CELLS]s32
    steps: [2 * CELLS]s32
    count: s32 = 0
    for y: 2..board_rows - 4 {
        for x: 1..board_columns - 2 {
            across := DoorwaySpan(game, cast(s32)x, cast(s32)y, 1, 0)
            if across > 0 { firsts[count] = Index(x, y); spans[count] = across; steps[count] = 1; count += 1 }
            down := DoorwaySpan(game, cast(s32)x, cast(s32)y, 0, 1)
            if down > 0 { firsts[count] = Index(x, y); spans[count] = down; steps[count] = board_columns; count += 1 }
        }
    }
    if count == 0 { return -1 }
    total: s32 = 0
    for at: 0..CELLS - 1 { if Passable(game, cast(s32)at) { total += 1 } }
    fallback: s32 = -1
    offset := Mix(cast(s64)game.level) % count
    for attempt: 0..count - 1 {
        pick := (offset + cast(s32)attempt) % count
        near := FloodFrom(game, start, firsts[pick], reached, spans[pick], steps[pick])
        far := total - near - spans[pick]
        if near < 24 || far < 24 { continue }
        exit_beyond := Passable(game, exit) && !reached[exit]
        if !exit_beyond && fallback >= 0 { continue }
        if !IdeaFits(game, reached, firsts[pick], feature) { continue }
        if exit_beyond { span.* = spans[pick]; step.* = steps[pick]; return firsts[pick] }
        fallback = pick
    }
    if fallback < 0 { return -1 }
    unused FloodFrom(game, start, firsts[fallback], reached, spans[fallback], steps[fallback])
    span.* = spans[fallback]
    step.* = steps[fallback]
    return firsts[fallback]
}

// Whether this board's idea has its spots once the doorway closes: a key or
// switch stone before it, a portal on each side of a portal room.
IdeaFits :: (game: *Game, reached: []bool, door: s32, feature: s32) -> bool {
    if feature == FEATURE_PORTAL_ROOM {
        spots: [CELLS]s32
        return OpenSpots(game, reached, 1, spots[:]) > 0 && OpenSpots(game, reached, 0, spots[:]) > 0
    }
    return SideSpot(game, reached, door, feature == FEATURE_KEY).x >= 0
}

// Open spots for portals, keys and switch stones: the middle of open floor,
// clear of the entrance and exit lanes and of the board's creatures. A key
// or switch stone may also lie in a corridor (loose).
OpenAround :: (game: *Game, x: s32, y: s32) -> bool {
    for dy: -1..1 {
        for dx: -1..1 {
            if !Inside(x + dx, y + dy) || game.board[Index(x + dx, y + dy)] >= 20 { return false }
        }
    }
    return true
}
OpenFloor :: (game: *Game, x: s32, y: s32) -> bool { return Inside(x, y) && game.board[Index(x, y)] < 20 }
InCorridor :: (game: *Game, x: s32, y: s32) -> bool {
    if !OpenFloor(game, x, y) { return false }
    open: s32 = 0
    if OpenFloor(game, x - 1, y) { open += 1 }
    if OpenFloor(game, x + 1, y) { open += 1 }
    if OpenFloor(game, x, y - 1) { open += 1 }
    if OpenFloor(game, x, y + 1) { open += 1 }
    return open >= 3
}
// side: 1 only the entrance side, 0 only the far side, -1 anywhere.
OpenSpots :: (game: *Game, reached: []bool, side: s32, output: []s32, loose: bool = false) -> s32 {
    count: s32 = 0
    half := board_columns / 2
    for y: 3..board_rows - 4 {
        for x: 2..board_columns - 3 {
            if StartClearance(cast(s32)x, cast(s32)y) ||
            (Abs(cast(s32)x - half) <= 2 && (y <= 5 || y >= board_rows - 6)) { continue }
            if !OpenAround(game, cast(s32)x, cast(s32)y) && !(loose && InCorridor(game, cast(s32)x, cast(s32)y)) { continue }
            at := Index(x, y)
            if side >= 0 && reached[at] != (side == 1) { continue }
            centre := Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8}
            crowded := false
            for index: 0..game.monster_count - 1 {
                if Near(centre, game.monsters[index].position, 32) { crowded = true }
            }
            if !crowded { output[count] = at; count += 1 }
        }
    }
    return count
}
PortalCentre :: (cell: s32) -> Point {
    return Point.{(cell % board_columns) * 16 + 8, (cell / board_columns) * 16 + 8}
}
CellsApart :: (first: s32, second: s32) -> s32 {
    return Abs(first % board_columns - second % board_columns) + Abs(first / board_columns - second / board_columns)
}
// Pairs far apart in the open; a portal room joins one spot on each side.
PlacePortals :: (game: *Game, pairs: s32, reached: []bool, room: bool) -> bool {
    near_spots: [CELLS]s32
    far_spots: [CELLS]s32
    near := OpenSpots(game, reached, ifx room then 1 else -1, near_spots[:])
    far := ifx room then OpenSpots(game, reached, 0, far_spots[:]) else 0
    if !room { far_spots = near_spots; far = near }
    if near < 1 || far < 1 { return false }
    taken: [4]s32
    taken_count: s32 = 0
    for pair: 0..pairs - 1 {
        first: s32 = -1
        for attempt: 0..near - 1 {
            cell := near_spots[(Mix(cast(s64)game.level * 7919 + cast(s64)pair * 31) + cast(s32)attempt) % near]
            free := true
            for index: 0..taken_count - 1 { if CellsApart(cell, taken[index]) < 6 { free = false } }
            if free { first = cell; break }
        }
        if first < 0 { break }
        second: s32 = -1
        farthest: s32 = ifx room then 0 else 13
        for index: 0..far - 1 {
            cell := far_spots[index]
            apart := CellsApart(cell, first)
            if apart <= farthest { continue }
            free := true
            for other: 0..taken_count - 1 { if CellsApart(cell, taken[other]) < 6 { free = false } }
            if free { second = cell; farthest = apart }
        }
        if second < 0 { break }
        game.portals[pair] = Portal.{PortalCentre(first), PortalCentre(second)}
        taken[taken_count] = first
        taken[taken_count + 1] = second
        taken_count += 2
        game.portal_count += 1
    }
    return game.portal_count > 0
}
// The spot on the entrance side farthest from the entrance, for a key; a
// switch stone takes a spot partway there.
SideSpot :: (game: *Game, reached: []bool, door: s32, farthest: bool) -> Point {
    spots: [CELLS]s32
    count := OpenSpots(game, reached, 1, spots[:], true)
    start := Index(board_columns / 2, board_rows - 2)
    best: s32 = -1
    best_apart: s32 = -1
    for index: 0..count - 1 {
        cell := spots[index]
        if CellsApart(cell, door) < 4 || CellsApart(cell, start) < 6 { continue }
        apart := CellsApart(cell, start)
        if !farthest { apart = 100 - Abs(apart - 14) }
        if apart > best_apart { best = cell; best_apart = apart }
    }
    if best < 0 { return Point.{-1, -1} }
    return PortalCentre(best)
}
OpenGate :: (game: *Game, open: bool) {
    if game.gate < 0 { return }
    for cell: 0..game.gate_span - 1 {
        game.board[game.gate + cast(s32)cell * game.gate_step] = ifx open then game.gate_tiles[cell] else 20
    }
    game.gate_open = open
}
PlaceIdeas :: (game: *Game) {
    game.portal_count = 0
    game.portal_wait = 0
    game.feature = FEATURE_NONE
    game.gate = -1
    game.gate_span = 0
    game.gate_step = 1
    game.gate_open = false
    game.key = Point.{-1, -1}
    game.switch_stone = Point.{-1, -1}
    game.on_switch = false
    if !features_enabled { return }
    feature := BoardFeature(game.level)
    reached: [CELLS]bool
    if feature == FEATURE_PORTALS {
        // In the last landscape a board with a closed room puts its portal
        // there.
        if game.level >= IDEA_PORTAL_ROOM && PlaceGate(game, FEATURE_PORTAL_ROOM, reached[:]) {
            game.feature = FEATURE_PORTAL_ROOM
            return
        }
        pairs: s32 = ifx game.level >= IDEA_PORTAL_ROOM && Mix(cast(s64)game.level * 3) % 2 == 1 then PORTAL_PAIRS else 1
        if PlacePortals(game, pairs, reached[:], false) { game.feature = feature }
        return
    }
    if feature == FEATURE_NONE {
        // A new gate idea that found no doorway on the board before moves
        // on to this one.
        newest := IdeasMet(game.level)
        if newest < FEATURE_KEY || game.level - IdeaIntros[newest - 1] >= 10 || HostsIdea(game.level - 1, newest) { return }
        if PlaceGate(game, newest, reached[:]) { game.feature = newest }
        return
    }
    // A board without a doorway for its idea takes another gate idea met
    // so far, or else portals.
    ideas: [3]s32 = .[feature, FEATURE_SWITCH, FEATURE_KEY]
    intros: [3]s32 = .[0, IDEA_SWITCH, IDEA_KEY]
    for index: 0..2 {
        idea := ideas[index]
        if (index > 0 && idea == feature) || game.level < intros[index] { continue }
        if PlaceGate(game, idea, reached[:]) { game.feature = idea; return }
    }
    if PlacePortals(game, 1, reached[:], false) { game.feature = FEATURE_PORTALS }
}
// Whether a level's board has a doorway for a gate idea, loaded aside.
HostsIdea :: (level: s32, feature: s32) -> bool {
    columns := board_columns
    rows := board_rows
    enabled := features_enabled
    features_enabled = false
    aside: Game
    aside.random = 1
    LoadLevel(*aside, level, 0)
    reached: [CELLS]bool
    span: s32 = 0
    step: s32 = 1
    hosts := FindDoorway(*aside, reached[:], *span, *step, feature) >= 0
    features_enabled = enabled
    BoardSize(columns, rows)
    return hosts
}
PlaceGate :: (game: *Game, feature: s32, reached: []bool) -> bool {
    span: s32 = 0
    step: s32 = 1
    door := FindDoorway(game, reached, *span, *step, feature)
    if door < 0 { return false }
    game.gate = door
    game.gate_span = span
    game.gate_step = step
    for cell: 0..span - 1 { game.gate_tiles[cell] = game.board[door + cast(s32)cell * step] }
    OpenGate(game, false)
    if feature == FEATURE_KEY { game.key = SideSpot(game, reached, door, true) }
    if feature == FEATURE_SWITCH { game.switch_stone = SideSpot(game, reached, door, false) }
    placed := (feature == FEATURE_KEY && game.key.x >= 0) || (feature == FEATURE_SWITCH && game.switch_stone.x >= 0) ||
    (feature == FEATURE_PORTAL_ROOM && PlacePortals(game, 1, reached, true))
    if !placed {
        OpenGate(game, true)
        game.gate = -1
        game.gate_span = 0
        game.key = Point.{-1, -1}
        game.switch_stone = Point.{-1, -1}
        game.portal_count = 0
        return false
    }
    // A portal room's doorway stays a plain hedge for good.
    if feature == FEATURE_PORTAL_ROOM { game.gate = -1; game.gate_span = 0 }
    return true
}
OnPortal :: (game: *Game, position: Point) -> bool {
    for pair: 0..game.portal_count - 1 {
        if Near(position, game.portals[pair].a, 12) || Near(position, game.portals[pair].b, 12) { return true }
    }
    return Near(position, game.key, 12) || Near(position, game.switch_stone, 12)
}
// The complete playable campaign is designed and certified. The recovered
// 99-level archive stays an independent, untouched historical reference.
BaseTile :: (level: s32, x: s32, y: s32) -> u8 {
    if level >= 0 && level < DESIGNED_LEVEL_COUNT { return DesignedTile(level, x, y) }
    return 20
}
BaseApples :: (level: s32) -> s32 {
    if level >= 0 && level < DESIGNED_LEVEL_COUNT { return DesignedApples[level] }
    return 2
}
BaseObject :: (level: s32, x: s32, y: s32) -> u8 {
    return 0
}

LoadLevel :: (game: *Game, level: s32, now: s64) {
    BoardSize(COLUMNS, ROWS)
    tiles: [CELLS]u8
    objects: [CELLS]u8
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 {
            tiles[y * COLUMNS + x] = BaseTile(level, cast(s32)x, cast(s32)y)
            objects[y * COLUMNS + x] = BaseObject(level, cast(s32)x, cast(s32)y)
        }
    }
    LoadLevelData(game, level, now, tiles[:], BaseApples(level), COLUMNS, ROWS, objects[:])
}
StartGameData :: (game: *Game, level: s32, now: s64, seed: u32, board: []u8, apples: s32, columns: s32, rows: s32, objects: []u8) {
    game.random = seed
    game.lives = 3
    game.score = 0
    LoadLevelData(game, level, now, board, apples, columns, rows, objects)
}
StartGame :: (game: *Game, level: s32, now: s64, seed: u32 = 1) {
    game.random = seed
    game.lives = 3
    game.score = 0
    LoadLevel(game, level, now)
}
// Decoration objects ride above the tiles and never block the worm.
OBJECT_LOG :: 1;
OBJECT_FLOWERS :: 2;
OBJECT_MUSHROOM :: 3;
OBJECT_ROCK :: 4;
OBJECT_BUTTERFLY :: 5;
OBJECT_SNAIL :: 6;
OBJECT_BIRD :: 7;

// The smart hedge brush: a wall piece wears grass on the sides that face
// open space, so painted walls read as shaped hedges without hand-picking
// pieces. Tile ids 50-58 are the pieces; 20 stays the plain fill.
IsHedge :: (tile: u8) -> bool { return tile == 20 || (tile >= 50 && tile <= 58) }
SolidNeighbour :: (board: []u8, x: s32, y: s32) -> bool {
    if x < 0 || y < 0 || x >= board_columns || y >= board_rows { return true }
    tile := board[Index(x, y)]
    if (tile & 127) >= 40 && (tile & 127) <= 45 { return false }
    return tile >= 20 && tile < 128
}
AutoHedge :: (board: []u8, x: s32, y: s32) -> u8 {
    north := !SolidNeighbour(board, x, y - 1)
    east := !SolidNeighbour(board, x + 1, y)
    south := !SolidNeighbour(board, x, y + 1)
    west := !SolidNeighbour(board, x - 1, y)
    open: s32 = 0
    if north { open += 1 }
    if east { open += 1 }
    if south { open += 1 }
    if west { open += 1 }
    if open == 0 { return 50 }
    if open == 1 {
        if north { return 51 }
        if east { return 52 }
        if south { return 53 }
        return 54
    }
    if open == 2 {
        if north && east { return 55 }
        if north && west { return 56 }
        if south && east { return 57 }
        if south && west { return 58 }
    }
    return 20
}
RetouchHedge :: (board: []u8, x: s32, y: s32) {
    if x < 0 || y < 0 || x >= board_columns || y >= board_rows { return }
    if IsHedge(board[Index(x, y)]) { board[Index(x, y)] = AutoHedge(board, x, y) }
}
// Painting a wall fits the piece and re-fits its wall neighbours; painting
// a floor re-fits the walls that face the new open side.
ApplyWallBrush :: (board: []u8, x: s32, y: s32) {
    board[Index(x, y)] = AutoHedge(board, x, y)
    RetouchHedge(board, x, y - 1)
    RetouchHedge(board, x + 1, y)
    RetouchHedge(board, x, y + 1)
    RetouchHedge(board, x - 1, y)
}
ApplyFloorBrush :: (board: []u8, x: s32, y: s32, floor: u8) {
    board[Index(x, y)] = floor
    RetouchHedge(board, x, y - 1)
    RetouchHedge(board, x + 1, y)
    RetouchHedge(board, x, y + 1)
    RetouchHedge(board, x - 1, y)
}

// The portrait orientation: the canonical 40x30 level stands clockwise as
// a 30x40 board. Canonical (x, y) lands at turned column ROWS-1-y, row x.
TurnForward :: (canonical: []u8, turned: []u8) {
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 { turned[x * ROWS + (ROWS - 1 - y)] = canonical[y * COLUMNS + x] }
    }
}
TurnBack :: (turned: []u8, canonical: []u8) {
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 { canonical[y * COLUMNS + x] = turned[x * ROWS + (ROWS - 1 - y)] }
    }
}

GuessFloor :: (board: []u8, x: s32, y: s32) -> bool {
    if x < 1 || y < 1 || x >= 29 || y >= 39 { return false }
    tile := LoadedTile(board[y * 30 + x])
    return tile < 20 || tile >= 128
}
ClearGuessCell :: (board: []u8, x: s32, y: s32) {
    if x < 1 || y < 1 || x >= 29 || y >= 39 { return }
    if !GuessFloor(board,x,y) { board[y * 30 + x] = 0 }
}
// A starting point for a separately authored portrait board. Keep the
// rotated rooms, then join both fixed gates to the largest playable region.
// Existing authored portrait boards never pass through this conversion.
GuessPortrait :: (landscape: []u8, portrait: []u8) {
    TurnForward(landscape,portrait)
    labels: [CELLS]s32
    queue: [CELLS]s32
    component: s32
    largest: s32
    largest_size: s32
    for start: 0..CELLS - 1 {
        if labels[start] != 0 || !GuessFloor(portrait,cast(s32)start % 30,cast(s32)start / 30) { continue }
        component += 1
        labels[start] = component
        queue[0] = cast(s32)start
        head: s32 = 0
        tail: s32 = 1
        while head < tail {
            at := queue[head]; head += 1
            for d: 0..3 {
                x := at % 30; y := at / 30
                if d == 0 { x -= 1 } else if d == 1 { y -= 1 } else if d == 2 { x += 1 } else { y += 1 }
                if !GuessFloor(portrait,x,y) || labels[y * 30 + x] != 0 { continue }
                labels[y * 30 + x] = component
                queue[tail] = y * 30 + x; tail += 1
            }
        }
        if tail > largest_size { largest_size = tail; largest = component }
    }
    for x: 14..15 {
        for y: 35..38 { ClearGuessCell(portrait,cast(s32)x,cast(s32)y) }
        for y: 1..3 { ClearGuessCell(portrait,cast(s32)x,cast(s32)y) }
    }
    if largest == 0 {
        for y: 1..38 { ClearGuessCell(portrait,14,cast(s32)y); ClearGuessCell(portrait,15,cast(s32)y) }
        return
    }
    for gate: 0..1 {
        start := ifx gate == 0 then 36 * 30 + 15 else 2 * 30 + 15
        if labels[start] == largest { continue }
        distance: [CELLS]s32
        previous: [CELLS]s32
        visited: [CELLS]bool
        for i: 0..CELLS - 1 { distance[i] = 100000; previous[i] = -1 }
        distance[start] = 0
        target: s32 = -1
        for step: 0..CELLS - 1 {
            at: s32 = -1
            for i: 0..CELLS - 1 {
                if !visited[i] && distance[i] < 100000 && (at < 0 || distance[i] < distance[at]) { at = cast(s32)i }
            }
            if at < 0 { break }
            if labels[at] == largest { target = at; break }
            visited[at] = true
            for d: 0..3 {
                x := at % 30; y := at / 30
                if d == 0 { x -= 1 } else if d == 1 { y -= 1 } else if d == 2 { x += 1 } else { y += 1 }
                if x < 1 || y < 1 || x >= 29 || y >= 39 { continue }
                next := y * 30 + x
                cost := distance[at] + (ifx GuessFloor(portrait,x,y) then 1 else 6)
                if cost < distance[next] { distance[next] = cost; previous[next] = at }
            }
        }
        while target >= 0 {
            x := target % 30; y := target / 30
            ClearGuessCell(portrait,x,y)
            before := previous[target]
            if before >= 0 && before / 30 == y { ClearGuessCell(portrait,x,y + 1) }
            else { ClearGuessCell(portrait,x + 1,y) }
            target = before
        }
    }
}

HasPortraitDesign :: (level: s32) -> bool { return DesignedPortraitText(level).count == CELLS }
PortraitBoard :: (level: s32, landscape: []u8, portrait: []u8) {
    text := DesignedPortraitText(level)
    if text.count != CELLS { GuessPortrait(landscape,portrait); return }
    for y: 0..39 {
        for x: 0..29 {
            code := text[x * 40 + y]
            for index: 0..DesignedAlphabet.count - 1 {
                if DesignedAlphabet[index] == code { portrait[y * 30 + x] = DesignedCodebook[index]; break }
            }
        }
    }
}

// The value a tile has once LoadLevelData has turned monster markers into
// monsters: markers leave nothing, or a false-wall flag, behind.
LoadedTile :: (raw: u8) -> u8 {
    kind := cast(s32)(raw & 127) - 39
    if kind >= 1 && kind <= 6 { return raw & 128 }
    return raw
}
// A level is impossible when the first tile the growing head must survive,
// just above the entrance, is solid, or when the tile the top exit opens
// from is solid. The head crosses the two bottom rows before collision
// checks begin. Bit 1 marks the entrance, bit 2 the exit.
LevelBlockages :: (board: []u8) -> s32 {
    result: s32 = 0
    entry := cast(s32)LoadedTile(board[Index(board_columns / 2, board_rows - 3)])
    leave := cast(s32)LoadedTile(board[Index(board_columns / 2, 1)])
    if entry >= 20 && entry < 128 { result = result | 1 }
    if leave >= 20 && leave < 128 { result = result | 2 }
    return result
}
MonsterBlocked :: (game: *Game, index: s32, position: Point) -> bool {
    if WallAt(game, position) || WormNear(game, position, 0, 10) { return true }
    for other: 0..game.monster_count - 1 {
        if other != index && Near(position, game.monsters[other].position, 8) { return true }
    }
    return false
}
MonsterNext :: (position: Point, direction: s32) -> Point {
    if direction == 0 { position.y -= 1 }
    else if direction == 1 { position.x += 1 }
    else if direction == 2 { position.y += 1 }
    else { position.x -= 1 }
    return position
}
MoveMonster :: (game: *Game, index: s32) {
    monster := *game.monsters[index]
    if monster.kind == 6 {
        candidate := monster.position
        if candidate.x > game.worm[0].x { candidate.x -= 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.x < game.worm[0].x { candidate.x += 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.y > game.worm[0].y { candidate.y -= 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.y < game.worm[0].y { candidate.y += 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        return
    }
    monster.timer += 1
    if monster.animal == ANIMAL_STONE {
        // A rolling stone keeps its patrol at twice the pace.
        PatrolStep(game, index)
        PatrolStep(game, index)
        return
    }
    if monster.kind == 1 && monster.animal == ANIMAL_SQUIRREL {
        // A squirrel dashes at twice the pace for a moment, then sits still.
        phase := monster.timer % 16
        if phase >= 8 { return }
        if phase == 0 { monster.direction = Random(game, 4) }
        for step: 0..1 {
            candidate := MonsterNext(monster.position, monster.direction)
            if MonsterBlocked(game, index, candidate) || candidate.y < 16 {
                monster.direction = Random(game, 4)
                return
            }
            monster.position = candidate
        }
        return
    }
    if monster.kind == 1 && monster.animal == ANIMAL_HEDGEHOG {
        // A hedgehog ambles at half pace and curls into a still, spiky ball
        // for a while when the worm's head comes close.
        if monster.timer < 0 { return }
        if game.length > 0 && Near(game.worm[0], monster.position, 40) { monster.timer = -HEDGEHOG_CURL; return }
        if monster.timer % 2 == 1 { return }
        RoamerStep(game, index)
        return
    }
    if monster.kind == 1 && monster.animal == ANIMAL_FROG {
        // A frog sits, then hops two tiles at once, even over a hedge.
        if monster.timer % 14 != 0 { return }
        direction := Random(game, 4)
        landing := monster.position
        for step: 0..31 { landing = MonsterNext(landing, direction) }
        if landing.y >= 16 && landing.x >= 16 && landing.x < (board_columns - 1) * 16 && landing.y < (board_rows - 1) * 16 &&
        !MonsterBlocked(game, index, landing) {
            monster.position = landing
            monster.direction = direction
        }
        return
    }
    if monster.kind == 1 { RoamerStep(game, index) }
    else { PatrolStep(game, index) }
}
RoamerStep :: (game: *Game, index: s32) {
    monster := *game.monsters[index]
    candidate := MonsterNext(monster.position, monster.direction)
    blocked := MonsterBlocked(game, index, candidate)
    if !blocked { blocked = Random(game, 25) == 0 || candidate.y < 16 }
    if blocked { monster.direction = Random(game, 4) }
    else { monster.position = candidate }
}
PatrolStep :: (game: *Game, index: s32) {
    monster := *game.monsters[index]
    candidate := MonsterNext(monster.position, monster.direction)
    if MonsterBlocked(game, index, candidate) {
        monster.direction = (monster.direction + 2) % 4
        monster.kind = monster.direction + 2
    } else { monster.position = candidate }
}
// Points follow how hard a board is: its enemies (wandering ones count
// twice), the apples it asks for, how tightly its walls close in and its
// speed. The first meadows are worth one point an apple, the hardest boards
// nine. Every player gets the same multiplier for the same board.
LevelMultiplier :: (game: *Game) -> s32 {
    roamers: s32 = 0
    for index: 0..game.monster_count - 1 { if game.monsters[index].kind == 1 { roamers += 1 } }
    walls: s32 = 0
    for at: 0..board_columns * board_rows - 1 {
        if game.board[at] >= 20 && (game.board[at] & 128) == 0 { walls += 1 }
    }
    tightness := ifx walls > 300 then (walls - 300) * 10 / 150 else 0
    difficulty := 10 * game.monster_count + 10 * roamers + 5 * (game.apples - 5) + tightness +
    5 * (32 - cast(s32)TickInterval(game.level))
    if game.feature >= FEATURE_KEY { difficulty += 10 }
    if difficulty < 0 { difficulty = 0 }
    return 1 + difficulty / 20
}

AddScore :: (game: *Game, points: s32) {
    multiplier := ifx game.multiplier > 0 then game.multiplier else 1
    // The extra-life step grows with the points, so a life still comes
    // about every 33 apples at any level.
    step := 33 * multiplier
    previous := game.score / step
    game.score += points * multiplier
    if game.score / step > previous { game.lives += 1 }
}

AddParticle :: (game: *Game, position: Point) {
    y := position.y + Random(game, 16) - 8
    x := position.x + Random(game, 16) - 8
    life := (Random(game, 4) + 6) * 2
    for index: 0..99 {
        if game.particles[index].life == 0 {
            game.particles[index] = Particle.{Point.{x, y}, life}
            return
        }
    }
}

FinishTick :: (game: *Game) {
    for index: 0..game.monster_count - 1 { MoveMonster(game, cast(s32)index) }
    // Original particle slots remain occupied at life 1 until the next map.
    for index: 0..99 {
        if game.particles[index].life > 1 { game.particles[index].life -= 1 }
    }
    if game.apple_flash > 0 { game.apple_flash -= 1 }
}

Tick :: (game: *Game) {
    if game.transition_ticks > 0 {
        game.transition_ticks -= 1
        if game.transition_ticks == 0 {
            if game.level + 1 >= LEVEL_COUNT { game.mode = MODE_VICTORY }
            else { game.mode = MODE_FINISHED }
        }
        FinishTick(game)
        return
    }
    if game.death_ticks > 0 {
        game.death_ticks -= 1
        if game.death_ticks == 0 {
            if game.lives > 0 { game.lives -= 1 }
            if game.lives <= 0 { game.lives = 0; game.mode = MODE_DIED }
            else { Respawn(game) }
        }
        FinishTick(game)
        return
    }
    game.direction = game.next_direction
    next := game.worm[0]
    if game.direction == DIR_LEFT { next.x -= 4 }
    else if game.direction == DIR_UP { next.y -= 4 }
    else if game.direction == DIR_RIGHT { next.x += 4 }
    else { next.y += 4 }
    // A head reaching a ring's centre comes out of its partner, keeping its
    // course; the body follows through the same rings.
    if game.portal_wait > 0 { game.portal_wait -= 1 }
    else {
        for pair: 0..game.portal_count - 1 {
            portal := game.portals[pair]
            from := portal.a
            to := portal.b
            if Abs(next.x - portal.b.x) <= 4 && Abs(next.y - portal.b.y) <= 4 { from = portal.b; to = portal.a }
            else if Abs(next.x - portal.a.x) > 4 || Abs(next.y - portal.a.y) > 4 { continue }
            for spark: 0..3 { AddParticle(game, from); AddParticle(game, to) }
            next = Point.{to.x + next.x - from.x, to.y + next.y - from.y}
            game.portal_wait = 5
            break
        }
    }
    // The key opens its gate for good; a switch stone flips it each time the
    // head arrives on it.
    if game.key.x >= 0 && Near(next, game.key, 10) {
        for spark: 0..5 { AddParticle(game, game.key) }
        game.key = Point.{-1, -1}
        OpenGate(game, true)
        AddScore(game, 2)
    }
    if game.switch_stone.x >= 0 {
        over := Near(next, game.switch_stone, 8)
        if over && !game.on_switch {
            OpenGate(game, !game.gate_open)
            for spark: 0..3 { AddParticle(game, game.switch_stone) }
        }
        game.on_switch = over
    }
    if game.apples == 0 && next.y < 0 {
        count := game.length
        if count > 100 { count = 100 }
        for index: 0..count - 1 {
            segment := Random(game, game.length)
            AddParticle(game, game.worm[segment])
        }
        AddScore(game, 5)
        game.transition_ticks = 50
        FinishTick(game)
        return
    }
    collision := false
    if game.length >= 16 {
        collision = WallAt(game, next) || WormNear(game, next, 8, 10)
        for index: 0..game.monster_count - 1 {
            if Near(next, game.monsters[index].position, 8) { collision = true }
        }
    }
    if collision { game.death_ticks = 20 }
    if !collision && game.apples > 0 && Near(next, game.apple, 10) {
        game.apples -= 1
        AddScore(game, 1)
        game.target_length += 4
        if game.target_length > 62 { game.target_length = 62 }
        SpawnApple(game)
        if game.apples == 0 { OpenExit(game) }
        count := Random(game, 5) + 3
        for index: 0..count - 1 { AddParticle(game, next) }
    }
    if game.length / 16 < game.target_length && game.length < WORM_LIMIT {
        game.worm[game.length] = game.worm[game.length - 1]
        game.length += 1
        if game.length == 32 { CloseEntrance(game) }
    }
    // Shift tail first; Ziran ranges only ascend, so a reversed range needs `for <`.
    for < index: 1..game.length - 1 { game.worm[index] = game.worm[index - 1] }
    game.worm[0] = next
    FinishTick(game)
}
Step :: (game: *Game, now: s64) -> bool {
    if game.mode != MODE_PLAYING || now < game.next_step { return false }
    interval := TickInterval(game.level)
    ticks := (now - game.next_step) / interval + 1
    if ticks > 8 { ticks = 8; game.next_step = now - (ticks - 1) * interval }
    for index: 0..ticks - 1 {
        if game.mode != MODE_PLAYING { break }
        Tick(game)
        game.next_step += interval
    }
    return true
}
ApplyInput :: (game: *Game, key: s32) -> bool {
    // Escape, Space and P toggle pause; Q leaves a paused game for the stages.
    pause_key := key == 27 || key == 256 || key == 32 || key == 80 || key == 112
    if game.mode == MODE_PLAYING {
        if pause_key { game.mode = MODE_PAUSED; return true }
        direction: s32 = -1
        if key == 262 || key == 68 || key == 100 { direction = DIR_RIGHT }
        else if key == 264 || key == 83 || key == 115 { direction = DIR_DOWN }
        else if key == 263 || key == 65 || key == 97 { direction = DIR_LEFT }
        else if key == 265 || key == 87 || key == 119 { direction = DIR_UP }
        if direction >= 0 && game.length >= 8 && direction != (game.direction + 2) % 4 {
            game.next_direction = direction
            return true
        }
    } else if game.mode == MODE_PAUSED {
        if pause_key { game.mode = MODE_PLAYING; return true }
        if key == 81 || key == 113 { game.mode = MODE_STAGES; return true }
    }
    return false
}
