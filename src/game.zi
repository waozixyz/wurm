#import, file "original_levels.zi";
#import, file "designed_levels.zi";

// Rules recovered from the owner's WURM.EXE. Coordinates are original pixels.
// COLUMNS x ROWS is the recovered canonical grid, also the archive and
// editor layout. The playing board may stand the same level turned a
// quarter (30x40) for portrait windows; loaders set the live dimensions.
COLUMNS :: 40;
ROWS :: 30;
CELLS :: 1200;
board_columns: s32 = 40;
board_rows: s32 = 30;
BoardSize :: (columns: s32, rows: s32) {
    board_columns = columns
    board_rows = rows
}
// Five connected landscapes, played as the same worm. The complete recovered
// 99-level archive remains untouched as reference data.
STAGE_COUNT :: 5;
LEVEL_COUNT :: 200;
WORM_LIMIT :: 1000;
MONSTER_LIMIT :: 100;
TICK_MS :: 25;
DIR_LEFT :: 0;
DIR_UP :: 1;
DIR_RIGHT :: 2;
DIR_DOWN :: 3;
MODE_STAGES :: 0;
MODE_PLAYING :: 1;
MODE_PAUSED :: 2;
MODE_DIED :: 3;
MODE_FINISHED :: 4;
MODE_VICTORY :: 5;
MODE_EDITOR :: 6;
MODE_CONTROLS :: 7;
MODE_LEVELS :: 8;

// A gentle Meadow introduction, reaching the recovered pace at Leafwood.
TickInterval :: (level: s32) -> s64 {
    interval := 32 - level / 2
    if interval < TICK_MS { interval = TICK_MS }
    return cast(s64)interval
}

Point :: struct { x: s32; y: s32; }
Monster :: struct { position: Point; kind: s32; direction: s32; }
Particle :: struct { position: Point; life: s32; }
Game :: struct {
    mode: s32
    level: s32
    score: s32
    lives: s32
    board: [CELLS]u8
    objects: [CELLS]u8
    worm: [WORM_LIMIT]Point
    length: s32
    target_length: s32
    direction: s32
    next_direction: s32
    next_step: s64
    apples: s32
    apple: Point
    apple_flash: s32
    monster_count: s32
    monsters: [MONSTER_LIMIT]Monster
    particles: [100]Particle
    death_ticks: s32
    transition_ticks: s32
    random: u32
    started: bool
}

Index :: (x: s64, y: s64) -> s32 { return cast(s32)(y * board_columns + x) }
StageOf :: (level: s32) -> s32 {
    for stage: 0..STAGE_COUNT - 2 {
        if level < DesignedStageStarts[stage + 1] { return cast(s32)stage }
    }
    return STAGE_COUNT - 1
}
StageFirst :: (stage: s32) -> s32 { return DesignedStageStarts[stage] }
StageLevels :: (stage: s32) -> s32 { return DesignedStageStarts[stage + 1] - DesignedStageStarts[stage] }
StageNumber :: (level: s32) -> s32 { return level - StageFirst(StageOf(level)) + 1 }
Inside :: (x: s64, y: s64) -> bool { return x >= 0 && x < board_columns && y >= 0 && y < board_rows }
Abs :: (v: s32) -> s32 { if v < 0 { return -v }; return v }
Near :: (a: Point, b: Point, distance: s32) -> bool {
    return Abs(a.x - b.x) < distance && Abs(a.y - b.y) < distance
}

// Watcom rand(), WURM.EXE 0x4091dd: 32-bit LCG, high 15 bits.
Random :: (game: *Game, limit: s32) -> s32 {
    next := (cast(u64)game.random * 1103515245 + 12345) & 4294967295
    game.random = cast(u32)next
    return cast(s32)((game.random >> 16) & 32767) % limit
}

TileAt :: (game: *Game, position: Point) -> s32 {
    if position.x < 0 || position.y < 0 || position.x >= board_columns * 16 || position.y >= board_rows * 16 { return 20 }
    return cast(s32)game.board[Index(position.x / 16, position.y / 16)]
}
WallAt :: (game: *Game, position: Point) -> bool {
    tile := TileAt(game, position)
    // Bit 7 marks a visible but passable tile, including false walls.
    return tile >= 20 && tile < 128
}
WormNear :: (game: *Game, position: Point, start: s32, distance: s32) -> bool {
    index := start
    while index < game.length - 4 {
        if Near(position, game.worm[index], distance) { return true }
        index += 4
    }
    return false
}
SpawnApple :: (game: *Game) {
    if game.apples <= 0 { game.apple = Point.{-1, -1}; return }
    // Original apples use pixel coordinates, not cell centers.
    for attempt: 0..32767 {
        // Temporary edge gates can close behind the tail. Apples belong on
        // the permanent interior floor, never inside those gate cells.
        candidate := Point.{16 + Random(game, (board_columns - 2) * 16),
            16 + Random(game, (board_rows - 2) * 16)}
        if TileAt(game, candidate) < 20 && !WormNear(game, candidate, 0, 10) {
            game.apple = candidate
            game.apple_flash = 128
            return
        }
    }
    for at: 0..CELLS - 1 {
        candidate := Point.{cast(s32)(at % board_columns) * 16 + 8, cast(s32)(at / board_columns) * 16 + 8}
        if candidate.x < 16 || candidate.y < 16 || candidate.x >= (board_columns - 1) * 16 || candidate.y >= (board_rows - 1) * 16 { continue }
        if TileAt(game, candidate) < 20 && !WormNear(game, candidate, 0, 10) {
            game.apple = candidate
            game.apple_flash = 128
            return
        }
    }
    game.apple = Point.{-1, -1}
}
// The gates keep their neighbouring tiles: only the hole is carved.
OpenEntrance :: (game: *Game) {
    half := board_columns / 2
    game.board[Index(half, board_rows - 1)] = game.board[Index(half, board_rows - 2)] & 127
}
CloseEntrance :: (game: *Game) { game.board[Index(board_columns / 2, board_rows - 1)] = 20 }
OpenExit :: (game: *Game) {
    half := board_columns / 2
    game.board[Index(half, 0)] = game.board[Index(half, 1)] & 127
}
Respawn :: (game: *Game) {
    game.length = 1
    game.target_length = 2
    game.direction = DIR_UP
    game.next_direction = DIR_UP
    game.death_ticks = 0
    game.worm[0] = Point.{board_columns / 2 * 16 + 8, board_rows * 16 + 16}
    OpenEntrance(game)
}
LoadLevelData :: (game: *Game, level: s32, now: s64, board: []u8, apples: s32, columns: s32, rows: s32, objects: []u8) {
    BoardSize(columns, rows)
    for at: 0..CELLS - 1 { game.objects[at] = objects[at] }
    if level < 0 { level = 0 }
    if level >= LEVEL_COUNT { level = LEVEL_COUNT - 1 }
    game.mode = MODE_PLAYING
    game.level = level
    game.apples = apples
    game.monster_count = 0
    game.transition_ticks = 0
    for index: 0..99 { game.particles[index].life = 0 }
    game.next_step = now + TickInterval(level)
    game.started = true
    for y: 0..board_rows - 1 {
        for x: 0..board_columns - 1 {
            tile := board[Index(x, y)]
            game.board[Index(x, y)] = tile
            kind := cast(s32)(tile & 127) - 39
            if kind >= 1 && kind <= 6 && game.monster_count < MONSTER_LIMIT {
                index := game.monster_count
                game.monsters[index].position = Point.{cast(s32)x * 16 + 8, cast(s32)y * 16 + 8}
                game.monsters[index].kind = kind
                game.monsters[index].direction = ifx kind == 1 then Random(game, 4) else kind - 2
                game.monster_count += 1
                game.board[Index(x, y)] = tile & 128
            }
        }
    }
    game.length = 0
    // Carve the entrance before the apple chooses its spot, so it can never
    // land on a cell the carving turns into wall.
    Respawn(game)
    SpawnApple(game)
}
// The complete playable campaign is designed and certified. The recovered
// 99-level archive stays an independent, untouched historical reference.
BaseTile :: (level: s32, x: s32, y: s32) -> u8 {
    if level >= 0 && level < DESIGNED_LEVEL_COUNT { return DesignedTile(level, x, y) }
    return 20
}
BaseApples :: (level: s32) -> s32 {
    if level >= 0 && level < DESIGNED_LEVEL_COUNT { return DesignedApples[level] }
    return 2
}
BaseObject :: (level: s32, x: s32, y: s32) -> u8 {
    return 0
}

LoadLevel :: (game: *Game, level: s32, now: s64) {
    BoardSize(COLUMNS, ROWS)
    tiles: [CELLS]u8
    objects: [CELLS]u8
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 {
            tiles[y * COLUMNS + x] = BaseTile(level, cast(s32)x, cast(s32)y)
            objects[y * COLUMNS + x] = BaseObject(level, cast(s32)x, cast(s32)y)
        }
    }
    LoadLevelData(game, level, now, tiles[:], BaseApples(level), COLUMNS, ROWS, objects[:])
}
StartGameData :: (game: *Game, level: s32, now: s64, seed: u32, board: []u8, apples: s32, columns: s32, rows: s32, objects: []u8) {
    game.random = seed
    game.lives = 3
    game.score = 0
    LoadLevelData(game, level, now, board, apples, columns, rows, objects)
}
StartGame :: (game: *Game, level: s32, now: s64, seed: u32 = 1) {
    game.random = seed
    game.lives = 3
    game.score = 0
    LoadLevel(game, level, now)
}
// Decoration objects ride above the tiles and never block the worm.
OBJECT_LOG :: 1;
OBJECT_FLOWERS :: 2;
OBJECT_MUSHROOM :: 3;
OBJECT_ROCK :: 4;
OBJECT_BUTTERFLY :: 5;
OBJECT_SNAIL :: 6;
OBJECT_BIRD :: 7;

// The smart hedge brush: a wall piece wears grass on the sides that face
// open space, so painted walls read as shaped hedges without hand-picking
// pieces. Tile ids 50-58 are the pieces; 20 stays the plain fill.
IsHedge :: (tile: u8) -> bool { return tile == 20 || (tile >= 50 && tile <= 58) }
SolidNeighbour :: (board: []u8, x: s32, y: s32) -> bool {
    if x < 0 || y < 0 || x >= board_columns || y >= board_rows { return true }
    tile := board[Index(x, y)]
    if (tile & 127) >= 40 && (tile & 127) <= 45 { return false }
    return tile >= 20 && tile < 128
}
AutoHedge :: (board: []u8, x: s32, y: s32) -> u8 {
    north := !SolidNeighbour(board, x, y - 1)
    east := !SolidNeighbour(board, x + 1, y)
    south := !SolidNeighbour(board, x, y + 1)
    west := !SolidNeighbour(board, x - 1, y)
    open: s32 = 0
    if north { open += 1 }
    if east { open += 1 }
    if south { open += 1 }
    if west { open += 1 }
    if open == 0 { return 50 }
    if open == 1 {
        if north { return 51 }
        if east { return 52 }
        if south { return 53 }
        return 54
    }
    if open == 2 {
        if north && east { return 55 }
        if north && west { return 56 }
        if south && east { return 57 }
        if south && west { return 58 }
    }
    return 20
}
RetouchHedge :: (board: []u8, x: s32, y: s32) {
    if x < 0 || y < 0 || x >= board_columns || y >= board_rows { return }
    if IsHedge(board[Index(x, y)]) { board[Index(x, y)] = AutoHedge(board, x, y) }
}
// Painting a wall fits the piece and re-fits its wall neighbours; painting
// a floor re-fits the walls that face the new open side.
ApplyWallBrush :: (board: []u8, x: s32, y: s32) {
    board[Index(x, y)] = AutoHedge(board, x, y)
    RetouchHedge(board, x, y - 1)
    RetouchHedge(board, x + 1, y)
    RetouchHedge(board, x, y + 1)
    RetouchHedge(board, x - 1, y)
}
ApplyFloorBrush :: (board: []u8, x: s32, y: s32, floor: u8) {
    board[Index(x, y)] = floor
    RetouchHedge(board, x, y - 1)
    RetouchHedge(board, x + 1, y)
    RetouchHedge(board, x, y + 1)
    RetouchHedge(board, x - 1, y)
}

// The portrait orientation: the canonical 40x30 level stands clockwise as
// a 30x40 board. Canonical (x, y) lands at turned column ROWS-1-y, row x.
TurnForward :: (canonical: []u8, turned: []u8) {
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 { turned[x * ROWS + (ROWS - 1 - y)] = canonical[y * COLUMNS + x] }
    }
}
TurnBack :: (turned: []u8, canonical: []u8) {
    for y: 0..ROWS - 1 {
        for x: 0..COLUMNS - 1 { canonical[y * COLUMNS + x] = turned[x * ROWS + (ROWS - 1 - y)] }
    }
}

GuessFloor :: (board: []u8, x: s32, y: s32) -> bool {
    if x < 1 || y < 1 || x >= 29 || y >= 39 { return false }
    tile := LoadedTile(board[y * 30 + x])
    return tile < 20 || tile >= 128
}
ClearGuessCell :: (board: []u8, x: s32, y: s32) {
    if x < 1 || y < 1 || x >= 29 || y >= 39 { return }
    if !GuessFloor(board,x,y) { board[y * 30 + x] = 0 }
}
// A starting point for a separately authored portrait board. Keep the
// rotated rooms, then join both fixed gates to the largest playable region.
// Existing authored portrait boards never pass through this conversion.
GuessPortrait :: (landscape: []u8, portrait: []u8) {
    TurnForward(landscape,portrait)
    labels: [CELLS]s32
    queue: [CELLS]s32
    component: s32
    largest: s32
    largest_size: s32
    for start: 0..CELLS - 1 {
        if labels[start] != 0 || !GuessFloor(portrait,cast(s32)start % 30,cast(s32)start / 30) { continue }
        component += 1
        labels[start] = component
        queue[0] = cast(s32)start
        head: s32 = 0
        tail: s32 = 1
        while head < tail {
            at := queue[head]; head += 1
            for d: 0..3 {
                x := at % 30; y := at / 30
                if d == 0 { x -= 1 } else if d == 1 { y -= 1 } else if d == 2 { x += 1 } else { y += 1 }
                if !GuessFloor(portrait,x,y) || labels[y * 30 + x] != 0 { continue }
                labels[y * 30 + x] = component
                queue[tail] = y * 30 + x; tail += 1
            }
        }
        if tail > largest_size { largest_size = tail; largest = component }
    }
    for x: 14..15 {
        for y: 35..38 { ClearGuessCell(portrait,cast(s32)x,cast(s32)y) }
        for y: 1..3 { ClearGuessCell(portrait,cast(s32)x,cast(s32)y) }
    }
    if largest == 0 {
        for y: 1..38 { ClearGuessCell(portrait,14,cast(s32)y); ClearGuessCell(portrait,15,cast(s32)y) }
        return
    }
    for gate: 0..1 {
        start := ifx gate == 0 then 36 * 30 + 15 else 2 * 30 + 15
        if labels[start] == largest { continue }
        distance: [CELLS]s32
        previous: [CELLS]s32
        visited: [CELLS]bool
        for i: 0..CELLS - 1 { distance[i] = 100000; previous[i] = -1 }
        distance[start] = 0
        target: s32 = -1
        for step: 0..CELLS - 1 {
            at: s32 = -1
            for i: 0..CELLS - 1 {
                if !visited[i] && distance[i] < 100000 && (at < 0 || distance[i] < distance[at]) { at = cast(s32)i }
            }
            if at < 0 { break }
            if labels[at] == largest { target = at; break }
            visited[at] = true
            for d: 0..3 {
                x := at % 30; y := at / 30
                if d == 0 { x -= 1 } else if d == 1 { y -= 1 } else if d == 2 { x += 1 } else { y += 1 }
                if x < 1 || y < 1 || x >= 29 || y >= 39 { continue }
                next := y * 30 + x
                cost := distance[at] + (ifx GuessFloor(portrait,x,y) then 1 else 6)
                if cost < distance[next] { distance[next] = cost; previous[next] = at }
            }
        }
        while target >= 0 {
            x := target % 30; y := target / 30
            ClearGuessCell(portrait,x,y)
            before := previous[target]
            if before >= 0 && before / 30 == y { ClearGuessCell(portrait,x,y + 1) }
            else { ClearGuessCell(portrait,x + 1,y) }
            target = before
        }
    }
}

HasPortraitDesign :: (level: s32) -> bool { return DesignedPortraitText(level).count == CELLS }
PortraitBoard :: (level: s32, landscape: []u8, portrait: []u8) {
    text := DesignedPortraitText(level)
    if text.count != CELLS { GuessPortrait(landscape,portrait); return }
    for y: 0..39 {
        for x: 0..29 {
            code := text[x * 40 + y]
            for index: 0..DesignedAlphabet.count - 1 {
                if DesignedAlphabet[index] == code { portrait[y * 30 + x] = DesignedCodebook[index]; break }
            }
        }
    }
}

// The value a tile has once LoadLevelData has turned monster markers into
// monsters: markers leave nothing, or a false-wall flag, behind.
LoadedTile :: (raw: u8) -> u8 {
    kind := cast(s32)(raw & 127) - 39
    if kind >= 1 && kind <= 6 { return raw & 128 }
    return raw
}
// A level is impossible when the first tile the growing head must survive,
// just above the entrance, is solid, or when the tile the top exit opens
// from is solid. The head crosses the two bottom rows before collision
// checks begin. Bit 1 marks the entrance, bit 2 the exit.
LevelBlockages :: (board: []u8) -> s32 {
    result: s32 = 0
    entry := cast(s32)LoadedTile(board[Index(board_columns / 2, board_rows - 3)])
    leave := cast(s32)LoadedTile(board[Index(board_columns / 2, 1)])
    if entry >= 20 && entry < 128 { result = result | 1 }
    if leave >= 20 && leave < 128 { result = result | 2 }
    return result
}
MonsterBlocked :: (game: *Game, index: s32, position: Point) -> bool {
    if WallAt(game, position) || WormNear(game, position, 0, 10) { return true }
    for other: 0..game.monster_count - 1 {
        if other != index && Near(position, game.monsters[other].position, 8) { return true }
    }
    return false
}
MonsterNext :: (position: Point, direction: s32) -> Point {
    if direction == 0 { position.y -= 1 }
    else if direction == 1 { position.x += 1 }
    else if direction == 2 { position.y += 1 }
    else { position.x -= 1 }
    return position
}
MoveMonster :: (game: *Game, index: s32) {
    monster := *game.monsters[index]
    if monster.kind == 6 {
        candidate := monster.position
        if candidate.x > game.worm[0].x { candidate.x -= 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.x < game.worm[0].x { candidate.x += 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.y > game.worm[0].y { candidate.y -= 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        candidate = monster.position
        if candidate.y < game.worm[0].y { candidate.y += 1 }
        if !MonsterBlocked(game, index, candidate) { monster.position = candidate }
        return
    }
    candidate := MonsterNext(monster.position, monster.direction)
    blocked := MonsterBlocked(game, index, candidate)
    if monster.kind == 1 {
        if !blocked { blocked = Random(game, 25) == 0 || candidate.y < 16 }
        if blocked { monster.direction = Random(game, 4) }
        else { monster.position = candidate }
    } else if blocked {
        monster.direction = (monster.direction + 2) % 4
        monster.kind = monster.direction + 2
    } else { monster.position = candidate }
}
AddScore :: (game: *Game, amount: s32) {
    previous := game.score / 33
    game.score += amount
    if game.score / 33 > previous { game.lives += 1 }
}

AddParticle :: (game: *Game, position: Point) {
    y := position.y + Random(game, 16) - 8
    x := position.x + Random(game, 16) - 8
    life := (Random(game, 4) + 6) * 2
    for index: 0..99 {
        if game.particles[index].life == 0 {
            game.particles[index] = Particle.{Point.{x, y}, life}
            return
        }
    }
}

FinishTick :: (game: *Game) {
    for index: 0..game.monster_count - 1 { MoveMonster(game, cast(s32)index) }
    // Original particle slots remain occupied at life 1 until the next map.
    for index: 0..99 {
        if game.particles[index].life > 1 { game.particles[index].life -= 1 }
    }
    if game.apple_flash > 0 { game.apple_flash -= 1 }
}

Tick :: (game: *Game) {
    if game.transition_ticks > 0 {
        game.transition_ticks -= 1
        if game.transition_ticks == 0 {
            if game.level + 1 >= LEVEL_COUNT { game.mode = MODE_VICTORY }
            else { game.mode = MODE_FINISHED }
        }
        FinishTick(game)
        return
    }
    if game.death_ticks > 0 {
        game.death_ticks -= 1
        if game.death_ticks == 0 {
            if game.lives > 0 { game.lives -= 1 }
            if game.lives <= 0 { game.lives = 0; game.mode = MODE_DIED }
            else { Respawn(game) }
        }
        FinishTick(game)
        return
    }
    game.direction = game.next_direction
    next := game.worm[0]
    if game.direction == DIR_LEFT { next.x -= 4 }
    else if game.direction == DIR_UP { next.y -= 4 }
    else if game.direction == DIR_RIGHT { next.x += 4 }
    else { next.y += 4 }
    if game.apples == 0 && next.y < 0 {
        count := game.length
        if count > 100 { count = 100 }
        for index: 0..count - 1 {
            segment := Random(game, game.length)
            AddParticle(game, game.worm[segment])
        }
        AddScore(game, 5)
        game.transition_ticks = 50
        FinishTick(game)
        return
    }
    collision := false
    if game.length >= 16 {
        collision = WallAt(game, next) || WormNear(game, next, 8, 10)
        for index: 0..game.monster_count - 1 {
            if Near(next, game.monsters[index].position, 8) { collision = true }
        }
    }
    if collision { game.death_ticks = 20 }
    if !collision && game.apples > 0 && Near(next, game.apple, 10) {
        game.apples -= 1
        AddScore(game, 1)
        game.target_length += 4
        if game.target_length > 62 { game.target_length = 62 }
        SpawnApple(game)
        if game.apples == 0 { OpenExit(game) }
        count := Random(game, 5) + 3
        for index: 0..count - 1 { AddParticle(game, next) }
    }
    if game.length / 16 < game.target_length && game.length < WORM_LIMIT {
        game.worm[game.length] = game.worm[game.length - 1]
        game.length += 1
        if game.length == 32 { CloseEntrance(game) }
    }
    // Shift tail first; Ziran ranges only ascend, so a reversed range needs `for <`.
    for < index: 1..game.length - 1 { game.worm[index] = game.worm[index - 1] }
    game.worm[0] = next
    FinishTick(game)
}
Step :: (game: *Game, now: s64) -> bool {
    if game.mode != MODE_PLAYING || now < game.next_step { return false }
    interval := TickInterval(game.level)
    ticks := (now - game.next_step) / interval + 1
    if ticks > 8 { ticks = 8; game.next_step = now - (ticks - 1) * interval }
    for index: 0..ticks - 1 {
        if game.mode != MODE_PLAYING { break }
        Tick(game)
        game.next_step += interval
    }
    return true
}
ApplyInput :: (game: *Game, key: s32) -> bool {
    // Escape, Space and P toggle pause; Q leaves a paused game for the stages.
    pause_key := key == 27 || key == 256 || key == 32 || key == 80 || key == 112
    if game.mode == MODE_PLAYING {
        if pause_key { game.mode = MODE_PAUSED; return true }
        direction: s32 = -1
        if key == 262 || key == 68 || key == 100 { direction = DIR_RIGHT }
        else if key == 264 || key == 83 || key == 115 { direction = DIR_DOWN }
        else if key == 263 || key == 65 || key == 97 { direction = DIR_LEFT }
        else if key == 265 || key == 87 || key == 119 { direction = DIR_UP }
        if direction >= 0 && game.length >= 8 && direction != (game.direction + 2) % 4 {
            game.next_direction = direction
            return true
        }
    } else if game.mode == MODE_PAUSED {
        if pause_key { game.mode = MODE_PLAYING; return true }
        if key == 81 || key == 113 { game.mode = MODE_STAGES; return true }
    }
    return false
}
