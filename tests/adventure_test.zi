    "LLUUUUUUUULUUUUURRUUURRDDDRUUUULLLLLUUUUUUURDRURRDLDLLDDRURRURUURDDDLDLLDLLDRRRRRDDDDDDLLLLLLULLLLUUUUUUUUUUUUUUUUUUUUU"
];

Direction :: (byte: u8) -> s32 {
    if byte == #char "L" { return DIR_LEFT }
    if byte == #char "U" { return DIR_UP }
    if byte == #char "R" { return DIR_RIGHT }
    return DIR_DOWN
}
PointSame :: (first: Point, second: Point) -> bool { return first.x == second.x && first.y == second.y }
ExpectedPoint :: (cell: s32, portrait: bool) -> Point {
    if cell < 0 { return Point.{-1,-1} }
    x := cell % 40; y := cell / 40
    if portrait { return Point.{(29 - y) * 16 + 8, x * 16 + 8} }
    return Point.{x * 16 + 8, y * 16 + 8}
}
CellPassable :: (mission: s32, cell: s32) -> bool {
    if cell < 0 { return true }
    tile := Designed.AdventureTile(mission, cell % 40, cell / 40)
    return tile < 20 || (tile >= 40 && tile <= 45)
}
EngineMove :: (game: *Game, direction: s32) -> bool {
    if !ApplyDirection(game, direction) { return false }
    for tick: 0..3 {
        Tick(game)
        if game.mode == MODE_DIED || game.death_ticks > 0 { return false }
    }
    return true
}

Replay :: (mission: s32, portrait: bool, switch_move: *s32) -> bool {
    game: Game
    features_enabled = true
    if !StartAdventure(*game, mission, 0, portrait) { return false }
    route := AdventureRoutes[mission * 2 + ifx portrait then 1 else 0]
    if route.count == 0 || route.count >= 220 { return false }
    used: s32
    for index: 0..route.count - 1 {
        before_key := game.key
        before_gate := game.gate_open
        before_head := game.worm[0]
        if !EngineMove(*game, Direction(route[index])) {
            print("route m% % failed at %/%\n", mission + 1, ifx portrait then "portrait" else "landscape", index, route.count)
            return false
        }
        if before_key.x >= 0 && game.key.x < 0 { used |= 1 }
        if before_gate != game.gate_open && before_key.x < 0 {
            used |= 2
            if switch_move != null { switch_move.* = cast(s32)index + 1 }
        }
        distance := Abs(before_head.x - game.worm[0].x) + Abs(before_head.y - game.worm[0].y)
        if distance > 32 { used |= 4 }
    }
    expected := Designed.AdventureMechanics[mission]
    solved := game.mode == MODE_FINISHED && game.apples == 0 && game.lives == 1 && (used & expected) == expected
    if !solved { print("route m% % ended mode=% apples=% used=%/% length=%\n", mission + 1, ifx portrait then "portrait" else "landscape", game.mode, game.apples, used, expected, route.count) }
    return solved
}

// Canonical floor signatures catch copies, turns and reflections both among
// Adventure missions and against the opening campaign.
Shape :: struct { width: s32; cells: [1200]bool }
ShapeLess :: (first: *Shape, second: *Shape) -> bool {
    if first.width != second.width { return first.width < second.width }
    for index: 0..1199 { if first.cells[index] != second.cells[index] { return !first.cells[index] } }
    return false
}
ShapeSame :: (first: *Shape, second: *Shape) -> bool {
    if first.width != second.width { return false }
    for index: 0..1199 { if first.cells[index] != second.cells[index] { return false } }
    return true
}
ShapeSignature :: (floor: []bool, output: *Shape) {
    first := true
    for rotation: 0..3 { for reflection: 0..1 {
        variant: Shape
        variant.width = ifx rotation % 2 == 0 then 40 else 30
        for y: 0..29 { for x: 0..39 {
            if !floor[y * 40 + x] { continue }
            px := x; py := y; width: s32 = 40; height: s32 = 30
            for turn: 0..rotation - 1 {
                next_x := height - 1 - py; next_y := px
                px = next_x; py = next_y
                swap := width; width = height; height = swap
            }
            if reflection == 1 { px = width - 1 - px }
            variant.cells[py * width + px] = true
        } }
        if first || ShapeLess(*variant, output) { output.* = variant; first = false }
    } }
}
LayoutChecks :: () {
    campaign: [50]Shape
    for level: 0..49 {
        floor: [1200]bool
        for y: 0..29 { for x: 0..39 {
            tile := Designed.DesignedTile(cast(s32)level, cast(s32)x, cast(s32)y)
            floor[y * 40 + x] = tile < 20 || (tile >= 40 && tile <= 45)
        } }
        ShapeSignature(floor[:], *campaign[level])
    }
    adventure: [20]Shape
    for mission: 0..19 {
        floor: [1200]bool
        floors: s32
        for y: 0..29 { for x: 0..39 {
            tile := Designed.AdventureTile(cast(s32)mission, cast(s32)x, cast(s32)y)
            floor[y * 40 + x] = tile < 20 || (tile >= 40 && tile <= 45)
            if floor[y * 40 + x] { floors += 1 }
        } }
        Expect(floors >= 280 && floors <= 520, "compact authored footprint", cast(s32)mission)
        ShapeSignature(floor[:], *adventure[mission])
        for previous: 0..mission - 1 {
            Expect(!ShapeSame(*adventure[previous], *adventure[mission]), "not a copied or turned Adventure room", cast(s32)mission)
        }
        for level: 0..49 {
            Expect(!ShapeSame(*campaign[level], *adventure[mission]), "not a copied opening-campaign recipe", cast(s32)mission)
        }
    }
}

DynamicSame :: (first: *Game, second: *Game) -> bool {
    if first.mode != second.mode || first.apples != second.apples || !PointSame(first.apple,second.apple) ||
        first.apple_flash != second.apple_flash || first.random != second.random || first.length != second.length ||
        first.target_length != second.target_length || first.direction != second.direction || first.next_direction != second.next_direction ||
        first.gate != second.gate || first.gate_span != second.gate_span || first.gate_step != second.gate_step ||
        first.gate_open != second.gate_open || !PointSame(first.key,second.key) ||
        !PointSame(first.switch_stone,second.switch_stone) || first.on_switch != second.on_switch ||
        first.portal_wait != second.portal_wait || first.monster_count != second.monster_count { return false }
    for index: 0..1199 { if first.board[index] != second.board[index] { return false } }
    for index: 0..first.length - 1 { if !PointSame(first.worm[index], second.worm[index]) { return false } }
    for index: 0..3 { if first.gate_tiles[index] != second.gate_tiles[index] { return false } }
    for index: 0..first.monster_count - 1 {
        a := *first.monsters[index]; b := *second.monsters[index]
        if !PointSame(a.position,b.position) || a.kind != b.kind || a.direction != b.direction ||
            a.animal != b.animal || a.timer != b.timer { return false }
    }
    return true
}
UndoCheck :: () {
    // Mission 20's switch shares an ordered objective. Undoing that move must
    // restore the objective, closed gate, both animals, worm body and RNG.
    switch_move: s32
    Expect(Replay(19, false, *switch_move), "mission 20 witness locates its switch event")
    Expect(switch_move > 1, "mission 20 switch event exists")
    route := AdventureRoutes[38]
    directions: Vec(s32)
    for byte: route { unused VecPush(directions, Direction(byte)) }
    before: Game; advanced: Game; restored: Game
    Expect(ReplayAdventure(*before, 19, 0, false, VecSlice(directions,0,switch_move - 1)), "rebuild before undo")
    Expect(ReplayAdventure(*advanced, 19, 0, false, VecSlice(directions,0,switch_move)), "apply switch move")
    unused VecResize(directions, cast(s64)switch_move - 1)
    Expect(ReplayAdventure(*restored, 19, 0, false, VecSlice(directions,0,directions.count)), "real undo rebuild")
    Expect(before.gate_open != advanced.gate_open && !PointSame(before.apple,advanced.apple), "undo fixture changes gate and objective")
    Expect(DynamicSame(*before,*restored), "undo restores objective, gate, enemies, body and RNG")
    VecFree(directions)
}

#program_export
main :: () -> s32 {
    LayoutChecks()
    for mission: 0..Designed.ADVENTURE_LEVEL_COUNT - 1 {
        mechanics := Designed.AdventureMechanics[mission]
        expected_enemies: s32 = ifx mission < 12 then 0 else ifx mission < 16 then 1 else 2
        cells: [7]s32 = .[Designed.AdventureKeyCells[mission], Designed.AdventureSwitchCells[mission],
            Designed.AdventurePortalACells[mission], Designed.AdventurePortalBCells[mission],
            Designed.AdventureEnemyACells[mission], Designed.AdventureEnemyBCells[mission], Designed.AdventureGateCells[mission]]
        for cell: cells { Expect(CellPassable(cast(s32)mission,cell), "authored mechanic is on canonical floor", cast(s32)mission) }
        for objective: 0..Designed.AdventureApples[mission] - 1 {
            Expect(CellPassable(cast(s32)mission,Designed.AdventureObjectiveCells[mission * 6 + objective]),
                "ordered objective is on canonical floor", cast(s32)mission)
        }
        for orientation: 0..1 {
            portrait := orientation == 1
            game: Game
            features_enabled = true
            Expect(StartAdventure(*game, cast(s32)mission, 0, portrait), "starts", cast(s32)mission)
            Expect(game.monster_count == expected_enemies, "area hazard count", cast(s32)mission)
            for objective: 0..Designed.AdventureApples[mission] - 1 {
                game.apples = game.adventure_total - cast(s32)objective
                SpawnApple(*game)
                expected := ExpectedPoint(Designed.AdventureObjectiveCells[mission * 6 + objective], portrait)
                Expect(PointSame(game.apple,expected) && TileAt(*game,game.apple) < 20,
                    "exact ordered objective coordinate", cast(s32)mission)
            }
            if (mechanics & 1) != 0 {
                Expect(PointSame(game.key,ExpectedPoint(Designed.AdventureKeyCells[mission],portrait)), "exact key coordinate", cast(s32)mission)
            }
            if (mechanics & 2) != 0 {
                Expect(PointSame(game.switch_stone,ExpectedPoint(Designed.AdventureSwitchCells[mission],portrait)), "exact switch coordinate", cast(s32)mission)
            }
            if (mechanics & 4) != 0 {
                Expect(game.portal_count == 1 && PointSame(game.portals[0].a,ExpectedPoint(Designed.AdventurePortalACells[mission],portrait)) &&
                    PointSame(game.portals[0].b,ExpectedPoint(Designed.AdventurePortalBCells[mission],portrait)), "exact portal coordinates", cast(s32)mission)
            }
            if Designed.AdventureGateCells[mission] >= 0 {
                gate := ExpectedPoint(Designed.AdventureGateCells[mission],portrait)
                Expect(game.gate == Index(gate.x / 16,gate.y / 16) && game.gate_span == 2 && !game.gate_open,
                    "exact closed gate coordinate", cast(s32)mission)
            }
            switch_move: s32
            Expect(Replay(cast(s32)mission,portrait,*switch_move),
                ifx portrait then "active portrait solution and interactions" else "active landscape solution and interactions", cast(s32)mission)
        }
    }
    UndoCheck()
    game: Game
    unused StartAdventure(*game, 0, 0, false)
    game.death_ticks = 1
    Tick(*game)
    Expect(game.mode == MODE_DIED && game.lives == 1, "an adventure collision never spends a campaign life")
    print("Adventure local test: 20 purpose-built puzzles, 40 active witnesses, exact metadata and deterministic undo; failures: %.\n", failures)
    return failures
}
