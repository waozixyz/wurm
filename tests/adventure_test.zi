#import, file "../src/game.zi";
Designed :: #import, file "../src/designed_levels.zi";

failures: s32;
Expect :: (value: bool, message: string, mission: s32 = -1) {
    if value { return }
    if mission >= 0 { print("FAIL: adventure puzzle %: %\n", mission + 1, message) }
    else { print("FAIL: %\n", message) }
    failures += 1
}

// Frozen witnesses found against the real Game state. They are deliberately
// independent of generated campaign loop certificates: gates, portals,
// ordered fruit, the full worm body, animals and RNG all remain active.
AdventureRoutes: [40]string = .[
    "LLUUULLLUUUUUUUUUUUUUUUUURRRDDDDDDDDDDDDDRRRRRRULLLUUUUUUUUUUUUULUUUUUUUU",
