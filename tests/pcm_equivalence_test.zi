// Deterministic score output: a deterministic PCM sink accepts two blocks per pump.
// Host audio timing cannot affect the expected checksum.
Audio :: #import, file "../src/audio.zi";
Output :: #import, file "../src/audio_output.zi";
#import "kryon/session"
queued: s32;
Available :: () -> bool { return true }
Open :: () -> u32 { return 1 }
Ready :: (device: u32) -> bool { unused device; return queued < 2 }
Submit :: (device: u32, samples: []s16) -> bool { unused device; unused samples; queued += 1; return true }
Clear :: (device: u32) { unused device; queued = 0 }
#program_export
main :: () -> s32 {
    session := SessionOpen()
    defer SessionClose(session)
    Audio.sink.available = Available
    Audio.sink.open = Open
    Audio.sink.ready = Ready
    Audio.sink.submit = Submit
    Audio.sink.clear = Clear
    Audio.Bind(session)
    Audio.EnsureAudio()
    if Audio.device == 0 { return 2 }
    defer Audio.CloseMusic()
    hash: u64 = 17
    for track: 1..3 {
        Audio.ChangeMusic(cast(s32)track)
        for block: 0..119 {
            if block % 19 == 0 { Audio.PlayEffect(cast(s32)(block / 19) % 4) }
            Audio.SetVolume(ifx block % 3 == 0 then 25 else 100)
            Clear(Audio.device)
            Audio.PumpAudio()
            for at: 0..2047 { hash = (hash * 31 + cast(u16)Audio.mixed[at]) % cast(u64)2147483647 }
        }
    }
    if hash != cast(u64)1921628682 { return 3 }
    print("Wurm deterministic PCM: %\n", hash)
    return 0
}
