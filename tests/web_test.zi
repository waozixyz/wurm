// Plays the browser edition in a private headless Chromium with its own
// profile, served by this test's own HTTP server (or WURM_TEST_URL): touch
// feedback, the direction pad, controls, play, portrait, music blending,
// durable progress and the unlocked-level selector. With WURM_TEST_PORTAL,
// the unpacked CrazyGames copy instead, below a nested path at the portal's
// frame sizes, with private editor screenshots under work/crazygames/.
#import "kryon/devtools_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/format"
#import "std/json_scan"
#import "std/text_tools"
#import "std/environment_linux"

OUT :: "build/web-test"

browser: *Browser;

Shot :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%.png", OUT, name)
    return BrowserScreenshot(browser, BuilderFinish(path))
}

Pause :: (milliseconds: s64) { BrowserSleep(browser, milliseconds) }

Until :: (expression: string) -> bool { return BrowserWait(browser, expression, 20000) }

True :: (expression: string) -> bool { return BrowserTrue(browser, expression) }

Fail :: (message: string) -> bool {
    print("FAIL: browser: %\n", message)
    unused Shot("failure")
    if BrowserEvaluate(browser, "JSON.stringify(window.__portal||[])") { print("portal events: %\n", browser.result) }
    if BrowserEvaluate(browser, "JSON.stringify({decoded:window.__wurmDecoded,context:window.__wurmContext?.state,music:window.__wurmMusic?.().map(s=>({duration:s.buffer.duration,gain:s.__gain?.gain.value})),errors:window.__wurmAudioErrors})") { print("audio state: %\n", browser.result) }
    return false
}

// A key as a person presses it: down, then up.
Key :: (name: string, code: s32) -> bool {
    dom := name
    if name == " " { dom = "Space" }
    if !BrowserKey(browser, name, dom, code) { return false }
    Pause(180)
    return true
}

Click :: (x: s64, y: s64) -> bool {
    fx := cast(float64)x; fy := cast(float64)y
    if !BrowserMouse(browser, "mouseMoved", fx, fy, 0.0) { return false }
    Pause(80)
    if !BrowserMouse(browser, "mousePressed", fx, fy, 0.0) { return false }
    Pause(80)
    if !BrowserMouse(browser, "mouseReleased", fx, fy, 0.0) { return false }
    Pause(180)
    return true
}

// A touch event; an empty point list ends every touch.
Touch :: (kind: string, x: s64, y: s64) -> bool {
    params: Vec(u8)
    if kind == "touchEnd" {
        Append(*params, "{\"type\":\"touchEnd\",\"touchPoints\":[]}")
    } else {
        BuilderPrint(*params, "{\"type\":\"%\",\"touchPoints\":[{\"x\":%,\"y\":%}]}", kind, x, y)
    }
    return BrowserCall(browser, "Input.dispatchTouchEvent", BuilderFinish(params))
}

Viewport :: (width: s32, height: s32, mobile: bool) -> bool {
    return BrowserViewport(browser, width, height, 1.0, mobile)
}

Reload :: () -> bool {
    if !BrowserCall(browser, "Page.reload", "{}") || !Until(LOADED) { return false }
    if True("typeof window.__wurmSources==='undefined'") { return true }
    return Until("!!window.__wurmContext") && Click(2,2)
}

// Observe native WebAudio nodes without replacing playback or exposing game state.
AUDIO_OBSERVER :: #string JS
window.__wurmSources=[];window.__wurmDecoded=0;window.__wurmAudioErrors=[];
const nativeDecode=BaseAudioContext.prototype.decodeAudioData;
BaseAudioContext.prototype.decodeAudioData=function(...args){const result=nativeDecode.apply(this,args);result.then(()=>window.__wurmDecoded++,e=>window.__wurmAudioErrors.push(String(e)));return result};
const NativeAudioContext=window.AudioContext||window.webkitAudioContext;
window.AudioContext=new Proxy(NativeAudioContext,{construct(target,args){
 const context=Reflect.construct(target,args);
 window.__wurmContext=context;
 const create=context.createBufferSource.bind(context);
 context.createBufferSource=()=>{
  const source=create(),connect=source.connect.bind(source),start=source.start.bind(source),stop=source.stop.bind(source);
  source.__playing=false;
  source.connect=(...args)=>{if(args[0]&&args[0].gain)source.__gain=args[0];return connect(...args)};
  source.start=(...args)=>{const result=start(...args);source.__playing=true;source.__started=context.currentTime;return result};
  source.stop=(...args)=>{const result=stop(...args);source.__playing=false;return result};
  source.addEventListener('ended',()=>source.__playing=false);
  window.__wurmSources.push(source);return source;
 };
 return context;
}});
window.__wurmMusic=()=>__wurmSources.filter(s=>s.__playing&&s.buffer&&s.buffer.duration>30);
window.__wurmSilent=()=>__wurmDecoded>=7&&__wurmSources.filter(s=>s.__playing).every(s=>s.__gain&&s.__gain.gain.value===0);
window.__wurmAudible=()=>__wurmMusic().some(s=>s.__gain&&s.__gain.gain.value>0);
window.__wurmAssets=()=>['start.wav','pickup.wav','lose.wav','exit.wav','garden.ogg','factory.ogg','space.ogg'].every(name=>Module.FS.analyzePath('/assets/sounds/'+name).exists);
JS;

LOADED :: "typeof Module!=='undefined' && Module.FS && document.getElementById('loading').hidden"

// The canvas's red, green and blue sum at a CSS point.
Brightness :: (x: s64, y: s64) -> s64 {
    expression: Vec(u8)
    BuilderPrint(*expression, "(()=>{const c=document.getElementById('canvas'),b=c.getBoundingClientRect();const p=c.getContext('2d').getImageData(Math.round((%-b.left)*c.width/b.width),Math.round((%-b.top)*c.height/b.height),1,1).data;return p[0]+p[1]+p[2]})()", x, y)
    return cast(s64)BrowserNumber(browser, BuilderFinish(expression), -1.0)
}

RunIs :: (bytes: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{try{return JSON.stringify(Array.from(Module.FS.readFile('/kryon-apps/wurm/run.dat')))==='%'}catch{return false}})()", bytes)
    return BuilderFinish(text)
}

Play :: () -> bool {
    url := EnvironmentText("WURM_TEST_URL")
    if url.count == 0 {
        if !BrowserServe(browser, "build/web") { return Fail("the HTTP server did not start") }
        url = BrowserUrl(browser, "/")
    }
    profile := JoinPath(ResolvePath(OUT), "profile")
    unused RemoveTree(profile)
    if !BrowserOpen(browser, profile) { return Fail("the private Chromium did not start") }
    // Observe the shared provider through real WebAudio nodes.
    audio := AUDIO_OBSERVER
    if !BrowserCall(browser, "Page.enable", "{}") || !BrowserCall(browser, "Runtime.enable", "{}") { return false }
    if !BrowserScriptOnLoad(browser, audio) || !Viewport(1100, 900, false) { return false }
    if !BrowserCall(browser, "Page.navigate", BrowserParams1("url", url)) { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") { return false }
    Pause(1800)
    if !Shot("title") { return false }
    colorful := BrowserNumber(browser, "(()=>{const c=document.getElementById('canvas'),p=c.getContext('2d').getImageData(0,0,c.width,c.height).data,s=new Set();for(let i=0;i<p.length;i+=80)s.add(p[i]+','+p[i+1]+','+p[i+2]);return s.size})()", 0.0)
    if colorful < 200.0 { return Fail("title artwork did not render") }
    if !Click(1018, 34) { return false }
    Pause(400)
    if !Shot("profile") || !Click(48, 30) { return false }
    Pause(200)
    if !Click(1066, 34) { return false }
    Pause(200)
    if !Shot("settings") || !Key("Escape", 27) || !Key("Enter", 13) { return false }
    Pause(200)
    if !Shot("controls") || !Key("1", 49) { return false }
    if !Until("(()=>{try{return Module.FS.readFile('/kryon-apps/wurm/controls.dat')[0]===0}catch{return false}})()") { return false }
    Pause(300)
    if !Shot("level-1") || !Key("ArrowRight", 39) { return false }
    Pause(150)
    if !Key(" ", 32) || !Shot("playing") { return false }
    // The preceding Space has paused the simulation; the soundtrack continues.
    // Wait for the actual authored recording. MediaAudio exposes no speed
    // operation: the two native sources overlap with complementary gains.
    if !Until("__wurmDecoded>=7&&__wurmMusic().length===1&&__wurmAudible()") { return false }
    if !BrowserEvaluate(browser,"window.__outgoing=__wurmMusic()[0];true") { return false }
    if !BrowserWait(browser,"__wurmMusic().length===2",180000) { return false }
    Pause(750)
    if !True("(()=>{const playing=__wurmMusic();return playing.length===2&&playing.every(s=>s.__gain.gain.value>0&&s.__gain.gain.value<0.4)&&Math.abs(playing.reduce((v,s)=>v+s.__gain.gain.value,0)-0.4)<0.001})()") {
        return Fail("music did not blend the two real recordings")
    }
    if !Until("!__outgoing.__playing&&__wurmMusic().length===1") { return false }
    if !Viewport(390, 844, true) { return false }
    Pause(400)
    if !Shot("portrait") || !Reload() { return false }
    Pause(1200)
    if !Until("(()=>{try{return Module.FS.readFile('/kryon-apps/wurm/controls.dat')[0]===0}catch{return false}})()") { return false }
    if !Key("Enter", 13) { return false }
    Pause(300)
    if !Shot("playing-portrait") { return false }
    // The real touch path paints Kryon's feedback above the board, then
    // removes it on release. Read the same spot to skip moving game pieces.
    before := Brightness(219, 480)
    if !Touch("touchStart", 195, 480) { return false }
    Pause(80)
    if !Touch("touchMove", 225, 480) { return false }
    Pause(80)
    during := Brightness(219, 480)
    if !Shot("swipe-feedback") { return false }
    if during < before + 80 { return Fail("touch feedback did not appear above the board") }
    if !Touch("touchEnd", 0, 0) { return false }
    Pause(100)
    after := Brightness(219, 480)
    if during < after + 80 { return Fail("touch feedback stayed after release") }
    if !Shot("swipe-released") { return false }
    // Import an old run, persist it through IndexedDB, then use the real title
    // buttons. Only this test's private browser profile holds these records.
    if !BrowserEvaluate(browser, "new Promise((resolve,reject)=>{Module.FS.writeFile('/kryon-apps/wurm/run.dat',new Uint8Array([57,6,120,0,0,0]));try{Module.FS.unlink('/kryon-apps/wurm/unlocked.dat')}catch{}Module.FS.syncfs(false,e=>e?reject(e):resolve(true))})") { return false }
    if !Reload() { return false }
    Pause(1500)
    if !Until("(()=>{try{return Module.FS.readFile('/kryon-apps/wurm/unlocked.dat')[0]===57}catch{return false}})()") { return false }
    if !Shot("continue-title") || !Click(195, 746) || !Until(RunIs("[57,3,0,0,0,0]")) || !Shot("continued-level-58") { return false }
    if !Key(" ", 32) || !Key("q", 81) { return false }
    if !True("Module.FS.readFile('/kryon-apps/wurm/unlocked.dat')[0]===57") { return Fail("leaving the run erased unlocked progress") }
    Pause(500)
    if !Reload() { return false }
    Pause(1500)
    if !Key("c", 67) || !Until(RunIs("[57,3,0,0,0,0]")) { return false }
    if !Key(" ", 32) || !Key("q", 81) || !Key("l", 76) || !Shot("stage-selector") || !Key("Enter", 13) || !Shot("level-selector") { return false }
    grid := "(()=>{const c=document.getElementById('canvas'),p=c.getContext('2d').getImageData(0,132,c.width,c.height-132).data;let h=0;for(let i=0;i<p.length;i+=20)h=(Math.imul(h,31)+p[i]+p[i+1]*3+p[i+2]*7)>>>0;return h})()"
    before_scroll := BrowserNumber(browser, grid, -1.0)
    if !Touch("touchStart", 195, 700) { return false }
    for step: 1..5 {
        if !Touch("touchMove", 195, 700 - step * 50) { return false }
        Pause(70)
    }
    if !Touch("touchEnd", 0, 0) { return false }
    Pause(350)
    if BrowserNumber(browser, grid, -1.0) == before_scroll { return Fail("the selector did not scroll under touch drag") }
    if !True("Module.FS.readFile('/kryon-apps/wurm/run.dat')[0]===57") { return Fail("dragging the selector started a level") }
    if !Shot("level-selector-scrolled") { return false }
    if !Click(354, 96) || !Click(90, 238) { return false }  // Future Pinewood shows only locks.
    if !True("Module.FS.readFile('/kryon-apps/wurm/run.dat')[0]===57") { return Fail("a locked browser level started") }
    if !Shot("locked-levels") || !Click(36, 96) || !Click(90, 238) || !Until(RunIs("[40,3,0,0,0,0]")) { return false }
    if !True("Module.FS.readFile('/kryon-apps/wurm/unlocked.dat')[0]===57") { return Fail("level selection erased progress") }
    if !Key(" ", 32) || !Key("q", 81) || !Key("l", 76) || !Key("Escape", 27) || !Key("c", 67) { return false }
    if !Until("Module.FS.readFile('/kryon-apps/wurm/run.dat')[0]===57") { return false }
    // Both orientations use the same pad placement and keep a press highlight.
    if !BrowserEvaluate(browser, "new Promise((resolve,reject)=>{Module.FS.writeFile('/kryon-apps/wurm/controls.dat',new Uint8Array([1]));Module.FS.writeFile('/kryon-apps/wurm/unlocked.dat',new Uint8Array([0]));Module.FS.writeFile('/kryon-apps/wurm/run.dat',new Uint8Array([0,3,0,0,0,0]));Module.FS.syncfs(false,e=>e?reject(e):resolve(true))})") { return false }
    for orientation: 0..1 {
        width: s64 = ifx orientation == 0 then 390 else 844
        height: s64 = ifx orientation == 0 then 844 else 390
        if !Viewport(cast(s32)width, cast(s32)height, true) || !Reload() { return false }
        Pause(1200)
        if !Key("Enter", 13) { return false }
        play_height := cast(float64)(height - (ifx width < 520 then 104 else 72))
        short := ifx cast(float64)width < play_height then cast(float64)width else play_height
        margin := short * 0.06
        if margin < 24.0 { margin = 24.0 }
        if margin > 32.0 { margin = 32.0 }
        side := short * 0.44
        if side < 168.0 { side = 168.0 }
        if side > 216.0 { side = 216.0 }
        x := cast(s64)(margin + side / 6.0 + 0.5)
        y := cast(s64)(cast(float64)height - margin - side / 2.0 + 0.5)
        rest := Brightness(x - 10, y + 9)
        if !Touch("touchStart", x, y) { return false }
        Pause(80)
        held := Brightness(x - 10, y + 9)
        name: Vec(u8)
        BuilderPrint(*name, "pad-%x%", width, height)
        if !Shot(BuilderFinish(name)) { return false }
        difference := held - rest
        if difference < 0 { difference = -difference }
        if difference < 10 { return Fail("the direction pad did not highlight the held arm") }
        if !Touch("touchEnd", 0, 0) { return false }
    }
    if browser.exceptions.count > 0 {
        for i: 0..browser.exceptions.count - 1 { print("page exception: %\n", browser.exceptions[i]) }
        return Fail("the page threw")
    }
    result: Vec(u8)
    BuilderPrint(*result, "{\n  \"passed\": true,\n  \"url\": %,\n  \"colorful\": %,\n", JsonQuote(url), cast(s64)colorful)
    Append(*result, "  \"behaviors\": [\"shared touch feedback and release\", \"mobile pad placement and held highlight in both orientations\", \"rendered title artwork\", \"control choice\", \"straight into level 1\", \"keyboard steering\", \"pause\", \"portrait resize\", \"durable saves after reload\", \"old run migration\", \"Continue highest level with fresh stats\", \"leaving a run preserves unlocks\", \"Continue after browser reload\", \"stage selector and landscape level selector\", \"touch scrolling without starting a level\", \"locked levels show only locks\", \"unlocked level selection starts fresh\", \"selector keyboard back\"]\n}\n")
    unused WriteEntireFile(JoinPath(OUT, "result.json"), BuilderFinish(result))
    print("Browser local test: touch feedback and release, mobile pad placement and highlight, controls, play, portrait, durable progress and unlocked-level selection passed.\n")
    return true
}

// The whole canvas as one number, to tell motion from stillness.
CANVAS_HASH :: "(()=>{const c=document.getElementById('canvas'),p=c.getContext('2d').getImageData(0,0,c.width,c.height).data;let h=0;for(let i=0;i<p.length;i+=12)h=(Math.imul(h,31)+p[i]+p[i+1]*3+p[i+2]*7)>>>0;return h})()"

// At this fixture's 907x510 viewport the title's gold lettering is above
// Play. Runtime/FS readiness alone can precede the first interactive frame.
PORTAL_TITLE_READY :: "(()=>{const c=document.getElementById('canvas');if(c.width!==907||c.height!==510)return false;const g=c.getContext('2d');return [300,600].every(x=>{const p=g.getImageData(x,100,1,1).data;return p[0]>160&&p[1]>100&&p[2]<120})})()"

// Only the private SDK fixture calls this probe. Keep each transition visible
// without exporting game state or reading account/browser storage contents.
PortalFallbackProbe :: (name: string) {
    unused Shot(name)
    if BrowserEvaluate(browser, "JSON.stringify({sdkActive:WurmPortal.sdkActive,saveLimited:WurmPortal.saveLimited,dataError:WurmPortal.dataError,fixtureDataFailure:sessionStorage.getItem('wurm-data-fail')==='1',events:(window.__portal||[]).slice(-24),canvas:{width:canvas.width,height:canvas.height},focused:document.hasFocus(),activeElement:document.activeElement?.tagName})") {
        print("session-only %: %\n", name, browser.result)
    }
    print("session-only % canvas hash: %\n", name, BrowserNumber(browser, CANVAS_HASH, -1.0))
}

Record :: (name: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{try{return JSON.stringify(Array.from(Module.FS.readFile('/kryon-apps/wurm/%')))}catch{return ''}})()", name)
    return BrowserText(browser, BuilderFinish(text))
}

CloudRecord :: (name: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{try{const v=window.CrazyGames.SDK.data.getItem('%');return v===null?'':String(v)}catch{return ''}})()", name)
    return BrowserText(browser, BuilderFinish(text))
}

CloudRunIs :: (bytes: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{try{return JSON.stringify(Array.from((()=>{const h=window.CrazyGames.SDK.data.getItem('run.dat'),a=[];for(let i=0;i<h.length;i+=2)a.push(parseInt(h.substr(i,2),16));return a})()))==='%'}catch{return false}})()", bytes)
    return BuilderFinish(text)
}

SetCloudRecord :: (name: string, value: string) -> bool {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{window.CrazyGames.SDK.data.setItem('%','%');return true})()", name, value)
    return BrowserEvaluate(browser, BuilderFinish(text))
}

// The title's hidden portal corners: where waozi.xyz shows the shop, daily
// chest and Leaderboard. A press there must leave the title in place.
PressHiddenCorners :: (width: s64) -> bool {
    right := width - 12
    return Click(50, 50) && Key("Escape",27) && Click(50, 136) && Key("Escape",27) && Click(right - 166, 42)
}

// CrazyGames' SDK as the portal serves it, reporting German and keeping a
// log of what the game tells it; the real script stays blocked, so the page
// takes this one. With wurm-no-sdk in sessionStorage the page has no SDK.
// The log notes when the game reads the portal's language.
PORTAL_SDK :: "https://sdk.crazygames.com/crazygames-sdk-v3.js"
SDK_STUB :: "window.__scores=[];window.__portal=[];if(!sessionStorage.getItem('wurm-no-sdk')){const log=window.__portal,listeners=[],auth=[];let account=sessionStorage.getItem('wurm-account')||'guest';window.__portalConfigBuilt=false;const scoreFixtureKey='AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=';let fixtureKey='';const data=()=>({getItem(name){if(sessionStorage.getItem('wurm-data-fail')==='1')throw new Error('data');const value=sessionStorage.getItem('wurm-data:'+account+':'+name);return value===null?null:value},setItem(name,value){if(sessionStorage.getItem('wurm-data-fail')==='1')throw new Error('data');sessionStorage.setItem('wurm-data:'+account+':'+name,String(value))}});window.CrazyGames={SDK:{environment:'local',init(){log.push('init');return Promise.resolve()},user:{isUserAccountAvailable:sessionStorage.getItem('wurm-account-available')!=='false',systemInfo:{locale:'de-DE'},submitScore(payload){window.__scores.push(payload);if(window.__scoreFail)return Promise.reject(new Error('send'));return Promise.resolve()},getUser(){log.push('getUser');return sessionStorage.getItem('wurm-profile-fail')==='1'?Promise.reject(new Error('profile')):Promise.resolve(account==='guest'?null:{username:account,__dangerousUserId:'fixture-'+account})},showAuthPrompt(){log.push('showAuthPrompt');return sessionStorage.getItem('wurm-prompt-fail')==='1'?Promise.reject(new Error('cancelled')):Promise.resolve()},addAuthListener(f){auth.push(f)}},ad:{requestAd(kind,callbacks){window.__adKind=kind;window.__adCalls=(window.__adCalls||0)+1;window.__adCallbacks=callbacks;if(window.__adMode==='throw')throw new Error('ad');if(window.__adMode==='reject')return Promise.reject(new Error('ad'));if(window.__adMode==='nofill')callbacks.adError();}},data:data(),game:{settings:{muteAudio:false},addSettingsChangeListener(f){listeners.push(f)},loadingStart(){log.push('loadingStart')},loadingStop(){log.push('loadingStop')},gameplayStart(){log.push('gameplayStart')},gameplayStop(){log.push('gameplayStop')}}}};window.__portalSettings=s=>listeners.forEach(f=>f(s));window.__portalAccount=(name,changed)=>{account=name;sessionStorage.setItem('wurm-account',name);window.CrazyGames.SDK.data=data();if(changed)auth.forEach(f=>f())};window.__portalSignIn=name=>window.__portalAccount(name,true);window.__portalSignOut=()=>window.__portalAccount('guest',true);let bridge;Object.defineProperty(window,'WurmPortal',{configurable:true,get(){return bridge},set(v){bridge=v;if(!window.__portalConfigChecked){fixtureKey=window.WurmPortalConfig.leaderboardKey;window.__portalConfigBuilt=typeof fixtureKey==='string'&&/^(?:$|[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=)$/.test(fixtureKey)&&typeof window.WurmPortalConfig.adsEnabled==='boolean';WurmPortalConfig.leaderboardKey='';WurmPortalConfig.adsEnabled=false;window.__portalConfigChecked=true}if(sessionStorage.getItem('wurm-score-test'))window.WurmPortalConfig.leaderboardKey=scoreFixtureKey;let locale=v.locale;Object.defineProperty(v,'locale',{get(){log.push('locale');return locale},set(x){locale=x}})}})}"

// SDK fixture only; no hidden app state.
STORE_STUB :: "// Private browser SDK/data seams only. No game variables or exports.\nwindow.__storeCalls=[];window.__storeBuys=[];\nlet publicStore;\nconst mappings=[{kind:'skin',skinId:1,sku:'sample-skin',purchaseId:'sample-explicit-skin'},{kind:'skin',skinId:2,sku:'sample-free',purchaseId:'sample-explicit-free'},{kind:'skin',skinId:3,sku:'sample-missing',purchaseId:'sample-explicit-missing'},{kind:'mountains',sku:'sample-mountains',purchaseId:'sample-explicit-mountains'},{kind:'coins',sku:'sample-pack',purchaseId:'sample-explicit-pack',packCoins:1000,cumulativeInventory:true}];\nObject.defineProperty(window,'WurmPortalStoreConfig',{configurable:true,get(){return sessionStorage.getItem('shop-fixture')==='1'?{version:1,sandbox:false,products:mappings}:publicStore},set(v){publicStore=v}});\nif(window.CrazyGames){\n if(sessionStorage.getItem('shop-fixture')==='1')CrazyGames.SDK.user.systemInfo.locale='en-US';\n const account=()=>sessionStorage.getItem('wurm-account')||'guest';\n const invkey=()=> 'shop-inventory:'+account();\n const inventory=()=>JSON.parse(sessionStorage.getItem(invkey())||'[]');\n CrazyGames.SDK.store={get isAvailable(){return sessionStorage.getItem('shop-unsupported')!=='1'},setSandbox(value){if(value)throw Error('production sandbox must be false')},\n getCatalogItems({offset}){__storeCalls.push(['catalog',account(),offset]);if(sessionStorage.getItem('shop-catalog-error'))return Promise.reject({code:'catalogFetchFailed'});const currency=sessionStorage.getItem('shop-currency')||'USD';return Promise.resolve({hasMore:false,items:mappings.map((p,i)=>({sku:p.sku,name:'Sample '+p.kind,description:'Local fixture only',imageUrl:'',isFree:i===1,canBeBought:true,price:i===2?null:{amount:currency==='EUR'?'3.49':'4.99',amountWithoutDiscount:'4.99',currency}}))})},\n getPlayerInventory({offset}){__storeCalls.push(['inventory',account(),offset]);return Promise.resolve({items:inventory().slice(offset,offset+50)})},\n buyItem(id){__storeBuys.push(id);let buys=JSON.parse(sessionStorage.getItem('shop-buys')||'[]');buys.push(id);sessionStorage.setItem('shop-buys',JSON.stringify(buys));const mode=sessionStorage.getItem('shop-buy-mode');if(mode==='cancel')return Promise.reject({code:'purchaseCancelled'});if(mode!=='pending'){const p=mappings.find(p=>p.purchaseId===id);if(!p)return Promise.reject({code:'invalidArgument'});const all=inventory(),old=all.find(x=>x.sku===p.sku);if(old)old.quantity+=1;else all.push({sku:p.sku,quantity:p.kind==='coins'?1:null});sessionStorage.setItem(invkey(),JSON.stringify(all))}return Promise.resolve({itemId:id})},consumeItem(){throw Error('must never consume')}\n };\n}\n"

// Public fixture only. Decrypt the actual Progress.Report submission after
// loading the SDK best record; subsequent calls exercise queue/error glue.
PortalResults :: () -> bool {
    if !True("__portalConfigBuilt&&!WurmPortalConfig.adsEnabled&&WurmPortalConfig.leaderboardKey===''") { return Fail("portal configuration shape was invalid or not isolated") }
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-score-test','1');CrazyGames.SDK.data.setItem('best.dat','0700000039300000');true") || !Reload() { return false }
    if !Until("window.__scores.length===1&&WurmPortal.scoreSent===12345&&WurmPortal.scoreAt>Date.now()+8000") { return Fail("Progress.Report did not send the stored best campaign score") }
    if !True("(async()=>{const p=__scores[0],b=Uint8Array.from(atob(p.encryptedScore),c=>c.charCodeAt(0)),k=await crypto.subtle.importKey('raw',new Uint8Array(32),'AES-GCM',false,['decrypt']);return p.score===12345&&new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:b.slice(0,12)},k,b.slice(12)))==='12345'})()") { return Fail("the real best score encryption is incorrect") }
    if !BrowserEvaluate(browser, "WurmPortal.submitBest(12345);WurmPortal.submitBest(12346);true") || !True("__scores.length===1") { return Fail("score throttle/dedupe failed") }
    if !BrowserEvaluate(browser, "window.__scoreFail=true;WurmPortal.scoreAt=0;WurmPortal.submitBest(12346);true") || !Until("!WurmPortal.scoreBusy&&__scores.length===2") { return false }
    if !BrowserEvaluate(browser, "window.__scoreFail=false;WurmPortal.scoreAt=0;WurmPortal.submitBest(12347);true") || !Until("WurmPortal.scoreSent===12347&&__scores.length===3") { return Fail("newer best did not retry after rejection") }
    if !True("new Set(__scores.map(p=>atob(p.encryptedScore).slice(0,12))).size===3") { return Fail("score IVs were reused") }
    if !BrowserEvaluate(browser, "WurmPortal.levelFinished();true") || !True("!WurmPortal.adPending&&!window.__adCalls") { return Fail("Basic requested an ad") }
    if !BrowserEvaluate(browser, "WurmPortalConfig.adsEnabled=true;WurmPortal.levelFinished();true") || !True("WurmPortal.adPending&&!WurmPortal.adPlaying&&__adKind==='midgame'&&__adCalls===1") { return Fail("midgame request did not block while pending") }
    if !Key("Enter",13) || !Key("ArrowRight",39) || !True("WurmPortal.adPending&&__adCalls===1&&!__portal.includes('gameplayStart')") { return Fail("pending ad let input start gameplay") }
    if !BrowserEvaluate(browser, "__adCallbacks.adStarted();true") || !Until("WurmPortal.adPlaying&&__wurmSilent()") { return Fail("actual ad playback did not mute") }
    if !BrowserEvaluate(browser, "__portalSettings({muteAudio:true});__adCallbacks.adFinished();true") || !Until("!WurmPortal.adPending&&__wurmSilent()") { return Fail("SDK mute was lost after ad") }
    if !BrowserEvaluate(browser, "__portalSettings({muteAudio:false});true") || !Until("__wurmDecoded>=7&&!WurmPortal.muted") { return Fail("sound did not restore after ad") }
    if !BrowserEvaluate(browser, "window.__adMode='nofill';WurmPortal.levelFinished();true") || !True("!WurmPortal.adPending&&!WurmPortal.adPlaying") { return Fail("no fill froze the game") }
    if !BrowserEvaluate(browser, "window.__adMode='throw';WurmPortal.levelFinished();true") || !True("!WurmPortal.adPending") { return Fail("throw froze the game") }
    if !BrowserEvaluate(browser, "window.__adMode='reject';WurmPortal.levelFinished();true") || !Until("!WurmPortal.adPending") { return Fail("rejection froze the game") }
    if !BrowserEvaluate(browser, "window.__adMode='';window.__realTimer=window.setTimeout;window.setTimeout=(f,ms,...args)=>ms===30000?(window.__adTimeout=f,987654):__realTimer(f,ms,...args);WurmPortal.levelFinished();window.setTimeout=__realTimer;window.__late=__adCallbacks;__adTimeout();true") || !True("!WurmPortal.adPending&&WurmPortal.adsFailed") { return Fail("missing callback did not recover") }
    if !BrowserEvaluate(browser, "__late.adStarted();true") || !Until("WurmPortal.adPending&&WurmPortal.adPlaying&&__wurmSilent()") { return Fail("late ad was allowed over the game") }
    if !BrowserEvaluate(browser, "__late.adFinished();WurmPortal.levelFinished();true") || !True("!WurmPortal.adPending") { return Fail("late ad did not finish safely") }
    if !BrowserEvaluate(browser, "window.__oldEncrypt=crypto.subtle.encrypt;crypto.subtle.encrypt=()=>Promise.reject(new Error('encrypt'));WurmPortal.scoreAt=0;WurmPortal.submitBest(12348);true") || !Until("!WurmPortal.scoreBusy") || !True("__scores.length===3&&WurmPortal.scoreSent===12347") { return Fail("encryption failure sent a score") }
    if !BrowserEvaluate(browser, "crypto.subtle.encrypt=__oldEncrypt;WurmPortalConfig.leaderboardKey='';WurmPortal.submitBest(12349);true") || !True("__scores.length===3") { return Fail("missing key sent a score") }
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-score-test');CrazyGames.SDK.data.setItem('best.dat','0000000000000000');CrazyGames.SDK.data.setItem('sound.dat','0164');true") || !Reload() { return false }
    if !Until(LOADED) || !Key("Enter",13) || !Key("1",49) || !Key("Enter",13) || !Key(" ",32) || !Until("__wurmMusic().length>0&&__wurmSilent()") { return Fail("saved mute did not load") }
    if !BrowserEvaluate(browser, "WurmPortalConfig.adsEnabled=true;WurmPortal.levelFinished();__adCallbacks.adStarted();__adCallbacks.adFinished();true") || !Until("!WurmPortal.adPending&&__wurmSilent()") || CloudRecord("sound.dat") != "0164" { return Fail("ad changed saved user mute") }
    if !BrowserEvaluate(browser, "CrazyGames.SDK.data.setItem('sound.dat','0064');true") || !Reload() { return false }
    return Until(LOADED)
}

// Whether the SDK log's gameplay reports end with LAST and never repeat.
GameplayEnds :: (last: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "(()=>{const g=window.__portal.filter(e=>e.startsWith('gameplay'));return g.length>0&&g[g.length-1]==='%'&&g.every((e,i)=>i===0||e!==g[i-1])})()", last)
    return BuilderFinish(text)
}

// Inspect the rendered board panel, whose clear right edge is uniform.
EditorBoardVisible :: () -> bool {
    Pause(250)
    return True("(()=>{const c=document.getElementById('canvas'),g=c.getContext('2d'),a=g.getImageData(795,100,1,1).data,b=g.getImageData(795,220,1,1).data;return a[3]===255&&a[0]===b[0]&&a[1]===b[1]&&a[2]===b[2]})()")
}
// At the reload fixture's 800x450 size, wait for the Editor home buttons
// before clicking My levels. Loaded files/audio can precede this input frame.
EDITOR_HOME_READY :: "(()=>{const c=document.getElementById('canvas');if(c.width!==800||c.height!==450)return false;const g=c.getContext('2d');return [300,500].every(x=>{const a=g.getImageData(x,250,1,1).data,b=g.getImageData(x,380,1,1).data;return a[0]===113&&a[1]===152&&a[2]===106&&b[0]===51&&b[1]===62&&b[2]===56})})()"
CoverHash :: () -> float64 {
    Pause(1100)
    return BrowserNumber(browser,"(()=>{const c=document.getElementById('canvas'),p=c.getContext('2d').getImageData(100,90,c.width-200,80).data;let h=0;for(let i=0;i<p.length;i+=16)h=(Math.imul(h,31)+p[i]+p[i+1]*3+p[i+2]*7)>>>0;return h})()",-1.0)
}
PortalShot :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "work/crazygames/editor-swipe/%.png", name)
    return BrowserScreenshot(browser, BuilderFinish(path))
}
SwipeCover :: (start: s64, finish: s64, y: s64) -> bool {
    if !Touch("touchStart", start, y) { return false }
    Pause(80)
    if !Touch("touchMove", (start + finish) / 2, y) { return false }
    Pause(80)
    if !Touch("touchMove", finish, y) || !Touch("touchEnd", 0, 0) { return false }
    Pause(900)
    return true
}
PortalEditorUI :: () -> bool {
    if !CreateDirectories("work/crazygames/editor-swipe") { return false }
    // A fresh fixture account; all navigation and edits use real input.
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-no-sdk');sessionStorage.setItem('wurm-account','EditorQA');true") || !Viewport(800,450,false) || !Reload() { return false }
    Pause(1200)
    play_cover := CoverHash()
    if !PortalShot("play-landscape") || !Click(766,225) { return false }
    editor_cover := CoverHash()
    if editor_cover == play_cover || !PortalShot("editor-landscape") { return Fail("landscape arrow did not select editor") }
    if !Key("ArrowLeft",37) { return false }
    if CoverHash() != play_cover || !SwipeCover(620,180,180) || CoverHash() != editor_cover { return Fail("landscape swipe did not select editor") }
    if !Click(35,225) || CoverHash() != play_cover { return Fail("previous arrow did not select cover") }
    if !BrowserMouse(browser,"mouseMoved",400.0,180.0,0.0) { return false }
    Pause(200)
    if !BrowserMouse(browser,"mouseWheel",400.0,180.0,160.0) || CoverHash() != editor_cover { return Fail("wheel did not select cover") }
    if !Key("l",76) || !PortalShot("stages") || !Key("Escape",27) || !Key("e",69) { return Fail("Stages or E shortcut was unreachable") }
    if !Reload() { return false }
    Pause(1000)
    if !Key("ArrowRight",39) || !Key("Enter",13) { return Fail("keyboard did not activate editor") }
    if !PortalShot("editor-home") { return false }
    if !Click(400,244) || !Click(400,160) || !EditorBoardVisible() { return Fail("New level did not open a board") }
    if !True("JSON.parse(CrazyGames.SDK.data.getItem('editor-drafts-v1.json')).records[0].document.levels.length===1") { return Fail("New level was not stored") }
    if !BrowserEvaluate(browser, "window.__beforeDraft=CrazyGames.SDK.data.getItem('editor-drafts-v1.json');true") { return false }
    // Select the second floor swatch, then drag a horizontal paint stroke.
    if !Click(615,195) || !BrowserMouse(browser,"mousePressed",200.0,200.0,0.0) { return false }
    Pause(100)
    if !BrowserMouse(browser,"mouseMoved",310.0,200.0,0.0) { return false }
    Pause(100)
    if !BrowserMouse(browser,"mouseReleased",310.0,200.0,0.0) || !Click(610,350) { return false }
    if !Until("CrazyGames.SDK.data.getItem('editor-drafts-v1.json')!==__beforeDraft") { return Fail("pointer painting did not save") }
    if !BrowserEvaluate(browser, "window.__savedDraft=CrazyGames.SDK.data.getItem('editor-drafts-v1.json');sessionStorage.setItem('wurm-data-fail','1');true") || !Click(280,230) || !Click(610,350) { return false }
    if !True("sessionStorage.getItem('wurm-data:EditorQA:editor-drafts-v1.json')===__savedDraft") || !PortalShot("save-failure") { return Fail("failed write replaced durable draft") }
    // Title attempts to save too; a failure must leave the board and retry.
    if !Click(735,400) || !EditorBoardVisible() { return Fail("failed save discarded the editor") }
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-data-fail');true") || !Click(610,350) || !Until("CrazyGames.SDK.data.getItem('editor-drafts-v1.json')!==__savedDraft") { return Fail("dirty save could not retry") }
    if !Key("t",84) || !Click(615,195) || !Click(240,230) || !Click(610,350) { return false }
    if !Until("typeof JSON.parse(CrazyGames.SDK.data.getItem('editor-drafts-v1.json')).records[0].document.levels[0].portrait==='string'") { return Fail("orientation did not save") }
    if !PortalShot("painting") || !Click(610,400) || !Key("Enter",13) { return false }
    if !Until(GameplayEnds("gameplayStart")) { return Fail("editor playtest did not run") }
    if !Key("Escape",27) || !Key("Escape",27) || !EditorBoardVisible() { return Fail("playtest did not return to painting") }
    if !BrowserEvaluate(browser, "window.sessionStorage.setItem('editor-expected',CrazyGames.SDK.data.getItem('editor-drafts-v1.json'));true") || !Reload() || !Key("e",69) || !Until(EDITOR_HOME_READY) || !Click(400,390) || !Click(260,150) || !Click(250,175) || !EditorBoardVisible() { return Fail("My levels did not reopen after full reload") }
    if !True("CrazyGames.SDK.data.getItem('editor-drafts-v1.json')===sessionStorage.getItem('editor-expected')") || !PortalShot("reloaded") { return Fail("full reload changed saved painting") }
    // From a level copies the reached campaign board into this collection.
    if !Reload() || !Key("e",69) || !Click(400,328) || !Click(400,160) || !Click(55,100) || !EditorBoardVisible() { return Fail("From a level did not open a copy") }
    if !True("JSON.parse(CrazyGames.SDK.data.getItem('editor-drafts-v1.json')).records[0].document.levels.length===2") { return Fail("template was not stored") }
    // Account change uses the SDK fixture only. The guest cannot see QA drafts.
    if !BrowserEvaluate(browser,"__portalAccount('guest',false);true") || !Reload() || !Key("e",69) || !Click(400,390) { return false }
    if !True("CrazyGames.SDK.data.getItem('editor-drafts-v1.json')===null") { return Fail("editor crossed account namespaces") }
    if !Viewport(450,800,true) || !Reload() { return false }
    Pause(1000)
    portrait_play := CoverHash()
    if !SwipeCover(360,90,350) || CoverHash() == portrait_play || !PortalShot("editor-portrait") { return Fail("portrait swipe did not select editor") }
    if !Key("ArrowLeft",37) || !Key("ArrowRight",39) || !Key("Enter",13) { return Fail("portrait keyboard editor unreachable") }
    if !PortalShot("editor-home-portrait") { return false }
    // No SDK: local drafts persist across a real page reload as well.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('wurm-no-sdk','1');true") || !Viewport(800,450,false) || !Reload() { return false }
    Pause(1000)
    if !Key("e",69) || !Click(400,244) || !Click(400,160) || !EditorBoardVisible() || !Click(615,195) || !Click(250,220) || !Click(610,350) { return Fail("noSDK editor could not paint/save") }
    if !BrowserEvaluate(browser,"sessionStorage.setItem('local-editor-expected',new TextDecoder().decode(Module.FS.readFile('/kryon-apps/wurm/editor-drafts-v1.json')));true") || !Reload() { return false }
    Pause(1000)
    if !True("new TextDecoder().decode(Module.FS.readFile('/kryon-apps/wurm/editor-drafts-v1.json'))===sessionStorage.getItem('local-editor-expected')") { return Fail("local draft changed after reload") }
    if !Key("e",69) || !Until(EDITOR_HOME_READY) || !Click(400,390) || !Click(260,150) || !Click(250,175) || !EditorBoardVisible() || !PortalShot("nosdk-reloaded") { return Fail("noSDK My levels did not survive reload") }
    print("Browser local test: title arrows/swipe/wheel/keys and Stages shortcut in landscape and portrait; New level, From a level, My levels, pointer painting, save failure/retry, orientation, playtest/return, SDK account isolation and noSDK reload passed.\n")
    return true
}

ShopShot :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "work/crazygames/store-ui/%.png", name)
    return BrowserScreenshot(browser, BuilderFinish(path))
}
ShopHash :: (x: s32, y: s32, width: s32, height: s32) -> float64 {
    expression: Vec(u8)
    BuilderPrint(*expression,"(()=>{const p=document.getElementById('canvas').getContext('2d').getImageData(%,%,%,%).data;let h=0;for(let i=0;i<p.length;i+=4)h=(Math.imul(h,31)+p[i]+p[i+1]*3+p[i+2]*7)>>>0;return h})()",x,y,width,height)
    return BrowserNumber(browser,BuilderFinish(expression),-1.0)
}
ShopReady :: () -> bool {
    if !Until("__storeCalls.filter(x=>x[0]==='inventory').length>0") { return Fail("Wasm runtime did not read inventory") }
    Pause(700)
    return true
}
PortalShopUI :: () -> bool {
    if !CreateDirectories("work/crazygames/store-ui") { return false }
    if !BrowserEvaluate(browser,"sessionStorage.removeItem('wurm-no-sdk');sessionStorage.setItem('shop-fixture','1');sessionStorage.setItem('wurm-account','ShopQA');true") || !Viewport(800,450,false) || !Reload() || !ShopReady() { return false }
    if !Click(50,50) || !ShopShot("landscape-usd") { return false }
    usd := ShopHash(275,306,230,28)
    // Same native card redraws the personalized currency after explicit refresh.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('shop-currency','EUR');true") || !Click(740,88) { return false }
    Pause(1000)
    if ShopHash(275,306,230,28) == usd || !ShopShot("landscape-eur") { return Fail("personalized price did not redraw") }
    // Missing price never opens checkout; the free product needs confirmation.
    if !BrowserMouse(browser,"mouseMoved",400.0,330.0,0.0) || !BrowserMouse(browser,"mouseWheel",400.0,330.0,588.0) { return false }
    Pause(600)
    if !Click(135,365) || !True("__storeBuys.length===0") || !ShopShot("missing-price") { return Fail("missing paid price checked out") }
    if !Click(400,180) || !ShopShot("mountains-landscape") || !Click(570,180) || !ShopShot("coins-landscape") || !Click(230,180) { return false }
    // Cancel through SDK, then retry once through the actual confirm button.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('shop-buy-mode','cancel');true") || !Click(400,365) || !Click(400,310) { return false }
    if !Until("__storeBuys.length===1&&__storeBuys[0]==='sample-explicit-skin'&&CrazyGames.SDK.data.getItem('wurm-store-pending-v1')===''") { return Fail("cancel did not use explicit skin ID or clear marker") }
    if !ShopShot("cancelled") || !BrowserEvaluate(browser,"sessionStorage.setItem('shop-buy-mode','pending');true") || !Click(400,310) { return false }
    if !Until("__storeBuys.length===2&&!!CrazyGames.SDK.data.getItem('wurm-store-pending-v1')") { return Fail("explicit retry not pending") }
    Pause(1000)
    if !Click(400,310) || !True("__storeBuys.length===2&&JSON.parse(sessionStorage.getItem('shop-inventory:ShopQA')||'[]').length===0") || !ShopShot("pending") { return Fail("buy result granted or duplicate checkout happened") }
    if !Reload() || !ShopReady() || !Click(50,50) || !Click(400,365) || !True("__storeBuys.length===0") { return Fail("pending reload recharged") }
    // Restore proves ownership without a second charge, even outside the shop.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('shop-inventory:ShopQA',JSON.stringify([{sku:'sample-skin',quantity:null}]));true") || !Click(720,34) { return false }
    Pause(1200)
    if !Until("CrazyGames.SDK.data.getItem('wurm-store-pending-v1')===''") || !Click(400,365) { return Fail("restore did not reconcile skin") }
    if !Until("(CrazyGames.SDK.data.getItem('wardrobe.dat')||'').startsWith('01')") || !ShopShot("owned-skin") { return Fail("verified skin could not be worn") }
    if !Reload() || !ShopReady() || !True("CrazyGames.SDK.data.getItem('wardrobe.dat').startsWith('01')") || !Click(50,50) { return Fail("selected durable skin lost on reload") }
    // Real native free item, then paid chapter; only inventory opens gameplay.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('shop-buy-mode','success');true") || !Click(650,365) || !Click(400,310) || !Until("__storeBuys.includes('sample-explicit-free')") { return Fail("free product confirmation failed") }
    Pause(800)
    if !Click(400,365) || !Click(400,180) || !BrowserEvaluate(browser,"sessionStorage.setItem('shop-buy-mode','success');true") || !Click(580,316) || !Click(400,310) { return false }
    if !Until("__storeBuys.includes('sample-explicit-mountains')") { return Fail("chapter did not use explicit ID") }
    Pause(1000)
    if !Click(400,365) || !ShopShot("owned-mountains") || !Click(580,362) || !Until(CloudRunIs("[160,3,0,0,0,0]")) { return Fail("verified Mountains did not open its chapter") }
    // Counted pack inventory derives a stable total; no consume or client grant.
    if !Reload() || !ShopReady() || !Click(50,50) || !Click(570,180) || !Click(580,316) || !Click(400,310) { return false }
    if !Until("__storeBuys.includes('sample-explicit-pack')") { return Fail("coin pack did not use explicit ID") }
    Pause(1000)
    if !Click(400,365) || !ShopShot("coin-pack-owned") { return false }
    balance := ShopHash(20,72,140,32)
    if !Click(740,88) { return false }
    Pause(1000)
    if ShopHash(20,72,140,32) != balance || !Reload() || !ShopReady() || !Click(50,50) || ShopHash(20,72,140,32) != balance { return Fail("pack refresh/reload changed derived balance") }
    // Portrait keeps all tabs and Restore available. Scroll real coin skin 9
    // into view in landscape; strict SDK Data failure must roll back spending.
    if !Viewport(450,800,true) { return false }
    Pause(500)
    if !ShopShot("portrait") || !Click(225,180) || !ShopShot("mountains-portrait") || !Click(355,180) || !ShopShot("coins-portrait") || !Viewport(800,450,false) || !Click(230,180) { return false }
    if !BrowserMouse(browser,"mouseMoved",400.0,330.0,0.0) { return false }
    for step: 0..2 {
        if !BrowserMouse(browser,"mouseWheel",400.0,330.0,588.0) { return false }
        Pause(450)
    }
    if !ShopShot("coin-skin-offer") || !Click(135,340) || !BrowserEvaluate(browser,"sessionStorage.setItem('wurm-data-fail','1');true") || !Click(400,310) || !ShopShot("coin-save-error") { return false }
    if !BrowserEvaluate(browser,"sessionStorage.removeItem('wurm-data-fail');true") { return false }
    if !True("!(CrazyGames.SDK.data.getItem('wardrobe.dat')||'').startsWith('09')") || !Click(400,310) { return Fail("coin skin was worn after failed save") }
    if !Until("CrazyGames.SDK.data.getItem('wardrobe.dat').startsWith('09')") || !ShopShot("coin-skin-owned") { return Fail("coin skin retry did not persist") }
    if !Reload() || !ShopReady() || !Click(50,50) || !ShopShot("coin-reload") || !True("CrazyGames.SDK.data.getItem('wardrobe.dat').startsWith('09')") { return Fail("coin skin choice lost on reload") }
    // Unsupported payments/catalog failure must still restore owned inventory.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('shop-unsupported','1');sessionStorage.setItem('shop-catalog-error','1');true") || !Reload() || !ShopReady() || !Click(50,50) || !Click(400,180) || !ShopShot("unsupported-restored") || !Click(580,362) || !Until(CloudRunIs("[160,3,0,0,0,0]")) { return Fail("unsupported payment/catalog error lost owned Mountains") }
    // New account gets none of the first player's entitlements/pack balance.
    if !BrowserEvaluate(browser,"sessionStorage.setItem('wurm-account','ShopOther');sessionStorage.removeItem('shop-unsupported');sessionStorage.removeItem('shop-catalog-error');true") || !Reload() || !ShopReady() || !Click(50,50) || !Click(400,180) || !ShopShot("account-isolated") || !Click(580,362) || !True("CrazyGames.SDK.data.getItem('run.dat')===null&&__storeBuys.length===0") { return Fail("account inherited paid chapter") }
    if !BrowserEvaluate(browser,"sessionStorage.removeItem('shop-fixture');sessionStorage.setItem('wurm-account','guest');true") || !Reload() { return false }
    print("Browser local test: real Wasm shop tabs/orientations, personalized currency, free/missing price, explicit IDs, cancel/retry, pending/reload/restore, skin wear/chapter play, cumulative packs, strict coin spend failure/retry, unsupported catalog/payment restore and account isolation passed.\n")
    return true
}

// The packaged guest copy from WURM_TEST_PORTAL, served below
// /games/apfelwurm/ as a portal frame would load it.
Portal :: (root: string) -> bool {
    if !BrowserServe(browser, root) { return Fail("the HTTP server did not start") }
    base := BrowserUrl(browser, "/games/apfelwurm/")
    url := BrowserUrl(browser, "/games/apfelwurm/index.html")
    profile := JoinPath(ResolvePath(OUT), "portal-profile")
    unused RemoveTree(profile)
    if !BrowserOpen(browser, profile) { return Fail("the private Chromium did not start") }
    audio := AUDIO_OBSERVER
    if !BrowserCall(browser, "Page.enable", "{}") || !BrowserCall(browser, "Runtime.enable", "{}") { return false }
    if !BrowserScriptOnLoad(browser, audio) || !BrowserScriptOnLoad(browser, SDK_STUB) || !BrowserScriptOnLoad(browser, STORE_STUB) || !Viewport(907, 510, false) { return false }
    if !BrowserCall(browser, "Network.enable", "{}") || !BrowserCall(browser, "Network.setBlockedURLs", "{\"urls\":[\"*sdk.crazygames.com*\",\"https://*\"]}") { return false }
    if !BrowserCall(browser, "Page.navigate", BrowserParams1("url", url)) { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") { return Fail("the portal copy did not open") }
    if EnvironmentText("WURM_TEST_STORE_ONLY") == "1" {
        passed := PortalShopUI()
        if !passed {
            unused ShopShot("failure")
            if BrowserEvaluate(browser, "JSON.stringify({session:WurmPortal.storeRead('session'),calls:__storeCalls,buys:__storeBuys,pending:CrazyGames.SDK.data.getItem('wurm-store-pending-v1')})") { print("Store fixture failure: %\n", browser.result) }
        }
        return passed
    }
    if !True("__wurmAssets()") { return Fail("packed audio assets are missing from the virtual file system") }
    if !Until("!!window.__wurmContext") || !Click(2,2) || !PortalResults() { return false }
    // The SDK starts before the game loads, hears when loading ends, gives the
    // game the player's language, and never asks the player to sign in there.
    if !Until("(()=>{const l=window.__portal;return l[0]==='init'&&l[1]==='loadingStart'&&l.indexOf('loadingStop')>1&&l.includes('locale')&&WurmPortal.locale==='de-DE'&&WurmPortal.sdkActive&&WurmPortal.accountAvailable&&WurmPortal.username===''&&!l.includes('showAuthPrompt')})()") { return Fail("the SDK did not start, report loading or give its language") }
    // A failed profile fetch is bounded and cannot stop the game from opening.
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-profile-fail','1'),true") || !Reload() { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") || !True("WurmPortal.accountError") { return Fail("a failed profile fetch blocked the copy") }
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-profile-fail'),true") || !Reload() { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") { return Fail("the portal copy did not recover from a profile error") }
    Pause(1800)
    colorful := BrowserNumber(browser, "(()=>{const c=document.getElementById('canvas'),p=c.getContext('2d').getImageData(0,0,c.width,c.height).data,s=new Set();for(let i=0;i<p.length;i+=80)s.add(p[i]+','+p[i+1]+','+p[i+2]);return s.size})()", 0.0)
    if colorful < 200.0 { return Fail("title artwork did not render at 907x510") }
    // Settings still opens and closes; the account-free corners open nothing.
    if !Click(865, 42) || !Key("Escape", 27) || !PressHiddenCorners(907) { return false }
    // The profile opens only from its button. A rejected sign-in stays bounded,
    // leaves the player a guest, and a second explicit click reaches the prompt.
    if !Click(797, 42) { return false }
    Pause(300)
    if !True("WurmPortal.username===''") { return Fail("the guest profile did not open") }
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-prompt-fail','1'),true") || !Click(453, 204) { return false }
    if !Until("WurmPortal.accountError&&WurmPortal.username===''") { return Fail("a cancelled sign-in changed the guest or blocked the profile") }
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-prompt-fail'),true") || !Click(453, 204) { return false }
    if !Until("window.__portal.filter(e=>e==='showAuthPrompt').length===2") { return Fail("the explicit sign-in buttons did not reach CrazyGames") }
    if !Click(50, 30) { return false }
    Pause(200)
    // One actual Play click starts a fresh guest without a controls prompt.
    if !Click(453, 346) { return false }
    if !Until(CloudRunIs("[0,3,0,0,0,0]")) {
        if BrowserEvaluate(browser, "JSON.stringify({run:window.CrazyGames.SDK.data.getItem('run.dat'),unlocked:window.CrazyGames.SDK.data.getItem('unlocked.dat'),user:WurmPortal.username,saveLimited:WurmPortal.saveLimited,dataError:WurmPortal.dataError})") {
            print("profile-flow records: %\n", browser.result)
        }
        return Fail("the title did not start level 1 after the profile flow")
    }
    // Arrow keys steer a moving worm; Space pauses it and starts it again.
    if !Until(GameplayEnds("gameplayStart")) { return Fail("one Play click did not report gameplay to the SDK") }
    first := BrowserNumber(browser, CANVAS_HASH, -1.0)
    Pause(450)
    if BrowserNumber(browser, CANVAS_HASH, -1.0) == first { return Fail("the worm did not move") }
    if !Until(GameplayEnds("gameplayStart")) { return Fail("play was not reported to the SDK") }
    // The portal's mute silences music and effects over the player's On,
    // and lifting it brings the player's sound back.
    if !BrowserEvaluate(browser, "window.__portalSettings({muteAudio:true}),true") { return false }
    if !Until("__wurmMusic().length>0&&__wurmSilent()") { return Fail("the portal's mute did not silence the game") }
    if !BrowserEvaluate(browser, "window.__portalSettings({muteAudio:false}),true") { return false }
    if !Until("__wurmAudible()") { return Fail("the player's sound did not return after the portal's mute") }
    if !Key(" ", 32) { return false }
    Pause(300)
    paused := BrowserNumber(browser, CANVAS_HASH, -1.0)
    Pause(600)
    if BrowserNumber(browser, CANVAS_HASH, -1.0) != paused { return Fail("Space did not pause") }
    if !True(GameplayEnds("gameplayStop")) { return Fail("the pause was not reported to the SDK") }
    if !Key(" ", 32) { return false }
    Pause(450)
    if BrowserNumber(browser, CANVAS_HASH, -1.0) == paused { return Fail("Space did not resume") }
    if !True(GameplayEnds("gameplayStart")) { return Fail("resuming was not reported to the SDK") }
    // Old SDK progress survives; unowned paid chapters continue at level 160.
    if !SetCloudRecord("unlocked.dat", "a4") || !SetCloudRecord("run.dat", "a40300000000") { return false }
    if !Reload() { return false }
    Pause(1500)
    if CloudRecord("unlocked.dat") != "a4" { return Fail("guest progress did not survive a reload in SDK Data") }
    if !Key("c", 67) || !Until(CloudRunIs("[159,3,0,0,0,0]")) { return Fail("Continue did not fall back to last free level") }
    Pause(1500)
    if !Reload() { return false }
    Pause(1500)
    if !Until(CloudRunIs("[159,3,0,0,0,0]")) { return Fail("the guest's run did not survive a reload") }
    // A failing Data Module keeps this page's play alive in session memory and
    // says so, instead of silently borrowing another account's browser save.
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-data-fail','1'),true") || !Reload() { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") || !True("WurmPortal.saveLimited") { return Fail("a SDK Data error blocked the title or hid its save limit") }
    if !Until(PORTAL_TITLE_READY) || !Click(797, 42) || !Until(BuilderJoin("!(", PORTAL_TITLE_READY, ")")) || !True("WurmPortal.saveLimited&&WurmPortal.username===''") || !Key("Escape", 27) || !Until(PORTAL_TITLE_READY) { return Fail("the save warning did not stay visible in the guest profile") }
    PortalFallbackProbe("fallback-title")
    if !Click(453, 346) || !Until(GameplayEnds("gameplayStart")) || !Key("ArrowRight", 39) { return Fail("session-only Play did not start gameplay") }
    failed_still := BrowserNumber(browser, CANVAS_HASH, -1.0)
    Pause(450)
    failed_after := BrowserNumber(browser, CANVAS_HASH, -1.0)
    if failed_after == failed_still {
        PortalFallbackProbe("fallback-motion")
        return Fail("a SDK Data error stopped session-only play")
    }
    if !BrowserEvaluate(browser, "sessionStorage.removeItem('wurm-data-fail'),true") || !Reload() { return false }
    if !Until(LOADED) || CloudRecord("unlocked.dat") != "a4" { return Fail("SDK Data did not return after its error") }
    // Put an old guest save in browser IDB, then reload as Alice. Her missing
    // cloud record must not borrow it; she starts a new journey in her own data.
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-no-sdk','1'),true") || !Reload() { return false }
    // A trusted gesture unlocks the provider after storage settles.
    if !Until(LOADED) || !Click(2,2) || !Until("__wurmDecoded>=7") { return false }
    if !BrowserEvaluate(browser, "new Promise((resolve,reject)=>{Module.FS.mkdirTree('/kryon-apps/wurm');Module.FS.writeFile('/kryon-apps/wurm/unlocked.dat',new Uint8Array([57]));Module.FS.syncfs(false,e=>e?reject(e):resolve(true))})") { return false }
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-account','Alice');sessionStorage.removeItem('wurm-no-sdk');true") || !Reload() { return false }
    if !Until(LOADED) || !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") || !True("WurmPortal.username==='Alice'") { return Fail("the signed account did not load") }
    if CloudRecord("unlocked.dat") != "" {
        if BrowserEvaluate(browser, "JSON.stringify({account:sessionStorage.getItem('wurm-account'),unlocked:window.CrazyGames.SDK.data.getItem('unlocked.dat')})") {
            print("new-account cloud: %\n", browser.result)
        }
        return Fail("the new account inherited guest cloud progress")
    }
    if !Key("c", 67) { return false }
    Pause(200)
    if !Key("Enter", 13) || !Key("1", 49) || !Until(CloudRunIs("[0,3,0,0,0,0]")) { return Fail("Continue used another account's IDB save") }
    if !Click(797, 42) || !True("WurmPortal.username==='Alice'") || !Click(50, 30) { return Fail("the signed profile did not show Alice") }
    // The smaller portal frame keeps shop/chest navigation and free-level fallback.
    if !Viewport(800, 450, false) || !Reload() { return false }
    Pause(1500)
    if BrowserNumber(browser, "document.getElementById('canvas').getBoundingClientRect().width", 0.0) != 800.0 { return Fail("the canvas did not fill 800x450") }
    if !BrowserEvaluate(browser, "window.__portalAccount('guest',false),true") || !Reload() { return false }
    if !Until(LOADED) || CloudRecord("unlocked.dat") != "a4" { return Fail("guest progress did not return at 800x450") }
    if !PressHiddenCorners(800) || !Key("Enter", 13) { return false }
    if !Until(CloudRunIs("[159,3,0,0,0,0]")) { return Fail("Continue did not preserve the free-level fallback at 800x450") }
    if CloudRecord("unlocked.dat") != "a4" { return Fail("Continue erased guest progress") }
    // Every request stayed beside the page: no sign-in, shop or other site.
    check: Vec(u8)
    BuilderPrint(*check, "(()=>{const b='%';const urls=performance.getEntriesByType('resource').map(e=>e.name).concat(Array.from(document.querySelectorAll('[src]'),e=>e.src)).filter(u=>u!=='%');return urls.length>0&&urls.every(u=>u.startsWith(b))&&location.href.startsWith(b)})()", base, PORTAL_SDK)
    if !True(BuilderFinish(check)) {
        unused BrowserEvaluate(browser, "JSON.stringify(performance.getEntriesByType('resource').map(e=>e.name))")
        print("requests: %\n", browser.result)
        return Fail("a request left the game's folder")
    }
    // Without the SDK the game keeps its ordinary local guest behaviour.
    if !BrowserEvaluate(browser, "new Promise((resolve,reject)=>{for(const n of ['run.dat','unlocked.dat','controls.dat'])try{Module.FS.unlink('/kryon-apps/wurm/'+n)}catch{}Module.FS.syncfs(false,e=>e?reject(e):resolve(true))})") { return false }
    if !BrowserEvaluate(browser, "sessionStorage.setItem('wurm-no-sdk','1'),true") || !Reload() { return false }
    if !Until("(()=>{try{return Module.FS.stat('/kryon-apps').mode>0}catch{return false}})()") || !True("WurmPortal.sdk===null&&WurmPortal.locale===''&&!WurmPortal.muted") { return Fail("the copy did not open without the SDK") }
    Pause(1500)
    if !Click(400, 286) || !Until(RunIs("[0,3,0,0,0,0]")) { return Fail("one Play click did not start a level without the SDK") }
    still := BrowserNumber(browser, CANVAS_HASH, -1.0)
    Pause(450)
    if BrowserNumber(browser, CANVAS_HASH, -1.0) == still || !True("window.__portal.length===0") { return Fail("the copy did not play without the SDK") }
    if !PortalEditorUI() { unused PortalShot("failure"); return false }
    if !PortalShopUI() { unused ShopShot("failure"); return false }
    if browser.exceptions.count > 0 {
        for i: 0..browser.exceptions.count - 1 { print("page exception: %\n", browser.exceptions[i]) }
        return Fail("the page threw")
    }
    result: Vec(u8)
    BuilderPrint(*result, "{\n  \"passed\": true,\n  \"url\": %,\n  \"frames\": [\"907x510\", \"800x450\", \"450x800\"],\n", JsonQuote(url))
    Append(*result, "  \"behaviors\": [\"nested relative loading\", \"title artwork\", \"settings\", \"native shop and daily chest; no leaderboard button\", \"guest profile and explicit sign-in\", \"sign-in cancel recovery\", \"control choice\", \"level 1\", \"arrow steering\", \"Space pause and resume\", \"guest SDK Data reload\", \"paid Mountains gating and free-level fallback\", \"session-only play after Data errors\", \"account isolation from IDB\", \"signed Alice profile\", \"Continue keeps guest progress\", \"no requests outside the game folder\", \"SDK start, loading, language, gameplay and mute\", \"plays without the SDK\", \"title cover carousel\", \"editor paint/save/retry/orientation/playtest/reload\", \"editor account isolation\", \"local editor reload\"]\n}\n")
    unused WriteEntireFile(JoinPath(OUT, "portal-result.json"), BuilderFinish(result))
    print("Browser local test: the packaged CrazyGames copy loaded below a nested path at 907x510 and 800x450, showed guest and Alice profiles with explicit sign-in, kept account-scoped SDK Data, recovered from profile/Data errors without IDB mixing, played, paused, preserved paid chapter gating, reported to a stand-in SDK, followed its language and mute, and played without it.\n")
    return true
}

#program_export
main :: () -> s32 {
    unused CreateDirectories(OUT)
    session: Browser
    browser = *session
    portal := EnvironmentText("WURM_TEST_PORTAL")
    if portal.count > 0 {
        passed := Portal(portal)
        BrowserClose(browser)
        unused RemoveTree(JoinPath(ResolvePath(OUT), "portal-profile"))
        return ifx passed then 0 else 1
    }
    passed := Play()
    if !passed {
        if BrowserEvaluate(browser, "({context:window.__wurmContext?.state,decoded:window.__wurmDecoded,audio:(window.__wurmSources||[]).map(s=>({playing:s.__playing,duration:s.buffer?.duration,gain:s.__gain?.gain.value})),errors:window.__wurmAudioErrors})") {
            unused WriteEntireFile(JoinPath(OUT, "audio-failure.json"), browser.result)
        }
        unused Shot("failure")
    }
    BrowserClose(browser)
    unused RemoveTree(JoinPath(ResolvePath(OUT), "profile"))
    return ifx passed then 0 else 1
}
