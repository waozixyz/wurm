// Exercises the account build on its own verified private Xvfb display with a
// private profile: title actions, levels, settings and appearance, the
// leaderboard, the skin shop's sign-in and the shared Profile, in portrait
// and landscape. Build build/account-desktop/wurm first.
#import "kryon/private_display"
#import "kryon/test_driver_client"
#import "std/file"
#import "std/file_tree_linux"
#import "std/format"
#import "std/json_scan"
#import "std/timer_linux"
#import "std/text_tools"

OUT :: "build/account-ui-test"

display: *PrivateDisplay;
driver: *TestDriverClient;
window: u64;

Join :: (first: string, second: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", first, second)
    return BuilderFinish(path)
}

Shot :: (name: string, size: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/%-%.png", OUT, name, size)
    return BuilderFinish(path)
}

Fail :: (message: string, size: string) -> bool {
    print("FAIL: account UI %: %\n", size, message)
    return false
}

// Waits until every label shows in the committed tree.
Shows :: (labels: []string, timeout_ms: s64) -> bool {
    deadline := MonotonicMilliseconds() + timeout_ms
    while true {
        unused DriverTree(driver)
        missing := false
        for label: labels {
            found := false
            for i: 0..driver.nodes.count - 1 { if driver.nodes[i].label == label { found = true; break } }
            if !found { missing = true }
        }
        if !missing { return true }
        if MonotonicMilliseconds() >= deadline { return false }
        unused SleepMilliseconds(50)
    }
    return false
}

Show :: (label: string) -> bool {
    one: [1]string = .[label]
    return Shows(one[:], 5000)
}

Press :: (label: string) -> bool {
    return DriverPress(driver, .{label = label, enabled = true})
}

Capture :: (name: string, size: string, image: *DisplayImage) -> bool {
    if !PrivateDisplayOwned(display) || !CaptureWindow(display, window, image) { return false }
    unused SavePNG(image, Shot(name, size))
    return true
}

// A visible, enabled action at its painted-icon place in the title bar.
ActionIcon :: (label: string, x0: float64, y0: float64, x1: float64, y1: float64) -> bool {
    unused DriverTree(driver)
    for i: 0..driver.nodes.count - 1 {
        node := driver.nodes[i]
        if node.label != label || !node.visible || !node.enabled { continue }
        if node.x >= x0 && node.x < x1 && node.y >= y0 && node.y < y1 && node.width >= 40.0 { return true }
    }
    return false
}

Orientation :: (size: string, version: string) -> bool {
    image: DisplayImage
    title: [4]string = .["Shop", "Profile", "Settings", "Choose level"]
    if !Shows(title[:], 20000) { return Fail("title actions are missing", size) }
    unused SleepMilliseconds(1000)
    if !Capture("title", size, *image) { return Fail("cannot capture the title", size) }
    if size == "390x780" {
        if ImageColorCount(*image) <= 1000 { return Fail("title artwork is missing", size) }
        if !ActionIcon("Profile", 214.0, 8.0, 222.0, 16.0) { return Fail("profile icon is missing", size) }
        if !ActionIcon("Shop", 8.0, 8.0, 20.0, 20.0) { return Fail("shop action is missing", size) }
    }
    if !Press("Choose level") || !Show("Level board preview") { return Fail("no level selector", size) }
    maps: s32
    locked := false
    for i: 0..driver.nodes.count - 1 {
        node := driver.nodes[i]
        if node.label == "Level board preview" { maps += 1; if node.width < 120.0 { maps += 100 } }
        if node.label == "Locked" && !node.enabled { locked = true }
    }
    if maps != 1 { return Fail("one wide level board preview", size) }
    if !locked { return Fail("locked levels must be disabled", size) }
    unused SleepMilliseconds(500)
    if !Capture("levels", size, *image) { return false }
    settings: [7]string = .["Appearance", "Local multiplayer", "Controls", "Arrow keys", "W A S D", "Version", version]
    if !Press("Back") || !Press("Settings") || !Shows(settings[:], 5000) { return Fail("settings are incomplete", size) }
    if !Capture("settings", size, *image) { return false }
    appearance: [4]string = .["System", "Light", "Dark", "Accent"]
    if !Press("Appearance") || !Shows(appearance[:], 5000) { return Fail("appearance options are missing", size) }
    if !Press("Dark") || !Press("Back") || !Show("Version") { return Fail("Appearance Back must return to Settings", size) }
    if !Press("Back") || !Press("Leaderboard") || !Show("Leaderboard") { return Fail("no leaderboard", size) }
    if !Press("Back") || !Show("Choose level") { return Fail("title leaderboard Back must return to title", size) }
    if !Press("Leaderboard") || !Show("Leaderboard") { return Fail("a second leaderboard open must keep drawing the board", size) }
    shop: [4]string = .["Skins", "Coins", "Dew", "Mint"]
    if !Press("Back") || !Press("Shop") || !Shows(shop[:], 5000) { return Fail("no skin catalog", size) }
    if !Capture("shop", size, *image) { return false }
    if !DriverPress(driver, .{label = "Buy", index = 0, enabled = true}) || !Show("Sign in") {
        return Fail("a purchase must ask for confirmation and sign-in", size)
    }
    profile: [3]string = .["Profile", "Import key", "Link from another device"]
    if !Press("Sign in") || !Shows(profile[:], 5000) { return Fail("shop sign-in must open shared Profile", size) }
    if !Press("Back") || !Show("Sign in") { return Fail("Profile Back must return to the confirmation", size) }
    if !Press("Cancel") || !Press("Back") || !Press("Profile") || !Show("Profile") { return Fail("no Profile from the title", size) }
    account := false
    for i: 0..driver.nodes.count - 1 { if TextContains(TextLower(driver.nodes[i].label), "account") { account = true } }
    if !account { return Fail("Profile does not mention the account", size) }
    return Capture("profile", size, *image)
}

#program_export
main :: () -> s32 {
    unused CreateDirectories(OUT)
    fixture := Join(ResolvePath(OUT), "fixture")
    unused RemoveTree(fixture)
    if !CreateDirectories(Join(fixture, "levels")) { return 1 }
    version_text, has_version := ReadEntireFile("version.json")
    version := ReadString(version_text, FieldAt(version_text, 0, "version"))
    if !has_version || !version.valid { print("FAIL: version.json has no version\n"); return 1 }
    private := OpenPrivateDisplay(1280, 960, Join(OUT, "xvfb.log"))
    if !private.valid { print("FAIL: %\n", private.error); return 1 }
    display = *private
    client := DriverOpen(Join(fixture, "driver"))
    driver = *client
    sizes: [2]string = .["390x780", "844x390"]
    passed := true
    for size: sizes {
        extra: Vec(string)
        fixed: [4]string = .["SDL_RENDER_DRIVER=software", "SDL_AUDIODRIVER=dummy", "LP_NUM_THREADS=1", "LANG=en_US.UTF-8"]
        for fixed { VecPush(extra, it) }
        // Saves, the profile and opened websites stay in this fixture.
        names: [3]string = .["WURM_LEVEL_DIR", "WURM_PROFILE_DIR", "KRYON_TEST_OPEN_URI_CAPTURE"]
        places: [3]string = .["levels", "profile", "website.txt"]
        for index: 0..2 {
            entry: Vec(u8)
            BuilderPrint(*entry, "%=%", names[index], Join(fixture, places[index]))
            VecPush(extra, BuilderFinish(entry))
        }
        window_size: Vec(u8)
        BuilderPrint(*window_size, "WURM_WINDOW=%", size)
        VecPush(extra, BuilderFinish(window_size))
        VecPush(extra, DriverEnvironment(driver))
        arguments: [1]string = .[Join(ResolvePath("build"), "account-desktop/wurm")]
        view: []string = VecSlice(extra, 0, extra.count)
        log := Join(OUT, "app.log")
        app := StartOnDisplay(display, arguments[:], view, "", log)
        if !app.started { print("FAIL: cannot start the account build\n"); passed = false; break }
        DriverWatch(driver, app.pid, log)
        window = FindOwnedWindow(display, app.pid, 15000)
        ok := window != 0 && Orientation(size, version_text[version.start:version.end])
        // Stop only the game this fixture owns.
        unused StopOwnedProcess(*app, 5000)
        if !ok { passed = false; break }
    }
    ClosePrivateDisplay(display)
    if !passed { return 1 }
    result: Vec(u8)
    BuilderPrint(*result, "{\n  \"passed\": true,\n  \"private_display\": \"%\",\n", private.name)
    Append(*result, "  \"behaviors\": [\"title-only account/shop/settings actions\", \"shared appearance options and version\", ")
    Append(*result, "\"title leaderboard Back returns to title twice\", \"skin catalog\", \"explicit purchase confirmation\", ")
    Append(*result, "\"sign-in instead of guest debit\", \"shared Profile in both orientations\"]\n}\n")
    unused WriteEntireFile(Join(OUT, "result.json"), BuilderFinish(result))
    print("Account UI local tests passed in portrait and landscape on private Xvfb.\n")
    return 0
}
