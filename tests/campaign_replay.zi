// campaign-cases:end
libc :: #system_library "libc";
ParseNumber :: (text: *u8) -> s32 #foreign libc "atoi";
File :: #import "std/file_linux";
#import "std/number_text"
#import "std/text_buffer"

route_name: [96]u8;
AppendName :: (at: s32, text: string) -> s32 {
    for i: 0..text.count - 1 { route_name[at + i] = text[i] }
    return at + cast(s32)text.count
}
CyclePath :: (level: s32, variant: s32 = 0, portrait: bool = false) -> string {
    digits: [20]u8
    at := AppendName(0, "build/designed/cycle")
    at = AppendName(at, FormatInteger(cast(s64)(level + 1), digits[:]))
    if variant > 0 {
        at = AppendName(at, "-")
        at = AppendName(at, FormatInteger(cast(s64)variant, digits[:]))
    }
    if portrait && HasPortraitDesign(level) { at = AppendName(at,"-portrait") }
    at = AppendName(at, ".dat")
    route_name[at] = 0
    return TextUntilNul(route_name[:])
}
U16 :: (bytes: []u8, at: s32) -> s32 {
    return cast(s32)bytes[at] | (cast(s32)bytes[at + 1] << 8)
}
ReadCycle :: (level: s32, route: []Point, variant: s32 = 0, portrait: bool = false) -> s32 {
    file := File.OpenRead(CyclePath(level, variant, portrait))
    if !file.valid { return 0 }
    bytes: [2402]u8
    count := File.ReadAt(file, bytes[:], 0)
    File.CloseFile(file)
    if count < 2 { return 0 }
    size := U16(bytes[:], 0)
    if size < 320 || size > 1200 || count != size * 2 + 2 { return 0 }
    for i: 0..size - 1 {
        cell := U16(bytes[:], 2 + cast(s32)i * 2)
        if cell >= 1200 { return 0 }
        columns: s32 = ifx portrait && HasPortraitDesign(level) then 30 else 40
        route[i] = Point.{cell % columns,cell / columns}
    }
    return size
}
DirectionKey :: (a: Point, b: Point) -> s32 {
    if b.x > a.x { return 262 }
    if b.x < a.x { return 263 }
    if b.y > a.y { return 264 }
    return 265
}
SafeTick :: (game: *Game) -> bool {
    Tick(game)
    return game.death_ticks == 0 && game.lives > 0 && game.mode != MODE_DIED
}
route_indices: [1200]s32;
RouteGap :: (from: s32, to: s32, count: s32) -> s32 {
    return (to - from + count) % count
}
SafeCell :: (game: *Game, direction: s32) -> bool {
    trial := game.*
    trial.next_direction = direction
    for tick: 0..3 {
        Tick(*trial)
        if trial.death_ticks > 0 || trial.mode == MODE_DIED { return false }
    }
    return true
}
Detour :: (game: *Game, route: []Point, at: s32) -> s32 {
    distances: [1200]s32
    queue: [1200]Point
    for i: 0..1199 { distances[i] = -1 }
    target := ifx game.apples > 0 then Point.{game.apple.x / 16, game.apple.y / 16} else Point.{board_columns / 2, 1}
    distances[Index(target.x, target.y)] = 0
    queue[0] = target
    head: s32 = 0
    tail: s32 = 1
    while head < tail {
        p := queue[head]; head += 1
        for d: 0..3 {
            q := p
            if d == 0 { q.x -= 1 } else if d == 1 { q.y -= 1 } else if d == 2 { q.x += 1 } else { q.y += 1 }
            if !Inside(q.x,q.y) || distances[Index(q.x,q.y)] >= 0 { continue }
            pixel := Point.{q.x * 16 + 8,q.y * 16 + 8}
            if WallAt(game,pixel) || WormNear(game,pixel,8,10) { continue }
            distances[Index(q.x,q.y)] = distances[Index(p.x,p.y)] + 1
            queue[tail] = q; tail += 1
        }
    }
    best: s32 = -1
    score: s32 = -1000000
    p := route[at]
    for d: 0..3 {
        if d == (game.direction + 2) % 4 || !SafeCell(game,cast(s32)d) { continue }
        q := p
        if d == 0 { q.x -= 1 } else if d == 1 { q.y -= 1 } else if d == 2 { q.x += 1 } else { q.y += 1 }
        if !Inside(q.x,q.y) { continue }
        index := route_indices[Index(q.x,q.y)]
        if index < 0 { continue }
        distance := distances[Index(q.x,q.y)]
        value := ifx distance >= 0 then 10000 - distance else -Abs(q.x-target.x)-Abs(q.y-target.y)
        value -= visits[Index(q.x,q.y)] * 8
        if best < 0 || value > score { best = index; score = value }
    }
    return best
}
visits: [1200]s32;

ChooseNext :: (game: *Game, route: []Point, at: s32) -> s32 {
    count := cast(s32)route.count
    tail := game.worm[game.length - 1]
    tail_at: s32 = -1
    if Inside(tail.x / 16, tail.y / 16) { tail_at = route_indices[Index(tail.x / 16, tail.y / 16)] }
    free := ifx tail_at < 0 then count else RouteGap(at, tail_at, count)
    if free == 0 { free = count }
    growth := ((game.target_length + game.apples * 4) * 16 - game.length + 3) / 4 + 3
    if growth < 3 { growth = 3 }
    apple_at: s32 = route_indices[Index(board_columns / 2, 1)]
    if game.apples > 0 { apple_at = route_indices[Index(game.apple.x / 16, game.apple.y / 16)] }
    target := ifx apple_at < 0 then count - 1 else RouteGap(at, apple_at, count)
    here := route[at]
    best: s32 = -1
    score: s32 = -1000000
    for direction: 0..3 {
        if direction == (game.direction + 2) % 4 { continue }
        next := here
        if direction == DIR_LEFT { next.x -= 1 }
        else if direction == DIR_UP { next.y -= 1 }
        else if direction == DIR_RIGHT { next.x += 1 }
        else { next.y += 1 }
        if !Inside(next.x, next.y) { continue }
        index := route_indices[Index(next.x, next.y)]
        if index < 0 { continue }
        gap := RouteGap(at, index, count)
        if gap < 1 || gap >= free - growth { continue }
        if gap > target && gap != 1 { continue }
        if !SafeCell(game, cast(s32)direction) { continue }
        value := gap
        // Keep a wide berth around moving hazards when a similarly useful
        // route exists. All moves still use the unchanged engine collisions.
        point := Point.{next.x * 16 + 8, next.y * 16 + 8}
        for enemy: 0..game.monster_count - 1 {
            distance := Abs(point.x - game.monsters[enemy].position.x) + Abs(point.y - game.monsters[enemy].position.y)
            if distance < 40 { value -= (40 - distance) * 6 }
        }
        if best < 0 || value > score { best = index; score = value }
    }
    // If a patrol blocks the ordered loop, use an exact-collision-tested
    // detour. Flood distances avoid the current body rather than assuming
    // that a two-wide corridor is still free.
    if best < 0 { best = Detour(game, route, at) }
    return best
}

replay_reason: s32;
replay_apples: s32;
Replay :: (level: s32, portrait: bool, seed: u32, route: []Point) -> bool {
    replay_reason = 0
    canonical: [CELLS]u8
    board: [CELLS]u8
    objects: [CELLS]u8
    for y: 0..29 {
        for x: 0..39 { canonical[y * 40 + x] = BaseTile(level, cast(s32)x, cast(s32)y) }
    }
    columns: s32 = ifx portrait then 30 else 40
    rows: s32 = ifx portrait then 40 else 30
    if portrait { PortraitBoard(level,canonical[:],board[:]) }
    else { board = canonical }
    apples := BaseApples(level)
    if level < 40 {
        Custom.EffectiveBoard(level, board[:], portrait)
        Custom.EffectiveObjects(level, objects[:], portrait)
        apples = Custom.EffectiveApples(level, portrait)
    }
    for i: 0..1199 { route_indices[i] = -1; visits[i] = 0 }
    BoardSize(columns, rows)
    for i: 0..route.count - 1 { route_indices[Index(route[i].x, route[i].y)] = cast(s32)i }
    game: Game
    StartGameData(*game, level, 0, seed, board[:], apples, columns, rows, objects[:])
    if level < 40 { game.monster_count = 0 }
    // Enter naturally from outside the bottom gate; no teleports or skips.
    while game.worm[0].y > (rows - 2) * 16 + 8 {
        if !SafeTick(*game) { return false }
    }
    cycle_at: s32 = -1
    for i: 0..route.count - 1 {
        if route[i].x == columns / 2 && route[i].y == rows - 2 { cycle_at = cast(s32)i }
    }
    if cycle_at < 0 { return false }
    edge: s32 = 0
    budget := cast(s32)route.count * (apples * 4 + 8)
    while edge < budget {
        here := route[cycle_at]
        visits[Index(here.x,here.y)] += 1
        if game.apples == 0 && here.x == columns / 2 && here.y == 1 {
            if !ApplyInput(*game, 265) { return false }
            while game.transition_ticks == 0 {
                if !SafeTick(*game) { return false }
            }
            for tick: 0..49 { Tick(*game) }
            replay_deaths = 3 - game.lives
            return game.lives > 0 && game.apples == 0 &&
            (game.mode == MODE_FINISHED || game.mode == MODE_VICTORY)
        }
        next_at := ChooseNext(*game, route, cycle_at)
        if next_at < 0 { replay_reason = 1; replay_apples = game.apples; return false }
        next := route[next_at]
        if !ApplyInput(*game, DirectionKey(here, next)) { replay_reason = 2; return false }
        hit := false
        for step: 0..3 {
            Tick(*game)
            if game.death_ticks > 0 { hit = true; break }
        }
        if hit {
            while game.death_ticks > 0 && game.mode == MODE_PLAYING { Tick(*game) }
            if game.mode != MODE_PLAYING { replay_reason = 3; return false }
            while game.worm[0].y > (rows - 2) * 16 + 8 {
                if !SafeTick(*game) { return false }
            }
            for i: 0..route.count - 1 {
                if route[i].x == columns / 2 && route[i].y == rows - 2 { cycle_at = cast(s32)i }
            }
            edge += 1
            continue
        }
        if game.worm[0].x != next.x * 16 + 8 || game.worm[0].y != next.y * 16 + 8 { replay_reason = 4; return false }
        if game.apple.x >= 0 && (game.apple.x < 16 || game.apple.y < 16 ||
            game.apple.x >= (columns - 1) * 16 || game.apple.y >= (rows - 1) * 16) { return false }
        cycle_at = next_at
        edge += 1
    }
    replay_reason = 5
    replay_apples = game.apples
    return false
}

replay_deaths: s32;
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    // The certificate proves every board can be won without its puzzle idea
    // (portals, gates and switches); the animals stay active.
    features_enabled = false
    if !Custom.CustomSetRoot("build/campaign-replay/private-levels/") { return 1 }
    search := argc > 1
    first: s32 = ifx argc > 2 then ParseNumber(argv[2]) - 1 else 40
    last: s32 = ifx argc > 3 then ParseNumber(argv[3]) - 1 else LEVEL_COUNT - 1
    canonical: [1200]Point
    route: [1200]Point
    wins: s32 = 0
    deaths: s32 = 0
    for level: first..last {
        count := ReadCycle(cast(s32)level, canonical[:])
        if count == 0 { print("Invalid cycle for level %\n", level + 1); return 1 }
        for orientation: 0..1 {
            if orientation == 1 && HasPortraitDesign(cast(s32)level) { count = ReadCycle(cast(s32)level,canonical[:],0,true) }
            attempts: s32 = ifx search then 16384 else 1
            won := false
            reasons: [6]s32
            for attempt: 0..attempts - 1 {
                variant := ifx search then cast(s32)(attempt / 128) else CampaignRoutes[level * 2 + orientation]
                reverse := ifx search then cast(s32)(attempt / 64) % 2 else CampaignReverse[level * 2 + orientation]
                if attempt % 128 == 0 {
                    if ReadCycle(cast(s32)level, canonical[:], variant,orientation == 1) != count { return 1 }
                }
                for i: 0..count - 1 {
                    point := canonical[ifx reverse == 0 then i else count - 1 - i]
                    route[i] = ifx orientation == 0 || HasPortraitDesign(cast(s32)level) then point else Point.{29 - point.y, point.x}
                }
                seed := CampaignSeeds[level * 2 + orientation]
                if search { seed = cast(u32)(1 + attempt * 7919 + level * 65537) }
                if Replay(cast(s32)level, orientation == 1, seed, route[0:count]) && replay_deaths == 0 {
                    print("WIN level % portrait % seed % deaths % reverse % route %\n", level + 1, orientation, seed, replay_deaths, reverse, variant)
                    wins += 1
                    deaths += replay_deaths
                    won = true
                    break
                }
                reasons[replay_reason] += 1
            }
            if !won {
                print("Replay failed: level %, portrait %, % attempts; reasons % % % % % % apples %\n", level + 1, orientation, attempts, reasons[0], reasons[1], reasons[2], reasons[3], reasons[4], reasons[5], replay_apples)
                return 2
            }
        }
    }
    print("Campaign engine local test: % complete wins with active enemies; % lives used.\n", wins, deaths)
    return 0
}
