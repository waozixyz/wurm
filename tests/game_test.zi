#import, file "../src/game.zi";

failures: s32;
Expect :: (value: bool, message: string) {
    if !value { print("FAIL: %\n", message); failures += 1 }
}

#program_export
main :: () -> s32 {
    game: Game
    Expect(LEVEL_COUNT == 200 && STAGE_COUNT == 5, "complete five-landscape campaign")
    for level: 0..LEVEL_COUNT - 1 {
        StartGame(*game, cast(s32)level, 0)
        Expect(game.apples > 0 && game.apples <= 12, "original apple goal")
        Expect(game.worm[0].x == 328 && game.worm[0].y == 496, "original bottom entry")
        Expect(game.board[Index(20, 29)] == (game.board[Index(20, 28)] & 127), "original entry background")
        Expect(game.apple.x >= 0 && game.apple.y >= 0 && TileAt(*game, game.apple) < 20, "apple in permitted terrain")
        Expect(game.monster_count <= MONSTER_LIMIT, "monsters fit original limit")
    }
    Expect(TickInterval(0) == 48 && TickInterval(10) == 41 && TickInterval(39) == 38 && TickInterval(40) == 28, "Meadow gives beginners more time while later stages retain their gentler pace")
    Expect(BaseTickInterval(0) == 32 && BaseTickInterval(10) == 27 && BaseTickInterval(40) == 25, "movement slowdown preserves the scoring difficulty curve")
    StartGame(*game, 0, 100)
    Expect(game.apples == 5 && game.monster_count == 0, "gentle first level with five apples and no moving hazards")
    Expect(!Step(*game, 147), "no movement before the gentler first tick")
    Expect(Step(*game, 148) && game.worm[0].y == 492, "four pixels per movement tick")
    Expect(!ApplyInput(*game, 262), "no steering before spawn is established")
    for tick: 0..29 { Tick(*game) }
    Expect(game.length == 32 && game.target_length == 2, "original initial growth")
    Expect(game.board[Index(20, 29)] == 20, "entrance closes behind tail")
    Expect(game.worm[4].x == 328 && game.worm[4].y == game.worm[0].y + 16 &&
        game.worm[28].y == game.worm[0].y + 112, "body follows the head")
    unused ApplyInput(*game, 264)
    Expect(game.next_direction == DIR_UP, "no reverse turn")
    unused ApplyInput(*game, 262)
    Expect(game.next_direction == DIR_RIGHT, "right turn")
    old := game.worm[0]
    unused ApplyInput(*game, 32)
    unused Step(*game, 10000)
    Expect(game.mode == MODE_PAUSED && game.worm[0].x == old.x && game.worm[0].y == old.y, "pause stops simulation")
    unused ApplyInput(*game, 256)
    Expect(game.mode == MODE_PLAYING, "escape resumes")
    unused ApplyInput(*game, 256)
    Expect(game.mode == MODE_PAUSED, "escape pauses")
    unused ApplyInput(*game, 113)
    Expect(game.mode == MODE_STAGES, "q leaves a paused game")
    game.mode = MODE_PAUSED

    // Collision bit 7 is meaningful: decorative false walls remain passable.
    game.board[Index(10, 10)] = 20
    Expect(WallAt(*game, Point.{168, 168}), "ordinary wall blocks")
    game.board[Index(10, 10)] = 148
    Expect(!WallAt(*game, Point.{168, 168}), "flagged wall passes")
    game.board[Index(10, 10)] = 128
    Expect(TileAt(*game, Point.{168, 168}) >= 20, "apples exclude flagged terrain")

    StartGame(*game, 0, 0)
    game.length = 16
    for i: 0..15 { game.worm[i] = Point.{328, 200 + cast(s32)i * 4} }
    game.apple = Point.{328, 196}
    game.apples = 1
    Tick(*game)
    Expect(game.apples == 0 && game.score == 1, "last apple scores one")
    Expect(game.apple.x == -1 && game.target_length == 6, "apple gone and target grows by four")
    Expect(game.board[Index(20, 0)] == 0 && game.board[Index(19, 0)] >= 20 && game.board[Index(21, 0)] >= 20, "top exit carves without touching its neighbours")
    game.length = 16
    for i: 0..15 { game.worm[i] = Point.{328, cast(s32)i * 4} }
    Tick(*game)
    Expect(game.transition_ticks == 50 && game.score == 6, "top exit awards five")
    for i: 0..49 { Tick(*game) }
    Expect(game.mode == MODE_FINISHED, "level transition delay")

    for stage: 0..STAGE_COUNT - 2 {
        first := StageFirst(cast(s32)stage + 1)
        Expect(StageOf(first - 1) == stage && StageOf(first) == stage + 1, "landscape boundary")
        Expect(StageNumber(first) == 1 && StageLevels(cast(s32)stage) == 40, "chapter numbering")
        StartGame(*game, first - 1, 0)
        multiplier := game.multiplier
        game.score = 12
        game.apples = 0
        game.worm[0] = Point.{328, 0}
        Tick(*game)
        for i: 0..49 { Tick(*game) }
        Expect(game.mode == MODE_FINISHED, "landscapes connect without ending the run")
        LoadLevel(*game, first, 2000)
        Expect(game.level == first && game.mode == MODE_PLAYING && game.lives == 3 && game.score == 12 + 5 * multiplier,
            "next landscape preserves lives and score")
    }

    StartGame(*game, LEVEL_COUNT - 1, 0)
    game.apples = 0
    game.worm[0] = Point.{328, 0}
    Tick(*game)
    for i: 0..49 { Tick(*game) }
    Expect(game.mode == MODE_VICTORY, "mountain finale completes the campaign")

    StartGame(*game, 0, 0)
    game.score = 32
    AddScore(*game, 1)
    Expect(game.lives == 4, "extra life every 33 points")
    // Points follow each board's difficulty, not its number.
    lowest: s32 = 100
    highest: s32 = 0
    meadow_low: s32 = 100
    meadow_high: s32 = 0
    for level: 0..LEVEL_COUNT - 1 {
        StartGame(*game, cast(s32)level, 0)
        if game.multiplier < lowest { lowest = game.multiplier }
        if game.multiplier > highest { highest = game.multiplier }
        if level < 40 && game.multiplier < meadow_low { meadow_low = game.multiplier }
        if level < 40 && game.multiplier > meadow_high { meadow_high = game.multiplier }
    }
    StartGame(*game, 0, 0)
    Expect(game.multiplier == 1 && lowest == 1 && highest >= 8 && highest <= 9 && meadow_high > meadow_low,
        "harder boards are worth more")
    StartGame(*game, 120, 0)
    multiplier := game.multiplier
    AddScore(*game, 1)
    Expect(game.score == multiplier, "an apple scores the board's multiplier")
    game.score = 33 * multiplier - 1
    lives := game.lives
    AddScore(*game, 1)
    Expect(game.lives == lives + 1, "extra lives keep pace with the multiplier")
    game.death_ticks = 1
    Tick(*game)
    Expect(game.lives == 3 && game.worm[0].y == 496, "death consumes a life and respawns")

    // New ideas open one at a time and come back in a mix.
    for level: 0..IDEA_PORTALS - 1 { Expect(BoardFeature(cast(s32)level) == FEATURE_NONE, "no puzzle idea before level 61") }
    Expect(BoardFeature(IDEA_PORTALS) == FEATURE_PORTALS && BoardFeature(IDEA_PORTALS + 1) == FEATURE_NONE &&
        BoardFeature(IDEA_KEY) == FEATURE_KEY && BoardFeature(IDEA_SWITCH) == FEATURE_SWITCH &&
        BoardFeature(IDEA_PORTAL_ROOM) == FEATURE_PORTAL_ROOM, "each puzzle idea opens on its own board")
    for level: 0..IDEA_SQUIRREL - 1 { Expect(RoamerAnimal(cast(s32)level, 0) == ANIMAL_CLASSIC, "no new animals in the meadow") }
    Expect(RoamerAnimal(IDEA_SQUIRREL, 0) == ANIMAL_SQUIRREL && RoamerAnimal(IDEA_HEDGEHOG, 0) == ANIMAL_HEDGEHOG &&
        RoamerAnimal(IDEA_FROG, 0) == ANIMAL_FROG && PatrolAnimal(IDEA_STONE, 0) == ANIMAL_STONE &&
        PatrolAnimal(IDEA_STONE - 1, 0) == ANIMAL_CLASSIC, "each animal opens in its own landscape")
    placed: [5]s32
    later_animals: [5]s32
    key_level: s32 = -1
    switch_level: s32 = -1
    room_level: s32 = -1
    portal_level: s32 = -1
    reached: [CELLS]bool
    for level: 0..LEVEL_COUNT - 1 {
        StartGame(*game, cast(s32)level, 0)
        placed[game.feature] += 1
        for index: 0..game.monster_count - 1 {
            if level >= IDEA_PORTAL_ROOM { later_animals[game.monsters[index].animal] += 1 }
        }
        start := Index(board_columns / 2, board_rows - 2)
        unused FloodFrom(*game, start, -1, reached[:])
        if game.feature == FEATURE_PORTALS && portal_level < 0 { portal_level = cast(s32)level }
        for pair: 0..game.portal_count - 1 {
            a := game.portals[pair].a
            b := game.portals[pair].b
            Expect(OpenAround(*game, a.x / 16, a.y / 16) && OpenAround(*game, b.x / 16, b.y / 16), "portals stand in open floor")
            Expect(!Near(game.apple, a, 12) && !Near(game.apple, b, 12), "apples never land on a portal")
        }
        if game.feature == FEATURE_KEY || game.feature == FEATURE_SWITCH {
            Expect(game.gate >= 0 && !game.gate_open && game.board[game.gate] == 20, "a gate starts closed")
            spot := ifx game.feature == FEATURE_KEY then game.key else game.switch_stone
            Expect(reached[Index(spot.x / 16, spot.y / 16)], "its key or switch lies on the entrance side")
            if game.feature == FEATURE_KEY && key_level < 0 { key_level = cast(s32)level }
            if game.feature == FEATURE_SWITCH && switch_level < 0 { switch_level = cast(s32)level }
        }
        if game.feature == FEATURE_PORTAL_ROOM {
            a := game.portals[0].a
            b := game.portals[0].b
            Expect(reached[Index(a.x / 16, a.y / 16)] && !reached[Index(b.x / 16, b.y / 16)], "a portal room is reached only through its portal")
            if room_level < 0 { room_level = cast(s32)level }
        }
    }
    print("Ideas placed: portals % keys % switches % rooms %; animals after 180: flames % squirrels % hedgehogs % frogs % stones %\n",
        placed[1], placed[2], placed[3], placed[4], later_animals[0], later_animals[1], later_animals[2], later_animals[3], later_animals[4])
    Expect(placed[FEATURE_PORTALS] >= 20 && placed[FEATURE_KEY] >= 8 && placed[FEATURE_SWITCH] >= 6 && placed[FEATURE_PORTAL_ROOM] >= 7,
        "every puzzle idea comes back in later levels")
    Expect(later_animals[1] > 0 && later_animals[2] > 0 && later_animals[3] > 0 && later_animals[4] > 0, "the last boards mix every animal")
    Expect(key_level >= 0 && switch_level >= 0 && room_level >= 0 && portal_level >= 0, "every puzzle idea is placed somewhere")
    if key_level < 0 || switch_level < 0 || portal_level < 0 { print("Gameplay failures: %\n", failures); return failures }
    // The key opens its gate for good.
    StartGame(*game, key_level, 0)
    game.apples = 3
    game.worm[0] = Point.{game.key.x, game.key.y + 4}
    game.direction = DIR_UP
    game.next_direction = DIR_UP
    Tick(*game)
    Expect(game.key.x < 0 && game.gate_open && game.board[game.gate] == game.gate_tiles[0], "the key opens its gate")
    // A switch stone flips its gate each time the head arrives on it.
    StartGame(*game, switch_level, 0)
    game.apples = 3
    stone := game.switch_stone
    game.worm[0] = Point.{stone.x, stone.y + 8}
    game.direction = DIR_UP
    game.next_direction = DIR_UP
    Tick(*game)
    Expect(game.gate_open, "a switch stone opens its gate")
    Tick(*game)
    Tick(*game)
    Tick(*game)
    Expect(game.gate_open && game.on_switch == false, "it stays open as the head moves on")
    game.worm[0] = Point.{stone.x, stone.y + 8}
    Tick(*game)
    Expect(!game.gate_open && game.board[game.gate] == 20, "arriving again closes it")
    // A head stepping into a ring comes out of its partner.
    StartGame(*game, portal_level, 0)
    portal := game.portals[0]
    game.apples = 3
    game.worm[0] = Point.{portal.a.x, portal.a.y + 4}
    game.direction = DIR_UP
    game.next_direction = DIR_UP
    Tick(*game)
    Expect(game.worm[0].x == portal.b.x && game.worm[0].y == portal.b.y, "the worm comes out of the partner ring")
    Tick(*game)
    Expect(game.worm[0].x == portal.b.x && game.worm[0].y == portal.b.y - 4 && game.death_ticks == 0, "it keeps its course out of the ring")
    // A squirrel sits between dashes; a frog hops two tiles or not at all.
    StartGame(*game, IDEA_SQUIRREL, 0)
    for index: 0..game.monster_count - 1 {
        if game.monsters[index].animal != ANIMAL_SQUIRREL { continue }
        game.monsters[index].timer = 8
        before := game.monsters[index].position
        MoveMonster(*game, cast(s32)index)
        Expect(game.monsters[index].position.x == before.x && game.monsters[index].position.y == before.y, "a squirrel sits between dashes")
    }
    // A hedgehog curls into a still ball as the worm's head comes close.
    StartGame(*game, IDEA_HEDGEHOG, 0)
    curled := false
    for index: 0..game.monster_count - 1 {
        if game.monsters[index].animal != ANIMAL_HEDGEHOG { continue }
        curled = true
        before := game.monsters[index].position
        game.worm[0] = Point.{before.x + 24, before.y}
        for tick: 0..HEDGEHOG_CURL - 2 { MoveMonster(*game, cast(s32)index) }
        Expect(game.monsters[index].timer < 0 && game.monsters[index].position.x == before.x &&
            game.monsters[index].position.y == before.y, "a hedgehog curls up and keeps still")
        game.worm[0] = Point.{-100, -100}
        for tick: 0..3 { MoveMonster(*game, cast(s32)index) }
        Expect(game.monsters[index].timer >= 0, "it uncurls once the worm has gone")
        break
    }
    Expect(curled, "the first hedgehog board has a hedgehog")
    StartGame(*game, IDEA_FROG, 0)
    for index: 0..game.monster_count - 1 {
        if game.monsters[index].animal != ANIMAL_FROG { continue }
        game.monsters[index].timer = 13
        before := game.monsters[index].position
        MoveMonster(*game, cast(s32)index)
        moved := Abs(game.monsters[index].position.x - before.x) + Abs(game.monsters[index].position.y - before.y)
        Expect(moved == 0 || moved == 32, "a frog hops two tiles")
    }
    game.lives = 1
    game.death_ticks = 1
    Tick(*game)
    Expect(game.mode == MODE_DIED && game.lives == 0, "last life ends the game at zero")
    Expect(!Step(*game, 100000) && game.lives == 0, "game over cannot consume another life")
    game.death_ticks = 1
    Tick(*game)
    Expect(game.mode == MODE_DIED && game.lives == 0, "a zero-life death cannot display minus one")

    StartGame(*game, 0, 0)
    for death: 0..2 {
        game.death_ticks = 1
        Tick(*game)
        Expect(game.lives == 2 - cast(s32)death, "each of the three lives is consumed exactly once")
        if death < 2 { Expect(game.mode == MODE_PLAYING, "remaining lives respawn") }
        else { Expect(game.mode == MODE_DIED, "zero lives do not grant an extra turn") }
    }

    StartGame(*game, 0, 0)
    game.monster_count = 1
    game.monsters[0] = Monster.{Point.{168, 168}, 3, 1, 0, 0}
    game.board[Index(10, 10)] = 0
    MoveMonster(*game, 0)
    Expect(game.monsters[0].position.x == 169, "monster moves one pixel")
    game.monsters[0].position = Point.{175, 168}
    game.board[Index(11, 10)] = 20
    MoveMonster(*game, 0)
    Expect(game.monsters[0].direction == 3 && game.monsters[0].kind == 5, "directional monster bounces and turns sprite")

    game.random = 1
    Expect(Random(*game, 32768) == 16838, "original RNG first value")
    Expect(Random(*game, 32768) == 5758, "original RNG second value")
    print("Gameplay failures: %\n", failures)
    return failures
}
