using WidgetKind;

message: AppMessage;
frame: AppUiFrame;
profile_opens: s32;
balance_reads: s32;
failures: s32;
connected: bool = true;
host_account :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
answer: [256]u8;
pointer: PointerFrame;
record_names: [32][65]u8;
record_values: [32][4803]u8;
record_count: s32;
invalid_record_names: s32;

#program_export
ReadAppHost :: () -> AppMessage { return message }
#program_export
WriteAppHost :: (value: AppMessage) { message = value }
#program_export
ReadAppUiHost :: () -> AppUiFrame { return frame }
field_input: TextFieldInput;
// Scripted input reaches the real collection/search field widget.
#program_export
AppFieldInputHost :: () -> TextFieldInput { return field_input }
#program_export
AppKeyHost :: () -> s32 { return frame_key }
#program_export
AppNowHost :: () -> float64 { return 1793232000.0 }
#program_export
PollPointer :: () -> PointerFrame { return pointer }
#program_export
AppSoundHost :: (name: string) -> bool { unused name; return true }
// A touch host: the controls question still comes.
#program_export
AppSupportsHost :: (capability: string) -> bool { unused capability; return false }
#program_export
AppRecordHost :: (name: string) -> string {
    for index: cast(s32)0..record_count - 1 {
        if TextUntilNul(record_names[index][:]) == name { return TextUntilNul(record_values[index][:]) }
    }
    return ""
}
#program_export
SaveAppRecordHost :: (name: string, value: string) -> bool {
    if name.count < 1 || name.count > 64 { invalid_record_names += 1; return false }
    for index: cast(s32)0..record_count - 1 {
        if TextUntilNul(record_names[index][:]) == name { return CopyCString(value, record_values[index][:]) }
    }
    if record_count >= 32 || !CopyCString(name, record_names[record_count][:]) ||
    !CopyCString(value, record_values[record_count][:]) { return false }
    record_count += 1
    return true
}
#program_export
AppServiceHost :: (name: string, request: string) -> string {
    if name == "entity.profile" && request == "open" { profile_opens += 1; return "available" }
    if name == "entity.records" {
        if request == "{\"operation\":\"status\"}" {
            out: Vec(u8)
            BuilderPrint(*out, "{\"status\":\"done\",\"account\":\"%\"}", ifx connected then host_account else "")
            text := BuilderFinish(out)
            for byte, index: text { answer[index] = byte }
            answer[text.count] = 0
            return TextUntilNul(answer[:])
        }
        return "{\"status\":\"missing\"}"
    }
    if name == "entity.dew" {
        if request == "balance" { balance_reads += 1; return "{\"units\":123000000}" }
        return "{\"status\":\"done\",\"owned\":0}"
    }
    return ""
}
Expect :: (ok: bool, reason: string) {
    if !ok { print("FAIL: %\n", reason); failures += 1 }
}
frame_input: FrameInputSnapshot = .{.focused = true};
frame_key: s32;
Draw :: () {
    frame.now += 0.1
    frame_input.available = true
    frame_input.pointer = pointer
    frame_input.sequence += 1
    Expect(FrameInputBegin(frame.session, frame_input), "publish hosted frame input")
    published := frame.session
    defer { FrameInputEnd(published) }
    BeginScrollFrame(frame.session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, 0.0, frame.now)
    Expect(cast(s32)BeginFrame(frame.session, 1, Rectangle.{0.0, 0.0, cast(float32)frame.width, cast(float32)frame.height}) == 0, "start hosted frame")
    message.action = APP_FRAME
    unused Portable.Main()
    Expect(message.succeeded && cast(s32)EndFrame(frame.session) == 0, "hosted frame accepted")
}
Find :: (label: string) -> s32 {
    for index: cast(s32)0..TreeCount(frame.session) - 1 {
        node := TreeNodeAt(frame.session, index)
        if node.kind == WidgetKindButton && node.semantic_label == label { return index }
    }
    return -1
}
Click :: (label: string) {
    index := Find(label)
    Expect(index >= 0, label)
    if index < 0 { return }
    bounds := TreeNodeAt(frame.session, index).bounds
    pointer = PointerFrame.{bounds.x + bounds.width / 2.0, bounds.y + bounds.height / 2.0, true, true, false}
    unused TreePointerUpdate(frame.session, pointer)
    Draw()
    pointer.down = false; pointer.pressed = false; pointer.released = true
    unused TreePointerUpdate(frame.session, pointer)
    Draw()
    pointer.released = false
    unused TreePointerUpdate(frame.session, pointer)
    Draw()
}
// Draw the actual consumer, including applying edits before queued paint flushes.
NameFrame :: (session: Session, field: *App.NameField, input: TextFieldInput, limit: s32 = 60) -> bool {
    field_input = input
    Expect(cast(s32)BeginFrame(session, 1, Rectangle.{0.0, 0.0, 400.0, 150.0}) == 0, "name frame starts")
    committed := App.DrawNameField(session, field, 908, Rectangle.{10.0, 10.0, 160.0, 52.0}, "Collection name", limit)
    Expect(field.state.bytes.count == 0, "name state retains no local or moved buffer view")
    Expect(cast(s32)EndFrame(session) == 0, "name frame paints after edit application")
    return committed
}
name_document: [2048]u8;
name_reply: [2304]u8;
name_saves: s32;
NameService :: (name: string, request: string) -> string {
    unused name
    operation: [16]u8
    unused ReadStringText(request, FieldAt(request, 0, "operation"), operation[:])
    if TextUntilNul(operation[:]) == "put" {
        start := FieldAt(request, 0, "document")
        end := ValueEnd(request, start, 0)
        Expect(start >= 0 && end > start && CopyCString(request[start:end], name_document[:]), "collection save captures document")
        name_saves += 1
        return "{\"status\":\"done\",\"id\":\"00000000000000000000000000000001\"}"
    }
    if TextUntilNul(operation[:]) == "get" {
        out: Vec(u8)
        BuilderPrint(*out, "{\"status\":\"done\",\"id\":\"00000000000000000000000000000001\",\"document\":%}", TextUntilNul(name_document[:]))
        unused CopyCString(BuilderFinish(out), name_reply[:])
        return TextUntilNul(name_reply[:])
    }
    return ""
}
NameFields :: () {
    session := SessionOpen()
    field: App.NameField
    App.NameFieldSet(*field, "Meadow")
    field.focused = true
    Expect(!NameFrame(session, *field, .{.focus = true, .select_all = true}), "selection is not Enter commit")
    Expect(field.cursor != field.anchor && field.focused, "selection and focus survive")
    Expect(!NameFrame(session, *field, .{.text = "Äpfel 🐛"}), "accepted Unicode edit is not Enter commit")
    Expect(TextView(field.bytes[:field.length]) == "Äpfel 🐛" && field.cursor == field.length && field.anchor == field.cursor, "Unicode replaces selected text")
    unused NameFrame(session, *field, .{.left = true, .shift = true})
    unused NameFrame(session, *field, .{.text = "é"})
    Expect(TextView(field.bytes[:field.length]) == "Äpfel é", "shift selection replaces a whole Unicode character")
    malformed: [1]u8 = .[255]
    prior := field
    unused NameFrame(session, *field, .{.text = TextView(malformed[:])})
    Expect(TextView(field.bytes[:field.length]) == "Äpfel é" && field.cursor == prior.cursor && field.anchor == prior.anchor && field.focused == prior.focused && field.scroll_x == prior.scroll_x, "malformed host typing preserves text and interaction state atomically")
    before := field
    unused NameFrame(session, *field, .{.text = "too long"}, field.length)
    Expect(field.length == before.length && field.cursor == before.cursor && field.anchor == before.anchor && TextView(field.bytes[:field.length]) == "Äpfel é", "capacity rejection preserves value and selection")
    Expect(NameFrame(session, *field, .{.commit = true}), "only Enter reports commit")
    unused NameFrame(session, *field, .{.blur = true})
    Expect(!field.focused, "blur updates focus")
    unused NameFrame(session, *field, .{.text = "ignored"})
    Expect(TextView(field.bytes[:field.length]) == "Äpfel é", "unfocused field ignores typing")
    App.NameFieldSet(*field, "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefgh")
    field.focused = true
    unused NameFrame(session, *field, .{.focus = true, .end = true})
    Expect(field.scroll_x > 0, "long name reveals its caret")
    unused NameFrame(session, *field, .{.home = true})
    Expect(field.cursor == 0 && field.anchor == 0 && field.scroll_x == 0, "Home restores cursor and scroll")
    moved := field
    unused NameFrame(session, *moved, .{.text = "é"}, 95)
    Expect(moved.length == field.length + 2 && field.bytes[0] == cast(u8)97 && field.state.bytes.count == 0, "copied name owns its bytes independently")
    // Legacy initialization remains byte-preserving, including a split scalar.
    legacy: [96]u8
    for index: 0..93 { legacy[index] = cast(u8)97 }
    legacy[94] = 195; legacy[95] = 169
    App.NameFieldSet(*field, TextView(legacy[:]))
    Expect(field.length == 95 && field.bytes[94] == cast(u8)195, "legacy byte truncation is preserved")
    unused NameFrame(session, *field, .{.focus = true}, 95)
    Expect(field.length == 95 && field.bytes[94] == cast(u8)195, "invalid legacy text is never silently rewritten")
    Expect(NameFrame(session, *field, .{.commit = true}, 95) && field.length == 95 && field.bytes[94] == cast(u8)195, "Enter without editing preserves raw legacy bytes")
    Expect(field.focused, "invalid legacy name remains focusable")
    unused NameFrame(session, *field, .{.select_all = true}, 95)
    unused NameFrame(session, *field, .{.text = "Repaired é"}, 95)
    Expect(TextView(field.bytes[:field.length]) == "Repaired é", "user can replace an invalid legacy name")
    unused SessionClose(session)

    // The collection screen keeps edits as drafts until Enter, then persists.
    saved_service := Own.own_service
    Own.own_service = NameService
    Own.OwnNew("Original", 1)
    App.EditorCollectionOpened()
    session = SessionOpen()
    field_input = .{}
    unused BeginFrame(session, 1, .{0.0, 0.0, 844.0, 390.0})
    App.DrawEditorMine(session, .{0.0, 0.0, 844.0, 390.0}, 0)
    unused EndFrame(session)
    App.mine_name.focused = true
    field_input = .{.focus = true, .select_all = true, .text = "Renamed é"}
    unused BeginFrame(session, 1, .{0.0, 0.0, 844.0, 390.0})
    App.DrawEditorMine(session, .{0.0, 0.0, 844.0, 390.0}, 0)
    unused EndFrame(session)
    Expect(TextView(App.mine_name.bytes[:App.mine_name.length]) == "Renamed é" && TextUntilNul(Own.own_title[:]) == "Original" && name_saves == 0, "typed collection draft does not save as Enter")
    field_input = .{.commit = true}
    unused BeginFrame(session, 1, .{0.0, 0.0, 844.0, 390.0})
    App.DrawEditorMine(session, .{0.0, 0.0, 844.0, 390.0}, 0)
    unused EndFrame(session)
    Expect(name_saves == 1 && !App.mine_name.focused && TextUntilNul(Own.own_title[:]) == "Renamed é", "Enter commits and saves collection name once")
    Own.OwnRename("temporary")
    Expect(Own.OwnOpen("00000000000000000000000000000001") && TextUntilNul(Own.own_title[:]) == "Renamed é", "collection name reloads from saved draft")
    Own.own_service = saved_service
    field_input = .{}
    unused SessionClose(session)
    print("Name field consumer local tests: % failures\n", failures)
}
// The real Wurm Frame consumes the public snapshot before simulation, while
// the UI key remains available for navigation. No native window is involved.
InputFrames :: () {
    round: *Local.Round = *App.local_round
    App.StartLevel(11, 0, 1)
    App.game.mode = Game.MODE_PLAYING
    App.game.next_step = 10000000
    App.game.direction = Game.DIR_UP
    App.game.length = 8
    frame_input.keys[KeyLeft] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    frame_key = KeyLeft
    Draw()
    Expect(App.game.next_direction == Game.DIR_LEFT, "real frame applies observed turn")
    App.game.next_direction = Game.DIR_RIGHT
    frame_input.keys[KeyLeft] = cast(u8)FrameKeyHeld
    frame_key = 0
    Draw()
    Expect(App.game.next_direction == Game.DIR_RIGHT, "held key does not overwrite a queued turn")
    frame_input.keys[KeyLeft] = cast(u8)(FrameKeyHeld | FrameKeyRepeated)
    frame_key = KeyLeft
    Draw()
    Expect(App.game.next_direction == Game.DIR_LEFT, "real frame keeps host repeat cadence")
    App.game.next_direction = Game.DIR_UP
    frame_input.keys[KeyLeft] = cast(u8)FrameKeyReleased
    Draw()
    Expect(App.game.next_direction == Game.DIR_UP, "release adds no real frame turn")
    frame_input.focused = false
    frame_input.keys[KeyLeft] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    Draw()
    Expect(App.game.next_direction == Game.DIR_UP, "focus loss cancels frame steering")
    frame_input.focused = true
    frame_input.keys[KeyLeft] = cast(u8)FrameKeyHeld
    Draw()
    Expect(App.game.next_direction == Game.DIR_UP, "focus regain does not replay held turn")
    frame_input.keys[KeyLeft] = 0
    frame_input.keys[32] = cast(u8)(FrameKeyHeld | FrameKeyRepeated)
    frame_key = 32
    Draw()
    Expect(App.game.mode == Game.MODE_PLAYING, "repeat does not activate pause shortcut")
    frame_input.keys[32] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    Draw()
    Expect(App.game.mode == Game.MODE_PAUSED, "fresh press pauses through real frame")
    frame_input = .{.focused = true}
    frame_key = 0
    App.game.mode = App.MODE_LOCAL
    Expect(Local.Start(round, 4, 0, 1), "start real frame multiplayer fixture")
    round.next_step = 10000000
    for id: 0..3 {
        round.players[id].alive = true
        round.players[id].direction = Game.DIR_UP
        round.players[id].next_direction = Game.DIR_UP
    }
    frame_input.keys[KeyLeft] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    frame_input.keys[65] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    frame_input.keys[74] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    frame_input.keys[324] = cast(u8)(FrameKeyHeld | FrameKeyPressed)
    frame_key = KeyLeft
    Draw()
    for id: 0..3 { Expect(round.players[id].next_direction == Game.DIR_LEFT, "real frame delivers all four players independently") }
    frame_input = .{.focused = true}
    frame_key = 0
    App.OpenStages()
    Draw()
}

#program_export
main :: () -> s32 {
    NameFields()
    message.abi = MODULE_ABI
    message.locale = "en"
    frame.session = SessionOpen()
    frame.top = 56
    frame.now = 1.0
    for portrait: 0..1 {
        frame.width = ifx portrait == 1 then 390 else 844
        frame.height = ifx portrait == 1 then 844 else 390
        Draw()
        Expect(Find("Play") >= 0 && Find("Shop") >= 0 && Find("Settings") >= 0, "hosted title retains play, shop and settings")
        Expect(Find("Back") < 0 && Find("Profile") < 0 && Find("123") < 0, "host owns title navigation and account controls")
        Expect(balance_reads == 0, "hosted title does not duplicate the host wallet")
        Expect(TextUntilNul(Progress.owner[:]) == host_account, "game uses the enclosing host account")
        message.action = APP_BACK
        unused Portable.Main()
        Expect(!message.succeeded, "title Back is left to the enclosing host")
        Click("Settings")
        Expect(Find("Back") >= 0, "settings retains its in-game Back")
        message.action = APP_BACK
        unused Portable.Main()
        Expect(message.succeeded, "settings Back returns inside the game")
        Draw()
        Click("Shop")
        Expect(Find("Buy") >= 0, "shop remains available inside a host")
        message.action = APP_BACK
        unused Portable.Main()
        Expect(message.succeeded, "shop Back returns inside the game")
        Draw()
    }
    InputFrames()
    for portrait: 0..1 {
        frame.width = ifx portrait == 1 then 390 else 844
        frame.height = ifx portrait == 1 then 844 else 390
        App.game_portrait = portrait == 1
        App.StartLevel(11, 0, 1)
        App.game.lives = 5
        App.game.score = 120
        App.game.mode = Game.MODE_FINISHED
        Draw()
        Expect(App.game.mode == Game.MODE_READY && App.game.level == 12 &&
            App.game.lives == 5 && App.game.score == 120, "hosted next level waits and carries the run")
        Expect(Find("Start level") >= 0, "hosted Start level action is available")
        Expect(TreeModalLayer(frame.session) != 0, "level start owns a modal input layer")
        button := Find("Start level")
        Expect(button >= 0 && TreeNodeAt(frame.session, button).focus_id == 24204,
            "level start has an explicit focus target")
        App.HandleInput(KeyUp, 100000)
        Draw()
        Expect(App.game.mode == Game.MODE_READY, "hosted steering cannot skip the preview")
        Click("Start level")
        Expect(App.game.mode == Game.MODE_PLAYING, "hosted Start level button starts play")
        App.game.mode = Game.MODE_READY
        message.action = APP_BACK
        unused Portable.Main()
        Expect(message.succeeded && App.game.mode == Game.MODE_STAGES, "hosted Back leaves the preview inside the game")
        App.StartLevel(9, 0, 1)
        App.game.mode = Game.MODE_READY
        Draw()
        hint: s32 = -1
        for index: cast(s32)0..TreeCount(frame.session) - 1 {
            if TreeNodeAt(frame.session, index).key == 24205 { hint = index }
        }
        Expect(hint >= 0, "portal preview explains matching rings in either orientation")
        if hint >= 0 {
            hint_bounds := TreeNodeAt(frame.session, hint).bounds
            start := Find("Start level")
            Expect(start >= 0 && hint_bounds.y + hint_bounds.height <= TreeNodeAt(frame.session, start).bounds.y,
                "portal hint stays above the Start action")
        }
        Expect(App.game.portal_count == 1 && App.game.mode == Game.MODE_READY,
            "portal lesson waits for the player to start")
        Click("Start level")
        Expect(App.game.mode == Game.MODE_PLAYING, "portal lesson starts through its modal action")
    }
    Expect(Progress.Begin(57, 6, 123456), "connected hosted run saves within host record limits")
    Progress.Complete(56)
    Progress.loaded = false
    Progress.unlocked = 0
    Progress.level = 0
    Progress.lives = 3
    Progress.score = 0
    Progress.dirty = false
    Progress.Load()
    Expect(Progress.unlocked == 57 && Progress.level == 57 && Progress.lives == 6 && Progress.score == 123456,
        "connected hosted run and unlocked progress survive restart")
    Expect(Progress.Completed(56) && Progress.dirty, "connected hosted completion and sync retry survive restart")
    Expect(invalid_record_names == 0, "every hosted save uses an accepted record name")
    connected = false
    Progress.poll_at = 0
    Draw()
    Click("Shop")
    Click("Buy")
    Expect(Find("Sign in") >= 0, "signed-out shop offers the host sign-in")
    Click("Sign in")
    Expect(profile_opens == 1 && !Account.ProfileVisible(), "profile requests open the enclosing host profile")
    Expect(SessionClose(frame.session), "close hosted test session")
    print("Hosted UI local test failures: %\n", failures)
    return failures
}
