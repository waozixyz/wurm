Audio :: #import, file "../src/audio.zi";
Volume :: #import, file "../src/audio_volume.zi";
File :: #import "std/file_linux";
sdl :: #system_library "SDL2";
CloseDevice :: (device: u32) #foreign sdl "SDL_CloseAudioDevice";
Quit :: () #foreign sdl "SDL_Quit";
Init :: (flags: u32) -> s32 #foreign sdl "SDL_InitSubSystem";
Clear :: (device: u32) #foreign sdl "SDL_ClearQueuedAudio";
Queued :: (device: u32) -> u32 #foreign sdl "SDL_GetQueuedAudioSize";

#program_export
main :: () -> s32 {
    // Run only with SDL_VIDEODRIVER=dummy and SDL_AUDIODRIVER=dummy.
    if Init(32) != 0 { return 1 }
    defer Quit()
    Audio.EnsureAudio()
    if Audio.device == 0 { return 2 }
    defer CloseDevice(Audio.device)
    for index: 0..3 { if Audio.effects[index].count <= 0 { return 3 } }
    for track: 1..1 {
        Audio.ChangeMusic(1)
        if Audio.music_bytes < 44100 { return 4 }
        Audio.PlayEffect(3)
        Clear(Audio.device)
        Audio.PumpAudio()
        if Audio.music_position == 0 || Queued(Audio.device) == 0 { return 5 }
    }
    heard := false
    for index: 0..2047 { if Audio.mixed[index] != 0 { heard = true } }
    if !heard { return 6 }
    if Volume.VolumeSample(12000,25) != 3000 || Volume.VolumeSample(-12000,50) != -6000 { return 13 }
    if Volume.VolumeSample(90000,100) != 32767 || Volume.VolumeSample(12000,0) != 0 { return 14 }
    Audio.SetVolume(0)
    Clear(Audio.device)
    Audio.PumpAudio()
    muted_index: s32 = 0
    while muted_index < 2048 {
        if Audio.mixed[muted_index] != 0 { return 15 }
        muted_index += 1
    }
    Audio.SetVolume(100)
    // Force a loop seam in the middle of a block and compare every byte:
    // no zero padding and no skipped or duplicated samples.
    expected: [4096]u8
    start := Audio.music_bytes - 14
    if File.ReadAt(Audio.music_file, expected[0:14], start) != 14 { return 8 }
    if File.ReadAt(Audio.music_file, expected[14:4096], 0) != 4082 { return 9 }
    Audio.music_position = start
    Audio.ReadMusicSamples()
    for at: 0..4095 { if Audio.music_samples[at] != expected[at] { return 10 } }
    if Audio.music_position != 4082 { return 11 }
    Audio.was_playing = true
    Audio.previous_level = 13
    Audio.UpdateAudio(true, 14, 5, 0, 0)
    if Audio.music_position < 4082 { return 12 }
    Audio.ToggleMute()
    if !Audio.muted { return 7 }
    print("Audio local test: four effects, continuous acoustic score, exact loop seam and no chapter rewind.\n")
    return 0
}
