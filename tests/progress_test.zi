Custom :: #import, file "../src/custom_levels.zi";
Controls :: #import, file "../src/controls.zi";
Progress :: #import, file "../src/progress.zi";
File :: #import "std/file_linux";

failures: s32;
Expect :: (value: bool, message: string) {
    if !value { print("FAIL: %\n", message); failures += 1 }
}

#program_export
main :: () -> s32 {
    Expect(Custom.CustomSetRoot("build/progress-test-data/"), "private records")
    unused File.CreateDirectory("build/progress-test-data")
    unused File.RemoveFile("build/progress-test-data/controls.dat")
    unused File.RemoveFile("build/progress-test-data/journey.dat")
    Expect(!Controls.Chosen(), "first play asks for controls")
    Expect(Controls.SetPad(true) && Controls.Pad(), "choose direction pad")
    Controls.mode = -2
    Expect(Controls.Chosen() && Controls.Pad(), "pad survives restart")
    Expect(Controls.SetPad(false) && !Controls.Pad(), "change to swipe")
    Controls.mode = -2
    Expect(Controls.Chosen() && !Controls.Pad(), "swipe survives restart")
    Expect(Progress.LevelUnlocked(0) && !Progress.LevelUnlocked(1), "start with the first level")
    Expect(!Progress.Unlocked(1) && !Progress.Win(40), "cannot skip to a locked stage")
    Expect(!Progress.Win(1), "cannot skip levels")
    for level: 0..199 {
        Expect(Progress.LevelUnlocked(cast(s32)level), "next level unlocks")
        Expect(Progress.Win(cast(s32)level), "win persists")
        Expect(Progress.Cleared(cast(s32)level / 40) == cast(s32)level % 40 + 1, "stage progress")
        if level % 40 == 38 && level < 160 { Expect(!Progress.Unlocked(cast(s32)level / 40 + 1), "stage requires all forty wins") }
        Progress.loaded = false
        Expect(Progress.LevelUnlocked(cast(s32)level), "progress survives restart")
        Expect(Progress.Win(0), "earlier levels remain replayable")
    }
    for stage: 0..4 { Expect(Progress.Unlocked(cast(s32)stage) && Progress.Cleared(cast(s32)stage) == 40, "all five stages complete") }
    invalid: [5]u8 = .[255,40,40,40,40]
    Expect(Controls.WriteRecord("journey.dat", invalid[:]), "write corrupt record fixture")
    Progress.loaded = false
    for stage: 0..4 { Progress.completed[stage] = 0 }
    Expect(Progress.LevelUnlocked(0) && !Progress.Unlocked(1), "invalid progress cannot unlock stages")
    print("Controls and progress local test failures: %\n", failures)
    return failures
}
