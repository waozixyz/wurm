// Profile uses lossless WebP while the game retains PNG. Compare RGBA pixels.
#import, file "../src/account_build.zi";
#program_export
main :: () -> s32 {
    entity := PackagePath("entity")
    arguments: [3]string = .["python3", "tests/skin_art_pixels_test.py", entity]
    output, ok := Step(arguments[:], false, no_extra[:])
    return ifx ok then 0 else 1
}
