#import, file "../src/game.zi";
#import, file "../src/original_levels.zi";
#import, file "../src/designed_levels.zi";
Custom :: #import, file "../src/custom_levels.zi";
File :: #import "std/file_linux";

failures: s32;
Expect :: (value: bool, message: string) {
    if !value { print("FAIL: %\n", message); failures += 1 }
}

#program_export
main :: () -> s32 {
    // A private root keeps the test's overrides out of the repository assets.
    Expect(Custom.CustomSetRoot("build/test-levels/"), "test root accepted")
    Custom.EnsureLoaded()
    unused Custom.ClearCustomLevel(2)
    Expect(!Custom.HasCustomLevel(0), "no override before any save")
    Expect(Custom.EffectiveApples(0) == BaseApples(0), "no override keeps original apples")
    Expect(Custom.EffectiveTile(0, 5, 7) == DesignedTile(0, 5, 7), "no override keeps original tiles")

    board: [CELLS]u8
    for at: 0..CELLS - 1 { board[at] = 0 }
    Expect(LevelBlockages(board[:]) == 0, "open board plays")
    board[Index(20, 27)] = 20
    Expect(LevelBlockages(board[:]) == 1, "solid tile above the entrance blocks the start")
    board[Index(20, 27)] = 0
    board[Index(20, 1)] = 21
    Expect(LevelBlockages(board[:]) == 2, "solid exit floor blocks the exit")
    board[Index(20, 1)] = 0
    board[Index(20, 27)] = 40
    Expect(LevelBlockages(board[:]) == 0, "a monster marker counts as open floor")
    board[Index(20, 27)] = 20
    board[Index(20, 1)] = 128
    Expect(LevelBlockages(board[:]) == 1, "false wall keeps the exit passable")

    for level: 0..98 {
        Custom.EffectiveBoard(cast(s32)level, board[:])
        Expect(LevelBlockages(board[:]) == 0, "recovered originals stay playable")
    }

    // A save round-trips raw tiles, including monster markers and false
    // walls, in the archive's column order.
    Custom.EffectiveBoard(2, board[:])
    board[Index(10, 10)] = 0
    board[Index(11, 10)] = 42
    board[Index(12, 10)] = 130
    objects: [CELLS]u8
    for at: 0..CELLS - 1 { objects[at] = 0 }
    objects[Index(10, 10)] = OBJECT_LOG
    objects[Index(11, 10)] = OBJECT_BUTTERFLY
    Expect(Custom.SaveCustomLevel(2, board[:], objects[:], 7), "override saves")
    Expect(Custom.HasCustomLevel(2), "saved override is present")
    Expect(Custom.EffectiveApples(2) == 7, "override apple count applies")
    Expect(Custom.EffectiveTile(2, 10, 10) == 0, "override floor applies")
    Expect(Custom.EffectiveTile(2, 11, 10) == 42, "monster marker round-trips")
    Expect(Custom.EffectiveTile(2, 12, 10) == 130, "false wall round-trips")
    Expect(Custom.EffectiveTile(2, 0, 0) == DesignedTile(2, 0, 0), "untouched cells keep their tiles")
    file := File.OpenRead("build/test-levels/level3.dat")
    Expect(file.valid, "override file exists")
    if file.valid {
        bytes: [2401]u8
        read := File.ReadAt(file, bytes[:], 0)
        File.CloseFile(file)
        Expect(read == 2401, "override file size")
        Expect(cast(s32)bytes[0] == 7, "apple count leads the file")
        Expect(bytes[1 + 10 * 30 + 10] == 0, "floor in column order")
        Expect(bytes[1 + 11 * 30 + 10] == 42, "marker in column order")
        Expect(bytes[1 + 12 * 30 + 10] == 130, "false wall in column order")
        Expect(bytes[1 + 1200 + 10 * 30 + 10] == OBJECT_LOG, "log object in column order")
        Expect(bytes[1 + 1200 + 11 * 30 + 10] == OBJECT_BUTTERFLY, "butterfly object in column order")
    }
    loaded_objects: [CELLS]u8
    Custom.EffectiveObjects(2, loaded_objects[:])
    Expect(loaded_objects[Index(10, 10)] == OBJECT_LOG, "object override applies")
    Expect(loaded_objects[Index(11, 10)] == OBJECT_BUTTERFLY, "second object applies")

    Expect(Custom.ClearCustomLevel(2), "override clears")
    Expect(!Custom.HasCustomLevel(2), "cleared override is gone")
    Expect(Custom.EffectiveApples(2) == BaseApples(2), "clear restores the original")
    Expect(Custom.EffectiveTile(2, 10, 10) == DesignedTile(2, 10, 10), "clear restores original tiles")

    // The smart hedge brush fits pieces to their open sides: a wall boxed in
    // from east, south and west wears grass only on its north side (51),
    // and a corner between two walls opens two sides (57).
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(6, 5)] = 20
    board[Index(4, 5)] = 20
    board[Index(5, 6)] = 20
    ApplyWallBrush(board[:], 5, 5)
    Expect(board[Index(5, 5)] == 51, "a wall boxed from three sides opens north only")
    board[Index(6, 6)] = 20
    ApplyWallBrush(board[:], 6, 6)
    Expect(board[Index(6, 6)] == 57, "the outer corner of the block opens east and south")
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(5, 6)] = 20
    board[Index(6, 5)] = 20
    ApplyWallBrush(board[:], 6, 6)
    Expect(board[Index(6, 6)] == 57, "a corner between walls opens east and south")
    ApplyFloorBrush(board[:], 5, 6, 0)
    Expect(board[Index(6, 6)] == 20, "three open sides fall back to the plain piece")

    // Turning the level for portrait and back loses nothing.
    turned: [CELLS]u8
    again: [CELLS]u8
    for at: 0..CELLS - 1 { board[at] = cast(u8)(at % 7) }
    TurnForward(board[:], turned[:])
    TurnBack(turned[:], again[:])
    same: bool = true
    for at: 0..CELLS - 1 { if board[at] != again[at] { same = false } }
    Expect(same, "turn round-trip keeps every tile")

    // An edited board drives play through the same loader as the originals.
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(3, 3)] = 45
    game: Game
    for at: 0..CELLS - 1 { objects[at] = 0 }
    objects[Index(5, 5)] = OBJECT_SNAIL
    LoadLevelData(*game, 0, 0, board[:], 2, COLUMNS, ROWS, objects[:])
    Expect(game.objects[Index(5, 5)] == OBJECT_SNAIL, "objects ride into play")
    Expect(game.monster_count == 1 && game.monsters[0].kind == 6, "editor board spawns its monster")
    Expect(game.board[Index(3, 3)] == 0, "marker cell becomes floor")

    print("Editor failures: %\n", failures)
    return failures
}
