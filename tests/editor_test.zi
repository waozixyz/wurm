#import, file "../src/game.zi";
#import, file "../src/original_levels.zi";
#import, file "../src/designed_levels.zi";
Custom :: #import, file "../src/custom_levels.zi";
File :: #import "std/file_linux";
EditorInput :: #import, file "../src/editor_input.zi";
Input :: #import "kryon/input_protocol";
Geometry :: #import "kryon/geometry";

failures: s32;
Expect :: (value: bool, message: string) {
    if !value { print("FAIL: %\n", message); failures += 1 }
}
// A tile of the published layout, which a landscape may mirror from its
// portrait design.
PublishedTile :: (level: s32, x: s32, y: s32, portrait: bool = false) -> u8 {
    board: [CELLS]u8
    Custom.DefaultBoard(level, board[:], portrait)
    return board[Custom.At(x, y, portrait)]
}

#program_export
main :: () -> s32 {
    stroke: EditorInput.StrokeState
    canvas := Geometry.Rectangle.{0.0,0.0,100.0,100.0}
    primary := Input.PointerFrame.{.x=20.0,.y=20.0,.down=true,.pressed=true}
    secondary: Input.SecondaryPointerFrame
    EditorInput.StrokeReset(*stroke)
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 0,"selecting a board does not paint it")
    primary.pressed = false
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 0,"holding the selector press cannot paint")
    primary.down = false
    unused EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas)
    primary.down = true; primary.pressed = true
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 1,"a fresh board click paints")
    primary.pressed = false; primary.x = 40.0
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 1,"a board stroke continues while held")
    primary.down = false
    unused EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas)
    primary.x = 120.0; primary.down = true; primary.pressed = true
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 0,"selecting a palette brush is not a stroke")
    primary.x = 20.0; primary.pressed = false
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 0,"dragging a palette press onto the board does not paint")
    primary.down = false
    unused EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas)
    secondary.down = true; secondary.pressed = true
    Expect(EditorInput.StrokeUpdate(*stroke,primary,secondary,canvas) == 2,"a fresh secondary click restores a tile")
    game: Game
    // A private root keeps the test's overrides out of the repository assets.
    Expect(Custom.CustomSetRoot("build/test-levels/"), "test root accepted")
    Custom.EnsureLoaded()
    unused Custom.ClearCustomLevel(2)
    Expect(!Custom.HasCustomLevel(0), "no override before any save")
    Expect(Custom.EffectiveApples(0) == BaseApples(0), "no override keeps original apples")
    Expect(Custom.EffectiveTile(0, 5, 7) == PublishedTile(0, 5, 7), "no override keeps the published tiles")

    board: [CELLS]u8
    for at: 0..CELLS - 1 { board[at] = 0 }
    Expect(LevelBlockages(board[:]) == 0, "open board plays")
    board[Index(20, 27)] = 20
    Expect(LevelBlockages(board[:]) == 1, "solid tile above the entrance blocks the start")
    board[Index(20, 27)] = 0
    board[Index(20, 1)] = 21
    Expect(LevelBlockages(board[:]) == 2, "solid exit floor blocks the exit")
    board[Index(20, 1)] = 0
    board[Index(20, 27)] = 40
    Expect(LevelBlockages(board[:]) == 0, "a monster marker counts as open floor")
    board[Index(20, 27)] = 20
    board[Index(20, 1)] = 128
    Expect(LevelBlockages(board[:]) == 1, "false wall keeps the exit passable")

    for level: 0..LEVEL_COUNT - 1 {
        Custom.EffectiveBoard(cast(s32)level, board[:])
        Expect(LevelBlockages(board[:]) == 0, "recovered originals stay playable")
    }

    // A save round-trips raw tiles, including monster markers and false
    // walls, in the archive's column order.
    Custom.EffectiveBoard(2, board[:])
    board[Index(10, 10)] = 0
    board[Index(11, 10)] = 42
    board[Index(12, 10)] = 130
    objects: [CELLS]u8
    for at: 0..CELLS - 1 { objects[at] = 0 }
    objects[Index(10, 10)] = OBJECT_LOG
    objects[Index(11, 10)] = OBJECT_BUTTERFLY
    Expect(Custom.SaveCustomLevel(2, board[:], objects[:], 7), "override saves")
    Expect(Custom.HasCustomLevel(2), "saved override is present")
    Expect(Custom.EffectiveApples(2) == 7, "override apple count applies")
    Expect(Custom.EffectiveTile(2, 10, 10) == 0, "override floor applies")
    Expect(Custom.EffectiveTile(2, 11, 10) == 42, "monster marker round-trips")
    Expect(Custom.EffectiveTile(2, 12, 10) == 130, "false wall round-trips")
    Expect(Custom.EffectiveTile(2, 0, 0) == PublishedTile(2, 0, 0), "untouched cells keep their tiles")
    file := File.OpenRead("build/test-levels/level3.dat")
    Expect(file.valid, "override file exists")
    if file.valid {
        bytes: [2401]u8
        read := File.ReadAt(file, bytes[:], 0)
        File.CloseFile(file)
        Expect(read == 2401, "override file size")
        Expect(cast(s32)bytes[0] == 7, "apple count leads the file")
        Expect(bytes[1 + 10 * 30 + 10] == 0, "floor in column order")
        Expect(bytes[1 + 11 * 30 + 10] == 42, "marker in column order")
        Expect(bytes[1 + 12 * 30 + 10] == 130, "false wall in column order")
        Expect(bytes[1 + 1200 + 10 * 30 + 10] == OBJECT_LOG, "log object in column order")
        Expect(bytes[1 + 1200 + 11 * 30 + 10] == OBJECT_BUTTERFLY, "butterfly object in column order")
    }
    loaded_objects: [CELLS]u8
    Custom.EffectiveObjects(2, loaded_objects[:])
    Expect(loaded_objects[Index(10, 10)] == OBJECT_LOG, "object override applies")
    Expect(loaded_objects[Index(11, 10)] == OBJECT_BUTTERFLY, "second object applies")

    Expect(Custom.ClearCustomLevel(2), "override clears")
    Expect(!Custom.HasCustomLevel(2), "cleared override is gone")
    Expect(Custom.EffectiveApples(2) == BaseApples(2), "clear restores the original")
    Expect(Custom.EffectiveTile(2, 10, 10) == PublishedTile(2, 10, 10), "clear restores the published tiles")

    // The smart hedge brush fits pieces to their open sides: a wall boxed in
    // from east, south and west wears grass only on its north side (51),
    // and a corner between two walls opens two sides (57).
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(6, 5)] = 20
    board[Index(4, 5)] = 20
    board[Index(5, 6)] = 20
    ApplyWallBrush(board[:], 5, 5)
    Expect(board[Index(5, 5)] == 51, "a wall boxed from three sides opens north only")
    board[Index(6, 6)] = 20
    ApplyWallBrush(board[:], 6, 6)
    Expect(board[Index(6, 6)] == 57, "the outer corner of the block opens east and south")
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(5, 6)] = 20
    board[Index(6, 5)] = 20
    ApplyWallBrush(board[:], 6, 6)
    Expect(board[Index(6, 6)] == 57, "a corner between walls opens east and south")
    ApplyFloorBrush(board[:], 5, 6, 0)
    Expect(board[Index(6, 6)] == 20, "three open sides fall back to the plain piece")

    // Turning the level for portrait and back loses nothing.
    turned: [CELLS]u8
    again: [CELLS]u8
    for at: 0..CELLS - 1 { board[at] = cast(u8)(at % 7) }
    TurnForward(board[:], turned[:])
    TurnBack(turned[:], again[:])
    same: bool = true
    for at: 0..CELLS - 1 { if board[at] != again[at] { same = false } }
    Expect(same, "turn round-trip keeps every tile")

    // Portrait is independently saved in 30x40 column order. Its lower
    // rows must not index the landscape's 40x30 buffer.
    unused Custom.ClearCustomLevel(1,true)
    Custom.EffectiveBoard(1,turned[:],true)
    BoardSize(30,40)
    Expect(LevelBlockages(turned[:]) == 0,"portrait level 2 has clear gates")
    for at: 0..CELLS - 1 { objects[at] = 0 }
    StartGameData(*game,1,0,1,turned[:],5,30,40,objects[:])
    for tick: 0..63 { Tick(*game) }
    Expect(game.death_ticks == 0 && game.lives == 3,"portrait level 2 allows a two-second straight approach")
    turned[Custom.At(7,35,true)] = 21
    objects[Custom.At(8,36,true)] = OBJECT_SNAIL
    published_before := PublishedTile(1,7,10)
    Expect(Custom.SaveCustomLevel(1,turned[:],objects[:],9,true),"independent portrait save")
    // Without a personal landscape, the landscape mirrors the personal
    // portrait and its goal; the published one stays as it was.
    Expect(Custom.EffectiveApples(1,true) == 9 && Custom.EffectiveApples(1) == 9 && Custom.LayoutSource(1) == Custom.LAYOUT_MIRRORED,
        "the landscape mirrors the personal portrait's apple goal")
    Custom.custom_loaded = false
    Custom.EnsureLoaded()
    Expect(Custom.EffectiveTile(1,7,35,true) == 21,"portrait lower rows survive a restart")
    Custom.EffectiveObjects(1,loaded_objects[:],true)
    Expect(loaded_objects[Custom.At(8,36,true)] == OBJECT_SNAIL,"portrait objects survive a restart")
    Expect(PublishedTile(1,7,10) == published_before,"portrait edits leave the published landscape alone")
    Expect(Custom.ClearCustomLevel(1,true),"reset only portrait")
    Expect(!Custom.HasCustomLevel(1,true),"portrait reset uses the generated layout again")

    // A straight rotation can put a wall at the fixed portrait entrance.
    // The best guess joins that entrance and exit to the interior floor.
    BoardSize(40,30)
    for at: 0..CELLS - 1 { board[at] = 0 }
    for y: 0..29 { board[y * 40 + 37] = 20 }
    TurnForward(board[:],turned[:])
    BoardSize(30,40)
    Expect((LevelBlockages(turned[:]) & 1) != 0,"regression fixture blocks a naive rotated entrance")
    GuessPortrait(board[:],turned[:])
    Expect(LevelBlockages(turned[:]) == 0,"best guess repairs fixed portrait gates")
    StartGameData(*game,1,0,1,turned[:],5,30,40,objects[:])
    for tick: 0..31 { Tick(*game) }
    Expect(game.death_ticks == 0 && game.lives == 3,"converted entrance survives normal spawn ticks")
    BoardSize(40,30)

    // An edited board drives play through the same loader as the originals.
    for at: 0..CELLS - 1 { board[at] = 0 }
    board[Index(3, 3)] = 45
    for at: 0..CELLS - 1 { objects[at] = 0 }
    objects[Index(5, 5)] = OBJECT_SNAIL
    LoadLevelData(*game, 0, 0, board[:], 2, COLUMNS, ROWS, objects[:])
    Expect(game.objects[Index(5, 5)] == OBJECT_SNAIL, "objects ride into play")
    Expect(game.monster_count == 1 && game.monsters[0].kind == 6, "editor board spawns its monster")
    Expect(game.board[Index(3, 3)] == 0, "marker cell becomes floor")

    print("Editor failures: %\n", failures)
    return failures
}
