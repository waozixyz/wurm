// Renders each level's board to a small preview picture for the level
// selectors: the published layout in both orientations, loaded as the
// game loads it (mirrors included), lit by the same terrain shaders as the
// game, 200x150 and 150x200, stored as 96-colour palette pictures to keep
// downloads small. Rerun after changing level data, mirroring, terrain
// shaders or material art. With --check the committed previews must match
// regeneration within the palette's error, which also absorbs floating
// point rounding on another machine.
//
//     LDLIBS=-lz ziran run --target=c tools/render_previews.zi -- [--check]
#import "std/file"
#import "std/format"
#import "std/byte_text_linux"
#import "std/image"
#import "std/png_linux"
Custom :: #import, file "../src/custom_levels.zi";
Terrain :: #import, file "../src/terrain.zi";

// Pixels per cell the shaders paint before the preview halves them.
PAINT :: 10
COLOURS :: 96
// Largest per-channel and average differences --check accepts between the
// committed palette picture and the palette regeneration.
WORST :: 48
AVERAGE :: 1.0

renderer: Terrain.TerrainRenderer;

Art :: (name: string) -> Image {
    path: Vec(u8)
    BuilderPrint(*path, "assets/art/%.png", name)
    return ReadPNGFile(BuilderFinish(path))
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    check := argc > 1 && TextFromCString(argv[1]) == "--check"
    stages: [5]string = .["meadow", "leafwood", "pinewood", "lake", "mountains"]
    changed: s32
    for stage: 0..4 {
        sheet := Art("sprites")
        if !ImageValid(*sheet) { print("tools/render_previews: art is missing\n"); return 1 }
        // Creatures keep their sheet art, shrunk to one painted cell.
        creatures := ResizeLanczos(*sheet, sheet.width * PAINT / 32, sheet.height * PAINT / 32)
        for number: 1..40 {
            level := cast(s64)stage * 40 + number
            for orientation: 0..1 {
                portrait := orientation == 1
                columns: s32 = ifx portrait then 30 else 40
                rows: s32 = ifx portrait then 40 else 30
                // Rows of columns cells, the published layout only.
                board: [1200]u8
                Custom.DefaultBoard(cast(s32)level - 1, board[:], portrait)
                if !Terrain.TerrainUpdate(*renderer, board[:], columns, rows, cast(s32)stage, PAINT, false) && !renderer.ready {
                    print("tools/render_previews: the terrain shaders failed\n")
                    return 1
                }
                painted := CopyImage(*renderer.image)
                for y: 0..rows - 1 {
                    for x: 0..columns - 1 {
                        tile := cast(s32)(board[y * columns + x] & 127)
                        if tile >= 40 && tile <= 45 {
                            column: s32 = ifx tile == 40 then 6 else tile - 40
                            AlphaComposite(*painted, *creatures, cast(s32)x * PAINT, cast(s32)y * PAINT, column * PAINT, 2 * PAINT, PAINT, PAINT)
                        }
                    }
                }
                preview := ResizeBox(*painted, columns * 5, rows * 5)
                path: Vec(u8)
                BuilderPrint(*path, "assets/art/campaign-previews/%-%", stages[stage], number)
                Append(*path, ifx portrait then "-portrait.png" else ".png")
                file := BuilderFinish(path)
                indexed := QuantizeImage(*preview, COLOURS, false)
                // Compare what would be written: the palette colours.
                for i: 0..cast(s64)preview.width * preview.height - 1 {
                    entry := cast(s64)indexed.indices[i] * 3
                    for channel: 0..2 { preview.pixels[i * 4 + channel] = indexed.palette[entry + channel] }
                }
                committed := ReadPNGFile(file)
                same := ImageValid(*committed) && committed.width == preview.width && committed.height == preview.height
                if same {
                    total := 0.0
                    for i: 0..cast(s64)preview.width * preview.height - 1 {
                        for channel: 0..2 {
                            a := cast(s32)committed.pixels[i * 4 + channel]
                            b := cast(s32)preview.pixels[i * 4 + channel]
                            d := ifx a > b then a - b else b - a
                            if d > WORST { same = false }
                            total += cast(float64)d
                        }
                    }
                    if total / cast(float64)(preview.width * preview.height * 3) > AVERAGE { same = false }
                }
                if check {
                    if !same { print("tools/render_previews: % does not match regeneration\n", file); return 1 }
                } else {
                    if !WriteIndexedPNGFile(file, *indexed) { print("tools/render_previews: cannot write %\n", file); return 1 }
                    if !same { changed += 1 }
                }
            }
        }
    }
    if check { print("Preview pictures match regeneration.\n") } else { print("Previews written: % changed, 400 total.\n", changed) }
    return 0
}
