// Synchronizes version.json and src/version.zi with the newest numbered
// release in CHANGELOG.md; the version code grows with each new release.
// update_version.sh runs it.
#import "std/file"
#import "std/format"
#import "std/json_scan"
#import "std/text_tools"

// The three numbers of an x.y.z version, or false.
Parts :: (text: string) -> (major: s64, minor: s64, patch: s64, ok: bool) {
    pieces := TextSplit(text, ".")
    if pieces.count != 3 { return 0, 0, 0, false }
    values: [3]s64
    for i: 0..2 {
        if pieces[i].count == 0 || !TextOnly(pieces[i], "0123456789") { return 0, 0, 0, false }
        value, ok := TextInteger(pieces[i])
        if !ok { return 0, 0, 0, false }
        values[i] = value
    }
    return values[0], values[1], values[2], true
}

#program_export
main :: () -> s32 {
    changelog, found := ReadEntireFile("CHANGELOG.md")
    version := ""
    if found {
        lines := TextLines(changelog)
        for i: 0..lines.count - 1 {
            if !TextHasPrefix(lines[i], "## [") { continue }
            close := TextFind(lines[i], "]")
            if close < 0 { continue }
            a, b, c, ok := Parts(lines[i][4:close])
            if ok {
                copy: Vec(u8)
                Append(*copy, lines[i][4:close])
                version = BuilderFinish(copy)
                break
            }
        }
    }
    if version.count == 0 { print("CHANGELOG.md needs a numeric release entry\n"); return 1 }
    code: s64 = 1
    previous, has_previous := ReadEntireFile("version.json")
    if has_previous {
        old_span := ReadString(previous, FieldAt(previous, 0, "version"))
        old_code := ReadNumber(previous, FieldAt(previous, 0, "version_code"))
        if !old_span.valid || !old_code.valid { print("version.json is unreadable\n"); return 1 }
        a0, b0, c0, old_ok := Parts(previous[old_span.start:old_span.end])
        a1, b1, c1, new_ok := Parts(version)
        if !old_ok || !new_ok { print("version.json is unreadable\n"); return 1 }
        older := a1 < a0 || (a1 == a0 && (b1 < b0 || (b1 == b0 && c1 < c0)))
        if older { print("Release versions cannot decrease\n"); return 1 }
        newer := a1 > a0 || (a1 == a0 && (b1 > b0 || (b1 == b0 && c1 > c0)))
        code = cast(s64)old_code.value + ifx newer then 1 else 0
    }
    metadata: Vec(u8)
    BuilderPrint(*metadata, "{\n  \"version\": \"%\",\n  \"version_code\": %\n}\n", version, code)
    source: Vec(u8)
    BuilderPrint(*source, "// Generated by update_version.sh from CHANGELOG.md.\nAppVersion :: \"%\"\n", version)
    if !WriteEntireFile("version.json", BuilderFinish(metadata)) || !WriteEntireFile("src/version.zi", BuilderFinish(source)) {
        print("cannot write version.json or src/version.zi\n"); return 1
    }
    print("Apfelwurm release metadata synchronized: %\n", version)
    return 0
}
