// Compiles the explicitly published editor boards in assets/authored-levels
// into src/authored_levels.zi, never personal save records. With --check it
// only verifies that the generated file is current.
//
//     ziran run --target=c tools/authored_levels.zi -- [--check]
#import "std/file"
#import "std/file_tree_linux"
#import "std/format"
#import "std/text_tools"
#import "std/byte_text_linux"
#import "std/number_text"

Record :: struct {
    level: s64
    portrait: bool
    raw: string
}

Fail :: (message: string) -> s32 {
    print("tools/authored_levels: %\n", message)
    return 1
}

// levelN.dat or levelN-portrait.dat, N from 1 to 200, as a 0-based level.
Name :: (name: string) -> (level: s64, portrait: bool, ok: bool) {
    if !TextHasPrefix(name, "level") || !TextHasSuffix(name, ".dat") { return 0, false, false }
    stem := name[5:name.count - 4]
    portrait := TextHasSuffix(stem, "-portrait")
    if portrait { stem = stem[0:stem.count - 9] }
    value, digits := IntegerPrefix(stem)
    if digits == 0 || digits != stem.count || stem[0] == #char "-" || value < 1 || value > 200 { return 0, false, false }
    return value - 1, portrait, true
}

Condition :: (out: *Vec(u8), record: Record) {
    BuilderPrint(out, "    if level == % && ", record.level)
    if !record.portrait { Append(out, "!") }
    Append(out, "portrait { return ")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    check := argc > 1 && TextFromCString(argv[1]) == "--check"
    folder := "assets/authored-levels"
    names: Vec(string)
    if !ListDirectory(folder, *names) { return Fail("cannot list assets/authored-levels") }
    records: Vec(Record)
    used: [256]bool
    for i: 0..names.count - 1 {
        if !TextHasSuffix(names[i], ".dat") { continue }
        level, portrait, ok := Name(names[i])
        if !ok { return Fail(JoinPath("unexpected record", names[i])) }
        raw, found := ReadEntireFile(JoinPath(folder, names[i]))
        if !found || (raw.count != 1201 && raw.count != 2401) || raw[0] < 1 || raw[0] > 12 {
            return Fail(JoinPath("bad record", names[i]))
        }
        for b: 1..raw.count - 1 { used[raw[b]] = true }
        unused VecPush(records, Record.{level, portrait, raw})
    }
    alphabet := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    code: [256]u8
    values: Vec(u8)
    for value: 0..255 {
        if !used[value] { continue }
        if values.count >= alphabet.count { return Fail("the authored tile codebook is full") }
        code[value] = alphabet[values.count]
        unused VecPush(values, cast(u8)value)
    }
    out: Vec(u8)
    Append(*out, "// Generated by tools/authored_levels.zi from assets/authored-levels.\nAuthoredAlphabet :: \"")
    Append(*out, alphabet[0:values.count])
    BuilderPrint(*out, "\";\nAuthoredCodebook: [%]u8 = .[", values.count)
    for i: 0..values.count - 1 { if i > 0 { Append(*out, ", ") }; BuilderPrint(*out, "%", values[i]) }
    Append(*out, "];\n\n")
    for part: 0..1 {
        first: s64 = ifx part == 0 then 1 else 1201
        last: s64 = ifx part == 0 then 1201 else 2401
        Append(*out, ifx part == 0 then "AuthoredTiles" else "AuthoredObjects")
        Append(*out, " :: (level: s32, portrait: bool) -> string {\n")
        for r: 0..records.count - 1 {
            record := records[r]
            end := ifx last < record.raw.count then last else record.raw.count
            any := false
            for b: first..end - 1 { if record.raw[b] != 0 { any = true } }
            if part == 1 && !any { continue }
            Condition(*out, record)
            Append(*out, "\"")
            for b: first..end - 1 { unused VecPush(out, code[record.raw[b]]) }
            Append(*out, "\" }\n")
        }
        Append(*out, "    return \"\"\n}\n\n")
    }
    Append(*out, "AuthoredApples :: (level: s32, portrait: bool) -> s32 {\n")
    for r: 0..records.count - 1 {
        Condition(*out, records[r])
        BuilderPrint(*out, "% }\n", records[r].raw[0])
    }
    Append(*out, "    return -1\n}\n\nAuthoredDecode :: (code: u8) -> u8 {\n    for index: 0..AuthoredAlphabet.count - 1 {\n")
    Append(*out, "        if AuthoredAlphabet[index] == code { return AuthoredCodebook[index] }\n    }\n    return 0\n}\n")
    generated := BuilderFinish(out)
    path := "src/authored_levels.zi"
    if check {
        current, found := ReadEntireFile(path)
        if !found || current != generated { return Fail("published editor boards need regeneration") }
        print("% published editor layouts verified.\n", records.count)
        return 0
    }
    if !WriteEntireFile(path, generated) { return Fail("cannot write src/authored_levels.zi") }
    print("% published editor layouts compiled.\n", records.count)
    return 0
}
