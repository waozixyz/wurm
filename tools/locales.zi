// Compiles the game's translated interface labels in src/locales/*.txt to
// ordinary Ziran in src/localization.zi. With --check it only verifies that
// the generated file is current.
//
//     ziran run --target=c tools/locales.zi -- [--check]
#import "std/file"
#import "std/file_tree_linux"
#import "std/format"
#import "std/text_tools"
#import "std/byte_text_linux"

// Every locale's labels, in file order: which locale, its key and its text.
names_of: Vec(string);
entry_locale: Vec(s64);
entry_key: Vec(string);
entry_text: Vec(string);

Fail :: (message: string) -> s32 {
    print("tools/locales: %\n", message)
    return 1
}

// Text as a JSON string literal, keeping non-ASCII characters as they are,
// exactly as Python's json.dumps(text, ensure_ascii=False) writes it.
Quote :: (out: *Vec(u8), text: string) {
    Append(out, "\"")
    for i: 0..text.count - 1 {
        byte := text[i]
        if byte == #char "\"" { Append(out, "\\\"") }
        else if byte == #char "\\" { Append(out, "\\\\") }
        else if byte == 10 { Append(out, "\\n") }
        else if byte == 13 { Append(out, "\\r") }
        else if byte == 9 { Append(out, "\\t") }
        else if byte == 8 { Append(out, "\\b") }
        else if byte == 12 { Append(out, "\\f") }
        else if byte < 32 {
            hex := "0123456789abcdef"
            Append(out, "\\u00")
            unused VecPush(out.*, hex[byte >> 4])
            unused VecPush(out.*, hex[byte & 15])
        } else { unused VecPush(out.*, byte) }
    }
    Append(out, "\"")
}

// The entry of KEY in LOCALE, or -1.
Find :: (locale: s64, key: string) -> s64 {
    for i: 0..entry_key.count - 1 { if entry_locale[i] == locale && entry_key[i] == key { return i } }
    return -1
}

Words :: (first: string, second: string, third: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "% % %", first, second, third)
    return BuilderFinish(text)
}

// The fixed start of the generated module.
Header :: (out: *Vec(u8)) {
    Append(out, "// Generated by tools/locales.zi from src/locales/*.txt.\n")
    Append(out, "#import \"std/text_buffer\"\n")
    Append(out, "#if #defined(PLATFORM_WEB) {\n")
    Append(out, "    #import \"std/web\"\n")
    Append(out, "} else #if !#defined(WURM_PORTABLE) {\n")
    Append(out, "    #import \"std/environment_linux\"\n")
    Append(out, "}\n")
    Append(out, "language: [3]u8;\n")
    Append(out, "ready: bool;\n")
    Append(out, "SetLanguage :: (value: string) {\n")
    Append(out, "    ready = true\n")
    Append(out, "    language = .{}\n")
    Append(out, "    if value.count >= 2 { language[0] = value[0]; language[1] = value[1] }\n")
    Append(out, "}\n")
    Append(out, "Detect :: () {\n")
    Append(out, "    if ready { return }\n")
    Append(out, "    ready = true\n")
    Append(out, "    #if #defined(PLATFORM_WEB) {\n")
    Append(out, "        scope := WebScope()\n")
    Append(out, "        bytes: [64]u8\n")
    Append(out, "        unused WebCopyString(WebGetObject(WebGetObject(WebGlobal, WebName(\"navigator\")), WebName(\"language\")), bytes[:])\n")
    Append(out, "        SetLanguage(TextUntilNul(bytes[:]))\n")
    Append(out, "        WebEnd(scope)\n")
    Append(out, "    } else #if !#defined(WURM_PORTABLE) {\n")
    Append(out, "        value := EnvironmentText(\"LANG\")\n")
    Append(out, "        if value != \"\" { SetLanguage(value) }\n")
    Append(out, "    }\n")
    Append(out, "}\n")
    Append(out, "Text :: (source: string) -> string {\n")
    Append(out, "    Detect()\n")
    Append(out, "    locale := TextUntilNul(language[:])\n")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    check := argc > 1 && TextFromCString(argv[1]) == "--check"
    names: Vec(string)
    if !ListDirectory("src/locales", *names) { return Fail("cannot list src/locales") }
    english: s64 = -1
    for n: 0..names.count - 1 {
        file := names[n]
        if !TextHasSuffix(file, ".txt") { continue }
        locale := names_of.count
        VecPush(names_of, file[0:file.count - 4])
        text, found := ReadEntireFile(JoinPath("src/locales", file))
        if !found { return Fail(Words("cannot read", file, "")) }
        blocks := TextSplit(text, "---\n")
        for b: 0..blocks.count - 1 {
            lines := TextLines(TextTrim(blocks[b]))
            if lines.count == 0 || !TextHasPrefix(lines[0], "[wurm_") { continue }
            for l: 1..lines.count - 1 {
                if TextHasPrefix(lines[l], "[") && TextHasSuffix(lines[l], "]") {
                    return Fail(Words("missing locale separator in", file, lines[0]))
                }
            }
            key := lines[0][1:lines[0].count - 1]
            if Find(locale, key) >= 0 { return Fail(Words("duplicate locale key in", file, lines[0])) }
            rest: []string = VecSlice(lines, 1, lines.count)
            VecPush(entry_locale, locale)
            VecPush(entry_key, key)
            VecPush(entry_text, TextJoin(rest, "\n"))
        }
        if file == "en.txt" { english = locale }
    }
    if english < 0 { return Fail("src/locales/en.txt is missing") }
    for locale: 0..names_of.count - 1 {
        count: s64
        for i: 0..entry_key.count - 1 {
            if entry_locale[i] != locale { continue }
            count += 1
            if Find(english, entry_key[i]) < 0 { return Fail("every locale must contain every key") }
        }
        for i: 0..entry_key.count - 1 {
            if entry_locale[i] == english && Find(locale, entry_key[i]) < 0 { return Fail("every locale must contain every key") }
        }
    }
    code: Vec(u8)
    Header(*code)
    for locale: 0..names_of.count - 1 {
        if locale == english { continue }
        Append(*code, "    if locale == ")
        Quote(*code, names_of[locale])
        Append(*code, " {\n")
        for i: 0..entry_key.count - 1 {
            if entry_locale[i] != locale { continue }
            source := entry_text[Find(english, entry_key[i])]
            if entry_text[i] == source { continue }
            Append(*code, "        if source == ")
            Quote(*code, source)
            Append(*code, " { return ")
            Quote(*code, entry_text[i])
            Append(*code, " }\n")
        }
        Append(*code, "    }\n")
    }
    Append(*code, "    return source\n}\n")
    generated := BuilderFinish(code)
    output := "src/localization.zi"
    if check {
        current, found := ReadEntireFile(output)
        if !found || current != generated { return Fail("src/localization.zi is out of date; run ziran run --target=c tools/locales.zi") }
        return 0
    }
    if !WriteEntireFile(output, generated) { return Fail("cannot write src/localization.zi") }
    return 0
}
